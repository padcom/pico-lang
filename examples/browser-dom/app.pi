// The DOM demo (spec §12.3): `js:dom` is typed from TypeScript's lib.dom.d.ts, so the DOM is
// used through generated classes (`Document`, `HTMLElement`, …); callbacks are `JsValue.fn`.
//
//   pico build --target wasm32-browser examples/browser-dom/app.pi -o examples/browser-dom/app
//   python3 -m http.server -d examples/browser-dom    # then open http://localhost:8000

import { document, console } from "js:dom"
import { JsValue } from "std/js"

const app = document.getElementById("app")
if (app != null) {
  const title = document.createElement("h1")
  title.textContent = "pico + lib.dom.d.ts"
  app.appendChild(title)

  const list = document.createElement("ul")
  for (const name of ["typed", "garbage-collected", "compiled to wasm"]) {
    const item = document.createElement("li")
    item.textContent = name
    list.appendChild(item)
  }
  app.appendChild(list)

  const button = document.createElement("button")
  button.id = "count"
  button.textContent = "clicked 0 times"
  let clicks = 0
  button.addEventListener("click", JsValue.fn((args: JsValue) => {
    clicks += 1
    button.textContent = `clicked ${clicks} times`
    console.log(`click ${clicks}`)
  }))
  app.appendChild(button)
  // (For automated checks: one click once loaded.)
  if (document.location.hash == "#click") {
    button.click()
  }
}
console.log(`ready: ${document.title}`)
