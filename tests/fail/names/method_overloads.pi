// Overloaded methods: overloads must differ in their parameter types and share visibility;
// virtual overloads and overloads of an inherited method aren't implemented yet; a call
// fits one overload, or it's ambiguous or fits none (`types/method_overload_calls.pi`).
// error: E0203
// at: 14:10
// error: E0203
// at: 16:3
// error: E0900
// at: 19:3
// error: E0900
// at: 23:10
class A {
  public f(x: int): int { return 1 }
  public f(y: int): string { return "2" }
  public g(x: int): int { return 1 }
  g(x: string): int { return 2 }
  public h(x: int?): int { return 1 }
  public h(x: string?): int { return 2 }
  public virtual v(x: int): int { return 1 }
  public v(x: string): int { return 2 }
}
class B extends A {
  public h(x: bool): int { return 3 }
  public h(x: number): int { return 4 }
}
