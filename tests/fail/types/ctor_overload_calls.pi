// A `new` fits one constructor: a `bool` neither (E0333), `null` both (E0332), three arguments
// none of them by count (E0302), and so for `super(…)` (#150).
// error: E0333
// at: 15:1
// error: E0332
// at: 16:1
// error: E0302
// at: 17:1
// error: E0333
// at: 19:19
class R {
  constructor(x: int?) {}
  constructor(s: string?) {}
}
new R(true)
new R(null)
new R(1, 2, 3)
class S extends R {
  constructor() { super(false) }
}
