// error: E0308
// at: 8:9
// error: E0304
// at: 14:17
// Generators yield their element type; `for-of` needs something iterable.
function* numbers(): Iterator<int> {
  yield 1
  yield "two"
}

class Bag {
  items: int[] = []
}
for (const x of new Bag()) {
  println(x)
}

function* letters(): Iterator<string> {
  const f = () => 1
  yield `${f()}`
}
