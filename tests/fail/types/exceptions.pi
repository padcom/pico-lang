// Unhandled checked errors (spec §7.2): every thrown error is caught or declared. Methods
// declare what they throw; top-level functions and lambdas without a clause infer it.
class IoError extends Error {}
class ParseError extends Error {}

function read(): string throws IoError {
  throw new IoError("gone")
}

function parse(s: string): int throws ParseError | IoError {
  0
}

class Service {
  // No `throws` clause on a method: it can't throw.
  public quiet(): string {
    read()
  }

  // Catching narrows: the `ParseError` is handled, the `IoError` isn't.
  public half(): int throws ParseError {
    try parse("1") catch (e: ParseError) 0
  }

  // `throws Error` covers every subclass, but `throws IoError` doesn't cover `Error`.
  public wide(): void throws IoError {
    throw new Error("plain")
  }

  // An error thrown inside a `catch` isn't caught by the same `try`.
  public rethrow(): void throws IoError {
    try {
      read()
    } catch (e: IoError) {
      throw new ParseError("again")
    }
  }
}

// A catch with a refutable pattern doesn't handle its type for sure.
class Coded extends Error {
  public code: int
  constructor(code: int) {
    super("coded")
    this.code = code
  }
}
function coded(): void throws Coded {
  throw new Coded(1)
}
function partly(): void throws ParseError {
  try coded() catch (e: Coded { code: 1 }) {}
}

// Inferred clauses propagate: `loader` infers `throws IoError`.
function loader(): string {
  read()
}
function strict(): string throws ParseError {
  loader()
}

// A lambda passed where a non-throwing function is expected can't throw.
function twice(f: () => string): string {
  f() + f()
}
const t = twice(() => read())

// Throws polymorphism: `map` throws what its callback throws.
function map<T, U, E extends Error>(xs: T[], f: (x: T) => U throws E): U[] throws E {
  const out: U[] = []
  for (const x of xs) {
    out.push(f(x))
  }
  out
}
function parseInt(s: string): int throws ParseError {
  throw new ParseError(s)
}
// `map(xs, l => parseInt(l))` throws exactly `ParseError`, which `throws IoError` doesn't cover.
function numbers(lines: string[]): int[] throws IoError {
  map(lines, l => parseInt(l))
}
function fine(xs: string[]): int[] {
  map(xs, s => s.length)
}

// Calling a function value runs whatever its type says it throws.
function call(f: () => string throws IoError): string {
  f()
}
function strictCall(f: () => string throws IoError): string throws ParseError {
  f()
}
