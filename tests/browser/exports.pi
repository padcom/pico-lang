// Built for wasm32-browser and driven from JavaScript by exports.mjs (crates/pico-tests/tests/browser.rs).
struct Point { x: f64; y: f64 }
struct Labeled { label: string; at: Point; count: int; ok: bool }

class Counter {
  public n: int = 0
  constructor() {}
  public bump(): int {
    this.n += 1
    this.n
  }
}

@export("js")
export function add(a: int, b: int): int { a + b }

@export("js")
export function greet(name: string): string { `hello, ${name}!` }

@export("js")
export function mid(a: Point, b: Point): Point {
  const p: Point = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }
  p
}

@export("js")
export function describe(l: Labeled): Labeled {
  const r: Labeled = { label: `${l.label}/${l.count}`, at: l.at, count: l.count * 2, ok: !l.ok }
  r
}

@export("js")
export function newCounter(): Counter { new Counter() }

@export("js")
export function bump(c: Counter): int { c.bump() }

@export("js")
export function later(ms: int): void {
  setTimeout(() => { println(`later ${ms}`) }, ms)
}

println("started")
