// A C library through its header (spec §12.2): zlib, linked by project.json. Run by
// crates/ppl-tests/tests/c_headers.rs where zlib's header and library are installed.
import { zlibVersion, compress, uncompress, compressBound, Z_OK } from "c:zlib.h"

const text = "hello hello hello hello hello hello hello hello, zlib!"
const input: u8[] = []
for (const c of text) {
  input.push(c as u32 as u8)
}
unsafe {
  println(`zlib ${string.fromC(zlibVersion()).length > 0}`)
  let cap = compressBound(input.length as usize)
  const packed: u8[] = []
  for (let i = 0; i < cap as int; i++) { packed.push(0 as u8) }
  let packedLen: usize = cap
  const r = compress(ptr.of(packed[0]), ptr.of(packedLen), ptr.of(input[0]), input.length as usize)
  println(`compress ${r == Z_OK} ${packedLen < input.length as usize}`)
  const out: u8[] = []
  for (let i = 0; i < input.length; i++) { out.push(0 as u8) }
  let outLen: usize = out.length as usize
  const r2 = uncompress(ptr.of(out[0]), ptr.of(outLen), ptr.of(packed[0]), packedLen)
  out.push(0 as u8)
  println(`uncompress ${r2 == Z_OK} ${string.fromC(ptr.of(out[0])) == text}`)
}
