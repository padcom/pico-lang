// `Array.splice(start, deleteCount?, ...items)` (decision 314): removes and inserts in place,
// returns the removed elements; negative `start` counts from the end; triggers reactivity once.
// expect: [2, 3] [1, 4, 5]
// expect: [5] [1, 4]
// expect: [] [1, 7, 8, 4]
// expect: [1, 7, 8, 4] [0]
// expect: [] [0]
// expect: 4 1.5
// expect: effect: a,b,c
// expect: effect: a,x,y,c
// expect: runs: 2
const xs = [1, 2, 3, 4, 5]
println(`${xs.splice(1, 2):?} ${xs:?}`)
println(`${xs.splice(-1):?} ${xs:?}`)
println(`${xs.splice(1, 0, 7, 8):?} ${xs:?}`)
println(`${xs.splice(0, 99, 0):?} ${xs:?}`)
println(`${xs.splice(5, -3):?} ${xs:?}`)

function wrap<T>(x: T): T[] {
  const out: T[] = [x, x, x]
  out.splice(1, 1, x, x)
  out
}
println(`${wrap("s").length} ${wrap(1.5)[3]}`)

// Through another reference to reactive state: one trigger per call.
reactive items: string[] = ["a", "b", "c"]
let runs = 0
watchEffect(() => {
  runs += 1
  println(`effect: ${items.join(",")}`)
})
const alias = items
alias.splice(1, 1, "x", "y")
println(`runs: ${runs}`)
