// expect: Vec2 { x: 4, y: 6 } Vec2 { x: 2, y: 4 } Vec2 { x: -1, y: -2 }
// expect: 1 2 | Vec2 { x: 7, y: 10 }
// expect: true false
// expect: [Point { x: 1, y: 5 }, Point { x: 2, y: 1 }, Point { x: 2, y: 3 }, Point { x: 9, y: 0 }]
// expect: -1 0 1 true
// expect: ann bob cy
// expect: true true false
// expect: 1 0 -1
// expect: [3, 1] < [3, 2]: true
// expect: 30 25
struct Vec2 {
  x: f32
  y: f32
  operator +(o: Vec2): Vec2 { Vec2 { x: x + o.x, y: y + o.y } }
  operator *(k: f32): Vec2 { Vec2 { x: x * k, y: y * k } }
  operator [](i: i32): f32 { if (i == 0) x else y }
  operator -(): Vec2 { Vec2 { x: -x, y: -y } }
}
const a = Vec2 { x: 1, y: 2 }
const b = Vec2 { x: 3, y: 4 }
println(`${a + b:?} ${a * 2:?} ${-a:?}`)
let c = a
c += b * 2
println(`${a[0]} ${a[1]} | ${c:?}`)
println(`${a == Vec2 { x: 1, y: 2 }} ${a == b}`)

// Structs compare field by field (derived `compareTo`), so they sort.
struct Point { x: i32; y: i32 }
function sort<T extends Comparable<T>>(xs: T[]) {
  let i = 1
  while (i < xs.length) {
    const v = xs[i]
    let j = i - 1
    while (j >= 0 && xs[j].compareTo(v) > 0) {
      xs[j + 1] = xs[j]
      j -= 1
    }
    xs[j + 1] = v
    i += 1
  }
}
const pts = [Point { x: 2, y: 3 }, Point { x: 9, y: 0 }, Point { x: 1, y: 5 }, Point { x: 2, y: 1 }]
sort(pts)
println(`${pts:?}`)
const p = Point { x: 1, y: 1 }
println(`${p.compareTo(Point { x: 1, y: 2 })} ${p.compareTo(p)} ${Point { x: 2, y: 0 }.compareTo(p)} ${p < Point { x: 1, y: 2 }}`)

// A class ordering itself by hand.
class User {
  constructor(public name: string) {}
  public compareTo(o: User): i32 { if (name < o.name) -1 else if (name > o.name) 1 else 0 }
}
const users = [new User("cy"), new User("ann"), new User("bob")]
sort(users)
println(`${users[0].name} ${users[1].name} ${users[2].name}`)

// `@derive` gives classes value equality, hashing and ordering.
@derive(Eq, Hash, Ord)
class Id { constructor(public value: i64) {} }
const i1 = new Id(7)
const i2 = new Id(7)
println(`${i1.equals(i2)} ${i1.hashCode() == i2.hashCode()} ${i1.hashCode() == new Id(8).hashCode()}`)
enum Level { Low, Mid(n: i32), High }
println(`${Level.Mid(5).compareTo(Level.Low)} ${Level.Mid(5).compareTo(Level.Mid(5))} ${Level.Mid(1).compareTo(Level.High)}`)
const t1: [i32, i32] = [3, 1]
const t2: [i32, i32] = [3, 2]
println(`[3, 1] < [3, 2]: ${t1 < t2}`)

class Money {
  constructor(public cents: i64) {}
  public equals(o: Money): bool { cents == o.cents }
  operator +(o: Money): Money { new Money(cents + o.cents) }
}
const m = new Money(10) + new Money(20)
println(`${m.cents} ${if (new Money(5) == new Money(5)) 25 else 0}`)
