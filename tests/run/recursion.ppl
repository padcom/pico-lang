// expect: true
// expect: false
// expect: 61
function isEven(n: i64): bool { if (n == 0) true else isOdd(n - 1) }
function isOdd(n: i64): bool { if (n == 0) false else isEven(n - 1) }
println(isEven(10))
println(isEven(7))
function ack(m: i64, n: i64): i64 {
  if (m == 0) return n + 1
  if (n == 0) return ack(m - 1, 1)
  ack(m - 1, ack(m, n - 1))
}
println(ack(2, 29))
