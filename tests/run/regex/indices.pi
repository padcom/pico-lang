// expect: [1, 4] [2, 4] [2, 4]
// expect: 3 [3, 6] [3, 5] null
// expect: no d: null
// expect: [2, 3] [5, 6]
// The `d` flag's `indices` (#62): where the match and each group start and end, also by name;
// `null` for a group that didn't take part and without the flag; with `g`, per match.
const m = /a(?<b>b+)/d.exec("xabb")
if (m != null) {
  println(`${m.indices?.[0]:?} ${m.indices?.[1]:?} ${m.indices?.groups?.get("b"):?}`)
}
const n = /(\d+)-(\d+)?/d.exec("id 12-")
if (n != null) {
  const ix = n.indices
  if (ix != null) {
    println(`${ix.length} ${ix[0]:?} ${ix[1]:?} ${ix[2]:?}`)
  }
}
const plain = /a/.exec("a")
println(`no d: ${plain?.indices:?}`)
const all = /x/dg
const parts: string[] = []
let found = all.exec("aax-ax")
while (found != null) {
  parts.push(`${found.indices?.[0]:?}`)
  found = all.exec("aax-ax")
}
println(parts.join(" "))
