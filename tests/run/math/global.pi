println(`${Math.PI} ${Math.sqrt(2)} ${Math.sin(1)} ${Math.atan2(1, 2)} ${Math.pow(2, 0.5)} ${Math.exp(1)} ${Math.log(10)}`)
println(`${Math.round(2.5)} ${Math.round(-2.5)} ${Math.round(0.49999999999999994)} ${Math.floor(-1.5)} ${Math.ceil(1.2)} ${Math.trunc(-1.7)} ${Math.sign(-3)}`)
println(`${Math.max(1, 5, 3)} ${Math.min()} ${Math.hypot(3, 4)} ${Math.cbrt(27)} ${Math.fround(5.5)} ${Math.fround(5.05)} ${Math.clz32(1)} ${Math.imul(0xffffffff, 5)} ${Math.imul(123456789, 987654321)}`)
println(`${Math.log2(8)} ${Math.log10(1000)} ${Math.expm1(1e-10)} ${Math.log1p(1e-10)} ${Math.tanh(0.5)} ${Math.asinh(1)} ${Math.abs(-0.0)} ${Math.pow(1, 1.0/0.0)}`)
const r = Math.random()
println(`${r >= 0.0 && r < 1.0}`)
