// Spec §16.4, §16.7: disposing an effect stops it (also with `using`), and an effect scope
// stops the effects, computeds and scopes created while it ran.
// expect: e 0
// expect: e 1
// expect: u 1
// expect: u 2
// expect: scoped 2
// expect: inner 2
// expect: scoped 3
// expect: inner 3
// expect: doubled 8
// expect: getter runs 2
// expect: done
reactive n = 0
const h = watchEffect(() => println(`e ${n}`))
n = 1
h.dispose()
h.dispose()
{
  using u = watchEffect(() => println(`u ${n}`))
  n = 2
}
let getterRuns = 0
let doubled: (() => int)? = null
const scope = effectScope(() => {
  watchEffect(() => println(`scoped ${n}`))
  effectScope(() => {
    watchEffect(() => println(`inner ${n}`))
  })
  const d = computed(() => {
    getterRuns += 1
    n * 2
  })
  doubled = () => d
})
n = 3
scope.dispose()
n = 4
// A stopped computed runs its getter at every read, uncached.
const read = doubled
if (read != null) {
  println(`doubled ${read()}`)
  read()
}
println(`getter runs ${getterRuns}`)
println("done")
