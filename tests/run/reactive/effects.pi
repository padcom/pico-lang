// Spec §16.4–16.5: effects run at once and again, synchronously, after the writes that
// trigger them; in creation order; not for identical values, nor for their own writes; and an
// effect that reads a computed runs only when its value changes.
// expect: a: 0
// expect: b: 0
// expect: write 1
// expect: a: 1
// expect: b: 1
// expect: after write 1
// expect: same value: nothing
// expect: parity: even
// expect: parity: odd
// expect: parity runs 2
// expect: count 5
// expect: same object: nothing
// expect: new object
// expect: diamond 2
// expect: diamond 4
reactive n = 0
watchEffect(() => println(`a: ${n}`))
watchEffect(() => println(`b: ${n}`))
println("write 1")
n = 1
println("after write 1")
n = 1
println("same value: nothing")

// `parity` changes only on some writes: the effect runs only then.
reactive m = 0
const parity = computed(() => if (m % 2 == 0) "even" else "odd")
let parityRuns = 0
watchEffect(() => {
  parityRuns += 1
  println(`parity: ${parity}`)
})
m = 2
m = 3
println(`parity runs ${parityRuns}`)

// An effect's own writes don't trigger it again.
reactive count = 0
watchEffect(() => {
  if (count < 5) {
    count = 5
  }
})
println(`count ${count}`)

class Thing {
  constructor(public name: string) {}
}
reactive thing = new Thing("x")
const t0 = thing
let runsT = 0
const wt = watchEffect(() => {
  thing
  runsT += 1
})
thing = t0
println(if (runsT == 1) "same object: nothing" else `runs ${runsT}`)
thing = new Thing("y")
println(if (runsT == 2) "new object" else `runs ${runsT}`)
wt.dispose()

// A diamond: the effect runs once per write, with both sides up to date.
reactive base = 1
const left = computed(() => base * 2)
const right = computed(() => base * 2)
watchEffect(() => {
  if (left != right) {
    println("glitch")
  }
  println(`diamond ${left}`)
})
base = 2
