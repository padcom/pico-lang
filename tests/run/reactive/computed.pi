// Spec §16.3: computed values are lazy, cached, and depend on what their last run read.
// expect: 20 20 runs=1
// expect: runs=1
// expect: 30 runs=2
// expect: big: 30
// expect: runs=2
// expect: small: 1
// expect: picks=2
// expect: Ada Lovelace
// expect: Grace Hopper Grace
reactive price = 10
reactive qty = 2
let runs = 0
const total = computed(() => {
  runs += 1
  price * qty
})
println(`${total} ${total} runs=${runs}`)
qty = 3
println(`runs=${runs}`)
println(`${total} runs=${runs}`)

// Dependencies come from the last run: `small` isn't read while `useBig` is true.
reactive useBig = true
reactive small = 1
let picks = 0
const pick = computed(() => {
  picks += 1
  if (useBig) `big: ${total}` else `small: ${small}`
})
println(pick)
small = 2
println(`runs=${runs}`)
useBig = false
small = 1
println(pick)
println(`picks=${picks}`)

// Writable computed.
reactive first = "Ada"
reactive last = "Lovelace"
const full = computed({
  get: () => `${first} ${last}`,
  set: (v: string) => {
    const parts = v.split(" ")
    first = parts[0]
    last = parts[1]
  },
})
println(full)
full = "Grace Hopper"
println(`${full} ${first}`)
