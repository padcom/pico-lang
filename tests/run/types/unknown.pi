// `unknown` (#53): any value goes in (boxed, with its type); it's used after narrowing it
// with `match`, `is` or a checked `as`.
// expect: int 42
// expect: string hi
// expect: null
// expect: Dog Rex
// expect: Animal Tom
// expect: point 1,2
// expect: other
// expect: true false
// expect: 7
// expect: unknown again: 5
// expect: 42 true

class Animal {
  public name: string
  constructor(name: string) {
    this.name = name
  }
}

class Dog extends Animal {}

struct Point {
  x: int
  y: int
}

function describe(u: unknown): string {
  return match (u) {
    n: int => `int ${n}`,
    s: string => `string ${s}`,
    null => "null",
    d: Dog => `Dog ${d.name}`,
    a: Animal => `Animal ${a.name}`,
    p: Point => `point ${p.x},${p.y}`,
    _ => "other",
  }
}

const maybe: string? = null
const values: unknown[] = [42, "hi", maybe, new Dog("Rex"), new Animal("Tom"), Point { x: 1, y: 2 }, 2.5]
for (const v of values) println(describe(v))
const u: unknown = "text"
println(`${u is string} ${u is int}`)
const seven: unknown = 7
println((seven as int))
const nested: unknown = 5
const again: unknown = nested
match (again) {
  n: int => println(`unknown again: ${n}`),
  _ => {},
}
const m: unknown = null
println(`${(42 as unknown) as int} ${m is null}`)
