// expect: 7 2.5 b z
// expect: 3 -1 0
// expect: [3, 2, 1] 3
// expect: hello 42
// expect: true false
// expect: 9
// expect: big 5
// expect: 2 1
function max<T extends Comparable<T>>(a: T, b: T): T { if (a.compareTo(b) >= 0) a else b }
println(`${max(3, 7)} ${max(2.5, 1.5)} ${max("a", "b")} ${max<char>("z", "y")}`)
println(`${max(1i32, 3i32)} ${max(-5, -1)} ${max(0u8, 0u8)}`)

function reversed<T>(xs: T[]): T[] {
  const out: T[] = []
  let i = xs.length - 1
  while (i >= 0) {
    out.push(xs[i])
    i -= 1
  }
  out
}
function len<T>(a: T[]): i64 { a.length }
const r = reversed([1, 2, 3])
println(`${r:?} ${len(r)}`)

function first<T>(xs: T[], fallback: T): T { if (xs.length > 0) xs[0] else fallback }
println(`${first(["hello"], "none")} ${first([], 42)}`)

function contains<T extends Equatable<T>>(xs: T[], x: T): bool {
  for (const v of xs) if (v == x) return true
  false
}
println(`${contains(["a", "b"], "b")} ${contains([1, 2], 3)}`)

// Generic functions calling generic functions (instances of instances).
function largest<T extends Comparable<T>>(xs: T[]): T {
  let best = xs[0]
  for (const x of xs) best = max(best, x)
  best
}
println(largest([3, 9, 4]))

interface Sized { size(): i64 }
struct Box implements Sized { n: i64; size(): i64 { n } }
class Bag implements Sized {
  constructor(public items: i64) {}
  public size(): i64 { items }
}
function describe<T extends Sized>(x: T): string { if (x.size() > 3) `big ${x.size()}` else "small" }
println(describe(Box { n: 5 }))

function pair<A, B>(a: A, b: B): [A, B] { [a, b] }
const p = pair(2, "x")
println(`${p[0]} ${describe(new Bag(1)).length - 4}`)
