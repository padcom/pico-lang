// expect: 2
// expect: 4
// expect: done
// expect: 1 3 5
// expect: 10 20 30
// A transform that gives no output for some chunks (the readable side's default
// highWaterMark is 0) went on reading; it deadlocked (#205).
const evens = new TransformStream<int, int>({
  transform: (n, c) => { if (n % 2 == 0) c.enqueue(n) },
})
for await (const n of ReadableStream.from([1, 2, 3, 4]).pipeThrough(evens)) println(n)
println("done")
const odds = new TransformStream<int, int>({
  transformAsync: async (n, c) => { if (n % 2 == 1) c.enqueue(n) },
})
const got: int[] = []
for await (const n of ReadableStream.from([1, 2, 3, 4, 5, 6]).pipeThrough(odds)) got.push(n)
println(got.join(" "))
// An async transform's output could be read before the write applied backpressure, which then
// nothing released.
const all = new TransformStream<int, int>({ transformAsync: async (n, c) => { c.enqueue(n * 10) } })
const tens: int[] = []
for await (const n of ReadableStream.from([1, 2, 3]).pipeThrough(all)) tens.push(n)
println(tens.join(" "))
