// `ArrayBuffer` copies received from a worker are freed once dropped (issue #16): 300 MiB of
// copies, resident memory stays well below that (measured where /proc exists).
// expect: received 300 copies; freed: true
import { Msg } from "./types"
import { exists, readText } from "std/fs"

async function rssMb(): Promise<int> throws IoError {
  if (!(await exists("/proc/self/status"))) return 0
  const s = await readText("/proc/self/status")
  for (const line of s.split("\n")) {
    if (line.startsWith("VmRSS:")) {
      const parts = line.split(" ").filter((p: string) => p != "")
      return parseInt(parts[1]) / 1024
    }
  }
  0
}

const w = new Worker<Msg, Msg>("./echo")
let n = 0
const done = new Promise<void>()
w.onmessage = (m: Msg) => {
  n += 1
  if (n < 300) w.postMessage(Msg { buf: new ArrayBuffer(1) }) else done.__resolve(__void())
}
const before = try! await rssMb()
w.postMessage(Msg { buf: new ArrayBuffer(1) })
await done
w.terminate()
const after = try! await rssMb()
println(`received ${n} copies; freed: ${after - before < 150}`)
