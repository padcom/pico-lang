// expect: /a/b
// expect: .
// expect: a/c/
// expect: ../../x
// expect: /x
// expect: /a/b
// expect: .
// expect: /
// expect: /a
// expect: b.txt
// expect: b
// expect: b
// expect: .gz
// expect:
// expect: .
