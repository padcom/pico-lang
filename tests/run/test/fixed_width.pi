// `expect` with fixed-width integers picks `expect(int)` (issue #87).
// expect:   ✓ widths
// expect: pico-test: 1 passed, 0 failed, 0 skipped
import { env } from "std/process"
import { test, expect } from "std/test"

env.set("PICO_TEST_TIMES", "0")

test("widths", () => {
  const a: i32 = 3
  const b: u32 = 4
  const c: i16 = -5
  const d: u8 = 6
  expect(a).toBe(3)
  expect(b).toBe(4)
  expect(c).toBe(-5)
  expect(d).toBe(6)
  expect(2.5).toBe(2.5)
  expect(7).toBe(7)
})
