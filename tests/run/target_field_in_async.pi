// expect: 3
// expect: 8
// expect: true 1
// expect: 6
// expect: 2 7
// expect: 9 b
// expect: 9 b 10
// A field named `target` inside async methods and arrows is the field, not the build constant;
// the build constant in an async method doesn't capture `this` (#104).
struct T { system: int }
class W {
  readonly target: T
  constructor(x: T) {
    this.target = x
  }
  public async run(): Promise<int> {
    target.system
  }
}
println(`${await new W({ system: 3 }).run()}`)

class A {
  public target: int = 7
  public run(): int {
    const f = () => target + 1
    f()
  }
}
println(`${new A().run()}`)

class B {
  public x: int = 1
  public async run(): Promise<string> {
    `${target.os.length > 0} ${x}`
  }
}
println(await new B().run())

class C {
  public n: int = 5
  public run(): int {
    const f = () => {
      const g = () => n + 1
      g()
    }
    f()
  }
}
println(`${new C().run()}`)

// Assigning a member in an async method (this is captured first).
class D {
  public n: int = 0
  public target: int = 0
  public async bump(): Promise<string> {
    n += 1
    n = n + 1
    target = 7
    `${n} ${target}`
  }
}
println(await new D().bump())

// Inherited members named `target` and `build` (a method, called bare), in sync, async and
// arrow code.
class Base {
  public target: int = 9
  public build(): string { "b" }
}
class Sub extends Base {
  public sync(): string { `${target} ${build()}` }
  public async run(): Promise<string> {
    const f = () => target + 1
    `${target} ${build()} ${f()}`
  }
}
println(new Sub().sync())
println(await new Sub().run())
