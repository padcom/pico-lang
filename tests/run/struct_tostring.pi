// expect: S#3
// expect: S#3
// expect: is S#3!
// expect: [S#4, S#5]
// expect: S { n: 3 }
// A struct's `toString(): string` is its string form (#57): in templates without a spec,
// `println` and string `+`; `:?` stays the debug form.
struct S {
  n: int
  toString(): string { `S#${this.n}` }
}
const s = S { n: 3 }
println(`${s}`)
println(s)
println("is " + s + "!")
const xs = [S { n: 4 }, S { n: 5 }]
println(`[${xs[0]}, ${xs[1]}]`)
println(`${s:?}`)
