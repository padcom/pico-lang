// `Iterable<T>` and `AsyncIterable<T, E>` (#51): a function takes anything `for-of` walks:
// an array, a string, a `Map`/`Set`, an iterator, a collection; through a bound too.
import { Deque } from "std/collections"
import { Channel } from "std/streams"

function total(xs: Iterable<int>): int {
  let n = 0
  for (const x of xs) n += x
  n
}
println(total([1, 2, 3]))
const s = new Set<int>()
s.add(4)
s.add(5)
println(total(s))
println(total([10, 20].iterator()))

function letters(xs: Iterable<char>): string {
  const out: string[] = []
  for (const c of xs) out.push(`${c}`)
  out.join("|")
}
println(letters("aéb"))

function pairs<K, V>(xs: Iterable<[K, V]>): string {
  const out: string[] = []
  for (const [k, v] of xs) out.push(`${k}=${v}`)
  out.join(",")
}
const m = new Map<string, int>()
m.set("a", 1)
m.set("b", 2)
println(pairs(m))

const d = new Deque<int>()
d.push(1)
d.push(2)
println(total(d))

// Through a bound: `I extends Iterable<T>`, an array included.
function first<T, I extends Iterable<T>>(xs: I): T? {
  xs.iterator().next()
}
println(first<int, int[]>([7, 8])!)
const words: Iterable<string> = ["x", "y"]
println(words.iterator().toArray().join(" "))

async function* count(n: int): AsyncIterator<int> {
  for (let i = 1; i <= n; i++) yield i
}
async function sum(xs: AsyncIterable<int>): Promise<int> {
  let n = 0
  for await (const x of xs) n += x
  n
}
println(await sum(count(3)))
const it = "héllo".iterator()
println(`${it.next()!} ${it.take(2).toArray().join("")}`)

// Streams, sockets, watchers, process output and channels are `AsyncIterable`s too.
async function chunks(xs: AsyncIterable<string, Error>): Promise<string> throws Error {
  const out: string[] = []
  for await (const x of xs) out.push(x)
  out.join("+")
}
println(await chunks(ReadableStream.from(["a", "b", "c"])))
const ch = new Channel<int>()
ch.send(1)
ch.send(2)
ch.close()
async function ints(xs: AsyncIterable<int>): Promise<int> {
  let n = 0
  for await (const x of xs) n += x
  n
}
println(await ints(ch))
