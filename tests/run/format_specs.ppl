println(`${3.14159:.2f}`)
println(`${42:08}`)
println(`${255:#x}`)
println(`${"hi":*^6}`)
println(`${0.25:.0%}`)
println(`${42:+}`)
println(`${255:x}`)
println(`${255:#X}`)
println(`${5:b}`)
println(`${1234.5:e}`)
println(`${"left":<10}|`)
println(`|${"right":>10}|`)
println(`${-42:05}`)
println(`${3.5:+.2f}`)
println(`${7: }`)
println(`[${"ab":^6}]`)
println(`[${"ab":5}]`)
println(`${"zażółć":.4}`)
const ch: char = "ż"
println(`${ch:_^5}`)
println(`${-255:x}`)
println(`${18446744073709551615u64:#b}`)
println(`${255u8:o}`)
println(`${15:#o}`)
println(`${150.0:.2e}`)
println(`${0.00000015:E}`)
println(`${1e21:f}`)
println(`${0.0001:f}`)
println(`${0.125:%}`)
println(`${2.5:.0}`)
println(`${2:.1f}`)
println(`${100:.3f}`)
println(`${0.1f32:f}`)
println(`${"a\"b\n":?}`)
const x: char = "x"
println(`${x:?}`)
const q: char = "'"
println(`${q:?}`)
println(`${true:6}|`)
const nan = 0.0 / 0.0
const inf = 1.0 / 0.0
println(`${nan}|${-inf}|${inf:+}`)
println(`${1.0:e}`)
println(`${0.125:.2f}`)
println(`${-1.5:6}`)
