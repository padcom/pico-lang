// The `Date` global against JavaScript (checked with Node, TZ=Europe/Berlin and
// America/New_York; JavaScript's long zone names are abbreviations here).
// expect: 2024-03-10T12:30:00.005Z
// expect: 1710073800005 0 12
// expect: Sun, 10 Mar 2024 12:30:00 GMT
// expect: Sun Mar 10 2024 13:30:00 GMT+0100 (CET)
// expect: -60 13 Sun Mar 10 2024
// expect: 1719828000000
// expect: Mon Jul 01 2024 12:00:00 GMT+0200 (CEST)
// expect: 1704067200000 NaN NaN Invalid Date
// expect: 1709247600000 1709341200000
// expect: 2024-03-31T01:30:00.000Z 2024-10-27T00:30:00.000Z
// expect: 1712966400000 2024-04-13T00:00:00.000Z
// expect: 1735689600000 2025-01-01T00:00:00.000Z
// expect: 1710073800000 1710073799995
// expect: Sun Mar 10 2024 08:30:00 GMT-0400 (EDT) 240
// expect: 1699162200000 1699169400000
// expect: -2208988800000 1900 -62230291200000
// expect: true true
import { env } from "std/process"

env.set("TZ", "Europe/Berlin")
const d = new Date(Date.UTC(2024, 2, 10, 12, 30, 0, 5))
println(d.toISOString())
println(`${d.getTime()} ${d.getUTCDay()} ${d.getUTCHours()}`)
println(d.toUTCString())
println(d.toString())
println(`${d.getTimezoneOffset()} ${d.getHours()} ${d.toDateString()}`)
println(`${Date.parse("2024-07-01T12:00:00+02:00")}`)
println(new Date("2024-07-01T12:00:00").toString())
println(`${Date.parse("2024-01-01")} ${Date.parse("2024-13-01")} ${Date.parse("nonsense")} ${new Date("x")}`)
// Local midnight in winter, then a local date with overflowing fields.
println(`${new Date(2024, 2, 1).getTime()} ${new Date(2024, 1, 30, 26).getTime()}`)
// 02:30 doesn't exist on 2024-03-31 in Berlin (moved forward); 02:30 on 2024-10-27 twice.
println(`${new Date(2024, 2, 31, 2, 30).toISOString()} ${new Date(2024, 9, 27, 2, 30).toISOString()}`)
const e = new Date(Date.UTC(2024, 0, 31))
println(`${e.setUTCMonth(3, 13)} ${e.toISOString()}`)
println(`${e.setUTCFullYear(2025, 0, 1)} ${e.toISOString()}`)
println(`${Date.parse(d.toUTCString())} ${Date.parse(d.toString()) - 5.0}`)
env.set("TZ", "America/New_York")
println(`${d.toString()} ${d.getTimezoneOffset()}`)
// 01:30 on 2023-11-05 happens twice in New York: the first is chosen.
println(`${new Date(2023, 10, 5, 1, 30).getTime()} ${new Date(2023, 10, 5, 2, 30).getTime()}`)
println(`${Date.UTC(1900, 0)} ${new Date(Date.UTC(1900, 0, 1)).getUTCFullYear()} ${Date.UTC(-2, 0)}`)
const now = Date.now()
println(`${now > 1.7e12} ${performance.now() >= 0.0}`)
