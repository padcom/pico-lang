// `std/time`: durations, instants, zones (tz database rules and their DST changes),
// calendar arithmetic and formatting. Offsets checked against Temporal/Node.
// expect: PT1H30M0.5S 5400.5 PT26H -PT0.25S PT0S
// expect: PT59M30.5S PT3H1S 1
// expect: invalid duration: P1Y
// expect: 2024-03-10T12:30:00.005Z 1710073800005 1710073800
// expect: true 1970-01-01T00:00:00Z
// expect: PT36H 36 true -1
// expect: 2001-09-09T01:46:40Z 2024-03-10T12:30:00.005Z
// expect: 2024-03-10T13:30:00.005+01:00[Europe/Berlin] 7 70 10 +01:00
// expect: Sunday, 10 March 2024 at 01:30 PM CET (+01:00), week 10
// expect: 2024-03-10T13:30:00.005+0100 Europe/Berlin Sun Mar 24 70
// expect: 2024-03-10T21:30:00.005+09:00[Asia/Tokyo] 2024-03-10T12:30:00.005+00:00
// expect: 2024-03-10T03:30:00-04:00[America/New_York] 2024-03-10T01:30:00-05:00[America/New_York]
// expect: 2024-11-03T01:30:00-04:00[America/New_York] 2024-11-03T01:30:00-05:00[America/New_York]
// expect: 2024-03-10T12:00:00-04:00[America/New_York] 2024-03-10T13:00:00-04:00[America/New_York]
// expect: PT23H 2024-01-09T09:00:00-05:00[America/New_York]
// expect: 2024-02-29T00:00:00+00:00[UTC] 2023-02-28T00:00:00+00:00[UTC]
// expect: 2025-03-07T08:00:00+00:00[UTC]
// expect: 2024-11-03T02:30:00-05:00[America/New_York]
// expect: 2024-03-10T12:00:00+00:00[UTC] 19800
// expect: 2030-07-01T12:00:00+02:00[Europe/Berlin] +01:00
// expect: 2024-06-15T00:00:00+10:00[Australia/Sydney] 2024-06-01T09:00:00+00:00[UTC]
// expect: +05:30 +05:30 -01:00 GMT
// expect: false true
// expect: unknown time zone: Nope/Zone
// expect: offset +05:00 doesn't match Europe/Berlin in 2024-03-10T12:00:00+05:00[Europe/Berlin]
// expect: 2000-01-01T00:00:00+00:00[UTC]
// expect: 53 53 1
// expect: true 0
import { Duration, Instant, TimeZone, DateTime } from "std/time"

const d = Duration.of({ hours: 1, minutes: 30, milliseconds: 500 })
println(`${d} ${d.totalSeconds()} ${Duration.parse("P1DT2H")} ${Duration.ofMilliseconds(-250)} ${Duration.zero()}`)
println(`${d.plus(Duration.ofSeconds(30)).minus(Duration.ofMinutes(31))} ${d.times(2)} ${Duration.parse("PT0.000000001S").nanoseconds}`)
try {
  Duration.parse("P1Y");
} catch (e) {
  println(e.message)
}

const i = Instant.parse("2024-03-10T12:30:00.005Z")
println(`${i} ${i.epochMilliseconds} ${i.epochSeconds}`)
println(`${Instant.parse("2024-03-10T13:30:00+01:00").equals(i.minus(Duration.ofMilliseconds(5)))} ${Instant.fromEpochSeconds(0)}`)
const later = i.plus(Duration.ofHours(36))
println(`${later.since(i)} ${i.until(later).totalHours()} ${later.isAfter(i)} ${Instant.compare(i, later)}`)
println(`${Instant.fromDate(new Date(1e12))} ${i.toDate().toISOString()}`)

const b = i.inZone("Europe/Berlin")
println(`${b} ${b.dayOfWeek} ${b.dayOfYear} ${b.weekOfYear} ${b.offset}`)
println(b.format("EEEE, d MMMM yyyy 'at' hh:mm a z (XXX), 'week' w"))
println(b.format("yyyy-MM-dd'T'HH:mm:ss.SSSXX VV E MMM yy D"))
println(`${b.withZone("Asia/Tokyo")} ${b.withZone(TimeZone.utc()).toIsoString()}`)

// 02:30 doesn't exist on 2024-03-10 in New York (compatible: later), 01:30 on 2024-11-03 twice.
const z = "America/New_York"
println(`${DateTime.of(2024, 3, 10, 2, 30, 0, 0, z)} ${DateTime.of(2024, 3, 10, 2, 30, 0, 0, z, "earlier")}`)
println(`${DateTime.of(2024, 11, 3, 1, 30, 0, 0, z)} ${DateTime.of(2024, 11, 3, 1, 30, 0, 0, z, "later")}`)
const before = DateTime.of(2024, 3, 9, 12, 0, 0, 0, z)
println(`${before.plus({ days: 1 })} ${before.plus(Duration.ofDays(1))}`)
println(`${before.plus({ days: 1 }).since(before)} ${before.minus({ months: 2, hours: 3 })}`)
println(`${DateTime.of(2024, 1, 31, 0, 0, 0, 0, "UTC").plus({ months: 1 })} ${DateTime.of(2023, 1, 31, 0, 0, 0, 0, "UTC").plus({ months: 1 })}`)
println(`${DateTime.of(2024, 2, 29, 8, 0, 0, 0, "UTC").plus({ years: 1, weeks: 1 })}`)
println(`${DateTime.parse("2024-11-03T01:30:00-05:00[America/New_York]").plus({ hours: 1 })}`)
println(`${DateTime.parse("2024-03-10T12:00:00Z")} ${DateTime.parse("2024-03-10T12:00:00+05:30").offsetSeconds}`)
// After the zone file's last transition its POSIX rule applies.
println(`${DateTime.of(2030, 7, 1, 12, 0, 0, 0, "Europe/Berlin")} ${DateTime.of(2030, 12, 1, 12, 0, 0, 0, "Europe/Berlin").offset}`)
println(`${DateTime.of(2024, 6, 15, 18, 45, 0, 0, "Australia/Sydney").startOfDay()} ${DateTime.of(2024, 6, 15, 0, 0, 0, 0, "UTC").with({ day: 1, hour: 9 })}`)
println(`${TimeZone.of("Asia/Kolkata").offsetAt(i)} ${TimeZone.of("+05:30")} ${TimeZone.fixed(-3600)} ${TimeZone.of("Europe/London").abbreviationAt(later)}`)
println(`${TimeZone.of("Europe/Paris").isDstAt(i)} ${TimeZone.of("Europe/Paris").isDstAt(Instant.parse("2024-07-01T00:00:00Z"))}`)
try {
  TimeZone.of("Nope/Zone");
} catch (e) {
  println(e.message)
}
try {
  DateTime.parse("2024-03-10T12:00:00+05:00[Europe/Berlin]");
} catch (e) {
  println(e.message)
}
println(`${DateTime.of(1999, 12, 31, 23, 59, 59, 999000000, "UTC").plus(Duration.ofMilliseconds(1))}`)
println(`${DateTime.of(2021, 1, 3, 0, 0, 0, 0, "UTC").weekOfYear} ${DateTime.of(2020, 12, 31, 0, 0, 0, 0, "UTC").weekOfYear} ${DateTime.of(2024, 12, 30, 0, 0, 0, 0, "UTC").weekOfYear}`)
println(`${Instant.now().isAfter(i)} ${DateTime.now("UTC").offsetSeconds}`)
