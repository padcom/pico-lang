// `std/path` (spec §13.2): POSIX paths, as Node's `path.posix`.
import { join, resolve, dirname, basename, extname, relative, normalize, isAbsolute, sep } from "std/path"
println(join("a", "../b", "c"))
println(join("/a/", "b", ""))
println(join())
println(normalize("a//b/../c/"))
println(normalize("../../x"))
println(normalize("/../x"))
println(dirname("/a/b/c"))
println(dirname("a"))
println(dirname("/a"))
println(dirname("/a/b/"))
println(basename("/a/b.txt"))
println(basename("/a/b.txt", ".txt"))
println(basename("/a/b/"))
println(extname("a.tar.gz"))
println(extname(".bashrc"))
println(extname("a."))
println(extname("noext"))
println(resolve("/x", "y", "../z"))
println(resolve("/x", "/y"))
println(relative("/data/a/b", "/data/c"))
println(relative("/a", "/a"))
println(isAbsolute("/a") && !isAbsolute("a"))
println(sep)
println(resolve("q") == join(resolve("."), "q"))
