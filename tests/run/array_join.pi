// `join` (#133): the same text whatever the number of elements (it joins halves, not one by
// one), with any separator and any element type.
// expect: []
// expect: [a]
// expect: [a,b]
// expect: 0-1-2-3-4-5-6-7
// expect: 0-1-2-3-4-5-6-7-8
// expect: 100 460 true
// expect: 1, 2.5, true
// expect: 1,2,3
const empty: string[] = []
println(`[${empty.join(",")}]`)
println(`[${["a"].join(",")}]`)
println(`[${["a", "b"].join()}]`)
const eight: int[] = []
for (let i = 0; i < 8; i++) eight.push(i)
println(eight.join("-"))
eight.push(8)
println(eight.join("-"))
const many: string[] = []
let expected = ""
for (let i = 0; i < 100; i++) {
  many.push(`${i * 3}`)
  expected = if (i == 0) `${i * 3}` else `${expected}, ${i * 3}`
}
const joined = many.join(", ")
println(`${many.length} ${joined.length} ${joined == expected}`)
const mixed: (int | f64 | bool)[] = [1, 2.5, true]
println(mixed.join(", "))
println([1, 2, 3].join())
