// Array, string, Map and Set APIs from the core library (spec §13.1).
// expect: [2, 4, 6, 8]
// expect: [2, 4]
// expect: 10
// expect: 3 null
// expect: 2 -1
// expect: true false true false
// expect: 1 -1 true
// expect: 1-2-3-4 | 1,2,3,4
// expect: [2, 3] [3, 4] [1, 2, 3, 4, 5]
// expect: [4, 3, 2, 1]
// expect: [1, 2, 5, 9] [9, 5, 2, 1]
// expect: ["ab", "b", "c"]
// expect: [[1, "b"], [1, "d"], [2, "a"], [2, "c"]]
// expect: sum 6
// expect: 6 true false true
// expect: [hi] [hi  ] [  hi]
// expect: ["a", "b", "", "c"] ["x", "y"]
// expect: HELLO hello
// expect: a-b-c a-b.c 00042 x..
// expect: ababab żółw 1
// expect: 3 1 null true
// expect: 3 false
// expect: ["a", "c", "d"] [1, 3, 4]
// expect: c=3 a=1 d=4
// expect: 2 true false
// expect: [10, 30]
// expect: 0

const xs = [1, 2, 3, 4]
println(`${xs.map(x => x * 2):?}`)
println(`${xs.filter(x => x % 2 == 0):?}`)
println(xs.reduce((acc: int, x: int) => acc + x, 0))
println(`${xs.find(x => x > 2)} ${xs.find(x => x > 9)}`)
println(`${xs.findIndex(x => x == 3)} ${xs.findIndex(x => x == 7)}`)
println(`${xs.some(x => x > 3)} ${xs.some(x => x > 4)} ${xs.every(x => x > 0)} ${xs.every(x => x > 1)}`)
println(`${xs.indexOf(2)} ${xs.indexOf(9)} ${xs.includes(4)}`)
println(`${xs.join("-")} | ${xs.join()}`)
println(`${xs.slice(1, 3):?} ${xs.slice(-2):?} ${xs.concat([5]):?}`)
println(`${[1, 2, 3, 4].reverse():?}`)
const unsorted = [5, 1, 9, 2]
println(`${unsorted.sort():?} ${unsorted.sort((a: int, b: int) => b - a):?}`)
println(`${["c", "ab", "b"].sort():?}`)
// Stable: equal keys keep their order.
const pairs: [int, string][] = [[2, "a"], [1, "b"], [2, "c"], [1, "d"]]
println(`${pairs.sort((p: [int, string], q: [int, string]) => p[0] - q[0]):?}`)
let total = 0
xs.slice(0, 3).forEach(x => {
  total += x
})
println(`sum ${total}`)

const s = "hello world"
println(`${s.indexOf("world")} ${s.includes("lo w")} ${s.startsWith("world")} ${s.endsWith("world")}`)
println(`[${"  hi ".trim()}] [${"  hi  ".trimStart()}] [${"  hi  ".trimEnd()}]`)
println(`${"a,b,,c".split(","):?} ${"xy".split(""):?}`)
println(`${"Hello".toUpperCase()} ${"HeLLo".toLowerCase()}`)
println(`${"a.b.c".replaceAll(".", "-")} ${"a.b.c".replace(".", "-")} ${"42".padStart(5, "0")} ${"x".padEnd(3, ".")}`)
println(`${"ab".repeat(3)} ${"żółwie".slice(0, 4)} ${"żółw".indexOf("ół")}`)

const m = new Map<string, int>()
m.set("c", 3).set("a", 1)
m.set("b", 2)
println(`${m.size} ${m.get("a")} ${m.get("zz")} ${m.has("b")}`)
m.delete("b")
m.set("d", 4)
println(`${m.size} ${m.has("b")}`)
println(`${m.keys().sort():?} ${m.values().sort():?}`)
let shown = ""
m.forEach((v: int, k: string) => {
  shown = shown + `${k}=${v} `
})
println(shown.trimEnd())

// Many keys: rehashing keeps every entry.
const big = new Map<int, int>()
for (const i of 0..1000) {
  big.set(i, i * i)
}
const seen = new Set<int>()
seen.add(10).add(30).add(10)
println(`${seen.size} ${seen.has(30)} ${seen.has(20)}`)
println(`${seen.values():?}`)
println(big.get(999)! - 998001)
