// Helpers pico-commander had of its own (decision 344): std/text, std/term, std/fmt's wrap,
// Map's copy constructor and char tests. (Writer.hasColors(): run/process/has_colors.pi.)
// expect: 3 1 3 1
// expect: pizzaType maxRetryCount foo_bar aB
// expect: pizza-type http-server version2-beta max_retry_count foo_bar_baz
// expect: bold and link 3
// expect: 3 4 1
// expect: the quick|brown fox|jumps
// expect:   indented|line||x
// expect: false true
// expect: 2 3 a,b 2 3
// expect: true false true false true false
import { camelCase, editDistance, kebabCase, snakeCase } from "std/text"
import { displayWidth, stripAnsi } from "std/term"
import { wrap } from "std/fmt"

println(`${editDistance("kitten", "sitting")} ${editDistance("ca", "ac")} ${editDistance("", "abc")} ${editDistance("héllo", "hello")}`)
println(`${camelCase("pizza-type")} ${camelCase("max_retry count")} ${camelCase("foo_bar", "-")} ${camelCase("a--b")}`)
println(`${kebabCase("pizzaType")} ${kebabCase("HTTPServer")} ${kebabCase("version2Beta")} ${snakeCase("maxRetryCount")} ${snakeCase("Foo Bar-baz")}`)

const styled = "\u{1b}[1mbold\u{1b}[22m and \u{1b}]8;;http://x\u{7}link\u{1b}]8;;\u{7}"
println(`${stripAnsi(styled)} ${stripAnsi("a\u{1b}[").length}`)
println(`${displayWidth("\u{1b}[31mred\u{1b}[39m")} ${displayWidth("日本")} ${displayWidth("e\u{301}")}`)

println(wrap("the quick brown fox jumps", 10).replaceAll("\n", "|"))
println(wrap("  indented line\n\nx", 8).replaceAll("\n", "|"))
const bold = "\u{1b}[1maaaa\u{1b}[22m bbbb"
println(`${wrap(bold, 9, displayWidth).includes("\n")} ${wrap(bold, 9).includes("\n")}`)

const m = new Map<string, int>()
m.set("a", 1).set("b", 2).set("a", 3)
const copy = new Map(m)
copy.set("c", 4)
println(`${m.size} ${m.get("a") ?? 0} ${m.keys().join(",")} ${m.size} ${copy.size}`)

const cs: char[] = ['7', 'x', 'Q', '_', '\t', 'é']
println(`${cs[0].isDigit()} ${cs[1].isDigit()} ${cs[2].isAlpha()} ${cs[3].isAlphanumeric()} ${cs[4].isWhitespace()} ${cs[5].isAlpha()}`)
