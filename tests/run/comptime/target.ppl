// expect: hello from a file
// expect: true true
// expect: debug 0
// expect: /
// expect-windows: \
// `target` and `build` (spec §15.4), and `comptime.readFile` (relative to the package root,
// here the directory of this file).
const GREETING = comptime comptime.readFile("data/greeting.txt").trim()
println(GREETING)
const known = ["linux", "macos", "windows", "wasi", "browser"]
println(`${known.includes(target.os)} ${target.triple.length > 0}`)
println(`${build.mode} ${build.flags.length}`)
const sep = comptime if (target.os == "windows") "\\" else "/"
println(sep)
