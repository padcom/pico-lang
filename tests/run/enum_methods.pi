// Enum methods (#51): `this` taken apart with `match`, captured by closures, methods calling
// each other, enums without payloads, overloads by type, a narrowed variant as receiver.
// expect: > true
// expect: > "a\"b"
// expect: > ["x"]
// expect: true
// expect: 1:"q" 2:"q"
// expect: green
// expect: 1
// expect: 36 0.75
enum Value {
  Bool(value: bool),
  Str(value: string),
  List(items: string[]),

  json(): string {
    return match (this) {
      Bool(b) => `${b}`,
      Str(s) => JSON.stringify(s),
      List(xs) => "[" + xs.map((x: string) => JSON.stringify(x)).join(",") + "]",
    }
  }
  describe(prefix: string): string { return `${prefix}${this.json()}` }
  wrap(): string[] { return [1, 2].map((n: int) => `${n}:${this.json()}`) }
  isEmpty(): bool {
    return match (this) {
      List(xs) => xs.length == 0,
      _ => false,
    }
  }
}
enum Color { Red, Green
  next(): Color { return match (this) { Red => Color.Green, Green => Color.Red } }
  name(): string { return if (this == Color.Red) "red" else "green" }
}
const vs: Value[] = [Value.Bool(true), Value.Str("a\"b"), Value.List(["x"])]
for (const v of vs) println(v.describe("> "))
println(Value.List([]).isEmpty())
println(Value.Str("q").wrap().join(" "))
println(Color.Red.next().name())
const v = vs[2]
if (v is Value.List(items)) println(items.length)
enum Shape { Circle(r: number), Square(side: number)
  scale(k: number): Shape { return match (this) { Circle(r) => Shape.Circle(r * k), Square(s) => Shape.Square(s * k) } }
  scale(k: int): Shape { return this.scale(k as number) }
  area(): number { return match (this) { Circle(r) => 3.0 * r * r, Square(s) => s * s } }
}
println(`${Shape.Square(2.0).scale(3).area()} ${Shape.Circle(1.0).scale(0.5).area()}`)
