// expect: 9 2
// expect: 1 -5
// expect: 7 4294967295
// expect: 1.5 0.25
// Typed arrays take `a[i] = v` as `a.set(i, v)` (#207).
const d = Uint8Array.from([1, 2])
d[0] = 9
println(`${d[0]} ${d[1]}`)
const i = new Int32Array(2)
i[0] = 1
i[1] = -5
println(`${i[0]} ${i[1]}`)
const u = new Uint32Array(2)
u[0] = 7
u[1] = -1
println(`${u[0]} ${u[1]}`)
const f = new Float32Array(1)
f[0] = 1.5
const g = new Float64Array(1)
g[0] = 0.25
println(`${f[0]} ${g[0]}`)
