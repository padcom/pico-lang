// Bulk byte copies (#84): `Uint8Array.setAll(source, offset)`, `copyWithin` and `slice` move whole
// ranges at once (`__buf_op` 4 and 3), with the Web's semantics for offsets and overlaps.
// expect: set: 0 1 2 3 0 0 | 9 7
// expect: views: 0 0 5 6 7 0 0 0
// expect: overlap right: 1 2 1 2 3 4 7 8
// expect: overlap left: 3 4 5 6 5 6 7 8
// expect: copyWithin: 4 5 3 4 5 | 1 2 3 1 2 | 1 4 5 4 5
// expect: slice: 2 3 4 | 5 1 | 0 | 99 2
// expect: buffer slice: 3 2 3 4 | 0
// expect: empty and detached: 0 0 0
// expect: 1 MB: 1048576 255 255
function show(b: Uint8Array): string {
  const parts: string[] = []
  for (let i = 0; i < b.length; i++) {
    parts.push(`${b.get(i)}`)
  }
  parts.join(" ")
}

// `setAll(source, offset)` next to `set(index, value)`.
const a = new Uint8Array(6)
a.setAll(Uint8Array.from([1, 2, 3]), 1)
const one = Uint8Array.from([9, 7])
one.setAll(new Uint8Array(0), 2)
println(`set: ${show(a)} | ${show(one)}`)

// Between views with offsets into a shared buffer.
const buf = new ArrayBuffer(8)
const whole = new Uint8Array(buf, 0)
new Uint8Array(buf, 2, 3).setAll(Uint8Array.from([5, 6, 7]))
println(`views: ${show(whole)}`)

// Overlapping source and destination: the bytes are moved as if copied first.
const r = Uint8Array.from([1, 2, 3, 4, 5, 6, 7, 8])
r.setAll(r.subarray(0, 4), 2)
println(`overlap right: ${show(r)}`)
const l = Uint8Array.from([1, 2, 3, 4, 5, 6, 7, 8])
l.setAll(l.subarray(2, 6))
println(`overlap left: ${show(l)}`)

// `copyWithin(target, start, end?)`, negative positions and clipping at the end.
const c1 = Uint8Array.from([1, 2, 3, 4, 5]).copyWithin(0, 3)
const c2 = Uint8Array.from([1, 2, 3, 4, 5]).copyWithin(3, 0)
const c3 = Uint8Array.from([1, 2, 3, 4, 5]).copyWithin(-4, -2, 5)
println(`copyWithin: ${show(c1)} | ${show(c2)} | ${show(c3)}`)

// `slice` copies (the copy is independent), honours the view's offset and negative positions.
const src = Uint8Array.from([1, 2, 3, 4, 5])
const mid = src.slice(1, 4)
const tail = src.subarray(3).slice(-1)
const s2 = src.slice(1, 3)
s2.set(0, 99)
println(`slice: ${show(mid)} | ${tail.get(0)} ${src.slice(0, 1).get(0)} | ${src.slice(4, 2).length} | ${s2.get(0)} ${src.get(1)}`)

const bs = src.buffer.slice(1, 4)
println(`buffer slice: ${bs.byteLength} ${show(new Uint8Array(bs, 0))} | ${src.buffer.slice(3, 3).byteLength}`)

// Nothing to copy: empty views, and views of a detached buffer.
const gone = new ArrayBuffer(4)
const goneView = new Uint8Array(gone, 0)
gone.__detach()
const into = new Uint8Array(4)
into.setAll(goneView)
println(`empty and detached: ${goneView.slice().length} ${gone.slice(0, 4).byteLength} ${into.get(0)}`)

// A megabyte in one go.
const big = new Uint8Array(1024 * 1024)
big.set(big.length - 1, 255)
const copy = new Uint8Array(1024 * 1024)
copy.setAll(big)
println(`1 MB: ${copy.length} ${copy.get(copy.length - 1)} ${big.slice(-1).get(0)}`)
