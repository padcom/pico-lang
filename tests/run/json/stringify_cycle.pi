// expect: {"name":"a","next":{"name":"b","next":null}}
// panic: JSON.stringify: objects nested over 1024 deep (a circular structure?)
// `JSON.stringify` of a reference cycle (#58): a clear panic instead of a stack overflow; a
// chain without one is written as usual.
class Node {
  public name: string
  public next: Node? = null
  constructor(name: string) { this.name = name }
}
const a = new Node("a")
const b = new Node("b")
a.next = b
println(JSON.stringify(a))
b.next = a
println(JSON.stringify(a))
