// JSON for numbers, strings, arrays, nullables and classes (including recursive ones).
class Tree {
  constructor(public name: string, public children: Tree[], public weight: f64?) {}
}
const t = JSON.parse<Tree>('{"name":"root","children":[{"name":"a","children":[],"weight":1.5},{"name":"b","children":[{"name":"c","children":[]}]}]}')
println(t.children[1].children[0].name)
println(JSON.stringify(t))

println(JSON.parse<i64>("-9223372036854775808"))
println(JSON.parse<i64>(" 9223372036854775807 "))
println(JSON.parse<u64>("18446744073709551615"))
println(JSON.parse<i8>("-128"))
println(JSON.parse<f32>("0.1"))
println(JSON.parse<f64>("-2.5e-3"))
println(JSON.parse<f64>("1"))
println(JSON.stringify(0.1 + 0.2))
println(JSON.stringify(-0.0 / 0.0))
println(JSON.parse<string>('"\\u00e9\\ud83d\\ude00 \\"q\\" \\\\ \\/ \\t."'))
println(JSON.stringify("tab\there \u{1} é \"q\""))
println(JSON.parse<char>('"x"'))
println(JSON.parse<bool[]?>("null") == null)
println(JSON.parse<bool[]?>("[true, false]")!.length)
println(JSON.stringify([[1, 2], [], [3]]))
println(JSON.parse<i32[][]>("[[1,2],[],[3]]")[2][0])
println(JSON.stringify<string?>(null))

function bad(text: string) {
  try {
    println(JSON.parse<i64>(text))
  } catch (e: JsonError) {
    println(e.message)
  }
}
bad("9223372036854775808")
bad("-9223372036854775809")
bad("01")
bad("")
bad("[")
bad("tru")
bad('"7"')
