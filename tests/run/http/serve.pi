// expect: listening: true
// expect: 200 OK true text/plain;charset=UTF-8
// expect: hello from GET /greet?name=pico (name pico)
// expect: 201 application/json
// expect: echo: 3 items, total 6
// expect: 404 Not Found: no route for /nope
// expect: streamed: one two three
// expect: redirected: true 200 /greet?name=again
// expect: 500 Internal Server Error
// expect: HEAD 200 0
// expect: refused: true
// expect: stopped
// `std/http` `serve` and `fetch` (spec §13.2): a round trip in one process.
import { serve } from "std/http"

struct Order {
  items: int[]
}

struct Total {
  count: int
  total: int
}

function chunks(): ReadableStream<Uint8Array> {
  ReadableStream.from(["one ", "two ", "three"]).pipeThrough(textEncoder())
}

function textEncoder(): TransformStream<string, Uint8Array> {
  const enc = new TextEncoder()
  new TransformStream<string, Uint8Array>({ transform: (s, c) => c.enqueue(enc.encode(s)) })
}

async function handle(req: Request): Promise<Response> throws Error {
  const url = new URL(req.url)
  if (url.pathname == "/greet") {
    const name = url.searchParams.get("name")
    return new Response(`hello from ${req.method} ${url.pathname}${url.search} (name ${name})`)
  }
  if (url.pathname == "/order" && req.method == "POST") {
    const order = await req.json<Order>()
    let total = 0
    for (const n of order.items) {
      total += n
    }
    const t: Total = { count: order.items.length, total }
    return Response.json<Total>(t, { status: 201 })
  }
  if (url.pathname == "/stream") {
    return new Response(chunks())
  }
  if (url.pathname == "/old") {
    return Response.redirect("/greet?name=again", 301)
  }
  if (url.pathname == "/fail") {
    throw new Error("handler failed")
  }
  new Response(`no route for ${url.pathname}`, { status: 404 })
}

const server = await serve({ port: 0 }, handle)
println(`listening: ${server.addr.port > 0}`)
const base = `http://127.0.0.1:${server.addr.port}`

const r1 = await fetch(`${base}/greet?name=pico`)
println(`${r1.status} ${r1.statusText} ${r1.ok} ${r1.headers.get("content-type")}`)
println(await r1.text())

const r2 = await fetch(`${base}/order`, {
  method: "POST",
  headers: new Headers([["content-type", "application/json"]]),
  body: "{\"items\": [1, 2, 3]}",
})
println(`${r2.status} ${r2.headers.get("content-type")}`)
const t = await r2.json<Total>()
println(`echo: ${t.count} items, total ${t.total}`)

const r3 = await fetch(`${base}/nope`)
println(`${r3.status} ${r3.statusText}: ${await r3.text()}`)

const r4 = await fetch(`${base}/stream`)
println(`streamed: ${await r4.text()}`)

const r5 = await fetch(`${base}/old`)
println(`redirected: ${r5.redirected} ${r5.status} ${new URL(r5.url).pathname}${new URL(r5.url).search}`)

const r6 = await fetch(`${base}/fail`)
println(`${r6.status} ${r6.statusText}`)

const r7 = await fetch(`${base}/greet`, { method: "HEAD" })
println(`HEAD ${r7.status} ${(await r7.bytes()).length}`)

await server.shutdown()
try {
  await fetch(`${base}/greet`)
} catch (e: TypeError) {
  println(`refused: ${e.message.startsWith("fetch failed: connection refused")}`)
}
await server.finished
println("stopped")
