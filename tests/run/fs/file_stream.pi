// expect: abcd|efgh|ij true
// std/fs' FileStream (#181): a file read in chunks; writes are discarded.
import { FileStream, writeText, remove } from "std/fs"
import { join } from "std/path"
import { tmpDir } from "std/os"

async function main(): Promise<void> throws Error {
  const path = join(tmpDir(), `pico-file-stream-${Math.floor(Math.random() * 1000000000)}.bin`)
  await writeText(path, "abcdefghij")
  const fs = new FileStream(path, 4)
  const parts: string[] = []
  let c = await fs.read()
  while (c != null) {
    parts.push(string.fromUtf8(c))
    c = await fs.read()
  }
  await fs.write(Uint8Array.from([1]))
  println(`${parts.join("|")} ${await fs.read() == null}`)

  await remove(path)
}
await main()
