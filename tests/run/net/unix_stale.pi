// native-only: the interpreter can't call C
// A Unix-domain socket file that nothing listens on (a server that crashed left it) is replaced
// by `listenUnix` (#85); one with a live listener isn't. The stale file is made through libc:
// bound, then the descriptor closed without removing the file, as a crash does.
// expect: stale file: true
// expect: replaced: echo
// expect: live: AddrInUse
import { listenUnix, connectUnix, Conn, Listener, NetError } from "std/net"
import { exists } from "std/fs"

extern "C" {
  function socket(domain: c_int, kind: c_int, protocol: c_int): c_int
  function bind(fd: c_int, addr: ptr<void>, len: u32): c_int
  function close(fd: c_int): c_int
}

const path = "stale.sock"
// `struct sockaddr_un`: on macOS 106 bytes, a length byte and a one-byte family first; on Linux
// 110, a two-byte family first (AF_UNIX = 1). (A size past the struct's is EINVAL on macOS.)
const macos = comptime (target.os == "macos")
const size = if (macos) 106 else 110
const addr = new Uint8Array(size)
if (macos) {
  addr.set(0, size as u8)
  addr.set(1, 1)
} else {
  addr.set(0, 1)
}
for (let i = 0; i < path.length; i++) addr.set(2 + i, (path[i] as u32) as u8)
unsafe {
  const fd = socket(1, 1, 0)
  bind(fd, ptr.bytes(addr) as ptr<void>, size as u32)
  close(fd)
}
println(`stale file: ${await exists(path)}`)

async function serve(server: Listener): Promise<void> throws NetError {
  for await (const conn of server) {
    // The live-listener check below connects and hangs up at once (that's how `listenUnix` tells
    // a live socket from a stale one): writing to it can fail, which mustn't end the server
    // (#116; under qemu-user it usually did).
    try {
      await conn.writeText("echo")
    } catch (e: NetError) {}
    conn.close()
  }
}
const server = await listenUnix(path)
serve(server)
const c = await connectUnix(path)
println(`replaced: ${await c.text()}`)
try {
  (await listenUnix(path)).close()
} catch (e: NetError) {
  println(`live: ${e.kind}`)
}
server.close()
