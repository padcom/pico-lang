// expect: hello world
// expect: code 0 true
// expect: cat: 8 bytes, 2 lines
// expect: one
// expect: two
// expect: stderr: oops
// expect: code 3 false
// expect: 2
// expect: NotFound: cannot run no-such-program-ppl: no such file or directory
// expect: killed: false 143 15
// `Command` (spec §13.3): `echo` and `cat` with pipes, a shell, failures and `kill`.
import { Command, ProcessError } from "std/process"

const out = await new Command("echo", ["hello", "world"]).output()
print(out.stdout)
println(`code ${out.code} ${out.success}`)

// Writing to `cat` and reading its output back, chunk by chunk.
const cat = new Command("cat", stdin: "pipe", stdout: "pipe").spawn()
cat.stdin.writeText("one\n")
const bytes = new Uint8Array(4)
bytes.set(0, 116)
bytes.set(1, 119)
bytes.set(2, 111)
bytes.set(3, 10)
cat.stdin.write(bytes)
cat.stdin.close()
let total = 0
let newlines = 0
for await (const chunk of cat.stdout) {
  total += chunk.length
  for (let i = 0; i < chunk.length; i++) {
    if (chunk[i] == 10) newlines += 1
  }
}
println(`cat: ${total} bytes, ${newlines} lines`)
await cat.status()

// The same through `text()`.
const cat2 = new Command("cat", stdin: "pipe", stdout: "pipe").spawn()
cat2.stdin.writeText("one\ntwo\n")
cat2.stdin.close()
print(await cat2.stdout.text())
await cat2.status()

const sh = await Command.shell("echo oops >&2; exit 3").output()
print(`stderr: ${sh.stderr}`)
println(`code ${sh.code} ${sh.success}`)

const lines = await Command.shell("printf 'a\\nb\\n' | wc -l").output()
println(lines.stdout.trim())

try {
  await new Command("no-such-program-ppl").status()
} catch (e: ProcessError) {
  println(`${e.kind}: ${e.message}`)
}

const sleeper = new Command("sleep", ["5"]).spawn()
sleeper.kill()
const st = await sleeper.status()
println(`killed: ${st.success} ${st.code} ${st.signal}`)
