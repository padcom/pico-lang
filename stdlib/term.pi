// `std/term` (spec §13.11, decision 344): text meant for a terminal — removing its escape codes
// and measuring how many columns it takes. Whether a stream shows colours is
// `std/process`'s `Writer.hasColors()`.

/// `text` without terminal escape codes: control sequences (`ESC [ … m` colours and styles,
/// cursor movement), operating-system commands (`ESC ] … BEL`, as for hyperlinks) and other
/// two-character escapes. A sequence that doesn't end is kept as it is.
///
/// @example
/// ```ts
/// import { stripAnsi } from "std/term"
///
/// println(stripAnsi("\u{1b}[1;31merror\u{1b}[0m: not found"))   // error: not found
/// ```
export function stripAnsi(text: string): string {
  if (!text.includes("\u{1b}")) return text
  const cs: char[] = []
  for (const c of text) cs.push(c)
  // (Pieces joined once: appending is O(n²), #73.)
  const out: string[] = []
  let i = 0
  while (i < cs.length) {
    if (cs[i] == '\u{1b}' && i + 1 < cs.length) {
      const end = escapeEnd(cs, i)
      if (end > i) {
        i = end
        continue
      }
    }
    out.push(cs[i].toString())
    i += 1
  }
  return out.join("")
}

/// Where the escape at `cs[i]` ends (just after it), or `i` when it isn't a complete one.
function escapeEnd(cs: char[], i: int): int {
  const kind = cs[i + 1]
  if (kind == '[') {
    // Parameters (0x30–0x3F), intermediates (0x20–0x2F), then the final character (0x40–0x7E).
    let j = i + 2
    while (j < cs.length && cs[j] >= '0' && cs[j] <= '?') j += 1
    while (j < cs.length && cs[j] >= ' ' && cs[j] <= '/') j += 1
    return if (j < cs.length && cs[j] >= '@' && cs[j] <= '~') j + 1 else i
  }
  if (kind == ']') {
    // Ends with BEL or `ESC \`.
    let j = i + 2
    while (j < cs.length) {
      if (cs[j] == '\u{7}') return j + 1
      if (cs[j] == '\u{1b}' && j + 1 < cs.length && cs[j + 1] == '\\') return j + 2
      j += 1
    }
    return i
  }
  return if (kind >= '@' && kind <= '_') i + 2 else i
}

/// How many terminal columns `text` takes: its escape codes take none (see `stripAnsi`), nor do
/// control characters, combining marks and zero-width characters; East Asian wide and full-width
/// characters and most emoji take two, everything else one. For one line of text.
///
/// @example
/// ```ts
/// import { displayWidth } from "std/term"
///
/// println(displayWidth("hello"))                   // 5
/// println(displayWidth("\u{1b}[32mok\u{1b}[0m"))   // 2
/// println(displayWidth("日本語"))                  // 6
/// ```
export function displayWidth(text: string): int {
  let n = 0
  for (const c of stripAnsi(text)) n += charWidth((c as u32) as int)
  return n
}

/// The columns code point `cp` takes (0, 1 or 2).
function charWidth(cp: int): int {
  if (cp < 0x20 || (cp >= 0x7f && cp < 0xa0)) return 0
  if (cp < 0x300) return 1
  if (inRanges(ZERO_WIDTH, cp)) return 0
  return if (inRanges(WIDE, cp)) 2 else 1
}

/// Combining marks and zero-width characters (past U+02FF), as `first, last` pairs, ascending.
const ZERO_WIDTH: int[] = [
  0x300, 0x36f, 0x483, 0x489, 0x591, 0x5bd, 0x610, 0x61a,
  0x64b, 0x65f, 0x1ab0, 0x1aff, 0x1dc0, 0x1dff, 0x200b, 0x200f,
  0x2028, 0x202e, 0x2060, 0x2064, 0x20d0, 0x20ff, 0xfe00, 0xfe0f,
  0xfe20, 0xfe2f, 0xfeff, 0xfeff, 0xe0100, 0xe01ef,
]

/// East Asian wide and full-width characters and emoji, as `first, last` pairs, ascending.
const WIDE: int[] = [
  0x1100, 0x115f, 0x231a, 0x231b, 0x2329, 0x232a, 0x23e9, 0x23ec,
  0x25fd, 0x25fe, 0x2614, 0x2615, 0x2648, 0x2653, 0x26a1, 0x26a1,
  0x26aa, 0x26ab, 0x26bd, 0x26be, 0x26c4, 0x26c5, 0x26ce, 0x26ce,
  0x26d4, 0x26d4, 0x26ea, 0x26ea, 0x26f5, 0x26f5, 0x26fa, 0x26fa,
  0x26fd, 0x26fd, 0x2705, 0x2705, 0x2728, 0x2728, 0x274c, 0x274c,
  0x2b50, 0x2b50, 0x2b55, 0x2b55, 0x2e80, 0x303e, 0x3041, 0x33ff,
  0x3400, 0x4dbf, 0x4e00, 0x9fff, 0xa000, 0xa4cf, 0xa960, 0xa97f,
  0xac00, 0xd7a3, 0xf900, 0xfaff, 0xfe10, 0xfe19, 0xfe30, 0xfe6f,
  0xff00, 0xff60, 0xffe0, 0xffe6, 0x16fe0, 0x18cff, 0x1b000, 0x1b2ff,
  0x1f004, 0x1f004, 0x1f0cf, 0x1f0cf, 0x1f18e, 0x1f18e, 0x1f191, 0x1f19a,
  0x1f200, 0x1f251, 0x1f300, 0x1f64f, 0x1f680, 0x1f6ff, 0x1f7e0, 0x1f7eb,
  0x1f90c, 0x1f9ff, 0x1fa70, 0x1faff, 0x20000, 0x3fffd,
]

/// Whether `cp` is in one of `ranges`' pairs (a binary search).
function inRanges(ranges: int[], cp: int): bool {
  let lo = 0
  let hi = ranges.length / 2 - 1
  while (lo <= hi) {
    const mid = (lo + hi) / 2
    if (cp < ranges[mid * 2]) {
      hi = mid - 1
    } else if (cp > ranges[mid * 2 + 1]) {
      lo = mid + 1
    } else {
      return true
    }
  }
  return false
}
