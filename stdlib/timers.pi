// `std/timers`: promise-based timers (spec §10.5) that can be cancelled with a signal.
//
// `import { delay } from "std/timers"`, then `await delay(100, ac.signal)`.

/// Settles after `ms` milliseconds; rejects with `AbortError` as soon as `signal` is aborted
/// (right away if it already is), and the timer is cleared.
export function delay(ms: int, signal: AbortSignal? = null): Promise<void, AbortError> {
  const p = new Promise<void, AbortError>()
  if (signal != null) {
    const r = signal.reason
    if (signal.aborted && r != null) {
      p.__reject(r)
      return p
    }
  }
  const id = setTimeout(() => p.__resolve(__void()), ms)
  if (signal != null) {
    const s: AbortSignal = signal
    s.addEventListener("abort", () => {
      clearTimeout(id)
      const r = s.reason
      if (r != null) {
        p.__reject(r)
      }
    })
  }
  return p
}

/// What `withTimeout` rejects with when the time runs out.
export class TimeoutError extends Error {
  /// The time that ran out, in milliseconds.
  public ms: int

  constructor(ms: int) {
    super(`timed out after ${ms} ms`)
    this.ms = ms
  }
}

/// `promise`'s value or error if it settles within `ms` milliseconds, else a `TimeoutError`. The
/// work isn't stopped, only no longer waited for (give it an `AbortSignal` to stop it); a failure
/// it has later is ignored.
export function withTimeout<T, E extends Error>(promise: Promise<T, E>, ms: int): Promise<T, Error> {
  const out = new Promise<T, Error>()
  const id = setTimeout(() => out.__reject(new TimeoutError(ms)), ms)
  promise.then<void>((v: T) => {
    clearTimeout(id)
    out.__resolve(v)
  }).catch((e: Error) => {
    clearTimeout(id)
    out.__reject(e)
  })
  return out
}
