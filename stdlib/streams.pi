// `std/streams` (spec §13.5): the Web Streams classes (globals, as on the Web) and transform
// streams between strings and UTF-8 bytes.

export {
  ReadResult,
  QueuingStrategy,
  StreamPipeOptions,
  UnderlyingSource,
  ReadableStreamDefaultController,
  ReadableStream,
  ReadableStreamDefaultReader,
  WritableStreamDefaultController,
  UnderlyingSink,
  WritableStream,
  WritableStreamDefaultWriter,
  TransformStreamDefaultController,
  Transformer,
  TransformStream,
}

/// A transform stream from strings to their UTF-8 bytes.
///
/// @example
/// ```ts
/// import { textEncoderStream } from "std/streams"
///
/// const enc = textEncoderStream()
/// const w = enc.writable.getWriter()
/// const r = enc.readable.getReader()
/// w.write("hé")
/// w.close()
/// const chunk = await r.read()
/// println(chunk.value?.length)   // 3
/// ```
export function textEncoderStream(): TransformStream<string, Uint8Array> {
  const enc = new TextEncoder()
  new TransformStream<string, Uint8Array>({
    transform: (s, c) => {
      if (s.length > 0) {
        c.enqueue(enc.encode(s))
      }
    },
  })
}

/// A transform stream from UTF-8 bytes to strings (sequences split across chunks are kept
/// whole; bad bytes become U+FFFD).
///
/// @example
/// ```ts
/// import { textDecoderStream } from "std/streams"
///
/// const dec = textDecoderStream()
/// const w = dec.writable.getWriter()
/// const r = dec.readable.getReader()
/// w.write(Uint8Array.from([104, 195]))   // "h" and half of "é"
/// w.write(Uint8Array.from([169]))
/// w.close()
/// let text = ""
/// while (true) {
///   const c = await r.read()
///   if (c.done) {
///     break
///   }
///   text += c.value ?? ""
/// }
/// println(text)   // hé
/// ```
export function textDecoderStream(): TransformStream<Uint8Array, string> {
  const dec = new TextDecoder()
  new TransformStream<Uint8Array, string>({
    transform: (b, c) => {
      let s = ""
      try {
        s = dec.decode(b, { stream: true })
      } catch (e: TypeError) {}
      if (s.length > 0) {
        c.enqueue(s)
      }
    },
    flush: (c) => {
      let s = ""
      try {
        s = dec.decode()
      } catch (e: TypeError) {}
      if (s.length > 0) {
        c.enqueue(s)
      }
    },
  })
}

// ------------------------------------------------------------------------------- byte streams

/// Bytes in and out, in order: what a protocol library reads and writes, whatever carries them
/// (`TcpStream` and `UdpStream` from `std/net`, `FileStream` from `std/fs`, `bytePipe()`, a serial
/// port).
///
/// @example
/// ```ts
/// import { ByteStream, bytePipe } from "std/streams"
///
/// async function send(stream: ByteStream, text: string): Promise<void> throws Error {
///   await stream.write(new TextEncoder().encode(text))
/// }
///
/// const ends = bytePipe()
/// await send(ends[0], "hello")
/// const got = await ends[1].read()
/// if (got != null) {
///   println(new TextDecoder().decode(got))   // hello
/// }
/// ends[0].close()
/// ```
export interface ByteStream {
  /// The next bytes, as soon as some are there; null once the stream has ended.
  ///
  /// @example
  /// ```ts
  /// import { ByteStream, bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// const reader: ByteStream = ends[1]
  /// await ends[0].write(Uint8Array.from([1, 2]))
  /// ends[0].close()
  /// println((await reader.read())?.length)   // 2
  /// println(await reader.read())             // null
  /// ```
  read(): Promise<Uint8Array?, Error>
  /// Writes all of `bytes`, in order with earlier writes.
  ///
  /// @example
  /// ```ts
  /// import { ByteStream, bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// const writer: ByteStream = ends[0]
  /// await writer.write(Uint8Array.from([10, 20, 30]))
  /// println((await ends[1].read())?.length)   // 3
  /// writer.close()
  /// ```
  write(bytes: Uint8Array): Promise<void, Error>
  /// Ends the stream: a `read()` still waiting, and later ones, give null.
  ///
  /// @example
  /// ```ts
  /// import { ByteStream, bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// const s: ByteStream = ends[1]
  /// s.close()
  /// println(await s.read())   // null
  /// ```
  close(): void
}

/// An unbounded queue between async code: `send` never waits, `receive` waits for a value. Once
/// it's closed, the values already sent are still received, then `receive` gives null. Also
/// `for await (const v of channel)`.
///
/// @example
/// ```ts
/// import { Channel } from "std/streams"
///
/// const ch = new Channel<string>()
/// ch.send("a")
/// ch.send("b")
/// ch.close()
/// for await (const v of ch) {
///   println(v)   // a, then b
/// }
/// ```
export class Channel<T> {
  items: T[] = []
  head: int = 0
  waiters: ((value: T?) => void)[] = []
  closed: bool = false

  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const jobs = new Channel<int>()
  /// jobs.send(42)
  /// println(await jobs.receive())   // 42
  /// ```
  constructor() {}

  /// Values sent and not received yet.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<int>()
  /// ch.send(1)
  /// ch.send(2)
  /// println(ch.size)   // 2
  /// await ch.receive()
  /// println(ch.size)   // 1
  /// ```
  public get size(): int {
    return items.length - head
  }

  /// Whether `close()` was called.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<int>()
  /// println(ch.isClosed)   // false
  /// ch.close()
  /// println(ch.isClosed)   // true
  /// ```
  public get isClosed(): bool {
    return closed
  }

  /// Queues `value` (or hands it to a waiting `receive`); false, and dropped, once closed.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<string>()
  /// println(ch.send("hi"))     // true
  /// ch.close()
  /// println(ch.send("late"))   // false
  /// ```
  public send(value: T): bool {
    if (closed) {
      return false
    }
    if (waiters.length > 0) {
      const w = waiters.shift()
      if (w != null) {
        w(value)
        return true
      }
    }
    items.push(value)
    return true
  }

  /// The next value; null once the channel is closed and empty.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<string>()
  /// setTimeout(() => {
  ///   ch.send("ready")
  /// }, 10)
  /// println(await ch.receive())   // ready (after 10 ms)
  /// ch.close()
  /// println(await ch.receive())   // null
  /// ```
  public receive(): Promise<T?> {
    if (head < items.length) {
      const v = items[head]
      head += 1
      if (head == items.length) {
        items = []
        head = 0
      }
      return Promise.resolve<T?>(v)
    }
    if (closed) {
      return Promise.resolve<T?>(null)
    }
    new Promise<T?>((resolve: (value: T?) => void, _reject: (error: Error) => void) => {
      this.waiters.push(resolve)
    })
  }

  /// No more values: waiting `receive`s give null now, later ones once the queue is empty.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<int>()
  /// ch.send(1)
  /// ch.close()
  /// println(await ch.receive())   // 1
  /// println(await ch.receive())   // null
  /// ```
  public close(): void {
    if (closed) {
      return
    }
    closed = true
    const ws = waiters
    waiters = []
    for (const w of ws) {
      w(null)
    }
  }

  /// `for await`: the next value.
  ///
  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<int>()
  /// ch.send(5)
  /// println(await ch.next())   // 5
  /// ```
  public next(): Promise<T?> {
    receive()
  }

  /// @example
  /// ```ts
  /// import { Channel } from "std/streams"
  ///
  /// const ch = new Channel<int>()
  /// ch.send(1)
  /// ch.send(2)
  /// ch.close()
  /// let sum = 0
  /// for await (const v of ch.asyncIterator()) {
  ///   sum += v
  /// }
  /// println(sum)   // 3
  /// ```
  public asyncIterator(): Channel<T> {
    return this
  }
}

/// One end of an in-memory pipe (`bytePipe()`): what one end writes, the other reads.
///
/// @example
/// ```ts
/// import { bytePipe, PipeEnd } from "std/streams"
///
/// const ends = bytePipe()
/// const a: PipeEnd = ends[0]
/// await a.write(Uint8Array.from([1, 2, 3]))
/// println((await ends[1].read())?.length)   // 3
/// a.close()
/// ```
export class PipeEnd implements ByteStream {
  inbox: Channel<Uint8Array> = new Channel<Uint8Array>()
  /// The other end.
  public peer: PipeEnd? = null

  /// @example
  /// ```ts
  /// import { PipeEnd } from "std/streams"
  ///
  /// const a = new PipeEnd()
  /// const b = new PipeEnd()
  /// a.peer = b
  /// b.peer = a   // what bytePipe() does
  /// await a.write(Uint8Array.from([9]))
  /// const got = await b.read()
  /// println(got?.length)   // 1
  /// ```
  constructor() {}

  /// @example
  /// ```ts
  /// import { bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// await ends[0].write(new TextEncoder().encode("ok"))
  /// const got = await ends[1].read()
  /// if (got != null) {
  ///   println(new TextDecoder().decode(got))   // ok
  /// }
  /// ```
  public read(): Promise<Uint8Array?, Error> {
    inbox.receive()
  }

  /// Delivers a copy of `bytes` to the peer (dropped once the pipe is closed).
  ///
  /// @example
  /// ```ts
  /// import { bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// const data = Uint8Array.from([1, 2])
  /// await ends[0].write(data)
  /// data.set(0, 99)   // the peer got a copy
  /// const got = await ends[1].read()
  /// if (got != null) {
  ///   println(got[0])   // 1
  /// }
  /// ```
  public async write(bytes: Uint8Array): Promise<void> throws Error {
    const p = peer
    if (p != null) {
      p.inbox.send(bytes.slice())
    }
  }

  /// Ends both directions: reads on either end give null once what was sent is read.
  ///
  /// @example
  /// ```ts
  /// import { bytePipe } from "std/streams"
  ///
  /// const ends = bytePipe()
  /// await ends[0].write(Uint8Array.from([1]))
  /// ends[0].close()
  /// println((await ends[1].read())?.length)   // 1
  /// println(await ends[1].read())             // null
  /// println(await ends[0].read())             // null
  /// ```
  public close(): void {
    inbox.close()
    const p = peer
    if (p != null) {
      p.inbox.close()
    }
  }
}

/// Two connected in-memory byte streams, for tests and for joining two parts of a program.
///
/// @example
/// ```ts
/// import { bytePipe } from "std/streams"
///
/// const ends = bytePipe()
/// const client = ends[0]
/// const server = ends[1]
/// await client.write(new TextEncoder().encode("GET"))
/// const req = await server.read()
/// if (req != null) {
///   println(new TextDecoder().decode(req))   // GET
/// }
/// client.close()
/// ```
export function bytePipe(): PipeEnd[] {
  const a = new PipeEnd()
  const b = new PipeEnd()
  a.peer = b
  b.peer = a
  return [a, b]
}

// ------------------------------------------------------------------------------------ framing

/// The size of a frame's length prefix (a u32, big-endian).
export const FRAME_HEADER_BYTES: int = 4

/// The default limit on a frame's message.
export const DEFAULT_MAX_FRAME_BYTES: int = 16 * 1024 * 1024

/// Framing options: the largest message (`maxBytes`, default 16 MiB) and whether a message may be
/// empty (`allowEmpty`, default false).
///
/// @example
/// ```ts
/// import { encodeFrame, FrameOptions } from "std/streams"
///
/// const options: FrameOptions = { maxBytes: 1024, allowEmpty: true }
/// println(encodeFrame(new Uint8Array(0), options).length)   // 4
/// ```
export struct FrameOptions {
  maxBytes?: int
  allowEmpty?: bool
}

/// A frame that breaks the options: `kind` is `"Empty"` (an empty message where none are allowed),
/// `"TooLarge"` (over `maxBytes`), `"Truncated"` (`frames`: the stream ended inside a frame) or
/// `"Failed"` (an earlier error left the stream unusable);
/// `length` is the message length the frame gave (or was given).
///
/// @example
/// ```ts
/// import { FrameReader, FrameError } from "std/streams"
///
/// const reader = new FrameReader({ maxBytes: 8 })
/// reader.push(Uint8Array.from([0, 0, 1, 0]))   // a 256-byte frame
/// try {
///   const m = reader.next()
///   println(m)
/// } catch (e: FrameError) {
///   println(e.kind)     // TooLarge
///   println(e.length)   // 256
/// }
/// ```
export class FrameError extends Error {
  public kind: string
  public length: int

  /// @example
  /// ```ts
  /// import { FrameError } from "std/streams"
  ///
  /// const e = new FrameError("Empty", 0, "an empty frame")
  /// println(`${e.kind}: ${e.message}`)   // Empty: an empty frame
  /// ```
  constructor(kind: string, length: int, message: string) {
    super(message)
    this.kind = kind
    this.length = length
  }
}

function __frameCheck(n: int, options: FrameOptions): void throws FrameError {
  const max = options.maxBytes ?? DEFAULT_MAX_FRAME_BYTES
  if (n == 0 && options.allowEmpty != true) {
    throw new FrameError("Empty", 0, "an empty frame")
  }
  if (n > max) {
    throw new FrameError("TooLarge", n, `a frame of ${n} bytes (at most ${max})`)
  }
}

/// `message` with its length in front: a u32, big-endian.
///
/// @example
/// ```ts
/// import { encodeFrame } from "std/streams"
///
/// const frame = encodeFrame(new TextEncoder().encode("hi"))
/// println(frame.length)              // 6
/// println(frame[3])                  // 2
/// println(frame[4])                  // 104
/// ```
export function encodeFrame(message: Uint8Array, options: FrameOptions = {}): Uint8Array throws FrameError {
  const n = message.length
  __frameCheck(n, options)
  const out = new Uint8Array(FRAME_HEADER_BYTES + n)
  new DataView(out).setUint32(0, n)
  out.setAll(message, FRAME_HEADER_BYTES)
  return out
}

/// Splits a byte stream of frames back into messages, whatever the chunks: `push` what arrives,
/// then take `next()` until it gives null. A length over the limit fails before its bytes are
/// buffered; after an error the stream is unusable.
///
/// @example
/// ```ts
/// import { encodeFrame, FrameReader } from "std/streams"
///
/// const frame = encodeFrame(new TextEncoder().encode("hello"))
/// const reader = new FrameReader()
/// reader.push(frame.subarray(0, 3))   // a chunk boundary inside the frame
/// println(reader.next())              // null
/// reader.push(frame.subarray(3))
/// const m = reader.next()
/// if (m != null) {
///   println(new TextDecoder().decode(m))   // hello
/// }
/// ```
export class FrameReader {
  buf: Uint8Array = new Uint8Array(65536)
  start: int = 0
  end: int = 0
  failed: bool = false
  options: FrameOptions

  /// @example
  /// ```ts
  /// import { FrameReader } from "std/streams"
  ///
  /// const reader = new FrameReader({ maxBytes: 1024, allowEmpty: true })
  /// println(reader.pending)   // 0
  /// ```
  constructor(options: FrameOptions = {}) {
    this.options = options
  }

  /// Adds received bytes.
  ///
  /// @example
  /// ```ts
  /// import { encodeFrame, FrameReader } from "std/streams"
  ///
  /// const reader = new FrameReader()
  /// reader.push(encodeFrame(Uint8Array.from([1, 2])))
  /// reader.push(encodeFrame(Uint8Array.from([3])))
  /// println(reader.next()?.length)   // 2
  /// println(reader.next()?.length)   // 1
  /// ```
  public push(chunk: Uint8Array): void {
    const live = end - start
    if (end + chunk.length > buf.length) {
      let cap = buf.length
      while (cap < live + chunk.length) {
        cap = cap * 2
      }
      const grown = if (cap == buf.length) buf else new Uint8Array(cap)
      grown.setAll(buf.subarray(start, end))
      buf = grown
      start = 0
      end = live
    }
    buf.setAll(chunk, end)
    end += chunk.length
  }

  /// The next complete message, or null until more bytes arrive.
  ///
  /// @example
  /// ```ts
  /// import { encodeFrame, FrameReader } from "std/streams"
  ///
  /// const reader = new FrameReader()
  /// reader.push(encodeFrame(Uint8Array.from([1, 2, 3])))
  /// let m = reader.next()
  /// while (m != null) {
  ///   println(m.length)   // 3
  ///   m = reader.next()
  /// }
  /// ```
  public next(): Uint8Array? throws FrameError {
    if (failed) {
      throw new FrameError("Failed", 0, "the stream already failed")
    }
    if (end - start < FRAME_HEADER_BYTES) {
      return null
    }
    const n = new DataView(buf.buffer, buf.byteOffset + start, FRAME_HEADER_BYTES).getUint32(0)
    try {
      __frameCheck(n, options)
    } catch (e: FrameError) {
      failed = true
      throw e
    }
    if (end - start - FRAME_HEADER_BYTES < n) {
      return null
    }
    const at = start + FRAME_HEADER_BYTES
    start = at + n
    buf.slice(at, at + n)
  }

  /// Bytes of an unfinished frame (not 0 at the end of the stream: it was cut off).
  ///
  /// @example
  /// ```ts
  /// import { encodeFrame, FrameReader } from "std/streams"
  ///
  /// const reader = new FrameReader()
  /// reader.push(encodeFrame(Uint8Array.from([1, 2, 3])).subarray(0, 5))
  /// println(reader.next())    // null
  /// println(reader.pending)   // 5
  /// ```
  public get pending(): int {
    return end - start
  }
}

/// The messages of `stream`'s frames, until it ends; a frame cut off at the end is a `FrameError`
/// (`"Truncated"`).
///
/// @example
/// ```ts
/// import { bytePipe, encodeFrame, frames } from "std/streams"
///
/// const ends = bytePipe()
/// const enc = new TextEncoder()
/// await ends[0].write(encodeFrame(enc.encode("one")))
/// await ends[0].write(encodeFrame(enc.encode("two")))
/// ends[0].close()
/// for await (const m of frames(ends[1])) {
///   println(new TextDecoder().decode(m))   // one, then two
/// }
/// ```
export async function* frames(stream: ByteStream, options: FrameOptions = {}): AsyncIterator<Uint8Array> throws Error {
  const reader = new FrameReader(options)
  while (true) {
    let m = reader.next()
    while (m != null) {
      yield m
      m = reader.next()
    }
    const chunk = await stream.read()
    if (chunk == null) {
      if (reader.pending > 0) {
        throw new FrameError("Truncated", reader.pending, `the stream ended inside a frame (${reader.pending} bytes)`)
      }
      return
    }
    reader.push(chunk)
  }
}
