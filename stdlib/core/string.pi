// String methods (spec §13.1). `s.name(args)` calls `__String_name(s, args)`. Indices count
// code points, like `s[i]` and `s.length`; `s.slice(start, end)` is built in.

/// Where the first occurrence of `search` starts (in code points, like `s[i]`), or -1. An empty
/// `search` is found at 0.
///
/// @example
/// ```ts
/// println("hello".indexOf("l"))   // 2
/// println("hello".indexOf("z"))   // -1
/// ```
function __String_indexOf(s: string, search: string): int {
  const n = s.length
  const m = search.length
  let i = 0
  while (i + m <= n) {
    if (__matchesAt(s, search, i)) {
      return i
    }
    i += 1
  }
  return -1
}

function __matchesAt(s: string, search: string, at: int): bool {
  let k = 0
  while (k < search.length) {
    if (s[at + k] != search[k]) {
      return false
    }
    k += 1
  }
  return true
}

/// Whether `search` occurs in the string.
///
/// @example
/// ```ts
/// println("pico lang".includes("lang"))   // true
/// ```
function __String_includes(s: string, search: string): bool {
  return __String_indexOf(s, search) >= 0
}

/// Whether the string starts with `prefix`.
///
/// @example
/// ```ts
/// println("main.pi".startsWith("main"))   // true
/// ```
function __String_startsWith(s: string, prefix: string): bool {
  return prefix.length <= s.length && __matchesAt(s, prefix, 0)
}

/// Whether the string ends with `suffix`.
///
/// @example
/// ```ts
/// println("main.pi".endsWith(".pi"))   // true
/// ```
function __String_endsWith(s: string, suffix: string): bool {
  return suffix.length <= s.length && __matchesAt(s, suffix, s.length - suffix.length)
}

function __isSpace(c: char): bool {
  const n = c as u32
  return n == 32 || (n >= 9 && n <= 13)
}

/// The string without leading whitespace (spaces, tabs, line breaks, vertical tabs and form feeds).
///
/// @example
/// ```ts
/// println(`[${"  hi  ".trimStart()}]`)   // [hi  ]
/// ```
function __String_trimStart(s: string): string {
  let i = 0
  while (i < s.length && __isSpace(s[i])) {
    i += 1
  }
  s.slice(i)
}

/// The string without trailing whitespace (spaces, tabs, line breaks, vertical tabs and form
/// feeds).
///
/// @example
/// ```ts
/// println(`[${"  hi  ".trimEnd()}]`)   // [  hi]
/// ```
function __String_trimEnd(s: string): string {
  let j = s.length
  while (j > 0 && __isSpace(s[j - 1])) {
    j -= 1
  }
  s.slice(0, j)
}

/// The string without leading and trailing whitespace (spaces, tabs, line breaks, vertical tabs and
/// form feeds).
///
/// @example
/// ```ts
/// println(`[${"\t hi \n".trim()}]`)   // [hi]
/// ```
function __String_trim(s: string): string {
  __String_trimEnd(__String_trimStart(s))
}

/// ASCII letters only.
///
/// @example
/// ```ts
/// println("Hello, world".toUpperCase())   // HELLO, WORLD
/// ```
function __String_toUpperCase(s: string): string {
  // (Pieces joined once: appending is O(n²), #73.)
  const out: string[] = []
  for (const c of s) {
    const n = c as u32
    out.push(if (n >= 97 && n <= 122) `${(n - 32) as char}` else `${c}`)
  }
  return out.join("")
}

/// ASCII letters only.
///
/// @example
/// ```ts
/// println("Hello, World".toLowerCase())   // hello, world
/// ```
function __String_toLowerCase(s: string): string {
  const out: string[] = []
  for (const c of s) {
    const n = c as u32
    out.push(if (n >= 65 && n <= 90) `${(n + 32) as char}` else `${c}`)
  }
  return out.join("")
}

/// The pieces of the string between occurrences of `separator` (a string or a `RegExp`, whose
/// captured groups are spliced in), at most `limit` of them; an empty separator splits into
/// characters.
///
/// @example
/// ```ts
/// println("a,b,c".split(",").join(" | "))      // a | b | c
/// println("a,b,c".split(",", 2).join(" | "))   // a | b
/// println("1 + 2".split(/\s*\+\s*/).join(" | "))   // 1 | 2
/// ```
function __String_split(s: string, separator: string | RegExp, limit: int = -1): string[] {
  match (separator) {
    sep: string => {
      const parts = __splitStr(s, sep)
      if (limit >= 0 && parts.length > limit) parts.slice(0, limit) else parts
    },
    re: RegExp => __rSplit(s, re, limit),
  }
}

function __splitStr(s: string, separator: string): string[] {
  const out: string[] = []
  if (separator.length == 0) {
    for (const c of s) {
      out.push(`${c}`)
    }
    return out
  }
  let start = 0
  let i = 0
  while (i + separator.length <= s.length) {
    if (__matchesAt(s, separator, i)) {
      out.push(s.slice(start, i))
      i += separator.length
      start = i
    } else {
      i += 1
    }
  }
  out.push(s.slice(start))
  return out
}

/// Replaces the first occurrence of `search` (every match for a `RegExp` with the `g` flag).
/// `replacement` may use `$&`, `$1`, `$<name>`, `` $` ``, `$'` and `$$`, or be a function of the
/// match.
///
/// @example
/// ```ts
/// println("one two two".replace("two", "2"))         // one 2 two
/// println("a1b22".replace(/\d+/g, "#"))              // a#b#
/// println("john smith".replace(/(\w+) (\w+)/, "$2, $1"))   // smith, john
/// ```
function __String_replace(s: string, search: string | RegExp, replacement: string | ((m: RegExpMatch) => string)): string {
  match (search) {
    t: string => {
      const i = __String_indexOf(s, t)
      if (i < 0) {
        return s
      }
      const m = new RegExpMatch([t], i, s, null)
      s.slice(0, i) + __rReplaceWith(replacement, m, s) + s.slice(i + t.length)
    },
    re: RegExp => __rReplace(s, re, replacement, re.global),
  }
}

/// Replaces every occurrence of `search` (a `RegExp` needs the `g` flag).
///
/// @example
/// ```ts
/// println("one two two".replaceAll("two", "2"))   // one 2 2
/// println("a-b_c".replaceAll(/[-_]/g, (m) => "."))   // a.b.c
/// ```
function __String_replaceAll(s: string, search: string | RegExp, replacement: string | ((m: RegExpMatch) => string)): string {
  match (search) {
    t: string => match (replacement) {
      r: string => if (r.includes("$")) __rReplace(s, RegExp.__literal(__rQuote(t), "g"), r, true) else __replaceAllStr(s, t, r),
      f: __ReplaceFn => __rReplace(s, RegExp.__literal(__rQuote(t), "g"), f, true),
    },
    re: RegExp => {
      if (!re.global) {
        panic("replaceAll must be called with a global RegExp")
      }
      __rReplace(s, re, replacement, true)
    },
  }
}

/// The first match of `re` (no `g` flag), or every match's text (`g`); `null` without one.
///
/// @example
/// ```ts
/// const m = "v1.20".match(/(\d+)\.(\d+)/)
/// if (m != null) {
///   println(`${m[1]} ${m[2]}`)   // 1 20
/// }
/// const all = "a1b22c333".match(/\d+/g)
/// if (all != null) {
///   println(all.length)   // 3
///   println(all[2])       // 333
/// }
/// ```
function __String_match(s: string, re: RegExp): RegExpMatch? {
  if (!re.global) {
    return re.exec(s)
  }
  const all = __rMatchAll(s, re)
  re.lastIndex = 0
  if (all.length == 0) {
    return null
  }
  const items: (string?)[] = []
  for (const m of all) {
    items.push(m[0])
  }
  new RegExpMatch(items, -1, s, null)
}

/// Every match of `re`, with its groups and index.
///
/// @example
/// ```ts
/// for (const m of "x=1, y=2".matchAll(/(\w)=(\d)/g)) {
///   println(`${m[1]} is ${m[2]} at ${m.index}`)
/// }
/// // x is 1 at 0
/// // y is 2 at 5
/// ```
function __String_matchAll(s: string, re: RegExp): RegExpMatch[] {
  __rMatchAll(s, re)
}

/// Where the first match of `re` starts, or -1.
///
/// @example
/// ```ts
/// println("abc123".search(/\d/))   // 3
/// ```
function __String_search(s: string, re: RegExp): int {
  const caps = re.__search(__rChars(s), 0, re.sticky)
  if (caps == null) -1 else caps[0]
}

/// `s` with regex syntax characters escaped (a pattern matching `s` literally).
function __rQuote(s: string): string {
  const out: string[] = []
  for (const c of s) {
    if ("\\^$.*+?()[]{}|/".includes(`${c}`)) out.push("\\")
    out.push(`${c}`)
  }
  return out.join("")
}

function __replaceAllStr(s: string, search: string, replacement: string): string {
  if (search.length == 0) {
    return s
  }
  // Every occurrence: the pieces between them, joined with the replacement once (#73).
  return __splitStr(s, search).join(replacement)
}

/// The string `count` times over: `"ab".repeat(3)` is `"ababab"` (empty for a `count` of 0 or
/// less).
///
/// @example
/// ```ts
/// println("ab".repeat(3))   // ababab
/// ```
function __String_repeat(s: string, count: int): string {
  // By doubling: O(n) bytes built rather than O(n²) (a 100 kB string was 5 GB of garbage).
  let out = ""
  let piece = s
  let n = count
  while (n > 0) {
    if (n % 2 == 1) {
      out = out + piece
    }
    n = n / 2
    if (n > 0) {
      piece = piece + piece
    }
  }
  return out
}

function __padding(length: int, fill: string): string {
  if (fill.length == 0 || length <= 0) {
    return ""
  }
  // (By `repeat`, which doubles: appending `fill` one at a time is O(n²), #73.)
  __String_repeat(fill, (length + fill.length - 1) / fill.length).slice(0, length)
}

/// The string padded with spaces at the start to `length` code points (unchanged if it's that long
/// already): `"7".padStart(3)` is `"  7"`.
///
/// @example
/// ```ts
/// println(`[${"7".padStart(3)}]`)   // [  7]
/// ```
function __String_padStart(s: string, length: int): string {
  __String_padStart(s, length, " ")
}

/// The string padded at the start to `length` code points with `fill`, repeated and cut to fit
/// (unchanged if it's that long already, or `fill` is empty): `"7".padStart(3, "0")` is `"007"`.
///
/// @example
/// ```ts
/// println("7".padStart(3, "0"))   // 007
/// ```
function __String_padStart(s: string, length: int, fill: string): string {
  if (s.length >= length) s else __padding(length - s.length, fill) + s
}

/// The string padded with spaces at the end to `length` code points (unchanged if it's that long
/// already).
///
/// @example
/// ```ts
/// println(`[${"ab".padEnd(5)}]`)   // [ab   ]
/// ```
function __String_padEnd(s: string, length: int): string {
  __String_padEnd(s, length, " ")
}

/// The string padded at the end to `length` code points with `fill`, repeated and cut to fit
/// (unchanged if it's that long already, or `fill` is empty).
///
/// @example
/// ```ts
/// println("ab".padEnd(6, "-="))   // ab-=-=
/// ```
function __String_padEnd(s: string, length: int, fill: string): string {
  if (s.length >= length) s else s + __padding(length - s.length, fill)
}

/// The integer at the start of `s`, like JavaScript's `parseInt(s)` in base 10: leading
/// whitespace, an optional sign, then digits up to the first non-digit. Panics without any
/// digits (`int` has no `NaN`).
///
/// @example
/// ```ts
/// println(parseInt("42"))         // 42
/// println(parseInt("  -7 apples"))   // -7
/// ```
function parseInt(s: string): int {
  let i = 0
  const n = s.length
  while (i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')) {
    i += 1
  }
  let negative = false
  if (i < n && (s[i] == '-' || s[i] == '+')) {
    negative = s[i] == '-'
    i += 1
  }
  const start = i
  let value = 0
  while (i < n && s[i] >= '0' && s[i] <= '9') {
    value = value * 10 + ((s[i] as u32) as int - 48)
    i += 1
  }
  if (i == start) {
    panic(`parseInt: no digits in "${s}"`)
  }
  if (negative) -value else value
}

/// The value of digit `c` in bases up to 36 (`0`–`9`, then `a`–`z` or `A`–`Z`), or -1.
function __digitValue(c: char): int {
  const n = (c as u32) as int
  if (n >= 48 && n <= 57) return n - 48
  if (n >= 97 && n <= 122) return n - 87
  if (n >= 65 && n <= 90) return n - 55
  return -1
}

function __checkRadix(radix: int): void {
  if (radix < 2 || radix > 36) panic(`parse: radix ${radix} isn't between 2 and 36`)
}

/// `s` (spaces around it are allowed) as an integer in base `radix`: an optional sign and at
/// least one digit, nothing else; `null` for other text or a value that doesn't fit an `i64`.
function __parseSigned(s: string, radix: int): i64? {
  __checkRadix(radix)
  const t = s.trim()
  let i = 0
  let negative = false
  if (t.startsWith("-") || t.startsWith("+")) {
    negative = t.startsWith("-")
    i = 1
  }
  if (i >= t.length) return null
  let v: i64 = 0
  while (i < t.length) {
    const d = __digitValue(t[i])
    if (d < 0 || d >= radix) return null
    const m = v.checkedMul(radix)
    if (m == null) return null
    const a = if (negative) m.checkedSub(d) else m.checkedAdd(d)
    if (a == null) return null
    v = a
    i += 1
  }
  return v
}

/// `__parseSigned` for unsigned types: no `-`, up to `u64`'s range.
function __parseUnsigned(s: string, radix: int): u64? {
  __checkRadix(radix)
  const t = s.trim()
  let i = if (t.startsWith("+")) 1 else 0
  if (i >= t.length) return null
  let v: u64 = 0
  while (i < t.length) {
    const d = __digitValue(t[i])
    if (d < 0 || d >= radix) return null
    const m = v.checkedMul(radix as u64)
    if (m == null) return null
    const a = m.checkedAdd(d as u64)
    if (a == null) return null
    v = a
    i += 1
  }
  return v
}

/// `int.parse(s)`, `i64.parse(s, radix)`: the integer `s` is, or `null` (#154).
function __i64_parse(s: string, radix: int = 10): i64? {
  return __parseSigned(s, radix)
}

function __i32_parse(s: string, radix: int = 10): i32? {
  const v = __parseSigned(s, radix)
  if (v == null || v < -2147483648 || v > 2147483647) return null
  return v as i32
}

function __i16_parse(s: string, radix: int = 10): i16? {
  const v = __parseSigned(s, radix)
  if (v == null || v < -32768 || v > 32767) return null
  return v as i16
}

function __i8_parse(s: string, radix: int = 10): i8? {
  const v = __parseSigned(s, radix)
  if (v == null || v < -128 || v > 127) return null
  return v as i8
}

function __u64_parse(s: string, radix: int = 10): u64? {
  return __parseUnsigned(s, radix)
}

function __u32_parse(s: string, radix: int = 10): u32? {
  const v = __parseUnsigned(s, radix)
  if (v == null || v > 4294967295u64) return null
  return v as u32
}

function __u16_parse(s: string, radix: int = 10): u16? {
  const v = __parseUnsigned(s, radix)
  if (v == null || v > 65535u64) return null
  return v as u16
}

function __u8_parse(s: string, radix: int = 10): u8? {
  const v = __parseUnsigned(s, radix)
  if (v == null || v > 255u64) return null
  return v as u8
}

/// Where the longest decimal number at the start of `t` ends (`[+-]` digits, a `.` and digits,
/// an exponent; or `Infinity`), or 0 when there's none.
function __numberEnd(t: string): int {
  let i = 0
  if (i < t.length && (t[i] == '+' || t[i] == '-')) i += 1
  if (t.slice(i).startsWith("Infinity")) return i + 8
  const from = i
  while (i < t.length && t[i] >= '0' && t[i] <= '9') {
    i += 1
  }
  let digits = i - from
  if (i < t.length && t[i] == '.') {
    let j = i + 1
    while (j < t.length && t[j] >= '0' && t[j] <= '9') {
      j += 1
    }
    digits += j - i - 1
    if (digits > 0) i = j
  }
  if (digits == 0) return 0
  if (i < t.length && (t[i] == 'e' || t[i] == 'E')) {
    let j = i + 1
    if (j < t.length && (t[j] == '+' || t[j] == '-')) j += 1
    const k = j
    while (j < t.length && t[j] >= '0' && t[j] <= '9') {
      j += 1
    }
    if (j > k) i = j
  }
  return i
}

/// The value of a number `__numberEnd` accepted (the same in every backend).
function __numberValue(text: string): f64 {
  const t = if (text.startsWith("+")) text.slice(1) else text
  if (t == "Infinity") return __parse_f64("inf")
  if (t == "-Infinity") return __parse_f64("-inf")
  return __parse_f64(t)
}

/// `number.parse(s)`, `f64.parse(s)`: the number `s` is (decimal, an exponent, `Infinity`,
/// `NaN`; spaces around it), or `null` (#154).
function __f64_parse(s: string): f64? {
  const t = s.trim()
  if (t == "NaN") return __parse_f64("NaN")
  const end = __numberEnd(t)
  if (end == 0 || end != t.length) return null
  return __numberValue(t)
}

function __f32_parse(s: string): f32? {
  const v = __f64_parse(s)
  if (v == null) return null
  return v as f32
}

/// The number at the start of `s`, like JavaScript's `parseFloat(s)`: leading whitespace, then
/// the longest decimal number (or `Infinity`); `NaN` without one.
///
/// @example
/// ```ts
/// println(parseFloat("3.14 m"))   // 3.14
/// println(parseFloat("abc"))      // NaN
/// ```
function parseFloat(s: string): number {
  const t = s.trimStart()
  const end = __numberEnd(t)
  if (end == 0) return __parse_f64("NaN")
  return __numberValue(t.slice(0, end))
}

/// The text from `start` up to `end` (default: the end), as JavaScript's `substring` (#156):
/// both are clamped to the string, and swapped when `start` is greater.
///
/// @example
/// ```ts
/// println("Hello, world".substring(7))      // world
/// println("Hello, world".substring(5, 0))   // Hello
/// ```
function __String_substring(s: string, start: int, end: int = s.length): string {
  const n = s.length
  const a = if (start < 0) 0 else if (start > n) n else start
  const b = if (end < 0) 0 else if (end > n) n else end
  return if (a <= b) s.slice(a, b) else s.slice(b, a)
}

/// The code point at position `i` (positions count code points), or `null` outside the string
/// (#156).
///
/// @example
/// ```ts
/// println("A€".codePointAt(1))   // 8364
/// println("A€".codePointAt(5))   // null
/// ```
function __String_codePointAt(s: string, i: int): int? {
  if (i < 0 || i >= s.length) return null
  return (s[i] as u32) as int
}

/// Compares `s` with `other` for sorting text (#156): ignoring case first, then lower case
/// before upper case, as ICU's root collation orders ASCII (JavaScript's `localeCompare`).
/// Negative, 0 or positive.
///
/// @example
/// ```ts
/// const names = ["bob", "Alice", "carol"]
/// names.sort((a, b) => a.localeCompare(b))
/// println(names.join(", "))   // Alice, bob, carol
/// ```
function __String_localeCompare(s: string, other: string): int {
  const a = s.toLowerCase()
  const b = other.toLowerCase()
  if (a < b) return -1
  if (a > b) return 1
  if (s == other) return 0
  return if (s > other) -1 else 1
}

/// Writes `text` to stderr at once, after what `print` wrote (#157).
///
/// @example
/// ```ts
/// eprint("warning: ")
/// eprintln("disk almost full")   // stderr: warning: disk almost full
/// ```
function eprint(text: string): void {
  __io(122, 2, 0, 0, text, "");
}

/// `eprint` with a line break.
///
/// @example
/// ```ts
/// eprintln("something went wrong")   // written to stderr
/// ```
function eprintln(text: string = ""): void {
  __io(122, 2, 0, 0, text + "\n", "");
}

/// Whether the character is an ASCII digit, `0` to `9` (decision 344).
function __Char_isDigit(c: char): bool {
  return c >= '0' && c <= '9'
}

/// Whether the character is an ASCII letter, `a` to `z` or `A` to `Z`.
function __Char_isAlpha(c: char): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

/// Whether the character is an ASCII letter or digit.
function __Char_isAlphanumeric(c: char): bool {
  return __Char_isAlpha(c) || __Char_isDigit(c)
}

/// Whether the character is ASCII whitespace: a space, `\t`, `\n`, `\r`, `\v` or `\f`.
function __Char_isWhitespace(c: char): bool {
  return c == ' ' || (c >= '\t' && c <= '\r')
}

/// The last position of `search` in `s`, or -1.
///
/// @example
/// ```ts
/// println("a/b/c".lastIndexOf("/"))   // 3
/// println("a/b/c".lastIndexOf("x"))   // -1
/// ```
function __String_lastIndexOf(s: string, search: string): int {
  const n = s.length
  const m = search.length
  let i = n - m
  while (i >= 0) {
    if (s.slice(i, i + m) == search) {
      return i
    }
    i -= 1
  }
  return -1
}

/// `string.fromUtf8(bytes)`: the text of UTF-8 `bytes`, each invalid sequence as U+FFFD, a leading
/// byte-order mark kept. Never throws (a `TextDecoder`'s `decode` may: it can be fatal).
function __string_fromUtf8(bytes: Uint8Array): string {
  try {
    TextDecoder.utf8({ ignoreBOM: true }).decode(bytes)
  } catch (e: TypeError) {
    panic("a decoder that isn't fatal doesn't throw")
  }
}

/// `string.fromCBytes(bytes)`: the text up to the first NUL byte (all of `bytes` without one), as
/// `string.fromUtf8` decodes it: a C string or a fixed-size `char[n]` field in a buffer.
function __string_fromCBytes(bytes: Uint8Array): string {
  const end = bytes.indexOf(0)
  __string_fromUtf8(if (end < 0) bytes else bytes.subarray(0, end))
}

// `string.fromC(p)` (spec §12.1): a copy of the NUL-terminated UTF-8 string at `p`.
extern "C" {
  function pico_str_from_c(p: ptr<u8>): string
}

/// A string built piece by piece, in time linear in its length: appending to a `string` with `+`
/// copies everything so far each time (O(n²) for a long one). The pieces are joined once, by
/// `toString()`.
///
/// @example
/// ```ts
/// const b = new StringBuilder()
/// for (let i = 1; i <= 3; i++) b.append(i).append(",")
/// println(b.toString())   // 1,2,3,
/// println(b.length)       // 6
/// ```
class StringBuilder {
  parts: string[] = []
  chars: int = 0

  /// An empty builder.
  ///
  /// @example
  /// ```ts
  /// println(new StringBuilder().length)   // 0
  /// ```
  constructor() {}

  /// Adds `x`'s string form (as `${x}` gives it) at the end; the builder itself, to chain.
  ///
  /// @example
  /// ```ts
  /// const b = new StringBuilder()
  /// b.append("x = ").append(4.5).append(true)
  /// println(b.toString())   // x = 4.5true
  /// ```
  public append<T>(x: T): StringBuilder {
    const s = `${x}`
    if (s.length > 0) {
      this.parts.push(s)
      this.chars += s.length
    }
    return this
  }

  /// How many characters (code points) it holds.
  ///
  /// @example
  /// ```ts
  /// println(new StringBuilder().append("héllo").length)   // 5
  /// ```
  public get length(): int {
    this.chars
  }

  /// Empties it, to build another string.
  ///
  /// @example
  /// ```ts
  /// const b = new StringBuilder().append("a")
  /// b.clear()
  /// println(b.append("b").toString())   // b
  /// ```
  public clear(): void {
    this.parts = []
    this.chars = 0
  }

  /// The string built so far.
  ///
  /// @example
  /// ```ts
  /// println(new StringBuilder().append("a").append("b").toString())   // ab
  /// ```
  public toString(): string {
    // (Joined into one piece, so asking again doesn't join again.)
    if (this.parts.length > 1) {
      this.parts = [this.parts.join("")]
    }
    if (this.parts.length == 0) "" else this.parts[0]
  }
}
