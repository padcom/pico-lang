/// The platform the program is compiled for (spec §15.4), fixed at compile time.
struct Target {
  /// `"linux"`, `"macos"`, `"windows"`, `"wasi"` or `"browser"`.
  os: string
  /// `"aarch64"`, `"x86_64"` or `"wasm32"`.
  arch: string
  /// The LLVM target triple, e.g. `"aarch64-apple-darwin"`.
  triple: string
}

/// How the program is being built (spec §11.1).
struct BuildInfo {
  /// `"debug"` or `"release"`.
  mode: string
  /// Flags given to the build (none yet).
  flags: string[]
}

/// `target` and `build` (outside of a program's own declarations by those names) mean
/// `comptime __target()` and `comptime __build()`.
function __target(): Target {
  return { os: __comptime_info(0), arch: __comptime_info(1), triple: __comptime_info(2) }
}
function __build(): BuildInfo { return { mode: __comptime_info(3), flags: [] } }

/// A field of a type, as `T.fields` describes it (spec §11.1).
struct FieldInfo {
  name: string
  /// The field's type as written in messages, e.g. `"f64"` or `"string[]"`.
  typeName: string
}

/// A method of a type, as `T.methods` describes it.
struct MethodInfo {
  name: string
}

/// Hashing helpers for generated code (`Args.hashKey()` in `std/meta`).
function __hashOf<T extends Hashable<T>>(x: T): u64 { x.hashCode() }
function __hashMix(a: u64, b: u64): u64 { a * 31u64 + b }
