// Lazy iteration (spec §5.7). An `Iterator<T>` produces values on demand from its step
// function, which returns `null` once it's done; `function*` generators build one, and
// `for-of` walks one (or anything with an `iterator()` method returning one).

/// What `for-of` walks (spec §5.7): anything with an `iterator()`. Arrays, strings (their
/// characters), `Map`, `Set`, iterators themselves and the collections are `Iterable`s, so a
/// function can take any of them.
///
/// @example
/// ```ts
/// function total(xs: Iterable<int>): int {
///   let n = 0
///   for (const x of xs) n += x
///   n
/// }
/// println(total([1, 2, 3]))                     // 6
/// println(total(new Set<int>([4, 5]).values()))   // 9
/// ```
interface Iterable<T> {
  /// A fresh iterator over the values.
  ///
  /// @example
  /// ```ts
  /// const xs: Iterable<int> = [1, 2, 3]
  /// println(xs.iterator().map((x) => x * 2).toArray().join(", "))   // 2, 4, 6
  /// ```
  iterator(): Iterator<T>
}

/// What `for await` walks: anything with an `asyncIterator()` (async generators, streams).
///
/// @example
/// ```ts
/// async function* count(n: int): AsyncIterator<int> {
///   for (let i = 1; i <= n; i++) yield i
/// }
///
/// async function sum(xs: AsyncIterable<int>): Promise<int> {
///   let n = 0
///   for await (const x of xs) n += x
///   n
/// }
/// println(await sum(count(3)))   // 6
/// ```
interface AsyncIterable<T, E extends Error = never> {
  /// An async iterator over the values.
  ///
  /// @example
  /// ```ts
  /// async function* two(): AsyncIterator<string> {
  ///   yield "a"
  ///   yield "b"
  /// }
  ///
  /// const xs: AsyncIterable<string> = two()
  /// println(await xs.asyncIterator().next())   // a
  /// ```
  asyncIterator(): AsyncIterator<T, E>
}

/// An array as an `Iterable` (where one is expected, an array becomes this).
class __ArrayIterable<T> implements Iterable<T> {
  xs: T[]

  constructor(xs: T[]) {
    this.xs = xs
  }

  public iterator(): Iterator<T> {
    __Array_iterator(this.xs)
  }
}

function __arrayIterable<T>(xs: T[]): Iterable<T> {
  new __ArrayIterable<T>(xs)
}

/// An `Iterable` whose iterators `f` makes (generic, so a program only has it if it's used).
class __FnIterable<T> implements Iterable<T> {
  f: () => Iterator<T>

  constructor(f: () => Iterator<T>) {
    this.f = f
  }

  public iterator(): Iterator<T> {
    const f = this.f
    f()
  }
}

function __fnIterable<T>(f: () => Iterator<T>): Iterable<T> {
  new __FnIterable<T>(f)
}

/// A string as an `Iterable` of its characters. (Generic, `C` is `char`, so it's only lowered
/// where it's used: a non-generic function would be, with the adapter class's itable, in every
/// program.)
function __stringIterable<C>(s: string): Iterable<char> {
  __fnIterable<char>(() => __String_iterator(s))
}

/// Values produced on demand (spec §5.7): `function*` generators return one, `for-of` walks one (or
/// anything with an `iterator()` method), and its adapters (`map`, `filter`, `take`, …) build new
/// ones without running anything until values are asked for. An iterator is used up as it goes:
/// walk it once.
///
/// @example
/// ```ts
/// function* naturals(): Iterator<int> {
///   let n = 1
///   while (true) {
///     yield n
///     n += 1
///   }
/// }
///
/// const squares = naturals().map((n) => n * n).take(4).toArray()
/// println(squares.join(", "))   // 1, 4, 9, 16
/// ```
class Iterator<T> implements Iterable<T> {
  step: () => T?
  done: bool = false

  /// An iterator whose values come from calling `step` until it returns `null`.
  ///
  /// @example
  /// ```ts
  /// let n = 0
  /// const countdown = new Iterator<int>(() => {
  ///   n += 1
  ///   if (n > 3) null else 4 - n
  /// })
  /// for (const x of countdown) {
  ///   println(x)
  /// }
  /// // 3
  /// // 2
  /// // 1
  /// ```
  constructor(step: () => T?) {
    this.step = step
  }

  /// The next value, or `null` at the end (and every time after).
  ///
  /// @example
  /// ```ts
  /// const it = ["a", "b"].iterator()
  /// println(it.next())   // a
  /// println(it.next())   // b
  /// println(it.next())   // null
  /// ```
  public next(): T? {
    if (this.done) {
      return null
    }
    const f = this.step
    const v = f()
    if (v == null) {
      this.done = true
    }
    return v
  }

  /// Itself (so an iterator works in `for-of`).
  ///
  /// @example
  /// ```ts
  /// const it = [1, 2, 3].iterator()
  /// it.next()
  /// for (const x of it.iterator()) {
  ///   println(x)
  /// }
  /// // 2
  /// // 3
  /// ```
  public iterator(): Iterator<T> {
    this
  }

  /// `f` of each value, lazily.
  ///
  /// @example
  /// ```ts
  /// const lengths = ["one", "three"].iterator().map((s) => s.length)
  /// println(lengths.toArray().join(", "))   // 3, 5
  /// ```
  public map<U>(f: (x: T) => U): Iterator<U> {
    const src = this
    new Iterator<U>(() => {
      const v = src.next()
      if (v == null) null else f(v)
    })
  }

  /// The values for which `f` is true, lazily.
  ///
  /// @example
  /// ```ts
  /// const odd = [1, 2, 3, 4, 5].iterator().filter((x) => x % 2 == 1)
  /// println(odd.toArray().join(", "))   // 1, 3, 5
  /// ```
  public filter(f: (x: T) => bool): Iterator<T> {
    const src = this
    new Iterator<T>(() => {
      loop {
        const v = src.next()
        if (v == null) {
          break null
        }
        if (f(v)) {
          break v
        }
      }
    })
  }

  /// The first `n` values (fewer if it ends sooner).
  ///
  /// @example
  /// ```ts
  /// const firstTwo = [10, 20, 30].iterator().take(2)
  /// println(firstTwo.toArray().join(", "))   // 10, 20
  /// ```
  public take(n: int): Iterator<T> {
    const src = this
    let left = n
    new Iterator<T>(() => {
      if (left <= 0) {
        return null
      }
      left -= 1
      src.next()
    })
  }

  /// The values after the first `n`.
  ///
  /// @example
  /// ```ts
  /// const rest = [10, 20, 30].iterator().skip(1)
  /// println(rest.toArray().join(", "))   // 20, 30
  /// ```
  public skip(n: int): Iterator<T> {
    const src = this
    let left = n
    new Iterator<T>(() => {
      while (left > 0) {
        left -= 1
        src.next()
      }
      src.next()
    })
  }

  /// Pairs of this iterator's and `other`'s values, until either ends.
  ///
  /// @example
  /// ```ts
  /// const names = ["ann", "bob", "cy"].iterator()
  /// const ages = [31, 27].iterator()
  /// for (const [name, age] of names.zip(ages)) {
  ///   println(`${name} is ${age}`)
  /// }
  /// // ann is 31
  /// // bob is 27
  /// ```
  public zip<U>(other: Iterator<U>): Iterator<[T, U]> {
    const src = this
    new Iterator<[T, U]>(() => {
      const a = src.next()
      if (a == null) {
        return null
      }
      const b = other.next()
      if (b == null) {
        return null
      }
      return [a, b]
    })
  }

  /// Each value with its position, from 0: `for (const [i, x] of it.enumerate())`.
  ///
  /// @example
  /// ```ts
  /// for (const [i, s] of ["a", "b"].iterator().enumerate()) {
  ///   println(`${i}: ${s}`)
  /// }
  /// // 0: a
  /// // 1: b
  /// ```
  public enumerate(): Iterator<[int, T]> {
    const src = this
    let i = 0
    new Iterator<[int, T]>(() => {
      const v = src.next()
      if (v == null) {
        return null
      }
      const pair: [int, T] = [i, v]
      i += 1
      return pair
    })
  }

  /// The remaining values in an array (runs the iterator to its end).
  ///
  /// @example
  /// ```ts
  /// const it = [1, 2, 3, 4].iterator()
  /// it.next()
  /// println(it.toArray().join(","))   // 2,3,4
  /// ```
  public toArray(): T[] {
    const out: T[] = []
    loop {
      const v = this.next()
      if (v == null) {
        break
      }
      out.push(v)
    }
    return out
  }

  /// Calls `f` with each remaining value.
  ///
  /// @example
  /// ```ts
  /// ["x", "y"].iterator().forEach((s) => println(s))
  /// // x
  /// // y
  /// ```
  public forEach(f: (x: T) => void): void {
    loop {
      const v = this.next()
      if (v == null) {
        break
      }
      f(v)
    }
  }
}

/// The elements of an array, lazily (`xs.iterator()`).
///
/// @example
/// ```ts
/// const it = [1, 2, 3].iterator()
/// println(it.next())   // 1
/// println(it.map((x) => x * 10).toArray().join(", "))   // 20, 30
/// ```
function __Array_iterator<T>(xs: T[]): Iterator<T> {
  let i = 0
  new Iterator<T>(() => {
    if (i >= xs.length) {
      return null
    }
    i += 1
    return xs[i - 1]
  })
}

/// The string's characters, lazily.
///
/// @example
/// ```ts
/// const it = "héllo".iterator()
/// println(it.next())                       // h
/// println(it.take(2).toArray().join(""))   // él
/// ```
function __String_iterator(s: string): Iterator<char> {
  let i = 0
  new Iterator<char>(() => {
    if (i >= s.length) {
      return null
    }
    i += 1
    s[i - 1]
  })
}
