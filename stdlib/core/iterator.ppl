// Lazy iteration (spec §5.7). An `Iterator<T>` produces values on demand from its step
// function, which returns `null` once it's done; `function*` generators build one, and
// `for-of` walks one (or anything with an `iterator()` method returning one).

/// Values produced on demand (spec §5.7): `function*` generators return one, `for-of` walks one (or
/// anything with an `iterator()` method), and its adapters (`map`, `filter`, `take`, …) build new
/// ones without running anything until values are asked for. An iterator is used up as it goes:
/// walk it once.
class Iterator<T> {
  step: () => T?
  done: bool = false

  /// An iterator whose values come from calling `step` until it returns `null`.
  constructor(step: () => T?) {
    this.step = step
  }

  /// The next value, or `null` at the end (and every time after).
  public next(): T? {
    if (this.done) {
      return null
    }
    const f = this.step
    const v = f()
    if (v == null) {
      this.done = true
    }
    v
  }

  /// Itself (so an iterator works in `for-of`).
  public iterator(): Iterator<T> {
    this
  }

  /// `f` of each value, lazily.
  public map<U>(f: (x: T) => U): Iterator<U> {
    const src = this
    new Iterator<U>(() => {
      const v = src.next()
      if (v == null) null else f(v)
    })
  }

  /// The values for which `f` is true, lazily.
  public filter(f: (x: T) => bool): Iterator<T> {
    const src = this
    new Iterator<T>(() => {
      loop {
        const v = src.next()
        if (v == null) {
          break null
        }
        if (f(v)) {
          break v
        }
      }
    })
  }

  /// The first `n` values (fewer if it ends sooner).
  public take(n: int): Iterator<T> {
    const src = this
    let left = n
    new Iterator<T>(() => {
      if (left <= 0) {
        return null
      }
      left -= 1
      src.next()
    })
  }

  /// The values after the first `n`.
  public skip(n: int): Iterator<T> {
    const src = this
    let left = n
    new Iterator<T>(() => {
      while (left > 0) {
        left -= 1
        src.next()
      }
      src.next()
    })
  }

  /// Pairs of this iterator's and `other`'s values, until either ends.
  public zip<U>(other: Iterator<U>): Iterator<[T, U]> {
    const src = this
    new Iterator<[T, U]>(() => {
      const a = src.next()
      if (a == null) {
        return null
      }
      const b = other.next()
      if (b == null) {
        return null
      }
      [a, b]
    })
  }

  /// Each value with its position, from 0: `for (const [i, x] of it.enumerate())`.
  public enumerate(): Iterator<[int, T]> {
    const src = this
    let i = 0
    new Iterator<[int, T]>(() => {
      const v = src.next()
      if (v == null) {
        return null
      }
      const pair: [int, T] = [i, v]
      i += 1
      pair
    })
  }

  /// The remaining values in an array (runs the iterator to its end).
  public toArray(): T[] {
    const out: T[] = []
    loop {
      const v = this.next()
      if (v == null) {
        break
      }
      out.push(v)
    }
    out
  }

  /// Calls `f` with each remaining value.
  public forEach(f: (x: T) => void): void {
    loop {
      const v = this.next()
      if (v == null) {
        break
      }
      f(v)
    }
  }
}

/// The elements of an array, lazily (`xs.iterator()`).
function __Array_iterator<T>(xs: T[]): Iterator<T> {
  let i = 0
  new Iterator<T>(() => {
    if (i >= xs.length) {
      return null
    }
    i += 1
    xs[i - 1]
  })
}
