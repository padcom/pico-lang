// `std/net`'s implementation (spec §13.4), in the core library so `fetch` can use it: TCP
// (`__netListen`, `__netConnect`), UDP (`__netBind`) and DNS (`__netResolve`); `std/net`
// exports them under their own names.
// Accepting, connecting, reading, writing, sending, receiving and resolving are jobs on
// runtime threads that settle on the event loop (ops 30–35 and the pipe jobs 20–22 in
// `pico_io.c`). A socket's descriptor is closed only once no job uses it any more: `close()`
// shuts it down (or wakes a waiting accept or receive with a connection or a datagram to
// itself) and the last job to finish closes it.

/// A failed network operation: the address it was about (`host:port`), a message
/// (`connection refused: 127.0.0.1:9`) and a portable kind (`"ConnectionRefused"`,
/// `"ConnectionReset"`, `"AddrInUse"`, `"AddrNotAvailable"`, `"TimedOut"`, `"HostNotFound"`,
/// `"InvalidData"`, `"PermissionDenied"`, `"TlsError"` (a failed TLS handshake: the message
/// says why, such as an untrusted certificate), `"Other"`).
///
/// @example
/// ```ts
/// import { connect, listen } from "std/net"
///
/// // A port nobody listens on: listen, note the port, stop listening.
/// const probe = await listen(0)
/// const port = probe.addr.port
/// probe.close()
/// try {
///   const conn = await connect(port)
///   conn.close()
/// } catch (e: NetError) {
///   println(e.kind)                                // ConnectionRefused
///   println(e.address == `127.0.0.1:${port}`)      // true
/// }
/// ```
class NetError extends Error {
  /// What the operation was about: usually `host:port` (`[::1]:80` for IPv6), the host name alone
  /// for a failed lookup.
  public address: string
  /// The portable kind (`"ConnectionRefused"`, `"TimedOut"`, …; see above).
  public kind: string
  /// A `NetError` about `address` with `message` and `kind`.
  ///
  /// @example
  /// ```ts
  /// const e = new NetError("example.com:443", "timed out: example.com:443", "TimedOut")
  /// println(e.kind)      // TimedOut
  /// println(e.address)   // example.com:443
  /// println(e.message)   // timed out: example.com:443
  /// ```
  constructor(address: string, message: string, kind: string) {
    super(message)
    this.address = address
    this.kind = kind
  }
}

function __netError(address: string, r: int, errno: int): NetError {
  // (Kept in a function: a top-level constant would be built at every program's start.)
  const __netKinds = ["", "NotFound", "AlreadyExists", "PermissionDenied", "NotADirectory",
    "IsADirectory", "DirectoryNotEmpty", "InvalidData", "Other", "ConnectionRefused",
    "ConnectionReset", "AddrInUse", "AddrNotAvailable", "TimedOut", "HostNotFound", "TlsError"]
  const __netMessages = ["", "not found", "already exists", "permission denied",
    "not a directory", "is a directory", "directory not empty", "not valid UTF-8", "I/O error",
    "connection refused", "connection reset", "address in use", "address not available",
    "timed out", "host not found", "TLS failure"]
  const k = if (-r > 0 && -r < __netKinds.length) -r else 8
  const what = if (k == 8) `${__netMessages[k]} (os error ${errno})` else __netMessages[k]
  new NetError(address, `${what}: ${address}`, __netKinds[k])
}

/// An IP address and a port.
///
/// @example
/// ```ts
/// import { listen } from "std/net"
///
/// const listener = await listen(0, "127.0.0.1")
/// const addr: Addr = listener.addr
/// println(addr.hostname)   // 127.0.0.1
/// println(addr.port > 0)   // true (a free port the system picked)
/// listener.close()
/// ```
struct Addr {
  /// The IP address (`"127.0.0.1"`, `"::1"`, without brackets), or a Unix-domain socket's path.
  hostname: string
  /// The port number; -1 for a Unix-domain socket.
  port: int
}

/// `host:port` (`[::1]:80` for IPv6), or a Unix-domain socket's path.
function __netShow(hostname: string, port: int): string {
  if (port < 0) hostname else if (hostname.includes(":")) `[${hostname}]:${port}` else `${hostname}:${port}`
}

/// An `Addr` from "host port" at `fields[i]`, `fields[i + 1]`.
function __netAddr(fields: string[], i: int): Addr {
  const a: Addr = { hostname: fields[i], port: parseInt(fields[i + 1]) }
  return a
}

/// A finished job's results.
struct __NetResult {
  r: int
  r2: int
  job: int
}

/// Runs job `op`; failures reject with a `NetError` about `address`.
function __netJob<T>(op: int, a: int, b: int, c: int, s: string, t: string, address: string,
  read: (res: __NetResult) => T, failed: (() => void)? = null): Promise<T, NetError> {
  const p = new Promise<T, NetError>()
  __ioSubmit(op, a, b, c, s, t, (job: int) => {
    const r = __io(102, job, 0, 0, "", "")
    const r2 = __io(103, job, 0, 0, "", "")
    if (r < 0) {
      // The caller's busy state ends on failure too (#20): else the socket stays busy and
      // `close()` never releases its descriptor.
      if (failed != null) {
        failed()
      }
      p.__reject(__netError(address, r, r2))
    } else {
      p.__resolve(read({ r, r2, job }))
    }
  })
  return p
}

function __netResolved<T>(value: T): Promise<T, NetError> {
  const p = new Promise<T, NetError>()
  p.__resolve(value)
  return p
}

/// The bytes of a view as a buffer handle starting at its first byte.
function __netBytesOf(data: Uint8Array): ArrayBuffer {
  if (data.byteOffset == 0) data.buffer else data.buffer.slice(data.byteOffset, data.byteOffset + data.length)
}

/// A received buffer (`r` its handle, `r2` its length) as bytes.
function __netBytes(res: __NetResult): Uint8Array {
  new Uint8Array(new ArrayBuffer(res.r, res.r2, true), 0, res.r2)
}

/// Where to connect to reach a listener bound to `a` (the loopback for "every interface").
function __netReach(a: Addr): string {
  if (a.hostname == "0.0.0.0") "127.0.0.1" else if (a.hostname == "::") "::1" else a.hostname
}

/// A queued write.
struct __NetSend {
  bytes: ArrayBuffer?
  count: int
  text: string
  p: Promise<int, NetError>
}

/// A TCP connection: chunks of bytes with `read` or `for await`, the rest as text with
/// `text()`, writes (in the order they're made) with `write`/`writeText`. One read at a time.
///
/// @example
/// ```ts
/// import { connect, listen } from "std/net"
///
/// const listener = await listen(0)
/// const accepting = listener.accept()
/// const client = await connect(listener.addr.port)
/// const server = await accepting
/// if (server != null) {
///   await client.writeText("ping")
///   client.closeWrite()
///   println(await server.text())   // ping
///   server.close()
/// }
/// client.close()
/// listener.close()
/// ```
class Conn {
  fd: int
  /// This side's address.
  public readonly localAddr: Addr
  /// The other side's address.
  public readonly remoteAddr: Addr
  name: string
  reading: bool = false
  done: bool = false
  queue: __NetSend[] = []
  head: int = 0
  busy: bool = false
  /// 0 open, 1 closing for writing, 2 closing.
  closing: int = 0
  writeShut: bool = false
  shut: bool = false
  released: bool = false
  rs: ReadableStream<Uint8Array>? = null
  ws: WritableStream<Uint8Array>? = null

  /// A connection on descriptor `fd`; made by `connect` and `accept`, not by programs.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// // Connections come from `connect` (the client's end) and `accept` (the server's end).
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client: Conn = await connect(listener.addr.port)
  /// const server = await accepting
  /// println(client.remoteAddr.port == listener.addr.port)   // true
  /// println(server?.localAddr.port == listener.addr.port)   // true
  /// server?.close()
  /// client.close()
  /// listener.close()
  /// ```
  constructor(fd: int, localAddr: Addr, remoteAddr: Addr) {
    this.fd = fd
    this.localAddr = localAddr
    this.remoteAddr = remoteAddr
    this.name = __netShow(remoteAddr.hostname, remoteAddr.port)
  }

  /// The connection's incoming bytes as a stream (reading it and `read()` don't mix).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await server.writeText("streamed")
  ///   server.close()
  ///   const decoder = new TextDecoder()
  ///   for await (const chunk of client.readable) {
  ///     println(decoder.decode(chunk))   // streamed
  ///   }
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public get readable(): ReadableStream<Uint8Array> {
    const r = this.rs
    if (r != null) {
      return r
    }
    const s = new ReadableStream<Uint8Array>({
      pullAsync: (c) => __netPullConn(this, c),
      cancel: (_reason) => this.close(),
    })
    this.rs = s
    return s
  }

  /// The connection's outgoing bytes as a stream: closing it finishes writing
  /// (`closeWrite()`), aborting it closes the connection.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   const writer = client.writable.getWriter()
  ///   await writer.write(new TextEncoder().encode("via a stream"))
  ///   await writer.close()                 // finishes writing (closeWrite)
  ///   println(await server.text())         // via a stream
  ///   server.close()
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public get writable(): WritableStream<Uint8Array> {
    const w = this.ws
    if (w != null) {
      return w
    }
    const s = new WritableStream<Uint8Array>({
      writeAsync: (chunk, _c) => this.write(chunk).then<void>((_n: int) => {}),
      close: () => this.closeWrite(),
      abort: (_reason) => this.close(),
    })
    this.ws = s
    return s
  }

  /// Once the other side has finished and so has this one, the connection closes itself.
  finishIfDone(): void {
    if (done && writeShut && !shut) {
      shut = true
      __io(120, fd, 2, 0, "", "");
      release()
    }
  }

  /// Closes the descriptor once it's shut down and no job uses it.
  release(): void {
    if (shut && !reading && !busy && !released) {
      released = true
      __io(121, fd, 0, 0, "", "");
    }
  }

  start(): bool {
    if (reading) {
      panic(`the connection to ${name} is already being read`)
    }
    if (done || shut) {
      return false
    }
    reading = true
    return true
  }

  /// Runs a TLS handshake on the connection (P7.5b): afterwards its reads and writes are
  /// encrypted. `mode` 0 is a client checking the server's certificate for `host` against the
  /// system's roots and `pem` (extra trusted certificates), 1 a client that doesn't check,
  /// 2 a server with certificate chain `pem` and private key `key`. Fails with a
  /// `TlsError` saying why.
  public __startTls(mode: int, host: string, pem: string, key: string = ""): Promise<void, NetError> {
    const p = new Promise<void, NetError>()
    const peer = this.name
    __ioSubmit(36, fd, mode, 0, host, pem + "\u{0}" + key, (job: int) => {
      const r = __io(102, job, 0, 0, "", "")
      if (r == -15) {
        p.__reject(new NetError(peer, `${__io_text(job)}: ${peer}`, "TlsError"))
      } else if (r < 0) {
        p.__reject(__netError(peer, r, __io(103, job, 0, 0, "", "")))
      } else {
        p.__resolve(__void())
      }
    })
    return p
  }

  /// Up to `n` bytes (as soon as some arrive), or `null` once the other side has finished
  /// writing (or this side is closed).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await client.write(Uint8Array.from([1, 2, 3]))
  ///   const chunk = await server.read()
  ///   println(chunk?.length)   // 3
  ///   client.close()
  ///   println(await server.read())   // null (the client finished)
  ///   server.close()
  /// }
  /// listener.close()
  /// ```
  public read(n: int = 65536): Promise<Uint8Array?, NetError> {
    if (!start()) {
      return __netResolved<Uint8Array?>(null)
    }
    __netJob<Uint8Array?>(20, fd, n, 0, "", "", name, (res: __NetResult) => {
      this.reading = false
      if (res.r2 == 0) {
        __buf_op(2, res.r, 0, 0);
        this.done = true
        this.finishIfDone()
        this.release()
        null
      } else {
        this.release()
        __netBytes(res)
      }
    }, () => {
      this.reading = false
      this.release()
    })
  }

  /// `for await` reads chunks until the end.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await client.writeText("hi")
  ///   const chunk = await server.next()
  ///   println(chunk?.length)   // 2
  ///   server.close()
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public next(): Promise<Uint8Array?, NetError> {
    read()
  }

  /// The connection itself (`for await (const chunk of conn)`).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await client.writeText("hello")
  ///   client.close()
  ///   let total = 0
  ///   for await (const chunk of server) {
  ///     total += chunk.length
  ///   }
  ///   println(total)   // 5
  ///   server.close()
  /// }
  /// listener.close()
  /// ```
  public asyncIterator(): Conn {
    this
  }

  /// Everything until the other side finishes writing, as text (UTF-8; anything else
  /// rejects with kind `"InvalidData"`).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await server.writeText("line 1\nline 2\n")
  ///   server.close()
  ///   const all = await client.text()
  ///   println(all.split("\n").length)   // 3
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public text(): Promise<string, NetError> {
    if (!start()) {
      return __netResolved<string>("")
    }
    __netJob<string>(22, fd, 0, 0, "", "", name, (res: __NetResult) => {
      this.reading = false
      this.done = true
      this.finishIfDone()
      this.release()
      __io_text(res.job)
    }, () => {
      this.reading = false
      this.release()
    })
  }

  add(w: __NetSend): Promise<int, NetError> {
    if (closing > 0) {
      panic(`the connection to ${name} is closed for writing`)
    }
    queue.push(w)
    pump()
    return w.p
  }

  /// Writes all of `data`; the count written.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   const n = await client.write(new TextEncoder().encode("bytes"))
  ///   println(n)   // 5
  ///   server.close()
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public write(data: Uint8Array): Promise<int, NetError> {
    add({ bytes: __netBytesOf(data), count: data.length, text: "", p: new Promise<int, NetError>() })
  }

  /// Writes `text` as UTF-8; the count of bytes written.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   println(await client.writeText("żółw"))   // 7 (bytes of UTF-8)
  ///   server.close()
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public writeText(text: string): Promise<int, NetError> {
    add({ bytes: null, count: 0, text, p: new Promise<int, NetError>() })
  }

  /// Turns Nagle's algorithm off (`noDelay`, the default) or on: small writes go out at once
  /// instead of waiting to be coalesced (`TCP_NODELAY`, #65). Throws a `NetError` where the
  /// system can't (WASI).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const client = await connect(listener.addr.port)
  /// client.setNoDelay()
  /// client.close()
  /// listener.close()
  /// ```
  public setNoDelay(noDelay: bool = true): void throws NetError {
    this.option(6, if (noDelay) 1 else 0, "no delay")
  }

  /// Turns TCP keep-alive probes on (`enable`) or off (#65); `initialDelay` is how long the
  /// connection idles before the first probe, in milliseconds (0: the system's default; rounded
  /// up to seconds). Throws a `NetError` where the system can't (WASI).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const client = await connect(listener.addr.port)
  /// client.setKeepAlive(true, 30000)
  /// client.close()
  /// listener.close()
  /// ```
  public setKeepAlive(enable: bool = false, initialDelay: int = 0): void throws NetError {
    const n = if (!enable) -1 else if (initialDelay <= 0) 0 else (initialDelay + 999) / 1000
    this.option(7, n, "keep-alive")
  }

  /// Sets socket option `which` (`pico_io` op 170); throws what the system says.
  option(which: int, value: int, about: string): void throws NetError {
    if (this.shut) {
      panic(`the connection to ${this.name} is closed`)
    }
    const r = __io(170, this.fd, which, value, "", "")
    if (r < 0) {
      throw __netError(about, -((-r) & 255), (-r) >> 8)
    }
  }

  /// Finishes writing once earlier writes are done (the other side reads the end); reading
  /// goes on.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// if (server != null) {
  ///   await client.writeText("question")
  ///   client.closeWrite()                  // the server's text() can finish…
  ///   const q = await server.text()
  ///   await server.writeText(`answer to ${q}`)
  ///   server.close()
  ///   println(await client.text())         // …and the client still reads: answer to question
  /// }
  /// client.close()
  /// listener.close()
  /// ```
  public closeWrite(): void {
    if (closing == 0) {
      closing = 1
    }
    pump()
  }

  /// Closes the connection once earlier writes are done: a waiting read ends with `null`.
  /// Twice is fine.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const server = await accepting
  /// client.close()
  /// client.close()                     // twice is fine
  /// if (server != null) {
  ///   println(await server.read())     // null
  ///   server.close()
  /// }
  /// listener.close()
  /// ```
  public close(): void {
    closing = 2
    pump()
  }

  pump(): void {
    if (busy) {
      return
    }
    if (head == queue.length) {
      queue = []
      head = 0
      if (closing == 1 && !writeShut) {
        writeShut = true
        __io(120, fd, 1, 0, "", "");
        finishIfDone()
      } else if (closing == 2 && !shut) {
        shut = true
        __io(120, fd, 2, 0, "", "");
        release()
      }
      return
    }
    const w = queue[head]
    head += 1
    busy = true
    const b = w.bytes
    const settle = (job: int) => {
      const r = __io(102, job, 0, 0, "", "")
      const r2 = __io(103, job, 0, 0, "", "")
      this.busy = false
      if (r < 0) {
        w.p.__reject(__netError(this.name, r, r2))
      } else {
        w.p.__resolve(r)
      }
      this.pump()
    }
    if (b != null) {
      __ioSubmit(21, fd, b.__handle, w.count, "", "", settle)
    } else {
      __ioSubmit(21, fd, 0, -1, "", w.text, settle)
    }
  }
}

/// Reads the next chunk of `conn` into a stream.
async function __netPullConn(conn: Conn, c: ReadableStreamDefaultController<Uint8Array>): Promise<void> throws NetError {
  const chunk = await conn.read()
  if (chunk == null) {
    c.close()
  } else {
    c.enqueue(chunk)
  }
}

/// `l.accept()` once `prev` (the accept before it) has settled, however it did.
async function __acceptAfter(l: Listener, prev: Promise<Conn?, NetError>): Promise<Conn?> throws NetError {
  try {
    await prev
  } catch (_e: NetError) {}
  return await l.accept()
}

/// A TCP listener: `accept()` or `for await (const conn of listener)`.
///
/// @example
/// ```ts
/// import { connect, listen } from "std/net"
///
/// const listener = await listen(0)
/// const accepting = listener.accept()
/// const client = await connect(listener.addr.port)
/// const server = await accepting
/// println(server != null)   // true
/// server?.close()
/// client.close()
/// listener.close()
/// ```
class Listener {
  fd: int
  /// The address it listens on (with the port chosen when `listen` was given 0).
  public readonly addr: Addr
  accepting: bool = false
  /// The accept in flight, which another `accept` waits for (#65).
  current: Promise<Conn?, NetError>? = null
  closed: bool = false
  released: bool = false

  /// A listener on descriptor `fd`; made by `listen`, not by programs.
  ///
  /// @example
  /// ```ts
  /// import { listen } from "std/net"
  ///
  /// // Listeners come from `listen` (and `listenUnix`).
  /// const listener: Listener = await listen(0)
  /// println(listener.addr.hostname)   // 127.0.0.1
  /// listener.close()
  /// ```
  constructor(fd: int, addr: Addr) {
    this.fd = fd
    this.addr = addr
  }

  release(): void {
    if (closed && !accepting && !released) {
      released = true
      __io(121, fd, 0, 0, "", "");
      if (addr.port < 0) {
        // A Unix-domain socket's file goes with it, as in Node.js.
        __ioSubmit(7, 0, 0, 0, addr.hostname, "", (_job: int) => {})
      }
    }
  }

  /// The next connection, or `null` once the listener is closed. Several calls at once each get
  /// a connection (#65: a call made while another waits accepts after it).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.accept()
  /// const client = await connect(listener.addr.port)
  /// const conn = await accepting
  /// println(conn?.remoteAddr.port == client.localAddr.port)   // true
  /// conn?.close()
  /// client.close()
  /// listener.close()
  /// println(await listener.accept())   // null (closed)
  /// ```
  public accept(): Promise<Conn?, NetError> {
    if (closed) {
      return __netResolved<Conn?>(null)
    }
    const busy = current
    if (accepting && busy != null) {
      const after = __acceptAfter(this, busy)
      current = after
      return after
    }
    accepting = true
    const job = __netJob<Conn?>(31, fd, 0, 0, "", "", __netShow(addr.hostname, addr.port), (res: __NetResult) => {
      this.accepting = false
      if (this.closed) {
        // (The connection that woke it up.)
        __io(121, res.r, 0, 0, "", "");
        this.release()
        return null
      }
      if (this.addr.port < 0) {
        return new Conn(res.r, this.addr, this.addr)
      }
      const f = __io_text(res.job).split(" ")
      new Conn(res.r, __netAddr(f, 0), __netAddr(f, 2))
    }, () => {
      this.accepting = false
      this.release()
    })
    current = job
    return job
  }

  /// `for await` accepts connections until the listener is closed.
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const accepting = listener.next()
  /// const client = await connect(listener.addr.port)
  /// const conn = await accepting
  /// println(conn != null)   // true
  /// conn?.close()
  /// client.close()
  /// listener.close()
  /// ```
  public next(): Promise<Conn?, NetError> {
    accept()
  }

  /// The listener itself (`for await (const conn of listener)`).
  ///
  /// @example
  /// ```ts
  /// import { connect, listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const client = await connect(listener.addr.port)
  /// await client.writeText("hello")
  /// client.close()
  /// for await (const conn of listener) {
  ///   println(await conn.text())   // hello
  ///   conn.close()
  ///   listener.close()             // ends the loop
  /// }
  /// ```
  public asyncIterator(): Listener {
    this
  }

  /// Stops listening: a waiting `accept()` gives `null` (twice is fine). Open connections
  /// stay open.
  ///
  /// @example
  /// ```ts
  /// import { listen } from "std/net"
  ///
  /// const listener = await listen(0)
  /// const waiting = listener.accept()
  /// listener.close()
  /// println(await waiting)   // null
  /// ```
  public close(): void {
    if (closed) {
      return
    }
    closed = true
    if (accepting) {
      // Wakes the accept up with a connection of our own.
      const unix = addr.port < 0
      __ioSubmit(32, addr.port, 0, if (unix) 1 else 0, if (unix) addr.hostname else __netReach(addr), "", (job: int) => {
        const r = __io(102, job, 0, 0, "", "")
        if (r >= 0) {
          __io(121, r, 0, 0, "", "");
        }
      })
    } else {
      release()
    }
  }
}

/// Listens for TCP connections on `hostname` (`"0.0.0.0"` or `"::"` for every interface) and
/// `port` (0 picks a free one; see `addr`).
///
/// @example
/// ```ts
/// import { listen } from "std/net"
///
/// const listener = await listen(0, "127.0.0.1")
/// println(listener.addr.port > 0)   // true
/// listener.close()
/// ```
function __netListen(port: int = 0, hostname: string = "127.0.0.1"): Promise<Listener, NetError> {
  __netJob<Listener>(30, port, 0, 0, hostname, "", __netShow(hostname, port), (res: __NetResult) => {
    const f = __io_text(res.job).split(" ")
    new Listener(res.r, __netAddr(f, 0))
  })
}

/// Connects to `hostname` (a name or an IP address) and `port` over TCP.
///
/// @example
/// ```ts
/// import { connect, listen } from "std/net"
///
/// const listener = await listen(0)
/// const accepting = listener.accept()
/// const conn = await connect(listener.addr.port, "127.0.0.1")
/// println(conn.remoteAddr.hostname)   // 127.0.0.1
/// conn.close()
/// const server = await accepting
/// server?.close()
/// listener.close()
/// ```
function __netConnect(port: int, hostname: string = "127.0.0.1"): Promise<Conn, NetError> {
  __netJob<Conn>(32, port, 0, 0, hostname, "", __netShow(hostname, port), (res: __NetResult) => {
    const f = __io_text(res.job).split(" ")
    new Conn(res.r, __netAddr(f, 0), __netAddr(f, 2))
  })
}

/// Listens for connections on a Unix-domain socket at `path` (macOS, Linux and Windows 10 and
/// later; not WASI) (#85). The socket file must not exist yet (`AddrInUse`); closing the
/// listener removes it. `addr` is `{ hostname: path, port: -1 }`.
///
/// @example
/// ```ts
/// import { connectUnix, listenUnix } from "std/net"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), `pico-doc-${crypto.randomUUID()}.sock`)
/// const listener = await listenUnix(path)
/// println(listener.addr.port)   // -1
/// const accepting = listener.accept()
/// const client = await connectUnix(path)
/// await client.writeText("over a socket file")
/// client.close()
/// const server = await accepting
/// if (server != null) {
///   println(await server.text())   // over a socket file
///   server.close()
/// }
/// listener.close()                // removes the socket file
/// ```
function __netListenUnix(path: string): Promise<Listener, NetError> {
  __netJob<Listener>(30, 0, 0, 1, path, "", path, (res: __NetResult) => {
    new Listener(res.r, { hostname: path, port: -1 })
  })
}

/// Connects to the Unix-domain socket at `path` (#85).
///
/// @example
/// ```ts
/// import { connectUnix, listenUnix } from "std/net"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), `pico-doc-${crypto.randomUUID()}.sock`)
/// const listener = await listenUnix(path)
/// const accepting = listener.accept()
/// const conn = await connectUnix(path)
/// println(conn.remoteAddr.hostname == path)   // true
/// conn.close()
/// const server = await accepting
/// server?.close()
/// listener.close()
/// ```
function __netConnectUnix(path: string): Promise<Conn, NetError> {
  __netJob<Conn>(32, 0, 0, 1, path, "", path, (res: __NetResult) => {
    const a: Addr = { hostname: path, port: -1 }
    new Conn(res.r, a, a)
  })
}

/// A received datagram and where it came from.
///
/// @example
/// ```ts
/// import { bind } from "std/net"
///
/// const a = await bind(0)
/// const b = await bind(0)
/// await a.sendText("hi", b.addr.port)
/// const d: Datagram? = await b.receive()
/// if (d != null) {
///   println(new TextDecoder().decode(d.data))   // hi
///   println(d.addr.port == a.addr.port)         // true
/// }
/// a.close()
/// b.close()
/// ```
struct Datagram {
  /// The datagram's bytes (cut to the size `receive` asked for).
  data: Uint8Array
  /// The address it came from.
  addr: Addr
}

/// A UDP socket: `send` datagrams anywhere, `receive` them one at a time.
///
/// @example
/// ```ts
/// import { bind } from "std/net"
///
/// const server = await bind(0)
/// const client = await bind(0)
/// await client.sendText("ping", server.addr.port)
/// const d = await server.receive()
/// if (d != null) {
///   await server.sendText("pong", d.addr.port, d.addr.hostname)
/// }
/// const reply = await client.receive()
/// if (reply != null) {
///   println(new TextDecoder().decode(reply.data))   // pong
/// }
/// server.close()
/// client.close()
/// ```
class UdpSocket {
  fd: int
  /// The address it's bound to (with the port chosen when `bind` was given 0).
  public readonly addr: Addr
  receiving: bool = false
  sending: int = 0
  closed: bool = false
  released: bool = false

  /// A socket on descriptor `fd`; made by `bind`, not by programs.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// // UDP sockets come from `bind`.
  /// const socket: UdpSocket = await bind(0, "127.0.0.1")
  /// println(socket.addr.hostname)   // 127.0.0.1
  /// socket.close()
  /// ```
  constructor(fd: int, addr: Addr) {
    this.fd = fd
    this.addr = addr
  }

  /// Sets socket option `which` (`pico_io` op 170, #214); throws what the system says.
  option(which: int, value: int, group: string, iface: string, about: string): void throws NetError {
    if (closed) {
      panic(`the socket on ${__netShow(addr.hostname, addr.port)} is closed`)
    }
    const r = __io(170, fd, which, value, group, iface)
    if (r < 0) {
      throw __netError(about, -((-r) & 255), (-r) >> 8)
    }
  }

  /// Joins multicast group `group` (an IPv4 or IPv6 address): datagrams sent to it arrive here
  /// too. `interfaceAddress` picks the interface (its IPv4 address, or for IPv6 its name);
  /// `""` lets the system choose. Bind to `"0.0.0.0"` (or `"::"`) and the group's port.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0, "0.0.0.0", { reuseAddress: true })
  /// socket.addMembership("239.255.0.1")
  /// socket.dropMembership("239.255.0.1")
  /// socket.close()
  /// ```
  public addMembership(group: string, interfaceAddress: string = ""): void throws NetError {
    option(1, 0, group, interfaceAddress, group)
  }

  /// Leaves multicast group `group` (joined with `addMembership`).
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0, "0.0.0.0")
  /// socket.addMembership("239.255.0.1")
  /// socket.dropMembership("239.255.0.1")
  /// socket.close()
  /// ```
  public dropMembership(group: string, interfaceAddress: string = ""): void throws NetError {
    option(2, 0, group, interfaceAddress, group)
  }

  /// How many hops the multicast datagrams it sends may take (1 by default: this network only;
  /// mDNS uses 255).
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0, "0.0.0.0")
  /// socket.setMulticastTTL(255)
  /// socket.close()
  /// ```
  public setMulticastTTL(ttl: int): void throws NetError {
    option(3, ttl, "", "", __netShow(addr.hostname, addr.port))
  }

  /// Whether the multicast datagrams it sends come back to this machine's sockets too (on by
  /// default).
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0, "0.0.0.0")
  /// socket.setMulticastLoopback(false)
  /// socket.close()
  /// ```
  public setMulticastLoopback(on: bool): void throws NetError {
    option(4, if (on) 1 else 0, "", "", __netShow(addr.hostname, addr.port))
  }

  /// The interface its multicast datagrams go out on: its IPv4 address (for an IPv6 socket, its
  /// name). See `networkInterfaces`.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0, "0.0.0.0")
  /// socket.setMulticastInterface("127.0.0.1")
  /// socket.close()
  /// ```
  public setMulticastInterface(interfaceAddress: string): void throws NetError {
    option(5, 0, "", interfaceAddress, interfaceAddress)
  }

  release(): void {
    if (closed && !receiving && sending == 0 && !released) {
      released = true
      __io(121, fd, 0, 0, "", "");
    }
  }

  sendJob(handle: int, count: int, text: string, port: int, hostname: string): Promise<int, NetError> {
    if (closed) {
      panic(`the socket on ${__netShow(addr.hostname, addr.port)} is closed`)
    }
    sending += 1
    __netJob<int>(34, fd, handle, count, `${port} ${hostname}`, text, __netShow(hostname, port),
      (res: __NetResult) => {
        this.sending -= 1
        this.release()
        return res.r
      }, () => {
        this.sending -= 1
        this.release()
      })
  }

  /// Sends `data` as one datagram to `hostname` and `port`; the count of bytes sent.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const a = await bind(0)
  /// const b = await bind(0)
  /// println(await a.send(Uint8Array.from([0xCA, 0xFE]), b.addr.port))   // 2
  /// const d = await b.receive()
  /// println(d?.data.length)   // 2
  /// a.close()
  /// b.close()
  /// ```
  public send(data: Uint8Array, port: int, hostname: string = "127.0.0.1"): Promise<int, NetError> {
    sendJob(__netBytesOf(data).__handle, data.length, "", port, hostname)
  }

  /// Sends `text` (as UTF-8) as one datagram.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const a = await bind(0)
  /// const b = await bind(0)
  /// println(await a.sendText("hello", b.addr.port, "127.0.0.1"))   // 5
  /// const d = await b.receive()
  /// println(d?.data.length)   // 5
  /// a.close()
  /// b.close()
  /// ```
  public sendText(text: string, port: int, hostname: string = "127.0.0.1"): Promise<int, NetError> {
    sendJob(0, -1, text, port, hostname)
  }

  /// The next datagram (at most `n` bytes of it; the rest is dropped), or `null` once the
  /// socket is closed. One at a time.
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const a = await bind(0)
  /// const b = await bind(0)
  /// await a.sendText("a long datagram", b.addr.port)
  /// const d = await b.receive(6)
  /// if (d != null) {
  ///   println(new TextDecoder().decode(d.data))   // a long (the rest is dropped)
  /// }
  /// a.close()
  /// b.close()
  /// ```
  public receive(n: int = 65536): Promise<Datagram?, NetError> {
    if (closed) {
      return __netResolved<Datagram?>(null)
    }
    if (receiving) {
      panic(`the socket on ${__netShow(addr.hostname, addr.port)} is already receiving`)
    }
    receiving = true
    __netJob<Datagram?>(33, fd, n, 0, "", "", __netShow(addr.hostname, addr.port), (res: __NetResult) => {
      this.receiving = false
      if (this.closed) {
        __buf_op(2, res.r, 0, 0);
        this.release()
        return null
      }
      const f = __io_text(res.job).split(" ")
      const d: Datagram = { data: __netBytes(res), addr: __netAddr(f, 0) }
      return d
    }, () => {
      this.receiving = false
      this.release()
    })
  }

  /// Closes the socket: a waiting `receive()` gives `null` (twice is fine).
  ///
  /// @example
  /// ```ts
  /// import { bind } from "std/net"
  ///
  /// const socket = await bind(0)
  /// const waiting = socket.receive()
  /// socket.close()
  /// println((await waiting) == null)   // true
  /// ```
  public close(): void {
    if (closed) {
      return
    }
    if (receiving) {
      // Wakes the receive up with a datagram of our own.
      sendJob(0, -1, "", addr.port, __netReach(addr))
    }
    closed = true
    release()
  }
}

/// Options of `bind` (#214).
///
/// @example
/// ```ts
/// import { bind } from "std/net"
///
/// // mDNS listens on port 5353, which the system's responder may already have.
/// const options: BindOptions = { reuseAddress: true }
/// const socket = await bind(0, "0.0.0.0", options)
/// socket.close()
/// ```
struct BindOptions {
  /// Lets other sockets bind the same address and port (`SO_REUSEADDR`, and `SO_REUSEPORT`
  /// where there is one), so several programs can receive one multicast group's datagrams.
  reuseAddress?: bool
}

/// One address of a network interface (`networkInterfaces`).
///
/// @example
/// ```ts
/// import { networkInterfaces } from "std/net"
///
/// for (const i of networkInterfaces()) {
///   if (i.loopback && i.family == 4) println(i.address)   // 127.0.0.1
/// }
/// ```
struct NetworkInterface {
  /// The interface's name (`lo`, `eth0`, `en0`, `Ethernet`, …).
  name: string
  /// 4 or 6.
  family: int
  /// The address, as text.
  address: string
  /// Whether it's up.
  up: bool
  /// Whether it's the loopback interface.
  loopback: bool
  /// Whether it can send and receive multicast.
  multicast: bool
}

/// The machine's network interfaces, one entry per address (an interface with an IPv4 and an
/// IPv6 address has two). Empty where the platform can't tell (WASI, the browser).
///
/// @example
/// ```ts
/// import { networkInterfaces } from "std/net"
///
/// const loopback = networkInterfaces().filter((i) => i.loopback && i.family == 4)
/// println(loopback.length > 0)   // true
/// ```
function __netInterfaces(): NetworkInterface[] {
  const job = __io(171, 0, 0, 0, "", "")
  const text = __io_text(job)
  __io(104, job, 0, 0, "", "");
  const out: NetworkInterface[] = []
  for (const line of text.split("\n")) {
    const f = line.split("\t")
    if (f.length < 4) {
      continue
    }
    out.push({
      name: f[0],
      family: int.parse(f[1]) ?? 4,
      address: f[2],
      up: f[3].includes("u"),
      loopback: f[3].includes("l"),
      multicast: f[3].includes("m"),
    })
  }
  return out
}

/// A UDP socket on `hostname` and `port` (0 picks a free one; see `addr`). `options`: see
/// `BindOptions` (sharing the port, for multicast).
///
/// @example
/// ```ts
/// import { bind } from "std/net"
///
/// const socket = await bind(0, "127.0.0.1")
/// println(socket.addr.port > 0)   // true
/// socket.close()
/// ```
function __netBind(port: int = 0, hostname: string = "127.0.0.1", options: BindOptions? = null): Promise<UdpSocket, NetError> {
  const reuse = options != null && options.reuseAddress == true
  __netJob<UdpSocket>(30, port, if (reuse) 2 else 1, 0, hostname, "", __netShow(hostname, port), (res: __NetResult) => {
    const f = __io_text(res.job).split(" ")
    new UdpSocket(res.r, __netAddr(f, 0))
  })
}

/// The IP addresses of `hostname` (in the order the system gives them, without repeats).
///
/// @example
/// ```ts
/// import { resolve } from "std/net"
///
/// println((await resolve("127.0.0.1")).join(", "))      // 127.0.0.1
/// const local = await resolve("localhost")
/// println(local.length > 0)                            // true (e.g. 127.0.0.1 and ::1)
/// ```
function __netResolve(hostname: string): Promise<string[], NetError> {
  __netJob<string[]>(35, 0, 0, 0, hostname, "", hostname, (res: __NetResult) => {
    const out: string[] = []
    for (const part of __io_text(res.job).split("\u{0}")) {
      if (part.length > 0) {
        out.push(part)
      }
    }
    return out
  })
}
