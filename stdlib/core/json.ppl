// JSON (spec §11.4). `JSON.parse<T>` and `JSON.stringify` are generated by the compiler for
// each type (the calls of `__jsonRead` / `__jsonWrite` are replaced); the generated code uses
// the reader and writer below. After the first error the reader only returns placeholder
// values (and ends every array and object), so generated code needs no error paths: `parse`
// throws once the value is done.

/// What `JSON.parse` throws: the place in the value and what was wrong
/// (`field 'port': expected u16, got "x"`), or where the text isn't JSON.
class JsonError extends Error {
  constructor(message: string) { super(message) }
}

/// `JSON.parse<T>(text)` and `JSON.stringify(value)`.
class JSON {
  /// The `T` that `text` holds. Struct and class fields are matched by name (or by
  /// `@json.name`); unknown keys are skipped; a missing field is an error unless it's
  /// nullable (then it's `null`).
  public static parse<T>(text: string): T throws JsonError {
    const r = new __JsonReader(text)
    const v = __jsonRead<T>(r)
    r.finish()
    if (r.failed) {
      throw new JsonError(r.message)
    }
    v
  }

  /// `value` as JSON text (no spaces). `NaN` and infinities become `null`.
  public static stringify<T>(value: T): string {
    const w = new __JsonWriter()
    __jsonWrite<T>(w, value)
    w.text()
  }
}

function __jsonRead<T>(r: __JsonReader): T { panic("JSON reader wasn't generated") }
function __jsonWrite<T>(w: __JsonWriter, value: T): void { panic("JSON writer wasn't generated") }

/// Reads JSON text for generated parsers. Character codes; `-1` is the end of the text.
class __JsonReader {
  text: string
  pos: int = 0
  len: int
  public failed: bool = false
  public message: string = ""
  /// Where the value being read is: field names and `[i]` indices.
  path: string[] = []
  /// For each open array or object: whether no element has been read yet.
  firsts: bool[] = []

  constructor(text: string) {
    this.text = text
    this.len = text.length
  }

  code(i: int): int { if (i < len) (text[i] as u32) as int else -1 }

  /// Whether `lit` comes next.
  has(lit: string): bool { pos + lit.length <= len && __matchesAt(text, lit, pos) }

  ws() {
    while (pos < len) {
      const c = code(pos)
      if (c == 32 || c == 9 || c == 10 || c == 13) {
        pos += 1
      } else {
        return
      }
    }
  }

  location(): string {
    let line = 1
    let col = 1
    let i = 0
    while (i < pos && i < len) {
      if (code(i) == 10) {
        line += 1
        col = 1
      } else {
        col += 1
      }
      i += 1
    }
    `${line}:${col}`
  }

  prefix(): string {
    if (path.length == 0) {
      return ""
    }
    let p = ""
    for (const part of path) {
      p = if (p == "" || part.startsWith("[")) p + part else `${p}.${part}`
    }
    if (path[0].startsWith("[")) `element '${p}': ` else `field '${p}': `
  }

  fail(msg: string) {
    if (!failed) {
      failed = true
      message = prefix() + msg
    }
  }

  /// The text isn't JSON.
  syntax(msg: string) {
    if (!failed) {
      failed = true
      message = `invalid JSON at ${location()}: ${msg}`
    }
  }

  /// The value at the current position, for messages: a string or number as written, or what
  /// kind of value it is.
  got(): string {
    const c = code(pos)
    if (c == -1) {
      return "the end of the text"
    }
    if (c == 123) {
      return "an object"
    }
    if (c == 91) {
      return "an array"
    }
    if (c == 34) {
      let i = pos + 1
      while (i < len && code(i) != 34) {
        i += if (code(i) == 92) 2 else 1
      }
      return text.slice(pos, i + 1)
    }
    let i = pos
    while (i < len) {
      const d = code(i)
      if (d == 44 || d == 125 || d == 93 || d == 32 || d == 10 || d == 13 || d == 9) {
        break
      }
      i += 1
    }
    text.slice(pos, i)
  }

  /// Not the expected kind of value.
  mismatch(expected: string) {
    if (!failed) {
      ws()
      fail(`expected ${expected}, got ${got()}`)
    }
  }

  public pushField(name: string) { path.push(name) }
  public pushIndex(i: int) { path.push(`[${i}]`) }
  public pop() { path.pop() }

  public missing(name: string) { fail(`missing field '${name}'`) }

  /// Whether the next value is `null` (consumed).
  public isNull(): bool {
    ws()
    if (!failed && has("null")) {
      pos += 4
      return true
    }
    false
  }

  public readBool(type: string): bool {
    ws()
    if (failed) {
      return false
    }
    if (has("true")) {
      pos += 4
      return true
    }
    if (has("false")) {
      pos += 5
      return false
    }
    mismatch(type)
    false
  }

  public readString(type: string): string {
    ws()
    if (failed) {
      return ""
    }
    if (code(pos) != 34) {
      mismatch(type)
      return ""
    }
    pos += 1
    const start = pos
    // The common case: no escapes.
    while (pos < len && code(pos) != 34 && code(pos) != 92 && code(pos) >= 32) {
      pos += 1
    }
    if (code(pos) == 34) {
      pos += 1
      return text.slice(start, pos - 1)
    }
    let out = text.slice(start, pos)
    while (true) {
      const c = code(pos)
      if (c == -1) {
        syntax("unterminated string")
        return ""
      }
      if (c == 34) {
        pos += 1
        return out
      }
      if (c < 32) {
        syntax("control character in a string")
        return ""
      }
      if (c != 92) {
        out = out + `${text[pos]}`
        pos += 1
        continue
      }
      const e = code(pos + 1)
      pos += 2
      if (e == 34) {
        out = out + "\""
      } else if (e == 92) {
        out = out + "\\"
      } else if (e == 47) {
        out = out + "/"
      } else if (e == 98) {
        out = out + "\u{8}"
      } else if (e == 102) {
        out = out + "\u{c}"
      } else if (e == 110) {
        out = out + "\n"
      } else if (e == 114) {
        out = out + "\r"
      } else if (e == 116) {
        out = out + "\t"
      } else if (e == 117) {
        let u = hex4()
        if (u >= 0xD800 && u < 0xDC00 && code(pos) == 92 && code(pos + 1) == 117) {
          pos += 2
          const lo = hex4()
          if (lo >= 0xDC00 && lo < 0xE000) {
            u = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
          } else {
            u = 0xFFFD
          }
        } else if (u >= 0xD800 && u < 0xE000) {
          u = 0xFFFD
        }
        if (u < 0) {
          return ""
        }
        out = out + `${(u as u32) as char}`
      } else {
        pos -= 2
        syntax("invalid escape in a string")
        return ""
      }
    }
    out
  }

  hex4(): int {
    let v = 0
    let k = 0
    while (k < 4) {
      const c = code(pos)
      const d = if (c >= 48 && c <= 57) c - 48
        else if (c >= 97 && c <= 102) c - 87
        else if (c >= 65 && c <= 70) c - 55
        else -1
      if (d < 0) {
        syntax("invalid \\u escape")
        return -1
      }
      v = v * 16 + d
      pos += 1
      k += 1
    }
    v
  }

  public readChar(type: string): char {
    const s = readString(type)
    if (failed) {
      return ' '
    }
    if (s.length != 1) {
      fail(`expected ${type}, got ${__jsonQuote(s)}`)
      return ' '
    }
    s[0]
  }

  /// A JSON number's text at the current position (consumed), or `null`.
  numberText(): string? {
    ws()
    const start = pos
    let i = pos
    if (code(i) == 45) {
      i += 1
    }
    const intStart = i
    while (code(i) >= 48 && code(i) <= 57) {
      i += 1
    }
    if (i == intStart || (code(intStart) == 48 && i > intStart + 1)) {
      return null
    }
    if (code(i) == 46) {
      i += 1
      const f = i
      while (code(i) >= 48 && code(i) <= 57) {
        i += 1
      }
      if (i == f) {
        return null
      }
    }
    if (code(i) == 101 || code(i) == 69) {
      i += 1
      if (code(i) == 43 || code(i) == 45) {
        i += 1
      }
      const e = i
      while (code(i) >= 48 && code(i) <= 57) {
        i += 1
      }
      if (i == e) {
        return null
      }
    }
    pos = i
    text.slice(start, i)
  }

  public readF64(type: string): f64 {
    if (failed) {
      return 0.0
    }
    const t = numberText()
    if (t == null) {
      mismatch(type)
      return 0.0
    }
    __parse_f64(t)
  }

  /// An integer whose magnitude is at most `negLimit` (negative) or `posLimit` (decimal
  /// digits, so `i64`'s limits fit).
  public readInt(type: string, negLimit: string, posLimit: string): i64 {
    if (failed) {
      return 0
    }
    ws()
    const at = pos
    const t = numberText()
    if (t == null) {
      mismatch(type)
      return 0
    }
    const negative = t.startsWith("-")
    const digits = if (negative) t.slice(1) else t
    const limit = if (negative) negLimit else posLimit
    let ok = !t.includes(".") && !t.includes("e") && !t.includes("E")
    if (ok && (digits.length > limit.length || (digits.length == limit.length && digits > limit))) {
      ok = false
    }
    if (!ok) {
      pos = at
      fail(`expected ${type}, got ${t}`)
      return 0
    }
    let v: i64 = 0
    for (const c of digits) {
      const d = ((c as u32) as int) - 48
      v = if (negative) v * 10 - d else v * 10 + d
    }
    v
  }

  public readU64(type: string): u64 {
    if (failed) {
      return 0u64
    }
    ws()
    const t = numberText()
    if (t == null) {
      mismatch(type)
      return 0u64
    }
    const limit = "18446744073709551615"
    if (t.startsWith("-") || t.includes(".") || t.includes("e") || t.includes("E")
      || t.length > limit.length || (t.length == limit.length && t > limit)) {
      fail(`expected ${type}, got ${t}`)
      return 0u64
    }
    let v: u64 = 0u64
    for (const c of t) {
      v = v * 10u64 + (((c as u32) - 48u32) as u64)
    }
    v
  }

  /// Starts reading an array (`false` if it isn't one).
  public beginArray(type: string): bool {
    ws()
    if (failed) {
      return false
    }
    if (code(pos) != 91) {
      mismatch(type)
      return false
    }
    pos += 1
    firsts.push(true)
    true
  }

  /// Whether the open array has another element (moving to it).
  public more(): bool {
    ws()
    if (failed || firsts.length == 0) {
      return false
    }
    if (code(pos) == 93) {
      pos += 1
      firsts.pop()
      return false
    }
    if (firsts[firsts.length - 1]) {
      firsts[firsts.length - 1] = false
    } else if (code(pos) == 44) {
      pos += 1
    } else {
      syntax("expected ',' or ']'")
      return false
    }
    true
  }

  /// Starts reading an object (`false` if it isn't one).
  public beginObject(type: string): bool {
    ws()
    if (failed) {
      return false
    }
    if (code(pos) != 123) {
      mismatch(type)
      return false
    }
    pos += 1
    firsts.push(true)
    true
  }

  /// The open object's next key (its value comes next), or `null` at its end.
  public nextKey(): string? {
    ws()
    if (failed || firsts.length == 0) {
      return null
    }
    if (code(pos) == 125) {
      pos += 1
      firsts.pop()
      return null
    }
    if (firsts[firsts.length - 1]) {
      firsts[firsts.length - 1] = false
    } else if (code(pos) == 44) {
      pos += 1
      ws()
    } else {
      syntax("expected ',' or '}'")
      return null
    }
    if (code(pos) != 34) {
      syntax("expected a key (a string)")
      return null
    }
    const key = readString("a key")
    ws()
    if (code(pos) != 58) {
      syntax("expected ':'")
      return null
    }
    pos += 1
    key
  }

  /// Skips any value (checking that it's JSON).
  public skipValue(): void {
    ws()
    if (failed) {
      return
    }
    const c = code(pos)
    if (c == 34) {
      const _ = readString("a string")
    } else if (c == 123) {
      beginObject("an object")
      while (nextKey() != null) {
        skipValue()
      }
    } else if (c == 91) {
      beginArray("an array")
      while (more()) {
        skipValue()
      }
    } else if (has("true")) {
      pos += 4
    } else if (has("false")) {
      pos += 5
    } else if (has("null")) {
      pos += 4
    } else if (numberText() == null) {
      syntax(if (c == -1) "unexpected end of the text" else `unexpected ${got()}`)
    }
  }

  /// After the value: only whitespace may follow.
  public finish() {
    ws()
    if (!failed && pos < len) {
      syntax("unexpected text after the value")
    }
  }
}

/// Builds JSON text for generated writers.
class __JsonWriter {
  parts: string[] = []
  public raw(s: string) { parts.push(s) }
  public str(s: string) { parts.push(__jsonQuote(s)) }
  public num(x: f64) { parts.push(if (x - x != 0.0) "null" else `${x}`) }
  public text(): string { parts.join("") }
}

/// `s` as a JSON string literal.
function __jsonQuote(s: string): string {
  let out = "\""
  for (const c of s) {
    const n = c as u32
    out = out + (if (n == 34u32) "\\\""
      else if (n == 92u32) "\\\\"
      else if (n == 10u32) "\\n"
      else if (n == 13u32) "\\r"
      else if (n == 9u32) "\\t"
      else if (n < 32u32) `\\u${n:04x}`
      else `${c}`)
  }
  out + "\""
}
