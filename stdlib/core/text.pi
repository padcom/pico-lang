// `TextEncoder` and `TextDecoder` (WHATWG Encoding, UTF-8 only), spec §13.1. Strings are
// UTF-8 already, so encoding copies their bytes and decoding checks (or repairs) them; both
// are runtime operations (`__io` 130 and 131).

/// Turns strings into their UTF-8 bytes.
///
/// @example
/// ```ts
/// const bytes = new TextEncoder().encode("hé")
/// println(bytes.length)   // 3
/// ```
class TextEncoder {
  /// Always `"utf-8"`, the only encoding.
  public readonly encoding: string = "utf-8"

  /// A UTF-8 encoder.
  ///
  /// @example
  /// ```ts
  /// const encoder = new TextEncoder()
  /// println(encoder.encoding)   // utf-8
  /// ```
  constructor() {}

  /// The UTF-8 bytes of `input`.
  ///
  /// @example
  /// ```ts
  /// const bytes = new TextEncoder().encode("€")
  /// println(`${bytes.get(0)} ${bytes.get(1)} ${bytes.get(2)}`)   // 226 130 172
  /// ```
  public encode(input: string = ""): Uint8Array {
    const job = __io(130, 0, 0, 0, input, "")
    const h = __io(102, job, 0, 0, "", "")
    const n = __io(103, job, 0, 0, "", "")
    __io(104, job, 0, 0, "", "");
    new Uint8Array(new ArrayBuffer(h, n, true), 0, n)
  }
}

/// `TextDecoder` options: `fatal` makes bytes that aren't UTF-8 throw a `TypeError` (else
/// each bad sequence becomes U+FFFD); `ignoreBOM` keeps a leading byte-order mark.
///
/// @example
/// ```ts
/// const strict = new TextDecoder("utf-8", { fatal: true })
/// println(strict.fatal)   // true
/// ```
struct TextDecoderOptions {
  /// Whether bytes that aren't UTF-8 throw a `TypeError` (default `false`: each bad sequence
  /// becomes U+FFFD).
  fatal?: bool
  /// Whether a leading byte-order mark is kept in the text (default `false`: it's dropped).
  ignoreBOM?: bool
}

/// `decode` options: with `stream`, an incomplete sequence at the end waits for the next call.
///
/// @example
/// ```ts
/// const decoder = new TextDecoder()
/// const euro = Uint8Array.from([0xE2, 0x82, 0xAC])
/// print(decoder.decode(euro.subarray(0, 2), { stream: true }))   // (nothing yet)
/// println(decoder.decode(euro.subarray(2)))                       // €
/// ```
struct TextDecodeOptions {
  /// Whether more bytes follow: an incomplete sequence at the end is held back for the next call
  /// (default `false`: the call ends the stream).
  stream?: bool
}

/// Turns UTF-8 (or, by label, UTF-16; #63) bytes into strings, also chunk by chunk
/// (`{ stream: true }`).
///
/// @example
/// ```ts
/// const bytes = new TextEncoder().encode("grüße")
/// println(new TextDecoder().decode(bytes))   // grüße
/// ```
class TextDecoder {
  /// `"utf-8"`, `"utf-16le"` or `"utf-16be"`.
  public readonly encoding: string
  /// Whether bytes that aren't UTF-8 throw a `TypeError` (else they become U+FFFD).
  public readonly fatal: bool
  /// Whether a leading byte-order mark is kept in the text.
  public readonly ignoreBOM: bool
  /// Bytes of an incomplete sequence from the last streamed chunk.
  pending: int[] = []
  /// Whether the next bytes start the stream (where a BOM is dropped).
  atStart: bool = true

  /// A UTF-8 decoder (replacing invalid bytes with U+FFFD, dropping a leading BOM).
  ///
  /// @example
  /// ```ts
  /// const decoder = new TextDecoder()
  /// println(decoder.decode(Uint8Array.from([104, 105, 0xFF])))   // hi�
  /// ```
  constructor() {
    this.encoding = "utf-8"
    this.fatal = false
    this.ignoreBOM = false
  }

  /// A decoder for `label`, matched case-insensitively, ignoring surrounding whitespace, as on
  /// the Web: `"utf-8"` (`"utf8"`, `"unicode-1-1-utf-8"`), `"utf-16le"` (`"utf-16"`, `"ucs-2"`,
  /// `"unicode"`, …) or `"utf-16be"` (`"unicodefffe"`); another label throws a `RangeError`.
  ///
  /// @example
  /// ```ts
  /// const decoder = new TextDecoder("UTF-8", { fatal: true })
  /// try {
  ///   println(decoder.decode(Uint8Array.from([0xFF])))
  /// } catch (e: TypeError) {
  ///   println(e.message)   // The encoded data was not valid utf-8 (at byte 0)
  /// }
  /// ```
  constructor(label: string, options: TextDecoderOptions = {}) throws RangeError {
    const l = label.trim().toLowerCase()
    this.encoding = match (l) {
      "utf-8" | "utf8" | "unicode-1-1-utf-8" | "unicode11utf8" | "unicode20utf8" | "x-unicode20utf8" => "utf-8",
      "utf-16le" | "utf-16" | "ucs-2" | "unicode" | "csunicode" | "iso-10646-ucs-2" | "unicodefeff" => "utf-16le",
      "utf-16be" | "unicodefffe" => "utf-16be",
      _ => throw new RangeError(`TextDecoder: unsupported encoding ${label} (utf-8, utf-16le or utf-16be)`),
    }
    this.fatal = options.fatal == true
    this.ignoreBOM = options.ignoreBOM == true
  }

  /// A UTF-8 decoder with `options` (`TextDecoder.utf8({ fatal: true })`): no label, so unlike
  /// `new TextDecoder(label, options)` it can't throw.
  ///
  /// @example
  /// ```ts
  /// const decoder = TextDecoder.utf8({ ignoreBOM: true })
  /// println(decoder.ignoreBOM)   // true
  /// ```
  public static utf8(options: TextDecoderOptions = {}): TextDecoder {
    return new TextDecoder(options.fatal == true, options.ignoreBOM == true, 0)
  }

  /// `TextDecoder.utf8`'s (the third argument only tells it apart).
  ///
  /// @example
  /// ```ts
  /// const decoder = TextDecoder.utf8()
  /// println(decoder.decode(Uint8Array.from([111, 107])))   // ok
  /// ```
  constructor(fatal: bool, ignoreBOM: bool, __unlabelled: int) {
    this.encoding = "utf-8"
    this.fatal = fatal
    this.ignoreBOM = ignoreBOM
  }

  /// The text of `input` (and of bytes held back from earlier streamed calls).
  ///
  /// @example
  /// ```ts
  /// const decoder = new TextDecoder()
  /// const bytes = new TextEncoder().encode("hello")
  /// println(decoder.decode(bytes))   // hello
  /// ```
  public decode(input: Uint8Array = new Uint8Array(0), options: TextDecodeOptions = {}): string throws TypeError {
    const stream = options.stream == true
    let bytes = input
    if (this.pending.length > 0) {
      const joined = new Uint8Array(this.pending.length + input.length)
      for (let i = 0; i < this.pending.length; i++) {
        joined.set(i, this.pending[i])
      }
      for (let i = 0; i < input.length; i++) {
        joined.set(this.pending.length + i, input.get(i))
      }
      this.pending = []
      bytes = joined
    }
    if (this.encoding != "utf-8") {
      return this.__decode16(bytes, stream, this.encoding == "utf-16be")
    }
    let end = bytes.length
    if (stream) {
      end = __utf8Complete(bytes)
      for (let i = end; i < bytes.length; i++) {
        this.pending.push(bytes.get(i))
      }
    }
    let start = 0
    if (this.atStart && !this.ignoreBOM && end >= 3 && bytes.get(0) == 0xEF && bytes.get(1) == 0xBB && bytes.get(2) == 0xBF) {
      start = 3
    }
    if (end > 0 || !stream) {
      this.atStart = stream && end == 0
    }
    if (!stream) {
      this.atStart = true
    }
    const view = bytes.subarray(start, end)
    const data = if (view.byteOffset == 0) view.buffer else view.buffer.slice(view.byteOffset, view.byteOffset + view.length)
    const job = __io(131, if (this.fatal) 1 else 0, data.__handle, view.length, "", "")
    const r = __io(102, job, 0, 0, "", "")
    const at = __io(103, job, 0, 0, "", "")
    const text = __io_text(job)
    __io(104, job, 0, 0, "", "");
    if (r < 0) {
      this.pending = []
      throw new TypeError(`The encoded data was not valid utf-8 (at byte ${start + at})`)
    }
    return text
  }

  /// UTF-16 `bytes` (big-endian when `be`) as text: surrogate pairs joined, a lone surrogate or
  /// an odd last byte U+FFFD (a `TypeError` when `fatal`); with `stream`, an odd byte or a high
  /// surrogate at the end waits for the next call.
  __decode16(bytes: Uint8Array, stream: bool, be: bool): string throws TypeError {
    let n = bytes.length
    if (stream) {
      // (Whole code units only, and not a high surrogate at the end.)
      n -= n % 2
      if (n >= 2) {
        const last = if (be) (bytes.get(n - 2) << 8) | bytes.get(n - 1) else (bytes.get(n - 1) << 8) | bytes.get(n - 2)
        if (last >= 0xD800 && last <= 0xDBFF) n -= 2
      }
      for (let i = n; i < bytes.length; i++) {
        this.pending.push(bytes.get(i))
      }
    }
    let i = 0
    if (this.atStart && !this.ignoreBOM && n >= 2) {
      const bom = if (be) (bytes.get(0) << 8) | bytes.get(1) else (bytes.get(1) << 8) | bytes.get(0)
      if (bom == 0xFEFF) i = 2
    }
    if (n > 0 || !stream) this.atStart = stream && n == 0
    if (!stream) this.atStart = true
    const unit = (at: int): int => if (be) (bytes.get(at) << 8) | bytes.get(at + 1) else (bytes.get(at + 1) << 8) | bytes.get(at)
    const out: int[] = []
    while (i < n) {
      if (i + 1 >= n) {
        // An odd last byte (only without `stream`).
        if (this.fatal) {
          this.pending = []
          throw new TypeError(`The encoded data was not valid ${this.encoding} (at byte ${i})`)
        }
        __utf8Push(out, 0xFFFD)
        i += 1
        continue
      }
      const u = unit(i)
      if (u >= 0xD800 && u <= 0xDBFF && i + 3 < n) {
        const v = unit(i + 2)
        if (v >= 0xDC00 && v <= 0xDFFF) {
          __utf8Push(out, 0x10000 + ((u - 0xD800) << 10) + (v - 0xDC00))
          i += 4
          continue
        }
      }
      if (u >= 0xD800 && u <= 0xDFFF) {
        if (this.fatal) {
          this.pending = []
          throw new TypeError(`The encoded data was not valid ${this.encoding} (at byte ${i})`)
        }
        __utf8Push(out, 0xFFFD)
      } else {
        __utf8Push(out, u)
      }
      i += 2
    }
    return __string_fromUtf8(Uint8Array.from(out))
  }
}

/// Appends code point `c` to `out` as UTF-8.
function __utf8Push(out: int[], c: int): void {
  if (c < 0x80) {
    out.push(c)
  } else if (c < 0x800) {
    out.push(0xC0 | (c >> 6))
    out.push(0x80 | (c & 0x3F))
  } else if (c < 0x10000) {
    out.push(0xE0 | (c >> 12))
    out.push(0x80 | ((c >> 6) & 0x3F))
    out.push(0x80 | (c & 0x3F))
  } else {
    out.push(0xF0 | (c >> 18))
    out.push(0x80 | ((c >> 12) & 0x3F))
    out.push(0x80 | ((c >> 6) & 0x3F))
    out.push(0x80 | (c & 0x3F))
  }
}

/// Where the last complete UTF-8 sequence of `b` ends (a trailing lead byte and its
/// continuation bytes, if fewer than the lead asks for, are left out).
function __utf8Complete(b: Uint8Array): int {
  const n = b.length
  let i = n - 1
  let back = 0
  while (i >= 0 && back < 3 && (b.get(i) & 0xC0) == 0x80) {
    i -= 1
    back += 1
  }
  if (i < 0) {
    return n
  }
  const lead = b.get(i)
  const need = if (lead >= 0xF0 && lead <= 0xF4) 4 else if (lead >= 0xE0) 3 else if (lead >= 0xC2 && lead < 0xE0) 2 else 1
  if (need > 1 && n - i < need) i else n
}
