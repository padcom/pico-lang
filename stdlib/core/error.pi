// The root of thrown errors (spec §7.1).
/// The root of thrown errors: a message and, optionally, the error that caused it. Subclass it for
/// errors of your own (`class ParseError extends Error`); functions declare what they throw
/// (`throws ParseError`), and callers handle it with `try`/`catch` or declare it in turn.
class Error {
  /// What went wrong, for people.
  public message: string
  /// The error this one wraps, if any (`new Error("can't load config", e)`).
  public cause: Error? = null
  /// An error with `message`.
  constructor(message: string) { this.message = message }
  /// An error with `message`, caused by `cause`.
  constructor(message: string, cause: Error?) {
    this(message)
    this.cause = cause
  }
}

/// A value of the wrong type or shape, as JavaScript's (`TextDecoder` with `fatal` throws it
/// for bytes that aren't UTF-8).
class TypeError extends Error {
  /// A `TypeError` with `message`.
  constructor(message: string) { super(message) }
}

/// A value outside the allowed range, as JavaScript's.
class RangeError extends Error {
  /// A `RangeError` with `message`.
  constructor(message: string) { super(message) }
}

/// A failed file-system operation (`std/fs`): the path and what went wrong. `kind` is
/// `"NotFound"`, `"AlreadyExists"`, `"PermissionDenied"`, `"NotADirectory"`, `"IsADirectory"`,
/// `"DirectoryNotEmpty"`, `"InvalidData"` (text that isn't UTF-8) or `"Other"`.
class IoError extends Error {
  /// The path the operation was on.
  public path: string
  /// What went wrong, as one of the kinds above (`"Other"` unless given).
  public kind: string = "Other"
  /// An error of kind `"Other"` on `path`, with `message`.
  constructor(path: string, message: string) {
    super(message)
    this.path = path
  }
  /// An error of `kind` on `path`, with `message`.
  constructor(path: string, message: string, kind: string) {
    this(path, message)
    this.kind = kind
  }
}

/// A lightweight error (spec §7.1): a struct or enum that can be thrown without being an
/// `Error` (no stack trace). Enums can't have methods yet, so their message is their debug form.
interface Throwable {
  /// What went wrong, for people (what an uncaught throw prints).
  message(): string
}

/// Cleaned up by `using` at the end of its scope (spec §11.5).
interface Disposable {
  /// Releases what this value holds; `using` calls it once, when the scope ends (also when it's
  /// left by a throw).
  dispose(): void
}
