// `Formattable` (spec §1.4): types that format themselves in templates. `${x}` calls
// `x.format("")` and `${x:spec}` calls `x.format("spec")` with the spec's text unchecked
// (`std/fmt`'s `FormatSpec.parse` reads the standard grammar); `${x:?}` stays the debug form.

/// Types that format themselves in templates (spec §1.4): `${x}` calls `x.format("")` and
/// `${x:spec}` calls `x.format("spec")` (`${x:?}` stays the debug form). `std/fmt`'s
/// `FormatSpec.parse` reads the standard spec grammar (`>8`, `.2`, `x`).
///
/// @example
/// ```ts
/// class Money implements Formattable {
///   cents: int
///   constructor(cents: int) { this.cents = cents }
///   public format(spec: string): string {
///     const s = `${this.cents / 100}.${`${this.cents % 100}`.padStart(2, "0")}`
///     if (spec == "usd") `$${s}` else s
///   }
/// }
///
/// const price = new Money(1999)
/// println(`${price}`)       // 19.99
/// println(`${price:usd}`)   // $19.99
/// ```
interface Formattable {
  /// The value formatted as `spec` says (the text after the `:` in `${x:spec}`; empty for `${x}`).
  ///
  /// @example
  /// ```ts
  /// class Celsius implements Formattable {
  ///   degrees: f64
  ///   constructor(degrees: f64) { this.degrees = degrees }
  ///   public format(spec: string): string {
  ///     if (spec == "f") `${this.degrees * 9.0 / 5.0 + 32.0}°F` else `${this.degrees}°C`
  ///   }
  /// }
  ///
  /// const t = new Celsius(20.0)
  /// println(t.format(""))    // 20°C
  /// println(`${t:f}`)        // 68°F
  /// ```
  format(spec: string): string
}
