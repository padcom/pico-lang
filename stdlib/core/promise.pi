// Promises and async functions (spec §10.1, §7.4). `Promise<T, E>` settles once, with a `T`
// or an error; `E` is what awaiting it can throw (its async function's `throws`). Reactions
// run as microtasks, so the ordering is JavaScript's.
//
// `async function f(…): Promise<T> throws E { body }` becomes
// `function f(…): Promise<T, E> { const p = new Promise<T, E>(); p.__run(<step>); p }`, where
// the step function is a generator that runs `body` up to the next `await`: `await x` yields
// `x.__suspend()` (the driver resumes the step once `x` settles) and then reads `x.__get()`.

/// A value that arrives later (spec §10.1): settles once, with a `T` or an error. `E` is what
/// awaiting it can throw (an `async function`'s `throws`). `await p` waits for it inside an async
/// function (or at the top level); reactions run as microtasks, so the ordering is JavaScript's. An
/// `async function f(): Promise<T> throws E` returns a `Promise<T, E>`.
///
/// @example
/// ```ts
/// import { delay } from "std/timers"
///
/// async function fetchUser(id: int): Promise<string> throws AbortError {
///   await delay(10)
///   return `user ${id}`
/// }
///
/// const name = await fetchUser(7)
/// println(name)   // user 7
/// ```
class Promise<T, E extends Error = never> {
  /// 0: pending, 1: fulfilled, 2: rejected.
  state: int = 0
  /// The value once fulfilled (one element).
  values: T[] = []
  error: Error? = null
  /// Reactions waiting for it to settle.
  waiters: (() => void)[] = []
  /// Whether something awaits it or reacts to it (else a rejection ends the program).
  handled: bool = false

  /// A pending promise (what an async function settles).
  ///
  /// @example
  /// ```ts
  /// const p = new Promise<int>()
  /// println(p.settled)   // false
  /// ```
  constructor() {}

  /// `new Promise((resolve, reject) => …)`: `executor` runs right away and settles it.
  ///
  /// @example
  /// ```ts
  /// const p = new Promise<int>((resolve, reject) => {
  ///   setTimeout(() => resolve(42), 10)
  /// })
  /// println(await p)   // 42
  /// ```
  constructor(executor: (resolve: (value: T) => void, reject: (error: Error) => void) => void) {
    executor((v: T) => this.__resolve(v), (e: Error) => this.__reject(e))
  }

  public __resolve(v: T): void {
    if (this.state != 0) {
      return
    }
    this.values.push(v)
    this.state = 1
    this.wake()
  }

  public __reject(e: Error): void {
    if (this.state != 0) {
      return
    }
    this.error = e
    this.state = 2
    if (!this.handled) {
      __theLoop().rejected.push(() => if (this.handled) null else this.error)
    }
    this.wake()
  }

  wake(): void {
    const ws = this.waiters
    this.waiters = []
    for (const w of ws) {
      queueMicrotask(w)
    }
  }

  /// Runs `k` (as a microtask) once settled.
  public __onSettle(k: () => void): void {
    this.handled = true
    if (this.state == 0) {
      this.waiters.push(k)
    } else {
      queueMicrotask(k)
    }
  }

  /// An async function's result, kept until its body has finished (`finally` code, which
  /// may await, runs first; a later `return` replaces it).
  public __hold(v: T): void {
    if (this.state == 0) {
      this.values = [v]
    }
  }

  /// What `await` hands to the async function's driver.
  public __suspend(): (k: () => void) => void {
    (k: () => void) => this.__onSettle(k)
  }

  /// The value, or the error rethrown (after it settled).
  public __get(): T throws E {
    if (this.state == 2) {
      const e = this.error
      if (e != null) {
        __throw_unchecked(e)
      }
    }
    return this.values[0]
  }

  /// Runs an async function's step function until it finishes or awaits.
  public __run(step: () => ((k: () => void) => void)? throws E): void {
    let s: ((k: () => void) => void)? = null
    try {
      s = step()
    } catch (e) {
      this.__reject(e)
      return
    }
    if (s != null) {
      s(() => this.__run(step))
    } else if (this.state == 0 && this.values.length > 0) {
      this.state = 1
      this.wake()
    }
  }

  /// Whether it has settled (fulfilled or rejected).
  ///
  /// @example
  /// ```ts
  /// const p = Promise.resolve(1)
  /// println(p.settled)   // true
  /// println(new Promise<int>().settled)   // false
  /// ```
  public get settled(): bool {
    return this.state != 0
  }

  /// A promise of `f(value)`, settled after this one (rejected with its error).
  ///
  /// @example
  /// ```ts
  /// const doubled = Promise.resolve(21).then((n) => n * 2)
  /// println(await doubled)   // 42
  /// ```
  public then<U>(f: (value: T) => U): Promise<U, E> {
    const p = new Promise<U, E>()
    this.__onSettle(() => {
      const e = this.error
      if (this.state == 2 && e != null) {
        p.__reject(e)
      } else {
        p.__resolve(f(this.values[0]))
      }
    })
    return p
  }

  /// A promise of this one's value, or of `f(error)` when it rejects (so it doesn't reject):
  /// `load().catch((e) => fallback)` (#52).
  ///
  /// @example
  /// ```ts
  /// const p = Promise.reject<int>(new Error("offline"))
  /// const value = await p.catch((e) => {
  ///   println(e.message)   // offline
  ///   return 0
  /// })
  /// println(value)   // 0
  /// ```
  public catch(f: (error: Error) => T): Promise<T> {
    const p = new Promise<T>()
    this.__onSettle(() => {
      const e = this.error
      if (this.state == 2 && e != null) {
        p.__resolve(f(e))
      } else {
        p.__resolve(this.values[0])
      }
    })
    return p
  }

  /// A promise that settles like this one, after `f` ran (once it settled either way) (#52).
  ///
  /// @example
  /// ```ts
  /// const p = Promise.resolve("done").finally(() => println("cleaning up"))
  /// println(await p)   // cleaning up, then: done
  /// ```
  public finally(f: () => void): Promise<T, E> {
    const p = new Promise<T, E>()
    this.__onSettle(() => {
      f()
      const e = this.error
      if (this.state == 2 && e != null) {
        p.__reject(e)
      } else {
        p.__resolve(this.values[0])
      }
    })
    return p
  }

  /// A promise already fulfilled with `value`.
  ///
  /// @example
  /// ```ts
  /// const p = Promise.resolve("cached")
  /// println(await p)   // cached
  /// ```
  public static resolve<U>(value: U): Promise<U> {
    const p = new Promise<U>()
    p.__resolve(value)
    return p
  }

  /// A promise already rejected with `error`.
  ///
  /// @example
  /// ```ts
  /// const p = Promise.reject<int>(new Error("not found"))
  /// try {
  ///   println(await p)
  /// } catch (e: Error) {
  ///   println(e.message)   // not found
  /// }
  /// ```
  public static reject<U>(error: Error): Promise<U, Error> {
    const p = new Promise<U, Error>()
    p.__reject(error)
    return p
  }

  /// All the values, in order; rejected with the first error.
  ///
  /// @example
  /// ```ts
  /// import { delay } from "std/timers"
  ///
  /// async function square(n: int): Promise<int> throws AbortError {
  ///   await delay(n)
  ///   return n * n
  /// }
  ///
  /// const all = await Promise.all([square(3), square(1), square(2)])
  /// println(all.join(", "))   // 9, 1, 4
  /// ```
  public static all<U, F extends Error>(ps: Promise<U, F>[]): Promise<U[], F> {
    const out = new Promise<U[], F>()
    const slots: U[][] = []
    for (const _ of ps) {
      slots.push([])
    }
    let left = ps.length
    if (left == 0) {
      out.__resolve([])
    }
    for (let i = 0; i < ps.length; i++) {
      const p = ps[i]
      p.__onSettle(() => {
        const e = p.error
        if (p.state == 2 && e != null) {
          out.__reject(e)
          return
        }
        slots[i].push(p.values[0])
        left -= 1
        if (left == 0) {
          const vals: U[] = []
          for (const s of slots) {
            vals.push(s[0])
          }
          out.__resolve(vals)
        }
      })
    }
    return out
  }

  /// Settles like the first of `ps` to settle.
  ///
  /// @example
  /// ```ts
  /// import { delay } from "std/timers"
  ///
  /// async function after(ms: int, label: string): Promise<string> throws AbortError {
  ///   await delay(ms)
  ///   return label
  /// }
  ///
  /// println(await Promise.race([after(50, "slow"), after(5, "fast")]))   // fast
  /// ```
  public static race<U, F extends Error>(ps: Promise<U, F>[]): Promise<U, F> {
    const out = new Promise<U, F>()
    for (const p of ps) {
      p.__onSettle(() => {
        const e = p.error
        if (p.state == 2 && e != null) {
          out.__reject(e)
        } else {
          out.__resolve(p.values[0])
        }
      })
    }
    return out
  }

  /// A pending promise and the functions that settle it (ES2024), for code that settles it from
  /// outside an executor: `const r = Promise.withResolvers<int, Error>()`, then `r.resolve(1)`.
  ///
  /// @example
  /// ```ts
  /// const r = Promise.withResolvers<int, Error>()
  /// setTimeout(() => r.resolve(7), 10)
  /// println(await r.promise)   // 7
  /// ```
  public static withResolvers<U, F extends Error>(): PromiseWithResolvers<U, F> {
    new PromiseWithResolvers<U, F>(new Promise<U, F>())
  }

  /// Waits for all of `ps`, never rejecting: how each one ended.
  ///
  /// @example
  /// ```ts
  /// const results = await Promise.allSettled([Promise.resolve(1), Promise.reject<int>(new Error("boom"))])
  /// for (const r of results) {
  ///   println(r.status)   // fulfilled, then: rejected
  /// }
  /// println(results[1].reason!.message)   // boom
  /// ```
  public static allSettled<U, F extends Error>(ps: Promise<U, F>[]): Promise<Settled<U>[]> {
    const out = new Promise<Settled<U>[]>()
    const slots: Settled<U>[][] = []
    for (const _ of ps) {
      slots.push([])
    }
    let left = ps.length
    if (left == 0) {
      out.__resolve([])
    }
    for (let i = 0; i < ps.length; i++) {
      const p = ps[i]
      p.__onSettle(() => {
        const e = p.error
        if (p.state == 2 && e != null) {
          slots[i].push(Settled<U> { status: "rejected", value: null, reason: e })
        } else {
          slots[i].push(Settled<U> { status: "fulfilled", value: p.values[0], reason: null })
        }
        left -= 1
        if (left == 0) {
          const vals: Settled<U>[] = []
          for (const s of slots) {
            vals.push(s[0])
          }
          out.__resolve(vals)
        }
      })
    }
    return out
  }
}

/// What `Promise.withResolvers()` gives: the promise and the functions that settle it (the first
/// call of either wins).
///
/// @example
/// ```ts
/// const r = Promise.withResolvers<string, Error>()
/// r.resolve("ready")
/// println(await r.promise)   // ready
/// ```
class PromiseWithResolvers<T, E extends Error> {
  /// The pending promise.
  public readonly promise: Promise<T, E>

  /// @example
  /// ```ts
  /// const r = new PromiseWithResolvers<int, Error>(new Promise<int, Error>())
  /// r.resolve(5)
  /// println(await r.promise)   // 5
  /// ```
  constructor(promise: Promise<T, E>) {
    this.promise = promise
  }

  /// Fulfills the promise with `value`.
  ///
  /// @example
  /// ```ts
  /// const r = Promise.withResolvers<int, Error>()
  /// r.resolve(1)
  /// r.resolve(2)               // ignored: the first call wins
  /// println(await r.promise)   // 1
  /// ```
  public resolve(value: T): void {
    this.promise.__resolve(value)
  }

  /// Rejects the promise with `error`.
  ///
  /// @example
  /// ```ts
  /// const r = Promise.withResolvers<int, Error>()
  /// r.reject(new Error("cancelled"))
  /// try {
  ///   println(await r.promise)
  /// } catch (e: Error) {
  ///   println(e.message)   // cancelled
  /// }
  /// ```
  public reject(error: Error): void {
    this.promise.__reject(error)
  }
}

/// How a promise ended (`Promise.allSettled`): `status` is `"fulfilled"` (with `value`) or
/// `"rejected"` (with `reason`).
///
/// @example
/// ```ts
/// const [a, b] = await Promise.allSettled([Promise.resolve(10), Promise.reject<int>(new Error("bad"))])
/// println(`${a.status} ${a.value}`)            // fulfilled 10
/// println(`${b.status} ${b.reason!.message}`)  // rejected bad
/// ```
struct Settled<T> {
  /// `"fulfilled"` or `"rejected"`.
  status: string
  /// The value, if it was fulfilled (else `null`).
  value: T?
  /// The error, if it was rejected (else `null`).
  reason: Error?
}

/// `await p` at the top level of the entry module: runs the event loop until `p` settles
/// (and its reaction runs, as a microtask would), then gives its value or throws.
function __awaitTop<T, E extends Error>(p: Promise<T, E>): T throws E {
  let done = false
  p.__onSettle(() => {
    done = true
  })
  const l = __theLoop()
  // (In the browser this blocks the page until `p` settles: there's no suspending.)
  const outer = l.blocking
  l.blocking = true
  while (!done) {
    if (!l.step()) {
      panic("top-level `await` on a promise that never settles")
    }
    __finalizeAfterCollections()
  }
  l.blocking = outer
  p.__get()
}

/// A `void` value (an async function's result without `return`).
function __void(): void {}

/// An async iterator (spec §5.7): `next()` promises the next value, or `null` once done
/// (so, like `Iterator`, a `T` that is itself nullable can't be told apart from the end).
/// `async function* g(): AsyncIterator<T> throws E` makes one: its step function yields
/// suspensions, both for `await` and, after storing the value, for `yield v`.
///
/// @example
/// ```ts
/// async function* countdown(n: int): AsyncIterator<int> {
///   for (let i = n; i > 0; i--) {
///     yield i
///   }
/// }
///
/// for await (const i of countdown(3)) {
///   println(i)   // 3, 2, 1
/// }
/// ```
class AsyncIterator<T, E extends Error = never> {
  step: (() => ((k: () => void) => void)? throws E)? = null
  /// `next()` promises not fulfilled yet, oldest first.
  requests: Promise<T?, E>[] = []
  /// The value a `yield` just stored.
  values: T[] = []
  /// Continues the step after a `yield` (when the next value is asked for).
  parked: (() => void)? = null
  started: bool = false
  running: bool = false
  finished: bool = false

  /// An iterator with no steps (an `async function*` makes the ones that produce values).
  ///
  /// @example
  /// ```ts
  /// // `async function*` makes the iterators that produce values; this one is empty.
  /// const it = new AsyncIterator<int>()
  /// println(it.asyncIterator() == it)   // true
  /// ```
  constructor() {}

  public __start(step: () => ((k: () => void) => void)? throws E): void {
    this.step = step
  }

  public __put(v: T): void {
    this.values.push(v)
  }

  public __pause(): (k: () => void) => void {
    (k: () => void) => {
      this.parked = k
    }
  }

  /// Promises the next value, or `null` once done. The promise rejects with what the generator
  /// throws (and later calls give `null`). Calls made before earlier ones are fulfilled queue up,
  /// in order.
  ///
  /// @example
  /// ```ts
  /// async function* letters(): AsyncIterator<string> {
  ///   yield "a"
  ///   yield "b"
  /// }
  ///
  /// const it = letters()
  /// println(await it.next())   // a
  /// println(await it.next())   // b
  /// println(await it.next())   // null
  /// ```
  public next(): Promise<T?, E> {
    const p = new Promise<T?, E>()
    if (this.finished) {
      p.__resolve(null)
      return p
    }
    this.requests.push(p)
    if (!this.running) {
      this.resume()
    }
    return p
  }

  /// `for await` uses the iterator itself.
  ///
  /// @example
  /// ```ts
  /// async function* one(): AsyncIterator<int> {
  ///   yield 1
  /// }
  ///
  /// const it = one()
  /// println(it.asyncIterator() == it)   // true
  /// ```
  public asyncIterator(): AsyncIterator<T, E> {
    this
  }

  resume(): void {
    const k = this.parked
    if (k != null) {
      this.parked = null
      this.running = true
      k()
      return
    }
    if (!this.started) {
      this.started = true
      this.running = true
      this.pump()
    }
  }

  /// Runs the step up to its next `yield` (a value) or `await` (resumes by itself).
  pump(): void {
    const step = this.step
    if (step == null) {
      // An iterator with no steps is done at once (#204).
      this.finish(null)
      return
    }
    let s: ((k: () => void) => void)? = null
    try {
      s = step()
    } catch (e) {
      this.finish(e)
      return
    }
    if (s == null) {
      this.finish(null)
      return
    }
    if (this.values.length > 0) {
      const v = this.values[0]
      this.values = []
      const head = this.requests[0]
      this.requests = this.requests.slice(1)
      this.running = false
      s(() => this.pump())
      head.__resolve(v)
      if (this.requests.length > 0) {
        this.resume()
      }
      return
    }
    s(() => this.pump())
  }

  finish(e: Error?): void {
    this.finished = true
    this.running = false
    const rs = this.requests
    this.requests = []
    let first = true
    for (const r of rs) {
      if (first && e != null) {
        r.__reject(e)
      } else {
        r.__resolve(null)
      }
      first = false
    }
  }
}

/// Released by `await using` (spec §11.5) at the end of its scope.
///
/// @example
/// ```ts
/// class Session implements AsyncDisposable {
///   public async disposeAsync(): Promise<void> {
///     println("session closed")
///   }
/// }
///
/// async function run(): Promise<void> {
///   await using s = new Session()
///   println("working")   // working
/// }                      // session closed
///
/// await run()
/// ```
interface AsyncDisposable {
  /// Releases the resource; `await using` waits for the promise.
  ///
  /// @example
  /// ```ts
  /// class Upload implements AsyncDisposable {
  ///   public async disposeAsync(): Promise<void> {
  ///     println("upload finished")
  ///   }
  /// }
  ///
  /// const u = new Upload()
  /// await u.disposeAsync()   // upload finished
  /// ```
  disposeAsync(): Promise<void>
}
