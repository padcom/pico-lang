// `Map<K, V>` and `Set<T>` (spec §13.1): hash tables over `hashCode()` and `==`, iterated in
// insertion order like JavaScript's.

class __MapEntry<K, V> {
  public key: K
  public value: V
  public live: bool = true
  constructor(key: K, value: V) {
    this.key = key
    this.value = value
  }
}

/// A hash table from keys to values, iterated in insertion order like JavaScript's (spec §13.1).
/// Keys are compared with `==` and hashed with `hashCode()`: numbers, strings, `bool`, `char`, and
/// classes or structs with a `hashCode(): u64` method (the `Hashable` protocol, spec §2.8).
/// `for (const [k, v] of map)` walks the entries.
///
/// @example
/// ```ts
/// const ages = new Map<string, int>()
/// ages.set("ann", 31).set("bob", 27)
/// for (const [name, age] of ages) {
///   println(`${name}: ${age}`)
/// }
/// // ann: 31
/// // bob: 27
/// ```
class Map<K extends Hashable<K>, V> implements Iterable<[K, V]> {
  /// In insertion order; deleted entries stay (not `live`) until the next rehash, which comes once
  /// they outnumber the live ones.
  items: __MapEntry<K, V>[] = []
  /// Per bucket: indices into `items`.
  buckets: int[][] = []
  count: int = 0

  /// An empty map (`new Map<string, int>()`).
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// println(m.size)   // 0
  /// ```
  constructor() {}

  /// A copy of `other`: the same entries in the same order (a shallow copy; decision 344).
  ///
  /// @example
  /// ```ts
  /// const a = new Map<string, int>()
  /// a.set("x", 1)
  /// const b = new Map(a)
  /// b.set("y", 2)
  /// println(a.size)   // 1
  /// println(b.size)   // 2
  /// ```
  constructor(other: Map<K, V>) {
    for (const [k, v] of other) this.set(k, v)
  }

  bucket(key: K): int {
    return (key.hashCode() % (this.buckets.length as u64)) as int
  }

  /// The index of `key`'s entry, or -1.
  find(key: K): int {
    if (this.buckets.length == 0) {
      return -1
    }
    for (const i of this.buckets[this.bucket(key)]) {
      const e = this.items[i]
      if (e.live && e.key == key) {
        return i
      }
    }
    return -1
  }

  /// Rebuilds the buckets (`n` of them), dropping deleted entries.
  rehash(n: int): void {
    const kept: __MapEntry<K, V>[] = []
    for (const e of this.items) {
      if (e.live) {
        kept.push(e)
      }
    }
    this.items = kept
    const buckets: int[][] = []
    let k = 0
    while (k < n) {
      buckets.push([])
      k += 1
    }
    this.buckets = buckets
    let i = 0
    for (const e of kept) {
      this.buckets[this.bucket(e.key)].push(i)
      i += 1
    }
  }

  /// How many entries the map has.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// println(m.size)   // 2
  /// ```
  public get size(): int {
    if (__reactivity_on()) __trackObject(this)
    return this.count
  }

  /// Whether the map has an entry for `key`.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1)
  /// println(m.has("a"))   // true
  /// println(m.has("z"))   // false
  /// ```
  public has(key: K): bool {
    if (__reactivity_on()) __trackObject(this)
    return this.find(key) >= 0
  }

  /// The value for `key`, or `null` if there's none.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1)
  /// println(m.get("a"))   // 1
  /// println(m.get("z"))   // null
  /// ```
  public get(key: K): V? {
    if (__reactivity_on()) __trackObject(this)
    const i = this.find(key)
    if (i < 0) {
      return null
    }
    return this.items[i].value
  }

  /// Sets `key`'s value (replacing an earlier one, which keeps its place in the order); returns the
  /// map, so calls chain.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2).set("a", 3)
  /// println(m)   // Map { "a" => 3, "b" => 2 }
  /// ```
  public set(key: K, value: V): Map<K, V> {
    const i = this.find(key)
    if (i >= 0) {
      this.items[i].value = value
      if (__reactivity_on()) __triggerObject(this)
      return this
    }
    if (this.items.length >= this.buckets.length) {
      // More buckets only when the live entries need them; else this just drops the deleted ones
      // (a map with churn but few entries stays small, #97).
      const grow = this.buckets.length < 8 || this.count * 2 >= this.buckets.length
      this.rehash(if (this.buckets.length < 8) 8 else if (grow) this.buckets.length * 2 else this.buckets.length)
    }
    this.items.push(new __MapEntry(key, value))
    this.buckets[this.bucket(key)].push(this.items.length - 1)
    this.count += 1
    if (__reactivity_on()) __triggerObject(this)
    this
  }

  /// Removes `key`'s entry; whether there was one.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1)
  /// println(m.delete("a"))   // true
  /// println(m.delete("a"))   // false
  /// ```
  public delete(key: K): bool {
    const i = this.find(key)
    if (i < 0) {
      return false
    }
    this.items[i].live = false
    const b = this.bucket(key)
    const rest: int[] = []
    for (const j of this.buckets[b]) {
      if (j != i) {
        rest.push(j)
      }
    }
    this.buckets[b] = rest
    this.count -= 1
    // Deleted entries keep their key and value until a rehash: drop them once they outnumber the
    // live ones, so what was deleted becomes collectable (#97). (Iterations in progress keep the
    // array they started with.)
    const dead = this.items.length - this.count
    if (dead > 32 && dead > this.count) {
      this.rehash(this.buckets.length)
    }
    if (__reactivity_on()) __triggerObject(this)
    return true
  }

  /// Removes every entry.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// m.clear()
  /// println(m.size)   // 0
  /// ```
  public clear(): void {
    this.items = []
    this.buckets = []
    this.count = 0
    if (__reactivity_on()) __triggerObject(this)
  }

  /// The keys, in insertion order (a new array).
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("b", 2).set("a", 1)
  /// println(m.keys().join(", "))   // b, a
  /// ```
  public keys(): K[] {
    if (__reactivity_on()) __trackObject(this)
    const out: K[] = []
    for (const e of this.items) {
      if (e.live) {
        out.push(e.key)
      }
    }
    return out
  }

  /// The values, in insertion order (a new array).
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("b", 2).set("a", 1)
  /// println(m.values().join(", "))   // 2, 1
  /// ```
  public values(): V[] {
    if (__reactivity_on()) __trackObject(this)
    const out: V[] = []
    for (const e of this.items) {
      if (e.live) {
        out.push(e.value)
      }
    }
    return out
  }

  /// The entries as `[key, value]` pairs, in insertion order (a new array).
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// for (const [k, v] of m.entries()) {
  ///   println(`${k}=${v}`)
  /// }
  /// // a=1
  /// // b=2
  /// ```
  public entries(): [K, V][] {
    if (__reactivity_on()) __trackObject(this)
    const out: [K, V][] = []
    for (const e of this.items) {
      if (e.live) {
        out.push([e.key, e.value])
      }
    }
    return out
  }

  /// `for (const [k, v] of map)`: the entries in insertion order.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// const it = m.iterator()
  /// const first = it.next()
  /// if (first != null) {
  ///   const [k, v] = first
  ///   println(`${k}=${v}`)   // a=1
  /// }
  /// ```
  public iterator(): Iterator<[K, V]> {
    if (__reactivity_on()) __trackObject(this)
    __Array_iterator(this.entries())
  }

  /// Calls `f` with each value and its key, in insertion order.
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// m.forEach((value, key) => println(`${key} -> ${value}`))
  /// // a -> 1
  /// // b -> 2
  /// ```
  public forEach<E extends Error>(f: (value: V, key: K) => void throws E): void throws E {
    for (const e of this.items) {
      if (e.live) {
        f(e.value, e.key)
      }
    }
  }

  /// `Map { "a" => 1, "b" => 2 }`: the entries' debug forms, in insertion order (#11).
  ///
  /// @example
  /// ```ts
  /// const m = new Map<string, int>()
  /// m.set("a", 1).set("b", 2)
  /// println(m.toString())   // Map { "a" => 1, "b" => 2 }
  /// ```
  public toString(): string {
    if (this.count == 0) return "Map {}"
    let out = "Map { "
    let first = true
    for (const e of this.items) {
      if (e.live) {
        out = if (first) `${out}${e.key:?} => ${e.value:?}` else `${out}, ${e.key:?} => ${e.value:?}`
        first = false
      }
    }
    return `${out} }`
  }

  /// Sets each of `other`'s entries, in its order (`{ ...other }` in a map literal).
  __setAll(other: Map<K, V>): void {
    if (__reactivity_on()) __trackObject(other)
    for (const e of other.items) {
      if (e.live) {
        this.set(e.key, e.value)
      }
    }
  }
}

/// A set of distinct values, iterated in insertion order like JavaScript's (spec §13.1). Values are
/// compared with `==` and hashed with `hashCode()`, as `Map` keys are. `for (const x of set)` walks
/// it.
///
/// @example
/// ```ts
/// const seen = new Set<string>()
/// seen.add("a").add("b").add("a")
/// println(seen.size)   // 2
/// for (const x of seen) {
///   println(x)
/// }
/// // a
/// // b
/// ```
class Set<T extends Hashable<T>> implements Iterable<T> {
  map: Map<T, bool> = new Map()

  /// An empty set (`new Set<string>()`).
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// println(s.size)   // 0
  /// ```
  constructor() {}

  /// How many values the set has.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// s.add(1).add(2).add(2)
  /// println(s.size)   // 2
  /// ```
  public get size(): int {
    return this.map.size
  }

  /// Whether `value` is in the set.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<string>()
  /// s.add("red")
  /// println(s.has("red"))    // true
  /// println(s.has("blue"))   // false
  /// ```
  public has(value: T): bool {
    this.map.has(value)
  }

  /// Adds `value` (nothing changes if it's already there); returns the set, so calls chain.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// s.add(3).add(1).add(3)
  /// println(s)   // Set { 3, 1 }
  /// ```
  public add(value: T): Set<T> {
    this.map.set(value, true)
    this
  }

  /// Removes `value`; whether it was there.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// s.add(1)
  /// println(s.delete(1))   // true
  /// println(s.delete(1))   // false
  /// ```
  public delete(value: T): bool {
    this.map.delete(value)
  }

  /// Removes every value.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// s.add(1).add(2)
  /// s.clear()
  /// println(s.size)   // 0
  /// ```
  public clear(): void {
    this.map.clear()
  }

  /// The values, in insertion order (a new array).
  ///
  /// @example
  /// ```ts
  /// const s = new Set<string>()
  /// s.add("x").add("y")
  /// println(s.values().join(", "))   // x, y
  /// ```
  public values(): T[] {
    this.map.keys()
  }

  /// `for (const x of set)`: the values in insertion order.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<int>()
  /// s.add(10).add(20)
  /// const it = s.iterator()
  /// println(it.next())   // 10
  /// println(it.next())   // 20
  /// println(it.next())   // null
  /// ```
  public iterator(): Iterator<T> {
    __Array_iterator(this.map.keys())
  }

  /// Calls `f` with each value, in insertion order.
  ///
  /// @example
  /// ```ts
  /// const s = new Set<string>()
  /// s.add("x").add("y")
  /// s.forEach((v) => println(v))
  /// // x
  /// // y
  /// ```
  public forEach<E extends Error>(f: (value: T) => void throws E): void throws E {
    for (const v of this.map.keys()) {
      f(v)
    }
  }

  /// `Set { 1, 2 }`: the values' debug forms, in insertion order (#11).
  ///
  /// @example
  /// ```ts
  /// const s = new Set<string>()
  /// s.add("x").add("y")
  /// println(s.toString())   // Set { "x", "y" }
  /// ```
  public toString(): string {
    const vs = this.map.keys()
    if (vs.length == 0) return "Set {}"
    let out = "Set { "
    for (let i = 0; i < vs.length; i++) {
      out = if (i == 0) `${out}${vs[i]:?}` else `${out}, ${vs[i]:?}`
    }
    return `${out} }`
  }
}
