// `Map<K, V>` and `Set<T>` (spec §13.1): hash tables over `hashCode()` and `==`, iterated in
// insertion order like JavaScript's.

class __MapEntry<K, V> {
  public key: K
  public value: V
  public live: bool = true
  constructor(key: K, value: V) {
    this.key = key
    this.value = value
  }
}

/// A hash table from keys to values, iterated in insertion order like JavaScript's (spec §13.1).
/// Keys are compared with `==` and hashed with `hashCode()`: numbers, strings, `bool`, `char`, and
/// classes or structs with a `hashCode(): u64` method (the `Hashable` protocol, spec §2.8).
/// `for (const [k, v] of map)` walks the entries.
class Map<K extends Hashable<K>, V> {
  /// In insertion order; deleted entries stay (not `live`) until the next rehash.
  items: __MapEntry<K, V>[] = []
  /// Per bucket: indices into `items`.
  buckets: int[][] = []
  count: int = 0

  /// An empty map (`new Map<string, int>()`).
  constructor() {}

  bucket(key: K): int {
    (key.hashCode() % (this.buckets.length as u64)) as int
  }

  /// The index of `key`'s entry, or -1.
  find(key: K): int {
    if (this.buckets.length == 0) {
      return -1
    }
    for (const i of this.buckets[this.bucket(key)]) {
      const e = this.items[i]
      if (e.live && e.key == key) {
        return i
      }
    }
    -1
  }

  /// Rebuilds the buckets (`n` of them), dropping deleted entries.
  rehash(n: int): void {
    const kept: __MapEntry<K, V>[] = []
    for (const e of this.items) {
      if (e.live) {
        kept.push(e)
      }
    }
    this.items = kept
    const buckets: int[][] = []
    let k = 0
    while (k < n) {
      buckets.push([])
      k += 1
    }
    this.buckets = buckets
    let i = 0
    for (const e of kept) {
      this.buckets[this.bucket(e.key)].push(i)
      i += 1
    }
  }

  /// How many entries the map has.
  public get size(): int {
    if (__reactivity_on()) __trackObject(this)
    this.count
  }

  /// Whether the map has an entry for `key`.
  public has(key: K): bool {
    if (__reactivity_on()) __trackObject(this)
    this.find(key) >= 0
  }

  /// The value for `key`, or `null` if there's none.
  public get(key: K): V? {
    if (__reactivity_on()) __trackObject(this)
    const i = this.find(key)
    if (i < 0) {
      return null
    }
    this.items[i].value
  }

  /// Sets `key`'s value (replacing an earlier one, which keeps its place in the order); returns the
  /// map, so calls chain.
  public set(key: K, value: V): Map<K, V> {
    const i = this.find(key)
    if (i >= 0) {
      this.items[i].value = value
      if (__reactivity_on()) __triggerObject(this)
      return this
    }
    if (this.items.length >= this.buckets.length) {
      this.rehash(if (this.buckets.length < 8) 8 else this.buckets.length * 2)
    }
    this.items.push(new __MapEntry(key, value))
    this.buckets[this.bucket(key)].push(this.items.length - 1)
    this.count += 1
    if (__reactivity_on()) __triggerObject(this)
    this
  }

  /// Removes `key`'s entry; whether there was one.
  public delete(key: K): bool {
    const i = this.find(key)
    if (i < 0) {
      return false
    }
    this.items[i].live = false
    const b = this.bucket(key)
    const rest: int[] = []
    for (const j of this.buckets[b]) {
      if (j != i) {
        rest.push(j)
      }
    }
    this.buckets[b] = rest
    this.count -= 1
    if (__reactivity_on()) __triggerObject(this)
    true
  }

  /// Removes every entry.
  public clear(): void {
    this.items = []
    this.buckets = []
    this.count = 0
    if (__reactivity_on()) __triggerObject(this)
  }

  /// The keys, in insertion order (a new array).
  public keys(): K[] {
    if (__reactivity_on()) __trackObject(this)
    const out: K[] = []
    for (const e of this.items) {
      if (e.live) {
        out.push(e.key)
      }
    }
    out
  }

  /// The values, in insertion order (a new array).
  public values(): V[] {
    if (__reactivity_on()) __trackObject(this)
    const out: V[] = []
    for (const e of this.items) {
      if (e.live) {
        out.push(e.value)
      }
    }
    out
  }

  /// The entries as `[key, value]` pairs, in insertion order (a new array).
  public entries(): [K, V][] {
    if (__reactivity_on()) __trackObject(this)
    const out: [K, V][] = []
    for (const e of this.items) {
      if (e.live) {
        out.push([e.key, e.value])
      }
    }
    out
  }

  /// `for (const [k, v] of map)`: the entries in insertion order.
  public iterator(): Iterator<[K, V]> {
    if (__reactivity_on()) __trackObject(this)
    __Array_iterator(this.entries())
  }

  /// Calls `f` with each value and its key, in insertion order.
  public forEach<E extends Error>(f: (value: V, key: K) => void throws E): void throws E {
    for (const e of this.items) {
      if (e.live) {
        f(e.value, e.key)
      }
    }
  }
}

/// A set of distinct values, iterated in insertion order like JavaScript's (spec §13.1). Values are
/// compared with `==` and hashed with `hashCode()`, as `Map` keys are. `for (const x of set)` walks
/// it.
class Set<T extends Hashable<T>> {
  map: Map<T, bool> = new Map()

  /// An empty set (`new Set<string>()`).
  constructor() {}

  /// How many values the set has.
  public get size(): int {
    this.map.size
  }

  /// Whether `value` is in the set.
  public has(value: T): bool {
    this.map.has(value)
  }

  /// Adds `value` (nothing changes if it's already there); returns the set, so calls chain.
  public add(value: T): Set<T> {
    this.map.set(value, true)
    this
  }

  /// Removes `value`; whether it was there.
  public delete(value: T): bool {
    this.map.delete(value)
  }

  /// Removes every value.
  public clear(): void {
    this.map.clear()
  }

  /// The values, in insertion order (a new array).
  public values(): T[] {
    this.map.keys()
  }

  /// `for (const x of set)`: the values in insertion order.
  public iterator(): Iterator<T> {
    __Array_iterator(this.map.keys())
  }

  /// Calls `f` with each value, in insertion order.
  public forEach<E extends Error>(f: (value: T) => void throws E): void throws E {
    for (const v of this.map.keys()) {
      f(v)
    }
  }
}
