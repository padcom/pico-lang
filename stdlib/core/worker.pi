// Workers (spec §10.2–10.3): threads with their own heap and module instances that share
// nothing; messages are deep-copied. The runtime side is `runtime/src/pico_worker.c`.

/// A worker ended by a panic or an uncaught error (`Worker.onerror`).
///
/// @example
/// ```ts
/// const w = new Worker((n: int): int => {
///   if (n < 0) panic("negative input")
///   return n * 2
/// })
/// w.onerror = (e: WorkerPanicked) => println(`worker died: ${e.message}`)   // worker died: negative input
/// try {
///   println(await w.call(-1))
/// } catch (e: WorkerPanicked) {
///   println(`call failed: ${e.message}`)   // call failed: negative input
/// }
/// ```
class WorkerPanicked extends Error {
  /// A `WorkerPanicked` with the panic's or the uncaught error's `message`.
  ///
  /// @example
  /// ```ts
  /// const e = new WorkerPanicked("the worker was terminated")
  /// println(e.message)   // the worker was terminated
  /// ```
  constructor(message: string) {
    super(message)
  }
}

/// A call of an inline worker's function, and its result (`values`: one, unless it threw).
struct __Call<T> {
  id: int
  arg: T
}

struct __Reply<T> {
  id: int
  values: T[]
  error: Error?
}

/// A worker thread running a module: `new Worker<In, Out>("./job")` (the compiler turns the
/// path into the module's id). It receives `In`s and sends `Out`s. An inline worker,
/// `new Worker(f)`, runs a capture-free function: `await w.call(x)` is `f(x)`, computed in
/// the worker (throwing what `f` throws, `E`).
///
/// @example
/// ```ts
/// const w = new Worker((n: i64): i64 => {
///   let a: i64 = 0
///   let b: i64 = 1
///   for (let i = 0; i < n; i++) {
///     const t = a + b
///     a = b
///     b = t
///   }
///   return a
/// })
/// println(await w.call(50))   // 12586269025
/// ```
class Worker<In extends Sendable, Out extends Sendable, E extends Error = never> {
  handle: int
  /// Called with each message the worker sends (inline workers' replies settle `call`'s promises
  /// instead).
  public onmessage: ((message: Out) => void)? = null
  /// Called when the worker ends by a panic or an uncaught error; without it, the error ends the
  /// program like an uncaught one.
  public onerror: ((error: WorkerPanicked) => void)? = null
  inline: bool = false
  /// Inline workers: the calls not answered yet.
  pending: Map<int, Promise<Out, E>> = new Map<int, Promise<Out, E>>()
  nextCall: int = 1
  /// Why the worker is gone (terminated, or ended by a panic): later `call`s reject with it at
  /// once instead of waiting for an answer that can't come (#203).
  ended: WorkerPanicked? = null

  /// (`new Worker("./job")`: `module` is the module's id; `kind` is 0.)
  ///
  /// @example
  /// ```ts
  /// // The path names a worker module, e.g. "./job" for job.pi beside this file:
  /// //   import { self } from "std/worker"
  /// //   self.onmessage = (n: int) => self.postMessage(n * n)
  /// // (This example names "std/worker" so it compiles on its own.)
  /// function start(): Worker<int, int> {
  ///   const w = new Worker<int, int>("std/worker")
  ///   w.onmessage = (n: int) => println(`got ${n}`)
  ///   w.onerror = (e: WorkerPanicked) => println(`worker died: ${e.message}`)
  ///   w.postMessage(7)
  ///   return w
  /// }
  /// ```
  constructor(module: int, _kind: int) {
    this.handle = __worker_op(1, module)
    __theLoop().channels.set(this.handle, () => this.__deliver())
  }

  /// `new Worker(f)`: an inline worker that serves `call`s with `f`, a capture-free function copied
  /// to the worker. While no call is pending it doesn't keep the program running.
  ///
  /// @example
  /// ```ts
  /// const w = new Worker((s: string): int => s.length)
  /// println(await w.call("hello"))   // 5
  /// ```
  constructor(f: (input: In) => Out throws E) {
    this.inline = true
    this.handle = __worker_op(8, 0)
    // (Idle, it doesn't keep the program running.)
    __worker_op(9, this.handle)
    __theLoop().channels.set(this.handle, () => this.__deliver())
    // The worker gets this (a copy: `f` captures nothing) and serves the calls with it.
    const setup = () => {
      __workerOnMessage<__Call<In>>((c: __Call<In>) => {
        try {
          const v = f(c.arg)
          __worker_post(0, __Reply<Out> { id: c.id, values: [v], error: null })
        } catch (e) {
          __worker_post(0, __Reply<Out> { id: c.id, values: [], error: e })
        }
      })
    }
    __worker_post(this.handle, setup)
  }

  /// An inline worker's `f(input)`, computed in the worker.
  ///
  /// @example
  /// ```ts
  /// const w = new Worker((xs: int[]): int => {
  ///   let sum = 0
  ///   for (const x of xs) sum += x
  ///   return sum
  /// })
  /// const [a, b] = await Promise.all([w.call([1, 2, 3]), w.call([10, 20])])
  /// println(a)   // 6
  /// println(b)   // 30
  /// ```
  public call(input: In): Promise<Out, E> {
    const p = new Promise<Out, E>()
    const ended = this.ended
    if (ended != null) {
      p.__reject(ended)
      return p
    }
    const id = this.nextCall
    this.nextCall += 1
    this.pending.set(id, p)
    __worker_op(10, this.handle)
    __worker_post(this.handle, __Call<In> { id: id, arg: input })
    return p
  }

  /// Sends a copy of `message` to the worker (`options.transfer`: buffers moved instead). Only
  /// for a worker module: an inline worker (`new Worker(f)`) takes `call`s, and this panics.
  ///
  /// @example
  /// ```ts
  /// // `w` runs a worker module (`new Worker<ArrayBuffer, int>("./job")`) that takes byte buffers.
  /// function send(w: Worker<ArrayBuffer, int>): void {
  ///   const frame = new ArrayBuffer(1 << 20)
  ///   w.postMessage(frame, { transfer: [frame] })   // moved, not copied: `frame` is detached here
  /// }
  /// ```
  public postMessage(message: In, options: TransferOptions? = null): void {
    // An inline worker reads every message as a `call` (#202).
    if (this.inline) {
      panic("Worker: an inline worker (`new Worker(f)`) takes `call`s, not `postMessage`")
    }
    __worker_post(this.handle, message, __transfer(options))
    __detachAll(options)
  }

  /// Stops the worker (right away: at its next safepoint). Pending `call`s reject with a
  /// `WorkerPanicked`.
  ///
  /// @example
  /// ```ts
  /// const w = new Worker((n: int): int => n + 1)
  /// println(await w.call(1))   // 2
  /// const p = w.call(2)
  /// w.terminate()
  /// try {
  ///   println(await p)
  /// } catch (e: WorkerPanicked) {
  ///   println(e.message)   // the worker was terminated
  /// }
  /// ```
  public terminate(): void {
    __worker_op(4, this.handle)
    __theLoop().channels.delete(this.handle)
    const e = new WorkerPanicked("the worker was terminated")
    this.ended = e
    this.failPending(e)
  }

  /// Rejects every call not answered yet: the worker won't answer them (#21).
  failPending(e: WorkerPanicked): void {
    if (this.pending.size == 0) {
      return
    }
    const ps: Promise<Out, E>[] = []
    this.pending.forEach((p: Promise<Out, E>, _id: int) => {
      ps.push(p)
    })
    this.pending = new Map<int, Promise<Out, E>>()
    for (const p of ps) {
      p.__reject(e)
    }
  }

  __deliver(): void {
    const kind = __worker_op(3, this.handle)
    if (kind == 0 && this.inline) {
      const r = __worker_take<__Reply<Out>>(this.handle)
      const p = this.pending.get(r.id)
      this.pending.delete(r.id)
      if (this.pending.size == 0) {
        __worker_op(9, this.handle)
      }
      if (p != null) {
        const e = r.error
        if (e != null) {
          p.__reject(e)
        } else {
          p.__resolve(r.values[0])
        }
      }
    } else if (kind == 0) {
      const m = __worker_take<Out>(this.handle)
      const f = this.onmessage
      if (f != null) {
        f(m)
      }
    } else if (kind == 1) {
      const text = __worker_error(this.handle)
      __theLoop().channels.delete(this.handle)
      const e = new WorkerPanicked(text)
      this.ended = e
      this.failPending(e)
      const f = this.onerror
      if (f != null) {
        f(e)
      } else {
        __exit_uncaught(e)
      }
    } else {
      // It ended by itself.
      __worker_op(5, this.handle)
      __theLoop().channels.delete(this.handle);
    }
  }
}

/// `self.onmessage = f` in a worker module: `f` gets the parent's messages, as `T`s.
function __workerOnMessage<T extends Sendable>(f: (message: T) => void): void {
  const l = __theLoop()
  l.listening = true
  l.channels.set(0, () => {
    if (__worker_op(3, 0) == 0) {
      f(__worker_take<T>(0))
    } else {
      __worker_op(5, 0);
    }
  })
}

/// An inline worker's thread, after the library modules' code: takes the function to serve
/// (the parent's first message), which starts listening for calls.
function __inlineWorkerMain(): void {
  while (__worker_op(3, 0) != 0) {
    __loop_wait(-1)
  }
  const setup = __worker_take<() => void>(0)
  setup()
}

/// What the machine offers (`navigator.hardwareConcurrency`, as on the Web).
///
/// @example
/// ```ts
/// const n = navigator.hardwareConcurrency
/// println(`up to ${n} workers in parallel`)   // e.g. up to 8 workers in parallel
/// ```
class navigator {
  /// The number of processors.
  ///
  /// @example
  /// ```ts
  /// println(navigator.hardwareConcurrency > 0)   // true
  /// ```
  public static get hardwareConcurrency(): int {
    __worker_op(11, 0)
  }
}
