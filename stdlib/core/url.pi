// `URL` and `URLSearchParams` (WHATWG URL, spec §13.1), globals. The parser covers what
// programs meet in practice: special schemes (http, https, ws, wss, ftp, file) with
// authority, default ports, dot segments and percent-encoding, opaque paths for other
// schemes (`mailto:`, `data:`), IPv6 hosts in brackets, and resolving against a base.
// Not covered: IDNA (non-ASCII host names are percent-encoded), IPv4 number forms other
// than dotted decimal, and `blob:` origins.

function __defaultPort(scheme: string): string {
  if (scheme == "http" || scheme == "ws") "80"
  else if (scheme == "https" || scheme == "wss") "443"
  else if (scheme == "ftp") "21"
  else ""
}

function __isSpecial(scheme: string): bool {
  return scheme == "http" || scheme == "https" || scheme == "ws" || scheme == "wss" ||
    scheme == "ftp" || scheme == "file"
}

function __hexValue(c: char): int {
  if (c >= '0' && c <= '9') (c as u32 as int) - 48
  else if (c >= 'a' && c <= 'f') (c as u32 as int) - 87
  else if (c >= 'A' && c <= 'F') (c as u32 as int) - 55
  else -1
}

/// `%XX` for each UTF-8 byte of `c`.
function __pctChar(c: char): string {
  const bytes = new TextEncoder().encode(`${c}`)
  const __hexUpper = "0123456789ABCDEF"
  let out = ""
  for (let i = 0; i < bytes.length; i++) {
    const b = bytes.get(i)
    out = `${out}%${__hexUpper[b >> 4]}${__hexUpper[b & 15]}`
  }
  return out
}

/// `s` with the characters of `set` (and controls, and everything past ASCII) encoded.
function __encode(s: string, chars: string): string {
  // (Pieces joined once: appending is O(n²), #73.)
  const out: string[] = []
  for (const c of s) {
    const n = c as u32
    if (n < 0x21 || n > 0x7E || chars.includes(`${c}`)) {
      out.push(__pctChar(c))
    } else {
      out.push(`${c}`)
    }
  }
  return out.join("")
}

/// The bytes `%XX` stand for, decoded as UTF-8 (`plus`: `+` is a space).
function __decode(s: string, plus: bool): string {
  if (!s.includes("%") && !(plus && s.includes("+"))) {
    return s
  }
  const bytes: int[] = []
  const chars: char[] = []
  for (const c of s) {
    chars.push(c)
  }
  const enc = new TextEncoder()
  let i = 0
  while (i < chars.length) {
    const c = chars[i]
    if (c == '%' && i + 2 < chars.length + 0 && __hexValue(chars[i + 1]) >= 0 && __hexValue(chars[i + 2]) >= 0) {
      bytes.push(__hexValue(chars[i + 1]) * 16 + __hexValue(chars[i + 2]))
      i += 3
      continue
    }
    if (plus && c == '+') {
      bytes.push(32)
    } else {
      const b = enc.encode(`${c}`)
      for (let k = 0; k < b.length; k++) {
        bytes.push(b.get(k))
      }
    }
    i += 1
  }
  let text = ""
  try {
    text = new TextDecoder().decode(Uint8Array.from(bytes))
  } catch (e: TypeError) {}
  return text
}

/// `application/x-www-form-urlencoded`: letters, digits and `*-._` stay, a space is `+`.
function __formEncode(s: string): string {
  const out: string[] = []
  for (const c of s) {
    if (c.isAlpha() || c.isDigit() || c == '*' || c == '-' || c == '.' || c == '_') {
      out.push(`${c}`)
    } else if (c == ' ') {
      out.push("+")
    } else {
      out.push(__pctChar(c))
    }
  }
  return out.join("")
}

/// A query string's name/value pairs (`a=1&b=two%20words`), in order.
///
/// @example
/// ```ts
/// const params = new URLSearchParams("q=pico&page=2")
/// println(params.get("q"))       // pico
/// println(params.toString())     // q=pico&page=2
/// ```
class URLSearchParams implements Iterable<[string, string]> {
  list: [string, string][] = []
  /// The URL whose query this is (kept in step).
  public __owner: URL? = null

  /// From a query string (a leading `?` is skipped) or name/value pairs.
  ///
  /// @example
  /// ```ts
  /// const fromQuery = new URLSearchParams("?a=1&b=two%20words")
  /// println(fromQuery.get("b"))     // two words
  /// const fromPairs = new URLSearchParams([["x", "1"], ["y", "2"]])
  /// println(fromPairs.toString())   // x=1&y=2
  /// ```
  constructor(init: string | [string, string][] = "") {
    match (init) {
      q: string => this.__parse(q),
      pairs: [string, string][] => {
        for (const [k, v] of pairs) {
          this.list.push([k, v])
        }
      },
    }
  }

  public __parse(init: string): void {
    this.list = []
    const q = if (init.startsWith("?")) init.slice(1) else init
    if (q.length == 0) {
      return
    }
    for (const part of q.split("&")) {
      if (part.length == 0) {
        continue
      }
      const i = part.indexOf("=")
      if (i < 0) {
        this.list.push([__decode(part, true), ""])
      } else {
        this.list.push([__decode(part.slice(0, i), true), __decode(part.slice(i + 1), true)])
      }
    }
  }

  update(): void {
    const o = this.__owner
    if (o != null) {
      o.__setQuery(this.toString())
    }
  }

  /// The count of pairs (repeated names included).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("a=1&a=2&b=3")
  /// println(params.size)   // 3
  /// ```
  public get size(): int {
    return this.list.length
  }

  /// Adds a pair (after any others of the same name).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("tag=a")
  /// params.append("tag", "b")
  /// println(params.toString())   // tag=a&tag=b
  /// ```
  public append(name: string, value: string): void {
    this.list.push([name, value])
    this.update()
  }

  /// Removes every pair named `name`.
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("a=1&b=2&a=3")
  /// params.delete("a")
  /// println(params.toString())   // b=2
  /// ```
  public delete(name: string): void {
    const kept: [string, string][] = []
    for (const [k, v] of this.list) {
      if (k != name) {
        kept.push([k, v])
      }
    }
    this.list = kept
    this.update()
  }

  /// The first value named `name`.
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("name=Ada&lang=pico")
  /// println(params.get("name"))      // Ada
  /// println(params.get("missing"))   // null
  /// ```
  public get(name: string): string? {
    for (const [k, v] of this.list) {
      if (k == name) {
        return v
      }
    }
    return null
  }

  /// Every value named `name`, in order (empty when there's none).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("tag=a&x=1&tag=b")
  /// println(params.getAll("tag").join(", "))   // a, b
  /// ```
  public getAll(name: string): string[] {
    const out: string[] = []
    for (const [k, v] of this.list) {
      if (k == name) {
        out.push(v)
      }
    }
    return out
  }

  /// Whether there's a pair named `name`.
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("debug=&level=3")
  /// println(params.has("debug"))   // true
  /// println(params.has("trace"))   // false
  /// ```
  public has(name: string): bool {
    return this.get(name) != null
  }

  /// Replaces the first pair named `name` (dropping the others), or appends one.
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("a=1&b=2&a=3")
  /// params.set("a", "9")
  /// println(params.toString())   // a=9&b=2
  /// ```
  public set(name: string, value: string): void {
    const kept: [string, string][] = []
    let found = false
    for (const [k, v] of this.list) {
      if (k == name) {
        if (!found) {
          kept.push([k, value])
          found = true
        }
      } else {
        kept.push([k, v])
      }
    }
    if (!found) {
      kept.push([name, value])
    }
    this.list = kept
    this.update()
  }

  /// Sorts the pairs by name (stable).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("c=3&a=1&b=2")
  /// params.sort()
  /// println(params.toString())   // a=1&b=2&c=3
  /// ```
  public sort(): void {
    const items = this.list
    for (let i = 1; i < items.length; i++) {
      const x = items[i]
      let j = i - 1
      while (j >= 0 && items[j][0] > x[0]) {
        items[j + 1] = items[j]
        j -= 1
      }
      items[j + 1] = x
    }
    this.update()
  }

  /// Every pair's name, in order (repeats included).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("a=1&b=2&a=3")
  /// println(params.keys().join(" "))   // a b a
  /// ```
  public keys(): string[] {
    const out: string[] = []
    for (const [k, _v] of this.list) {
      out.push(k)
    }
    return out
  }

  /// The pairs, in order (a copy).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("a=1&b=2")
  /// for (const [name, value] of params.entries()) {
  ///   println(`${name} -> ${value}`)
  /// }
  /// // a -> 1
  /// // b -> 2
  /// ```
  public entries(): [string, string][] {
    const out: [string, string][] = []
    for (const [k, v] of this.list) {
      out.push([k, v])
    }
    return out
  }

  /// `for (const [name, value] of params)`.
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams("x=10&y=20")
  /// for (const [name, value] of params) {
  ///   println(`${name}=${value}`)
  /// }
  /// // x=10
  /// // y=20
  /// ```
  public iterator(): Iterator<[string, string]> {
    __Array_iterator(this.entries())
  }

  /// The pairs as a query string (without `?`).
  ///
  /// @example
  /// ```ts
  /// const params = new URLSearchParams()
  /// params.append("q", "hello world")
  /// params.append("lang", "en&de")
  /// println(params.toString())   // q=hello+world&lang=en%26de
  /// ```
  public toString(): string {
    let out = ""
    for (const [k, v] of this.list) {
      if (out.length > 0) {
        out = out + "&"
      }
      out = `${out}${__formEncode(k)}=${__formEncode(v)}`
    }
    return out
  }
}

/// A parsed URL. `new URL(input, base?)` throws a `TypeError` for an invalid URL;
/// `URL.parse` gives `null` instead.
///
/// @example
/// ```ts
/// const url = new URL("https://example.com:8080/docs/index.html?v=2#intro")
/// println(url.hostname)   // example.com
/// println(url.port)       // 8080
/// println(url.pathname)   // /docs/index.html
/// println(url.hash)       // #intro
/// ```
class URL {
  scheme: string = ""
  /// The user name (percent-encoded), or "".
  public username: string = ""
  /// The password (percent-encoded), or "".
  public password: string = ""
  /// The host, lowercased (an IPv6 address in brackets, `[::1]`), or "".
  public hostname: string = ""
  /// The port as text, or "" when there's none or it's the scheme's default (`80` for `http:`).
  public port: string = ""
  path: string = ""
  /// Whether the path is opaque (`mailto:a@b`) rather than a list of segments.
  opaque: bool = false
  hasHost: bool = false
  query: string? = null
  fragment: string? = null
  params: URLSearchParams? = null

  /// Parses `input`, resolving it against `base` when it's relative. Throws a `TypeError` for an
  /// invalid URL (or base).
  ///
  /// @example
  /// ```ts
  /// const abs = new URL("https://example.com/a/b")
  /// println(abs.href)   // https://example.com/a/b
  /// const rel = new URL("../c?x=1", "https://example.com/a/b/")
  /// println(rel.href)   // https://example.com/a/c?x=1
  /// try {
  ///   const bad = new URL("not a url")
  ///   println(bad.href)
  /// } catch (e: TypeError) {
  ///   println(e.message)   // Invalid URL: not a url
  /// }
  /// ```
  constructor(input: string, base: string? = null) throws TypeError {
    const b = base
    if (b != null) {
      const bu = new URL(b)
      this.parseInto(input.trim(), bu)
    } else {
      this.parseInto(input.trim(), null)
    }
  }

  /// The URL, or `null` when `input` isn't one.
  ///
  /// @example
  /// ```ts
  /// const good = URL.parse("http://localhost:3000/api")
  /// println(good?.port)                  // 3000
  /// println(URL.parse("::nonsense::"))   // null
  /// ```
  public static parse(input: string, base: string? = null): URL? {
    try {
      return new URL(input, base)
    } catch (e: TypeError) {}
    return null
  }

  /// Whether `input` (against `base`) is a valid URL.
  ///
  /// @example
  /// ```ts
  /// println(URL.canParse("https://example.com"))      // true
  /// println(URL.canParse("/relative/path"))           // false
  /// println(URL.canParse("/relative/path", "https://example.com"))   // true
  /// ```
  public static canParse(input: string, base: string? = null): bool {
    return URL.parse(input, base) != null
  }

  fail(input: string): void throws TypeError {
    throw new TypeError(`Invalid URL: ${input}`)
  }

  parseInto(input: string, base: URL?): void throws TypeError {
    let s = input.replaceAll("\t", "").replaceAll("\n", "").replaceAll("\r", "")
    // The scheme.
    let i = 0
    const chars: char[] = []
    for (const c of s) {
      chars.push(c)
    }
    let scheme = ""
    if (chars.length > 0 && chars[0].isAlpha()) {
      let k = 1
      while (k < chars.length && (chars[k].isAlpha() || chars[k].isDigit() || chars[k] == '+' || chars[k] == '-' || chars[k] == '.')) {
        k += 1
      }
      if (k < chars.length && chars[k] == ':') {
        scheme = s.slice(0, k).toLowerCase()
        i = k + 1
      }
    }
    if (scheme == "") {
      if (base == null) {
        this.fail(input)
        return
      }
      this.relative(s, base, input)
      return
    }
    this.scheme = scheme
    let rest = s.slice(i)
    if (__isSpecial(scheme)) {
      const bb = base
      if (bb != null && bb.scheme == scheme && !rest.startsWith("/") && !rest.startsWith("\\")) {
        // `http:foo` against an http base is relative.
        this.relative(rest, bb, input)
        return
      }
      let k = 0
      while (k < rest.length && (rest[k] == '/' || rest[k] == '\\')) {
        k += 1
      }
      this.authorityAndRest(rest.slice(k), input)
      return
    }
    if (rest.startsWith("//")) {
      this.authorityAndRest(rest.slice(2), input)
      return
    }
    // An opaque path, or a path without a host.
    this.splitTail(rest, !rest.startsWith("/"))
  }

  /// `[userinfo@]host[:port]` then the path, query and fragment.
  authorityAndRest(s: string, input: string): void throws TypeError {
    let end = s.length
    for (let k = 0; k < s.length; k++) {
      const c = s[k]
      if (c == '/' || c == '?' || c == '#' || (__isSpecial(this.scheme) && c == '\\')) {
        end = k
        break
      }
    }
    let auth = s.slice(0, end)
    const at = auth.lastIndexOf("@")
    if (at >= 0) {
      const info = auth.slice(0, at)
      auth = auth.slice(at + 1)
      const colon = info.indexOf(":")
      if (colon >= 0) {
        this.username = __encode(info.slice(0, colon), " \"#<>?`{}/:;=@[\\]^|")
        this.password = __encode(info.slice(colon + 1), " \"#<>?`{}/:;=@[\\]^|")
      } else {
        this.username = __encode(info, " \"#<>?`{}/:;=@[\\]^|")
      }
    }
    let host = auth
    let port = ""
    if (auth.startsWith("[")) {
      const close = auth.indexOf("]")
      if (close < 0) {
        this.fail(input)
      }
      host = auth.slice(0, close + 1).toLowerCase()
      const after = auth.slice(close + 1)
      if (after.startsWith(":")) {
        port = after.slice(1)
      } else if (after.length > 0) {
        this.fail(input)
      }
    } else {
      const colon = auth.lastIndexOf(":")
      if (colon >= 0) {
        host = auth.slice(0, colon)
        port = auth.slice(colon + 1)
      }
      host = __decode(host, false).toLowerCase()
      for (const c of host) {
        if (c == ' ' || c == '#' || c == '%' || c == '/' || c == ':' || c == '<' || c == '>' || c == '?' || c == '@' || c == '[' || c == '\\' || c == ']' || c == '^' || c == '|') {
          this.fail(input)
        }
      }
      host = __encode(host, "")
    }
    if (port.length > 0) {
      for (const c of port) {
        if (!c.isDigit()) {
          this.fail(input)
        }
      }
      const n = parseInt(port)
      if (n > 65535) {
        this.fail(input)
      }
      port = `${n}`
      if (port == __defaultPort(this.scheme)) {
        port = ""
      }
    }
    if (host.length == 0 && __isSpecial(this.scheme) && this.scheme != "file") {
      this.fail(input)
    }
    this.hostname = host
    this.port = port
    this.hasHost = true
    this.splitTail(s.slice(end), false)
  }

  /// Path, `?query` and `#fragment` of `s`.
  splitTail(s: string, opaque: bool): void {
    let rest = s
    const hash = rest.indexOf("#")
    if (hash >= 0) {
      this.fragment = __encode(rest.slice(hash + 1), " \"<>`")
      rest = rest.slice(0, hash)
    }
    const q = rest.indexOf("?")
    if (q >= 0) {
      this.query = __encode(rest.slice(q + 1), if (__isSpecial(this.scheme)) " \"#<>'" else " \"#<>")
      rest = rest.slice(0, q)
    }
    this.opaque = opaque
    if (opaque) {
      this.path = __encode(rest, "")
    } else {
      this.path = this.normalize(rest)
    }
  }

  /// A path with `.` and `..` segments resolved and characters encoded.
  normalize(p: string): string {
    const special = __isSpecial(this.scheme)
    const raw = if (special) p.replaceAll("\\", "/") else p
    if (raw.length == 0) {
      return if (special) "/" else ""
    }
    const out: string[] = []
    const parts = raw.split("/")
    for (let k = 0; k < parts.length; k++) {
      if (k == 0 && raw.startsWith("/")) {
        continue
      }
      const seg = parts[k]
      const last = k == parts.length - 1
      const low = seg.toLowerCase()
      if (seg == "." || low == "%2e") {
        if (last) {
          out.push("")
        }
      } else if (seg == ".." || low == ".%2e" || low == "%2e." || low == "%2e%2e") {
        if (out.length > 0) {
          out.pop()
        }
        if (last) {
          out.push("")
        }
      } else {
        out.push(__encode(seg, " \"#<>?`{}"))
      }
    }
    let text = ""
    for (const seg of out) {
      text = `${text}/${seg}`
    }
    if (text.length == 0) "/" else text
  }

  /// `s` (no scheme) against `base`.
  relative(s: string, base: URL, input: string): void throws TypeError {
    if (base.opaque && !s.startsWith("#")) {
      this.fail(input)
      return
    }
    this.scheme = base.scheme
    const special = __isSpecial(base.scheme)
    if (s.startsWith("//") || (special && (s.startsWith("\\\\") || s.startsWith("/\\") || s.startsWith("\\/")))) {
      this.authorityAndRest(s.slice(2), input)
      return
    }
    this.username = base.username
    this.password = base.password
    this.hostname = base.hostname
    this.port = base.port
    this.hasHost = base.hasHost
    this.opaque = base.opaque
    if (s.length == 0) {
      this.path = base.path
      this.query = base.query
      return
    }
    if (s.startsWith("#")) {
      this.path = base.path
      this.query = base.query
      this.fragment = __encode(s.slice(1), " \"<>`")
      return
    }
    if (s.startsWith("?")) {
      this.path = base.path
      this.splitTail(s, false)
      this.path = base.path
      return
    }
    if (s.startsWith("/") || (special && s.startsWith("\\"))) {
      this.splitTail(s, false)
      return
    }
    // Relative to the base's directory.
    const dir = base.path.slice(0, base.path.lastIndexOf("/") + 1)
    this.splitTail(`${dir}${s}`, false)
  }

  public __setQuery(q: string): void {
    this.query = if (q.length == 0) null else q
  }

  /// The scheme, lowercased, with its `:` (`"https:"`).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("HTTPS://example.com")
  /// println(url.protocol)   // https:
  /// ```
  public get protocol(): string {
    return `${this.scheme}:`
  }

  /// `hostname` and `:port` (when it isn't the default).
  ///
  /// @example
  /// ```ts
  /// println(new URL("http://example.com:8080/").host)   // example.com:8080
  /// println(new URL("http://example.com:80/").host)     // example.com
  /// ```
  public get host(): string {
    if (this.port.length > 0) `${this.hostname}:${this.port}` else this.hostname
  }

  /// The path with dot segments resolved and percent-encoded (`"/"` at least for special schemes;
  /// the whole opaque path for `mailto:a@b`).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/a/./b/../c")
  /// println(url.pathname)   // /a/c
  /// ```
  public get pathname(): string {
    return this.path
  }

  /// `?` and the query, or "".
  ///
  /// @example
  /// ```ts
  /// println(new URL("https://example.com/find?q=pico").search)   // ?q=pico
  /// println(new URL("https://example.com/find").search.length)   // 0
  /// ```
  public get search(): string {
    const q = this.query
    if (q == null || q.length == 0) "" else `?${q}`
  }

  /// `#` and the fragment, or "".
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/guide#install")
  /// println(url.hash)   // #install
  /// ```
  public get hash(): string {
    const f = this.fragment
    if (f == null || f.length == 0) "" else `#${f}`
  }

  /// `scheme://host` for http(s)/ws(s)/ftp, else `"null"`.
  ///
  /// @example
  /// ```ts
  /// println(new URL("https://example.com:8443/x?y").origin)   // https://example.com:8443
  /// println(new URL("mailto:ada@example.com").origin)         // null
  /// ```
  public get origin(): string {
    if (__isSpecial(this.scheme) && this.scheme != "file") `${this.scheme}://${this.host}` else "null"
  }

  /// The query's pairs (changing them changes the URL).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/search?q=pico")
  /// println(url.searchParams.get("q"))   // pico
  /// url.searchParams.append("page", "2")
  /// println(url.href)   // https://example.com/search?q=pico&page=2
  /// ```
  public get searchParams(): URLSearchParams {
    const p = this.params
    if (p != null) {
      return p
    }
    const q = this.query
    const made = new URLSearchParams(if (q != null) q else "")
    made.__owner = this
    this.params = made
    return made
  }

  /// The whole URL, serialized.
  ///
  /// @example
  /// ```ts
  /// const url = new URL("HTTP://User@Example.COM:80/a/../b?x#y")
  /// println(url.href)   // http://User@example.com/b?x#y
  /// ```
  public get href(): string {
    let out = `${this.scheme}:`
    if (this.hasHost) {
      out = out + "//"
      if (this.username.length > 0 || this.password.length > 0) {
        out = out + this.username
        if (this.password.length > 0) {
          out = `${out}:${this.password}`
        }
        out = out + "@"
      }
      out = out + this.host
    }
    out = out + this.path
    const q = this.query
    if (q != null) {
      out = `${out}?${q}`
    }
    const f = this.fragment
    if (f != null) {
      out = `${out}#${f}`
    }
    return out
  }

  /// Replaces the path (#66): percent-encoded as the parser does, `?` and `#` kept in it, a
  /// leading `/` added for special schemes. Ignored for an opaque path (`mailto:a@b`).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/a?x=1")
  /// url.pathname = "/docs/read me"
  /// println(url.href)   // https://example.com/docs/read%20me?x=1
  /// ```
  public set pathname(value: string) {
    if (this.opaque) return
    const p = value.replaceAll("?", "%3F").replaceAll("#", "%23")
    const lead = if (__isSpecial(this.scheme) && !p.startsWith("/")) "/" else ""
    this.__reparse(this.__head() + lead + p + this.search + this.hash)
  }

  /// Replaces the query (#66; a leading `?` is optional, `""` removes it). `searchParams`
  /// follows.
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/find?q=old#top")
  /// url.search = "q=new&page=2"
  /// println(url.href)                    // https://example.com/find?q=new&page=2#top
  /// println(url.searchParams.get("page"))   // 2
  /// ```
  public set search(value: string) {
    const q = (if (value.startsWith("?")) value.slice(1) else value).replaceAll("#", "%23")
    this.__reparse(this.__head() + this.path + (if (q.length > 0) `?${q}` else "") + this.hash)
  }

  /// Replaces the fragment (#66; a leading `#` is optional, `""` removes it).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/guide")
  /// url.hash = "install"
  /// println(url.href)   // https://example.com/guide#install
  /// ```
  public set hash(value: string) {
    const f = if (value.startsWith("#")) value.slice(1) else value
    this.__reparse(this.__head() + this.path + this.search + (if (f.length > 0) `#${f}` else ""))
  }

  /// Replaces the host and port (`example.com:8080`; #66): up to a `/`, `?` or `#`. Ignored
  /// without a host (an opaque URL) or for an invalid host.
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/a")
  /// url.host = "pico.dev:8443"
  /// println(url.href)   // https://pico.dev:8443/a
  /// ```
  public set host(value: string) {
    if (!this.hasHost) return
    let h = value
    for (const stop of ["/", "?", "#"]) {
      const at = h.indexOf(stop)
      if (at >= 0) h = h.slice(0, at)
    }
    if (h.length == 0) return
    this.__reparse(`${this.scheme}://${this.__userinfo()}${h}${this.path}${this.search}${this.hash}`)
  }

  /// Replaces the scheme (`"http"` or `"http:"`; #66), as the URL Standard allows: between
  /// two special schemes (`http`, `https`, `ws`, `wss`, `ftp`) or two others, not to or from
  /// `file`; anything else is ignored. A port that's the new scheme's default goes.
  ///
  /// @example
  /// ```ts
  /// const url = new URL("http://example.com:443/")
  /// url.protocol = "https"
  /// println(url.href)   // https://example.com/
  /// ```
  public set protocol(value: string) {
    const v = (if (value.includes(":")) value.slice(0, value.indexOf(":")) else value).toLowerCase()
    if (v.length == 0 || v == this.scheme) return
    if (__isSpecial(v) != __isSpecial(this.scheme) || v == "file" || this.scheme == "file") return
    this.__reparse(v + this.href.slice(this.scheme.length))
  }

  /// `scheme:` and, with a host, `//userinfo@host`: what comes before the path.
  __head(): string {
    if (!this.hasHost) return `${this.scheme}:`
    return `${this.scheme}://${this.__userinfo()}${this.host}`
  }

  /// `user:password@`, or "".
  __userinfo(): string {
    if (this.username.length == 0 && this.password.length == 0) return ""
    return if (this.password.length > 0) `${this.username}:${this.password}@` else `${this.username}@`
  }

  /// Becomes the URL `text` parses to (a setter's result); stays as it is when `text` isn't one.
  /// A `searchParams` already handed out follows the new query.
  __reparse(text: string): void {
    const u = URL.parse(text)
    if (u == null) return
    const n = u!
    this.scheme = n.scheme
    this.username = n.username
    this.password = n.password
    this.hostname = n.hostname
    this.port = n.port
    this.path = n.path
    this.opaque = n.opaque
    this.hasHost = n.hasHost
    this.query = n.query
    this.fragment = n.fragment
    const p = this.params
    if (p != null) p.__parse(n.query ?? "")
  }

  /// `href`.
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/path")
  /// println(url.toString())   // https://example.com/path
  /// println(`link: ${url}`)   // link: https://example.com/path
  /// ```
  public toString(): string {
    return this.href
  }

  /// `href` (as `JSON.stringify` writes a URL).
  ///
  /// @example
  /// ```ts
  /// const url = new URL("https://example.com/a")
  /// println(url.toJSON())   // https://example.com/a
  /// ```
  public toJSON(): string {
    return this.href
  }
}
