// `WebSocket` (WHATWG WebSockets over RFC 6455, spec §13.6), a global: the client
// (`new WebSocket("ws://…")`) and the socket `std/http`'s `upgradeWebSocket` hands a server.
// Text and binary messages (fragmented ones are joined), ping/pong, and the closing
// handshake, over `ws:` or `wss:` (TLS); no extensions.

/// `n` random bytes from the system.
function __randomBytes(n: int): Uint8Array {
  const job = __io(132, n, 0, 0, "", "")
  const h = __io(102, job, 0, 0, "", "")
  __io(104, job, 0, 0, "", "");
  new Uint8Array(new ArrayBuffer(h, n, true), 0, n)
}

function __rotl32(x: int, n: int): int {
  return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF
}

/// `new WebSocket(url, protocols, options)` (a pico extension): extra trusted certificates
/// (PEM) for `wss:`.
///
/// @example
/// ```ts
/// const options: WebSocketOptions = { caCerts: [] }   // PEM certificates to trust for wss:
/// const ws = new WebSocket("ws://127.0.0.1:9/", [], options)
/// ws.onerror = (e) => println(e.type)   // error (nothing listens on port 9)
/// ws.onclose = (e) => println(e.code)   // 1006
/// ```
struct WebSocketOptions {
  /// Extra trusted certificates (PEM) for `wss:`, besides the system's roots.
  caCerts?: string[]
  /// The largest message to receive, in bytes (its fragments together; #67): a bigger one
  /// closes the connection with code 1009 before it's read. No limit by default. A compressed
  /// message counts both ways: as received, and decompressed.
  maxMessageBytes?: int
  /// Whether to compress messages with permessage-deflate (RFC 7692; #67) when the peer agrees:
  /// a client offers it, a server accepts an offer. On by default, as in browsers.
  compress?: bool
}

/// The `sec-websocket-extensions` answer of a server to a client's `offers` (#67):
/// permessage-deflate, unless no offer is one it can take (miniz compresses with a 32 KiB
/// window only, so not one that limits the server's with `server_max_window_bits`).
function __wsDeflateAnswer(offers: string): string? {
  for (const offer of offers.split(",")) {
    const params = offer.split(";").map((p) => p.trim().toLowerCase())
    if (params[0] != "permessage-deflate") {
      continue
    }
    let ok = true
    for (let i = 1; i < params.length; i++) {
      const p = params[i]
      const name = p.split("=")[0].trim()
      if (name == "server_max_window_bits") {
        ok = ok && p.split("=").length == 2 && p.split("=")[1].trim() == "15"
      } else if (name != "client_max_window_bits" && name != "server_no_context_takeover" &&
          name != "client_no_context_takeover") {
        ok = false
      }
    }
    if (ok) {
      // (Each message is compressed on its own, which `server_no_context_takeover` says.)
      return "permessage-deflate; server_no_context_takeover"
    }
  }
  return null
}

/// Whether a server's `sec-websocket-extensions` answer to a client's offer of plain
/// permessage-deflate is one the client can take (#67): no other extension, and no
/// `client_max_window_bits` below 15 (miniz compresses with a 32 KiB window only).
function __wsDeflateAccepted(answer: string): bool {
  const params = answer.split(";").map((p) => p.trim().toLowerCase())
  if (params[0] != "permessage-deflate" || answer.indexOf(",") >= 0) {
    return false
  }
  for (let i = 1; i < params.length; i++) {
    const p = params[i]
    const name = p.split("=")[0].trim()
    if (name == "client_max_window_bits") {
      if (p.split("=").length != 2 || p.split("=")[1].trim() != "15") {
        return false
      }
    } else if (name != "server_max_window_bits" && name != "server_no_context_takeover" &&
        name != "client_no_context_takeover") {
      return false
    }
  }
  return true
}

/// Runs `data` through DEFLATE stream `z` (`__zlib_op` 41): the result, or null when it's
/// corrupt or decompresses to more than the stream's limit.
function __zlibRun(z: int, data: Uint8Array): Uint8Array? {
  const n = __zlib_op(42, z, data.buffer.__handle + data.byteOffset, data.length)
  if (n < 0) {
    return null
  }
  const h = __zlib_op(43, z, 0, 0)
  return new Uint8Array(new ArrayBuffer(h, n, true), 0)
}

/// SHA-1 of `data` (FIPS 180-4), as WebSocket handshakes need it.
function __sha1(data: Uint8Array): Uint8Array {
  const n = data.length
  const total = ((n + 8) / 64 + 1) * 64
  const m = new Uint8Array(total)
  m.setAll(data, 0)
  m.set(n, 0x80)
  const bits = n * 8
  for (let i = 0; i < 8; i++) {
    m.set(total - 1 - i, (bits >> (8 * i)) & 255)
  }
  let h0 = 0x67452301
  let h1 = 0xEFCDAB89
  let h2 = 0x98BADCFE
  let h3 = 0x10325476
  let h4 = 0xC3D2E1F0
  const w: int[] = []
  for (let i = 0; i < 80; i++) {
    w.push(0)
  }
  let block = 0
  while (block < total) {
    for (let i = 0; i < 16; i++) {
      const o = block + i * 4
      w[i] = (m.get(o) << 24) | (m.get(o + 1) << 16) | (m.get(o + 2) << 8) | m.get(o + 3)
    }
    for (let i = 16; i < 80; i++) {
      w[i] = __rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
    }
    let a = h0
    let b = h1
    let c = h2
    let d = h3
    let e = h4
    for (let i = 0; i < 80; i++) {
      let f = 0
      let k = 0
      if (i < 20) {
        f = (b & c) | ((~b) & d)
        k = 0x5A827999
      } else if (i < 40) {
        f = b ^ c ^ d
        k = 0x6ED9EBA1
      } else if (i < 60) {
        f = (b & c) | (b & d) | (c & d)
        k = 0x8F1BBCDC
      } else {
        f = b ^ c ^ d
        k = 0xCA62C1D6
      }
      const t = (__rotl32(a, 5) + (f & 0xFFFFFFFF) + e + k + w[i]) & 0xFFFFFFFF
      e = d
      d = c
      c = __rotl32(b, 30)
      b = a
      a = t
    }
    h0 = (h0 + a) & 0xFFFFFFFF
    h1 = (h1 + b) & 0xFFFFFFFF
    h2 = (h2 + c) & 0xFFFFFFFF
    h3 = (h3 + d) & 0xFFFFFFFF
    h4 = (h4 + e) & 0xFFFFFFFF
    block += 64
  }
  const out = new Uint8Array(20)
  const hs = [h0, h1, h2, h3, h4]
  for (let i = 0; i < 5; i++) {
    for (let k = 0; k < 4; k++) {
      out.set(i * 4 + k, (hs[i] >> (24 - 8 * k)) & 255)
    }
  }
  return out
}

/// `Sec-WebSocket-Accept` for a `Sec-WebSocket-Key`.
function __wsAccept(key: string): string {
  new Base64().encode(__sha1(new TextEncoder().encode(`${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`)))
}

/// An event, as the DOM has them: its `type`, and the `EventTarget` it was dispatched on
/// (`target`, `null` until then). `MessageEvent` and `CloseEvent` add what they carry (#67).
///
/// @example
/// ```ts
/// const e = new Event("open")
/// println(e.type)   // open
/// ```
class Event {
  /// The kind of event: `"open"`, `"error"`, `"abort"`, …
  public readonly type: string
  /// What it was dispatched on (`dispatchEvent`), `null` until then.
  public target: EventTarget? = null

  /// An event of type `type`.
  ///
  /// @example
  /// ```ts
  /// const e = new Event("error")
  /// println(e.type)   // error
  /// ```
  constructor(type: string) {
    this.type = type
  }
}

/// A listener of an `EventTarget`: what's called, and the function as it was given (one of
/// `ev`, `plain`, `msg`, `close`), which removal compares.
struct __Listener {
  type: string
  f: (e: Event) => void
  once: bool
  ev: ((e: Event) => void)?
  plain: (() => void)?
  msg: ((e: MessageEvent) => void)?
  close: ((e: CloseEvent) => void)?
}

/// Whether two listeners are the same function for the same type.
function __sameListener(a: __Listener, b: __Listener): bool {
  if (a.type != b.type) {
    return false
  }
  const x1 = a.ev
  const x2 = b.ev
  if (x1 != null && x2 != null) {
    return __identical(x1, x2)
  }
  const p1 = a.plain
  const p2 = b.plain
  if (p1 != null && p2 != null) {
    return __identical(p1, p2)
  }
  const m1 = a.msg
  const m2 = b.msg
  if (m1 != null && m2 != null) {
    return __identical(m1, m2)
  }
  const c1 = a.close
  const c2 = b.close
  if (c1 != null && c2 != null) {
    return __identical(c1, c2)
  }
  return false
}

/// Something events are dispatched on, as in the DOM (#67): listeners added per type with
/// `addEventListener` (once each: adding the same function again does nothing), run in the
/// order they were added by `dispatchEvent`. A listener takes the `Event`, or nothing; for
/// `"message"` and `"close"` it can take a `MessageEvent` or `CloseEvent` (a `WebSocket`'s).
///
/// @example
/// ```ts
/// const t = new EventTarget()
/// const hello = (e: Event) => println(`got ${e.type}`)
/// t.addEventListener("ping", hello)
/// t.addEventListener("ping", () => println("once"), once: true)
/// t.dispatchEvent(new Event("ping"))   // got ping, then: once
/// t.removeEventListener("ping", hello)
/// t.dispatchEvent(new Event("ping"))   // (nothing)
/// ```
class EventTarget {
  listeners: __Listener[] = []

  /// A target without listeners.
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// println(t.dispatchEvent(new Event("x")))   // true
  /// ```
  constructor() {}

  /// Adds `l` unless the same function listens to that type already.
  add(l: __Listener): void {
    for (const x of this.listeners) {
      if (__sameListener(x, l)) {
        return
      }
    }
    this.listeners.push(l)
  }

  /// Calls `listener` with each event of `type` dispatched on this target (`once`: only the
  /// next one). The same listener added twice for a type is called once.
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// t.addEventListener("tick", (e) => println(e.type))
  /// t.dispatchEvent(new Event("tick"))   // tick
  /// ```
  public addEventListener(type: string, listener: (e: Event) => void, once: bool = false): void {
    this.add({ type, f: listener, once, ev: listener, plain: null, msg: null, close: null })
  }

  /// Calls `listener` (taking no event) for each event of `type`.
  ///
  /// @example
  /// ```ts
  /// const c = new AbortController()
  /// c.signal.addEventListener("abort", () => println("aborted"))
  /// c.abort()   // aborted
  /// ```
  public addEventListener(type: string, listener: () => void, once: bool = false): void {
    const f = (_e: Event) => listener()
    this.add({ type, f, once, ev: null, plain: listener, msg: null, close: null })
  }

  /// Calls `listener` with each message (a `WebSocket`'s, after its `onmessage`).
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// t.addEventListener("message", (e) => {
  ///   match (e.data) {
  ///     s: string => println(s),   // hi
  ///     _ => {},
  ///   }
  /// })
  /// t.dispatchEvent(new MessageEvent("hi"))
  /// ```
  public addEventListener(type: "message", listener: (e: MessageEvent) => void, once: bool = false): void {
    const f = (e: Event) => {
      match (e) {
        m: MessageEvent => listener(m),
        _ => {},
      }
    }
    this.add({ type, f, once, ev: null, plain: null, msg: listener, close: null })
  }

  /// Calls `listener` when a `WebSocket` closes (after its `onclose`).
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// t.addEventListener("close", (e) => println(e.code))
  /// t.dispatchEvent(new CloseEvent(1000, "", true))   // 1000
  /// ```
  public addEventListener(type: "close", listener: (e: CloseEvent) => void, once: bool = false): void {
    const f = (e: Event) => {
      match (e) {
        c: CloseEvent => listener(c),
        _ => {},
      }
    }
    this.add({ type, f, once, ev: null, plain: null, msg: null, close: listener })
  }

  /// Stops calling `listener` for events of `type` (the same function that was added).
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// const f = (e: Event) => println("called")
  /// t.addEventListener("tick", f)
  /// t.removeEventListener("tick", f)
  /// t.dispatchEvent(new Event("tick"))   // (nothing)
  /// ```
  public removeEventListener(type: string, listener: (e: Event) => void): void {
    this.remove({ type, f: listener, once: false, ev: listener, plain: null, msg: null, close: null })
  }

  /// Stops calling a listener taking no event.
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// const f = () => println("called")
  /// t.addEventListener("tick", f)
  /// t.removeEventListener("tick", f)
  /// t.dispatchEvent(new Event("tick"))   // (nothing)
  /// ```
  public removeEventListener(type: string, listener: () => void): void {
    const f = (_e: Event) => listener()
    this.remove({ type, f, once: false, ev: null, plain: listener, msg: null, close: null })
  }

  /// Stops calling a `"message"` listener.
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// const f = (e: MessageEvent) => println("message")
  /// t.addEventListener("message", f)
  /// t.removeEventListener("message", f)
  /// t.dispatchEvent(new MessageEvent("x"))   // (nothing)
  /// ```
  public removeEventListener(type: "message", listener: (e: MessageEvent) => void): void {
    const f = (_e: Event) => {}
    this.remove({ type, f, once: false, ev: null, plain: null, msg: listener, close: null })
  }

  /// Stops calling a `"close"` listener.
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// const f = (e: CloseEvent) => println(e.code)
  /// t.addEventListener("close", f)
  /// t.removeEventListener("close", f)
  /// t.dispatchEvent(new CloseEvent(1000, "", true))   // (nothing)
  /// ```
  public removeEventListener(type: "close", listener: (e: CloseEvent) => void): void {
    const f = (_e: Event) => {}
    this.remove({ type, f, once: false, ev: null, plain: null, msg: null, close: listener })
  }

  remove(l: __Listener): void {
    const kept: __Listener[] = []
    for (const x of this.listeners) {
      if (!__sameListener(x, l)) {
        kept.push(x)
      }
    }
    this.listeners = kept
  }

  /// Runs the listeners of `e.type` with `e` (its `target` set to this), in the order they were
  /// added; `true` (nothing cancels an event here).
  ///
  /// @example
  /// ```ts
  /// const t = new EventTarget()
  /// t.addEventListener("tick", (e) => println(e.target != null))
  /// t.dispatchEvent(new Event("tick"))   // true
  /// ```
  public dispatchEvent(e: Event): bool {
    e.target = this
    // (The listeners as they are now: one added or removed by a listener waits for the next.)
    const now: __Listener[] = []
    for (const l of this.listeners) {
      if (l.type == e.type) {
        now.push(l)
      }
    }
    for (const l of now) {
      if (l.once) {
        this.remove(l)
      }
      const f = l.f
      f(e)
    }
    return true
  }
}

/// A received message: text (`string`) or binary (`Blob` or `ArrayBuffer`) `data`.
///
/// @example
/// ```ts
/// const text = new MessageEvent("hi")
/// match (text.data) {
///   s: string => println(`text: ${s}`),              // text: hi
///   a: ArrayBuffer => println(`${a.byteLength} bytes`),
///   blob: Blob => println(`${blob.size} bytes`),
/// }
/// println(text.type)   // message
/// ```
class MessageEvent extends Event {
  /// The message, as in browsers: a `string` for a text message; a binary one as a `Blob`, or
  /// an `ArrayBuffer` when the socket's `binaryType` is `"arraybuffer"` (#67).
  public readonly data: string | ArrayBuffer | Blob
  /// A message event carrying `data`.
  ///
  /// @example
  /// ```ts
  /// const e = new MessageEvent(Uint8Array.from([1, 2, 3]).buffer)
  /// match (e.data) {
  ///   s: string => println(s),
  ///   a: ArrayBuffer => println(`${a.byteLength} bytes`),   // 3 bytes
  ///   blob: Blob => {},
  /// }
  /// ```
  constructor(data: string | ArrayBuffer | Blob) {
    super("message")
    this.data = data
  }
}

/// How a connection ended: `code` (1000 normal, 1005 none given, 1006 lost), `reason`, and
/// whether the closing handshake completed (`wasClean`).
///
/// @example
/// ```ts
/// const e = new CloseEvent(1000, "done", true)
/// println(`${e.type} ${e.code} ${e.reason} ${e.wasClean}`)   // close 1000 done true
/// ```
class CloseEvent extends Event {
  /// The close code: the peer's, 1005 when its close frame had none, 1006 when the connection was
  /// lost or failed.
  public readonly code: int
  /// The peer's close reason ("" for none).
  public readonly reason: string
  /// Whether the closing handshake completed.
  public readonly wasClean: bool
  /// A close event with `code`, `reason` and `wasClean`.
  ///
  /// @example
  /// ```ts
  /// const lost = new CloseEvent(1006, "", false)
  /// println(lost.code)       // 1006
  /// println(lost.wasClean)   // false
  /// ```
  constructor(code: int, reason: string, wasClean: bool) {
    super("close")
    this.code = code
    this.reason = reason
    this.wasClean = wasClean
  }
}

/// `bytes` as UTF-8 text, or `null` if they aren't UTF-8.
function __wsText(bytes: Uint8Array): string? {
  try {
    return new TextDecoder("utf-8", { fatal: true }).decode(bytes)
  } catch (e) {
    return null
  }
}

/// A WebSocket connection. Assign `onopen`, `onmessage`, `onclose` and `onerror` right after
/// creating it (they're called from the event loop); `send` text or bytes once it's open.
///
/// @example
/// ```ts
/// import { serve, upgradeWebSocket } from "std/http"
///
/// // An echo server on 127.0.0.1.
/// async function handle(req: Request): Promise<Response> throws Error {
///   const up = upgradeWebSocket(req)
///   up.socket.onmessage = (e) => {
///     match (e.data) {
///       s: string => up.socket.send(s),
///       blob: Blob => up.socket.send(blob),
///       a: ArrayBuffer => up.socket.send(a),
///     }
///   }
///   up.response
/// }
/// const server = await serve({ port: 0 }, handle)
///
/// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
/// println(ws.readyState == WebSocket.CONNECTING)   // true
/// await new Promise<void>((resolve, reject) => {
///   ws.onopen = (e) => ws.send("hello")
///   ws.onmessage = (e) => {
///     println(e.data)   // hello
///     ws.close()
///   }
///   ws.onclose = (e) => {
///     println(e.code)   // 1000
///     resolve()
///   }
/// })
/// await server.shutdown()
/// ```
class WebSocket extends EventTarget {
  // (Getters: static fields would be set up at every program's start.)
  /// `readyState` 0: the handshake hasn't finished yet.
  ///
  /// @example
  /// ```ts
  /// const ws = new WebSocket("ws://127.0.0.1:9/")
  /// println(ws.readyState == WebSocket.CONNECTING)   // true (just created)
  /// println(WebSocket.CONNECTING)                    // 0
  /// ws.close()
  /// ```
  public static get CONNECTING(): int { return 0 }
  /// `readyState` 1: messages can be sent and received.
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => {
  ///     println(ws.readyState == WebSocket.OPEN)   // true
  ///     ws.close()
  ///   }
  ///   ws.onclose = (e) => resolve()
  /// })
  /// await server.shutdown()
  /// ```
  public static get OPEN(): int { return 1 }
  /// `readyState` 2: `close()` started the closing handshake.
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => {
  ///     ws.close()
  ///     println(ws.readyState == WebSocket.CLOSING)   // true
  ///   }
  ///   ws.onclose = (e) => resolve()
  /// })
  /// await server.shutdown()
  /// ```
  public static get CLOSING(): int { return 2 }
  /// `readyState` 3: the connection is closed (or never opened).
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => ws.close()
  ///   ws.onclose = (e) => resolve()
  /// })
  /// println(ws.readyState == WebSocket.CLOSED)   // true
  /// println(WebSocket.CLOSED)                    // 3
  /// await server.shutdown()
  /// ```
  public static get CLOSED(): int { return 3 }

  /// The URL connected to, normalized (as `URL.href`); "" for a server-side socket.
  public readonly url: string
  /// The connection's state: `CONNECTING`, `OPEN`, `CLOSING` or `CLOSED` (0–3).
  public readyState: int = 0
  /// Message bytes handed to `send` that aren't written yet (`bufferedAmount`).
  queued: int = 0
  /// The subprotocol the server chose ("" for none).
  public protocol: string = ""
  /// The extensions in use, as the handshake agreed them (#67): `"permessage-deflate"` and
  /// its parameters when messages are compressed, else "".
  public extensions: string = ""
  /// Called once the connection is open (an `"open"` event).
  public onopen: ((e: Event) => void)? = null
  /// Called for each message received while the socket is open (fragmented ones arrive whole).
  public onmessage: ((e: MessageEvent) => void)? = null
  /// Called once when the connection ends, cleanly or not.
  public onclose: ((e: CloseEvent) => void)? = null
  /// Called when connecting fails (an `"error"` event), just before `onclose` with code 1006.
  public onerror: ((e: Event) => void)? = null
  /// How binary messages arrive in `data` (#67), as in browsers: `"blob"` (the default) as a
  /// `Blob`, `"arraybuffer"` as an `ArrayBuffer` (`new Uint8Array(buf, 0)` reads it).
  public binaryType: "blob" | "arraybuffer" = "blob"
  protocols: string[]
  conn: Conn? = null
  reader: __HttpReader? = null
  /// Clients mask what they send; servers don't.
  client: bool = true
  sentClose: bool = false
  closed: bool = false
  tls: bool = false
  caCerts: string = ""
  /// `WebSocketOptions.maxMessageBytes` (0: no limit).
  public __maxMessageBytes: int = 0
  /// `WebSocketOptions.compress`.
  public __compress: bool = true
  /// permessage-deflate's streams once agreed (`__zlib_op` handles; 0 before).
  deflater: int = 0
  inflater: int = 0

  /// Starts compressing (#67): the handshake agreed permessage-deflate as `answer`. Without
  /// DEFLATE (the browser build) the socket stays uncompressed and says so.
  public __startDeflate(answer: string): bool {
    const d = __zlib_op(41, 0, 0, 0)
    if (d == 0) {
      return false
    }
    this.deflater = d
    this.inflater = __zlib_op(41, 1, this.__maxMessageBytes, 0)
    this.extensions = answer
    return true
  }

  /// `onmessage`, then the `"message"` listeners (`EventTarget`).
  emitMessage(e: MessageEvent): void {
    const f = this.onmessage
    if (f != null) {
      f(e)
    }
    this.dispatchEvent(e)
  }

  /// `onclose`, then the `"close"` listeners (`EventTarget`).
  emitClose(e: CloseEvent): void {
    const f = this.onclose
    if (f != null) {
      f(e)
    }
    this.dispatchEvent(e)
  }

  /// Connects to `url` (`ws:`/`wss:`, or `http:`/`https:` as the same). An invalid URL or
  /// another scheme throws a `TypeError`. (pico) `options.caCerts` adds trusted certificates
  /// (PEM) for `wss:`.
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/chat`)
  /// println(ws.url)   // e.g. ws://127.0.0.1:41234/chat
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => {
  ///     println(e.type)   // open
  ///     ws.close()
  ///   }
  ///   ws.onclose = (e) => resolve()
  /// })
  /// await server.shutdown()
  /// try {
  ///   const bad = new WebSocket("ftp://example.com/")
  ///   bad.close()
  /// } catch (e: TypeError) {
  ///   println("not a ws: URL")   // not a ws: URL
  /// }
  /// ```
  constructor(url: string, protocols: string[] = [], options: WebSocketOptions = {}) throws TypeError {
    this.protocols = protocols
    this.caCerts = (options.caCerts ?? []).join("\n")
    this.__maxMessageBytes = options.maxMessageBytes ?? 0
    this.__compress = options.compress ?? true
    if (url.length == 0) {
      // (A server-side socket: `std/http` attaches the connection.)
      this.url = ""
      this.client = false
      return
    }
    const u = new URL(url)
    this.tls = u.protocol == "wss:" || u.protocol == "https:"
    if (u.protocol != "ws:" && u.protocol != "http:" && !this.tls) {
      throw new TypeError(`WebSocket: ${u.protocol} is not a WebSocket URL`)
    }
    this.url = u.href
    this.handshake(u);
  }

  async handshake(u: URL): Promise<void> {
    try {
      const port = if (u.port.length > 0) parseInt(u.port) else if (this.tls) 443 else 80
      const c = await __netConnect(port, __connectHost(u))
      // `close()` while connecting ends the attempt (#23): no `onopen` after `onclose`.
      if (this.closed) {
        c.close()
        return
      }
      this.conn = c
      if (this.tls) {
        await c.__startTls(0, __connectHost(u), this.caCerts)
      }
      const key = new Base64().encode(__randomBytes(16))
      let head = `GET ${u.pathname}${u.search} HTTP/1.1\r\nhost: ${u.host}\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: ${key}\r\nsec-websocket-version: 13\r\n`
      if (this.protocols.length > 0) {
        head = `${head}sec-websocket-protocol: ${this.protocols.join(", ")}\r\n`
      }
      // (Offered only where it can run: the browser build has no DEFLATE.)
      const probe = if (this.__compress) __zlib_op(41, 0, 0, 0) else 0
      if (probe != 0) {
        __zlib_op(44, probe, 0, 0)
        head = `${head}sec-websocket-extensions: permessage-deflate\r\n`
      }
      await c.writeText(`${head}\r\n`)
      const r = new __HttpReader(c)
      const text = await r.head()
      if (text == null) {
        throw new TypeError("the server closed the connection")
      }
      const h = __parseHead(text)
      const accept = h.headers.get("sec-websocket-accept")
      if (h.second != "101" || accept == null || accept != __wsAccept(key)) {
        throw new TypeError(`the server refused the WebSocket (status ${h.second})`)
      }
      const p = h.headers.get("sec-websocket-protocol")
      this.protocol = if (p != null) p else ""
      const ext = h.headers.get("sec-websocket-extensions")
      if (ext != null) {
        // An extension we didn't offer, or can't take, fails the connection (RFC 6455 §4.1).
        if (probe == 0 || !__wsDeflateAccepted(ext) || !this.__startDeflate(ext)) {
          throw new TypeError("the server chose an extension that wasn't offered")
        }
      }
      this.__attach(c, r)
    } catch (e) {
      this.fail()
    }
  }

  /// Starts a socket on an upgraded connection (`r` may hold bytes already read).
  public __attach(c: Conn, r: __HttpReader): void {
    if (this.closed) {
      c.close()
      return
    }
    this.conn = c
    this.reader = r
    this.readyState = 1
    const f = this.onopen
    const open = new Event("open")
    if (f != null) {
      f(open)
    }
    this.dispatchEvent(open)
    this.receive();
  }

  /// A failure before or during the connection: `error`, then `close` (code 1006).
  fail(): void {
    if (this.closed) {
      return
    }
    const f = this.onerror
    const err = new Event("error")
    if (f != null) {
      f(err)
    }
    this.dispatchEvent(err)
    this.finish(1006, "", false)
  }

  finish(code: int, reason: string, clean: bool): void {
    if (this.closed) {
      return
    }
    this.closed = true
    this.readyState = 3
    if (this.deflater != 0) {
      __zlib_op(44, this.deflater, 0, 0)
      __zlib_op(44, this.inflater, 0, 0)
      this.deflater = 0
      this.inflater = 0
    }
    const c = this.conn
    if (c != null) {
      c.close()
    }
    this.emitClose(new CloseEvent(code, reason, clean))
  }

  /// Text that isn't UTF-8 fails the connection with code 1007 (RFC 6455 §8.1, #48): a close
  /// frame says why, and the socket closes.
  async failInvalidText(): Promise<void> throws NetError {
    await this.failWith(1007)
  }

  /// Fails the connection with `code`: a close frame says it, and the socket closes.
  async failWith(code: int): Promise<void> throws NetError {
    if (!this.sentClose) {
      this.sentClose = true
      const payload = new Uint8Array(2)
      payload.set(0, code >> 8)
      payload.set(1, code & 255)
      await this.sendFrame(8, payload)
    }
    this.finish(code, "", false)
  }

  /// Frames until the connection closes.
  async receive(): Promise<void> {
    const r = this.reader
    if (r == null) {
      return
    }
    let parts: Uint8Array[] = []
    let messageOp = 0
    // (Whether the message is compressed: RSV1 on its first frame.)
    let compressed = false
    // (The message's size so far, for `maxMessageBytes`.)
    let size = 0
    try {
      while (true) {
        const h = await r.exact(2)
        const fin = (h[0] & 0x80) != 0
        const op = h[0] & 15
        // RSV1 marks a compressed message's first frame, once permessage-deflate is agreed;
        // any other reserved bit is a protocol error (1002).
        const rsv = h[0] & 0x70
        if (rsv != 0 && (rsv != 0x40 || this.inflater == 0 || (op != 1 && op != 2))) {
          await this.failWith(1002)
          return
        }
        const masked = (h[1] & 0x80) != 0
        let len = h[1] & 127
        if (len == 126) {
          const x = await r.exact(2)
          len = (x[0] << 8) | x[1]
        } else if (len == 127) {
          const x = await r.exact(8)
          len = 0
          for (let i = 0; i < 8; i++) {
            len = (len << 8) | x[i]
          }
        }
        const key = if (masked) await r.exact(4) else new Uint8Array(0)
        // A message bigger than `maxMessageBytes` fails with 1009 before its payload is read.
        const max = this.__maxMessageBytes
        if (max > 0 && op < 8) {
          size += len
          if (size > max) {
            await this.failWith(1009)
            return
          }
        }
        const payload = await r.exact(len)
        if (masked) {
          for (let i = 0; i < len; i++) {
            payload.set(i, payload.get(i) ^ key.get(i % 4))
          }
        }
        if (op == 8) {
          // Close: answer it (unless we started it) and end.
          let code = 1005
          let reason = ""
          if (len >= 2) {
            code = (payload[0] << 8) | payload[1]
            const text = __wsText(payload.subarray(2))
            if (text == null) {
              await this.failInvalidText()
              return
            }
            reason = text
          }
          if (!this.sentClose) {
            await this.sendFrame(8, payload)
            this.sentClose = true
          }
          this.finish(code, reason, true)
          return
        }
        if (op == 9) {
          await this.sendFrame(10, payload)
          continue
        }
        if (op == 10) {
          continue
        }
        if (op == 1 || op == 2) {
          messageOp = op
          compressed = rsv != 0
        }
        parts.push(payload)
        if (fin) {
          const joined = if (parts.length == 1) parts[0] else __concatBytes(parts)
          parts = []
          size = 0
          // (A decompressed message bigger than `maxMessageBytes` fails with 1009 too.)
          const inflated = if (compressed) __zlibRun(this.inflater, joined) else joined
          if (inflated == null) {
            await this.failWith(if (this.__maxMessageBytes > 0) 1009 else 1007)
            return
          }
          const whole: Uint8Array = inflated
          if (this.readyState == 1) {
            if (messageOp == 1) {
              const text = __wsText(whole)
              if (text == null) {
                await this.failInvalidText()
                return
              }
              this.emitMessage(new MessageEvent(text))
            } else if (this.binaryType == "blob") {
              this.emitMessage(new MessageEvent(new Blob([whole])))
            } else {
              this.emitMessage(new MessageEvent(__ownBuffer(whole)))
            }
          }
        }
      }
    } catch (e) {
      this.finish(1006, "", false)
    }
  }

  /// Writes one frame (masked when this is a client; `rsv1` for a compressed message).
  async sendFrame(op: int, payload: Uint8Array, rsv1: bool = false): Promise<void> throws NetError {
    const c = this.conn
    if (c == null) {
      return
    }
    const n = payload.length
    const ext = if (n < 126) 0 else if (n < 65536) 2 else 8
    const maskLen = if (this.client) 4 else 0
    const frame = new Uint8Array(2 + ext + maskLen + n)
    frame.set(0, 0x80 | (if (rsv1) 0x40 else 0) | op)
    let i = 2
    if (ext == 0) {
      frame.set(1, n | (if (this.client) 0x80 else 0))
    } else if (ext == 2) {
      frame.set(1, 126 | (if (this.client) 0x80 else 0))
      frame.set(2, (n >> 8) & 255)
      frame.set(3, n & 255)
      i = 4
    } else {
      frame.set(1, 127 | (if (this.client) 0x80 else 0))
      for (let k = 0; k < 8; k++) {
        frame.set(2 + k, (n >> (56 - 8 * k)) & 255)
      }
      i = 10
    }
    if (this.client) {
      const key = __randomBytes(4)
      frame.setAll(key, i)
      for (let k = 0; k < n; k++) {
        frame.set(i + 4 + k, payload.get(k) ^ key.get(k % 4))
      }
    } else {
      frame.setAll(payload, i)
    }
    await c.write(frame)
  }

  /// The bytes of messages `send` was given that aren't written to the connection yet (#67):
  /// what a sender checks to keep from queuing too much. Frame headers, pings and the closing
  /// handshake don't count.
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => {
  ///     ws.send("hello")
  ///     println(ws.bufferedAmount)   // 5 (until it's written)
  ///     ws.close()
  ///   }
  ///   ws.onclose = (e) => resolve(__void())
  /// })
  /// await server.shutdown()
  /// ```
  public get bufferedAmount(): int { return this.queued }

  /// Sends a message, counted in `bufferedAmount` until it's written.
  async sendCounted(op: int, payload: Uint8Array): Promise<void> {
    this.queued += payload.length
    await this.sendSafely(op, payload)
    this.queued -= payload.length
  }

  async sendSafely(op: int, payload: Uint8Array): Promise<void> {
    try {
      // Messages of a few bytes aren't worth compressing (the flag is per message).
      if (this.deflater != 0 && payload.length >= 32) {
        const packed = __zlibRun(this.deflater, payload)
        if (packed != null) {
          await this.sendFrame(op, packed, true)
          return
        }
      }
      await this.sendFrame(op, payload)
    } catch (e) {
      this.finish(1006, "", false)
    }
  }

  /// Sends a text or binary message. Panics before the socket is open.
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => {
  ///     ws.send("text")
  ///     ws.send(Uint8Array.from([1, 2, 3]))
  ///   }
  ///   let got = 0
  ///   ws.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => println(`text: ${s}`),             // text: text
  ///       blob: Blob => println(`${blob.size} bytes`),    // 3 bytes
  ///       a: ArrayBuffer => {},
  ///     }
  ///     got += 1
  ///     if (got == 2) ws.close()
  ///   }
  ///   ws.onclose = (e) => resolve()
  /// })
  /// await server.shutdown()
  /// ```
  public send(data: string | BufferSource | Blob): void {
    if (this.readyState == 0) {
      panic("WebSocket: send() before the connection is open")
    }
    if (this.readyState != 1) {
      return
    }
    match (data) {
      s: string => this.sendCounted(1, new TextEncoder().encode(s)),
      // (Binary data or a blob's bytes, as a binary message.)
      _ => this.sendCounted(2, __partBytes(data)),
    };
  }

  /// Starts the closing handshake (`code` 1000 or 3000–4999, `reason` at most 123 bytes).
  ///
  /// @example
  /// ```ts
  /// import { serve, upgradeWebSocket } from "std/http"
  ///
  /// // An echo server on 127.0.0.1.
  /// async function handle(req: Request): Promise<Response> throws Error {
  ///   const up = upgradeWebSocket(req)
  ///   up.socket.onmessage = (e) => {
  ///     match (e.data) {
  ///       s: string => up.socket.send(s),
  ///       blob: Blob => up.socket.send(blob),
  ///       a: ArrayBuffer => up.socket.send(a),
  ///     }
  ///   }
  ///   up.response
  /// }
  /// const server = await serve({ port: 0 }, handle)
  ///
  /// const ws = new WebSocket(`ws://127.0.0.1:${server.addr.port}/`)
  /// await new Promise<void>((resolve, reject) => {
  ///   ws.onopen = (e) => ws.close(4000, "bye")
  ///   ws.onclose = (e) => {
  ///     println(`${e.code} ${e.reason} ${e.wasClean}`)   // 4000 bye true
  ///     resolve()
  ///   }
  /// })
  /// await server.shutdown()
  /// ```
  public close(code: int = 1000, reason: string = ""): void {
    if (this.readyState >= 2) {
      return
    }
    if (code != 1000 && (code < 3000 || code > 4999)) {
      panic(`WebSocket: close code ${code} isn't allowed (1000 or 3000–4999)`)
    }
    const why = new TextEncoder().encode(reason)
    if (why.length > 123) {
      panic("WebSocket: the close reason is longer than 123 bytes")
    }
    if (this.readyState == 0) {
      this.finish(1006, "", false)
      return
    }
    this.readyState = 2
    this.sentClose = true
    const payload = new Uint8Array(2 + why.length)
    payload.set(0, (code >> 8) & 255)
    payload.set(1, code & 255)
    payload.setAll(why, 2)
    this.sendSafely(8, payload);
  }
}
