// Array methods (spec §13.1). `xs.name(args)` on a `T[]` calls `__Array_name(xs, args)`.
// Callbacks take the element only; what they throw, the method throws (§7.2).

/// A new array of `f` of each element, in order: `[1, 2].map(x => x * 2)` is `[2, 4]`.
function __Array_map<T, U, E extends Error>(xs: T[], f: (x: T) => U throws E): U[] throws E {
  const out: U[] = []
  for (const x of xs) {
    out.push(f(x))
  }
  out
}

/// A new array of the elements for which `f` is true, in order.
function __Array_filter<T, E extends Error>(xs: T[], f: (x: T) => bool throws E): T[] throws E {
  const out: T[] = []
  for (const x of xs) {
    if (f(x)) {
      out.push(x)
    }
  }
  out
}

/// Folds the elements into one value: `f(acc, x)` for each element in order, starting from
/// `initial`. `[1, 2, 3].reduce((sum, x) => sum + x, 0)` is `6`.
function __Array_reduce<T, A, E extends Error>(
  xs: T[],
  f: (acc: A, x: T) => A throws E,
  initial: A,
): A throws E {
  let acc = initial
  for (const x of xs) {
    acc = f(acc, x)
  }
  acc
}

/// Calls `f` with each element, in order.
function __Array_forEach<T, E extends Error>(xs: T[], f: (x: T) => void throws E): void throws E {
  for (const x of xs) {
    f(x)
  }
}

/// The first element for which `f` is true, or `null`.
function __Array_find<T, E extends Error>(xs: T[], f: (x: T) => bool throws E): T? throws E {
  for (const x of xs) {
    if (f(x)) {
      return x
    }
  }
  null
}

/// The index of the first element for which `f` is true, or -1.
function __Array_findIndex<T, E extends Error>(xs: T[], f: (x: T) => bool throws E): int throws E {
  let i = 0
  for (const x of xs) {
    if (f(x)) {
      return i
    }
    i += 1
  }
  -1
}

/// Whether `f` is true for at least one element (stops at the first; false for an empty array).
function __Array_some<T, E extends Error>(xs: T[], f: (x: T) => bool throws E): bool throws E {
  for (const x of xs) {
    if (f(x)) {
      return true
    }
  }
  false
}

/// Whether `f` is true for every element (stops at the first that isn't; true for an empty array).
function __Array_every<T, E extends Error>(xs: T[], f: (x: T) => bool throws E): bool throws E {
  for (const x of xs) {
    if (!f(x)) {
      return false
    }
  }
  true
}

/// The index of the first element `== value`, or -1.
function __Array_indexOf<T extends Equatable<T>>(xs: T[], value: T): int {
  let i = 0
  for (const x of xs) {
    if (x == value) {
      return i
    }
    i += 1
  }
  -1
}

/// Whether an element is `== value`.
function __Array_includes<T extends Equatable<T>>(xs: T[], value: T): bool {
  __Array_indexOf(xs, value) >= 0
}

/// The elements' string forms joined with commas: `[1, 2].join()` is `"1,2"`.
function __Array_join<T>(xs: T[]): string {
  __Array_join(xs, ",")
}

/// The elements' string forms joined with `separator`: `["a", "b"].join(", ")` is `"a, b"`.
function __Array_join<T>(xs: T[], separator: string): string {
  let out = ""
  let first = true
  for (const x of xs) {
    if (!first) {
      out = out + separator
    }
    out = out + `${x}`
    first = false
  }
  out
}

/// `start` and `end` as in `slice`: negative counts from the end, both clamped.
function __clampIndex(i: int, n: int): int {
  if (i < 0) {
    if (n + i < 0) 0 else n + i
  } else if (i > n) {
    n
  } else {
    i
  }
}

/// A new array of the elements from index `start` to the end. A negative `start` counts from the
/// end (`xs.slice(-2)`: the last two); it's clamped to the array.
function __Array_slice<T>(xs: T[], start: int): T[] {
  __Array_slice(xs, start, xs.length)
}

/// A new array of the elements from index `start` up to (not including) `end`. Negative indices
/// count from the end; both are clamped to the array, and `start >= end` gives an empty array.
function __Array_slice<T>(xs: T[], start: int, end: int): T[] {
  const out: T[] = []
  let i = __clampIndex(start, xs.length)
  const stop = __clampIndex(end, xs.length)
  while (i < stop) {
    out.push(xs[i])
    i += 1
  }
  out
}

/// Removes the elements from index `start` to the end (in place) and returns them. A negative
/// `start` counts from the end; it's clamped to the array.
function __Array_splice<T>(xs: T[], start: int): T[] {
  __Array_splice(xs, start, xs.length)
}

/// Removes `deleteCount` elements from index `start`, inserts `items` there (in place), and
/// returns the removed elements. A negative `start` counts from the end; `start` and the count
/// are clamped to the array.
function __Array_splice<T>(xs: T[], start: int, deleteCount: int, ...items: T[]): T[] {
  const s = __clampIndex(start, xs.length)
  const d = if (deleteCount < 0) 0 else if (deleteCount > xs.length - s) xs.length - s else deleteCount
  const removed = __Array_slice(xs, s, s + d)
  const tail = __Array_slice(xs, s + d)
  while (xs.length > s) {
    xs.pop()
  }
  for (const x of items) {
    xs.push(x)
  }
  for (const x of tail) {
    xs.push(x)
  }
  removed
}

/// A new array of this array's elements followed by `other`'s.
function __Array_concat<T>(xs: T[], other: T[]): T[] {
  const out: T[] = []
  for (const x of xs) {
    out.push(x)
  }
  for (const x of other) {
    out.push(x)
  }
  out
}

/// Reverses in place and returns the array.
function __Array_reverse<T>(xs: T[]): T[] {
  let i = 0
  let j = xs.length - 1
  while (i < j) {
    const t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
    i += 1
    j -= 1
  }
  xs
}

/// Sorts in place (stable merge sort) by `<` and returns the array.
function __Array_sort<T extends Comparable<T>>(xs: T[]): T[] {
  __Array_sort(xs, (a: T, b: T) => if (a < b) -1 else if (b < a) 1 else 0)
}

/// Sorts in place (stable merge sort) by `compare` (negative: `a` first) and returns the array.
function __Array_sort<T, E extends Error>(xs: T[], compare: (a: T, b: T) => int throws E): T[] throws E {
  const n = xs.length
  if (n < 2) {
    return xs
  }
  let src = __Array_slice(xs, 0)
  let dst = __Array_slice(xs, 0)
  let width = 1
  while (width < n) {
    let lo = 0
    while (lo < n) {
      const mid = if (lo + width < n) lo + width else n
      const hi = if (lo + 2 * width < n) lo + 2 * width else n
      let i = lo
      let j = mid
      let k = lo
      while (k < hi) {
        if (i < mid && (j >= hi || compare(src[j], src[i]) >= 0)) {
          dst[k] = src[i]
          i += 1
        } else {
          dst[k] = src[j]
          j += 1
        }
        k += 1
      }
      lo = hi
    }
    const t = src
    src = dst
    dst = t
    width = width * 2
  }
  let k = 0
  while (k < n) {
    xs[k] = src[k]
    k += 1
  }
  xs
}

/// The sum of the elements (`0` for none).
function __Array_sum(xs: int[]): int {
  let total = 0
  for (const x of xs) {
    total += x
  }
  total
}
