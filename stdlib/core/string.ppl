// String methods (spec §13.1). `s.name(args)` calls `__String_name(s, args)`. Indices count
// code points, like `s[i]` and `s.length`; `s.slice(start, end)` is built in.

/// Where the first occurrence of `search` starts (in code points, like `s[i]`), or -1. An empty
/// `search` is found at 0.
function __String_indexOf(s: string, search: string): int {
  const n = s.length
  const m = search.length
  let i = 0
  while (i + m <= n) {
    if (__matchesAt(s, search, i)) {
      return i
    }
    i += 1
  }
  -1
}

function __matchesAt(s: string, search: string, at: int): bool {
  let k = 0
  while (k < search.length) {
    if (s[at + k] != search[k]) {
      return false
    }
    k += 1
  }
  true
}

/// Whether `search` occurs in the string.
function __String_includes(s: string, search: string): bool {
  __String_indexOf(s, search) >= 0
}

/// Whether the string starts with `prefix`.
function __String_startsWith(s: string, prefix: string): bool {
  prefix.length <= s.length && __matchesAt(s, prefix, 0)
}

/// Whether the string ends with `suffix`.
function __String_endsWith(s: string, suffix: string): bool {
  suffix.length <= s.length && __matchesAt(s, suffix, s.length - suffix.length)
}

function __isSpace(c: char): bool {
  const n = c as u32
  n == 32 || (n >= 9 && n <= 13)
}

/// The string without leading whitespace (spaces, tabs, line breaks, vertical tabs and form feeds).
function __String_trimStart(s: string): string {
  let i = 0
  while (i < s.length && __isSpace(s[i])) {
    i += 1
  }
  s.slice(i)
}

/// The string without trailing whitespace (spaces, tabs, line breaks, vertical tabs and form
/// feeds).
function __String_trimEnd(s: string): string {
  let j = s.length
  while (j > 0 && __isSpace(s[j - 1])) {
    j -= 1
  }
  s.slice(0, j)
}

/// The string without leading and trailing whitespace (spaces, tabs, line breaks, vertical tabs and
/// form feeds).
function __String_trim(s: string): string {
  __String_trimEnd(__String_trimStart(s))
}

/// ASCII letters only.
function __String_toUpperCase(s: string): string {
  let out = ""
  for (const c of s) {
    const n = c as u32
    out = out + (if (n >= 97 && n <= 122) `${(n - 32) as char}` else `${c}`)
  }
  out
}

/// ASCII letters only.
function __String_toLowerCase(s: string): string {
  let out = ""
  for (const c of s) {
    const n = c as u32
    out = out + (if (n >= 65 && n <= 90) `${(n + 32) as char}` else `${c}`)
  }
  out
}

/// The pieces of the string between occurrences of `separator` (a string or a `RegExp`, whose
/// captured groups are spliced in), at most `limit` of them; an empty separator splits into
/// characters.
function __String_split(s: string, separator: string | RegExp, limit: int = -1): string[] {
  match (separator) {
    sep: string => {
      const parts = __splitStr(s, sep)
      if (limit >= 0 && parts.length > limit) parts.slice(0, limit) else parts
    },
    re: RegExp => __rSplit(s, re, limit),
  }
}

function __splitStr(s: string, separator: string): string[] {
  const out: string[] = []
  if (separator.length == 0) {
    for (const c of s) {
      out.push(`${c}`)
    }
    return out
  }
  let start = 0
  let i = 0
  while (i + separator.length <= s.length) {
    if (__matchesAt(s, separator, i)) {
      out.push(s.slice(start, i))
      i += separator.length
      start = i
    } else {
      i += 1
    }
  }
  out.push(s.slice(start))
  out
}

/// Replaces the first occurrence of `search` (every match for a `RegExp` with the `g` flag).
/// `replacement` may use `$&`, `$1`, `$<name>`, `` $` ``, `$'` and `$$`, or be a function of the
/// match.
function __String_replace(s: string, search: string | RegExp, replacement: string | ((m: RegExpMatch) => string)): string {
  match (search) {
    t: string => {
      const i = __String_indexOf(s, t)
      if (i < 0) {
        return s
      }
      const m = new RegExpMatch([t], i, s, null)
      s.slice(0, i) + __rReplaceWith(replacement, m, s) + s.slice(i + t.length)
    },
    re: RegExp => __rReplace(s, re, replacement, re.global),
  }
}

/// Replaces every occurrence of `search` (a `RegExp` needs the `g` flag).
function __String_replaceAll(s: string, search: string | RegExp, replacement: string | ((m: RegExpMatch) => string)): string {
  match (search) {
    t: string => match (replacement) {
      r: string => if (r.includes("$")) __rReplace(s, RegExp.__literal(__rQuote(t), "g"), r, true) else __replaceAllStr(s, t, r),
      f: __ReplaceFn => __rReplace(s, RegExp.__literal(__rQuote(t), "g"), f, true),
    },
    re: RegExp => {
      if (!re.global) {
        panic("replaceAll must be called with a global RegExp")
      }
      __rReplace(s, re, replacement, true)
    },
  }
}

/// The first match of `re` (no `g` flag), or every match's text (`g`); `null` without one.
function __String_match(s: string, re: RegExp): RegExpMatch? {
  if (!re.global) {
    return re.exec(s)
  }
  const all = __rMatchAll(s, re)
  re.lastIndex = 0
  if (all.length == 0) {
    return null
  }
  const items: (string?)[] = []
  for (const m of all) {
    items.push(m[0])
  }
  new RegExpMatch(items, -1, s, null)
}

/// Every match of `re`, with its groups and index.
function __String_matchAll(s: string, re: RegExp): RegExpMatch[] {
  __rMatchAll(s, re)
}

/// Where the first match of `re` starts, or -1.
function __String_search(s: string, re: RegExp): int {
  const caps = re.__search(__rChars(s), 0, re.sticky)
  if (caps == null) -1 else caps[0]
}

/// `s` with regex syntax characters escaped (a pattern matching `s` literally).
function __rQuote(s: string): string {
  let out = ""
  for (const c of s) {
    if ("\\^$.*+?()[]{}|/".includes(`${c}`)) {
      out = `${out}\\${c}`
    } else {
      out = `${out}${c}`
    }
  }
  out
}

function __replaceAllStr(s: string, search: string, replacement: string): string {
  if (search.length == 0) {
    return s
  }
  let out = ""
  let start = 0
  let i = 0
  while (i + search.length <= s.length) {
    if (__matchesAt(s, search, i)) {
      out = out + s.slice(start, i) + replacement
      i += search.length
      start = i
    } else {
      i += 1
    }
  }
  out + s.slice(start)
}

/// The string `count` times over: `"ab".repeat(3)` is `"ababab"` (empty for a `count` of 0 or
/// less).
function __String_repeat(s: string, count: int): string {
  // By doubling: O(n) bytes built rather than O(n²) (a 100 kB string was 5 GB of garbage).
  let out = ""
  let piece = s
  let n = count
  while (n > 0) {
    if (n % 2 == 1) {
      out = out + piece
    }
    n = n / 2
    if (n > 0) {
      piece = piece + piece
    }
  }
  out
}

function __padding(length: int, fill: string): string {
  let pad = ""
  if (fill.length == 0) {
    return pad
  }
  while (pad.length < length) {
    pad = pad + fill
  }
  pad.slice(0, length)
}

/// The string padded with spaces at the start to `length` code points (unchanged if it's that long
/// already): `"7".padStart(3)` is `"  7"`.
function __String_padStart(s: string, length: int): string {
  __String_padStart(s, length, " ")
}

/// The string padded at the start to `length` code points with `fill`, repeated and cut to fit
/// (unchanged if it's that long already, or `fill` is empty): `"7".padStart(3, "0")` is `"007"`.
function __String_padStart(s: string, length: int, fill: string): string {
  if (s.length >= length) s else __padding(length - s.length, fill) + s
}

/// The string padded with spaces at the end to `length` code points (unchanged if it's that long
/// already).
function __String_padEnd(s: string, length: int): string {
  __String_padEnd(s, length, " ")
}

/// The string padded at the end to `length` code points with `fill`, repeated and cut to fit
/// (unchanged if it's that long already, or `fill` is empty).
function __String_padEnd(s: string, length: int, fill: string): string {
  if (s.length >= length) s else s + __padding(length - s.length, fill)
}

/// The integer at the start of `s`, like JavaScript's `parseInt(s)` in base 10: leading
/// whitespace, an optional sign, then digits up to the first non-digit. Panics without any
/// digits (`int` has no `NaN`).
function parseInt(s: string): int {
  let i = 0
  const n = s.length
  while (i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')) {
    i += 1
  }
  let negative = false
  if (i < n && (s[i] == '-' || s[i] == '+')) {
    negative = s[i] == '-'
    i += 1
  }
  const start = i
  let value = 0
  while (i < n && s[i] >= '0' && s[i] <= '9') {
    value = value * 10 + ((s[i] as u32) as int - 48)
    i += 1
  }
  if (i == start) {
    panic(`parseInt: no digits in "${s}"`)
  }
  if (negative) -value else value
}

/// The last position of `search` in `s`, or -1.
function __String_lastIndexOf(s: string, search: string): int {
  const n = s.length
  const m = search.length
  let i = n - m
  while (i >= 0) {
    if (s.slice(i, i + m) == search) {
      return i
    }
    i -= 1
  }
  -1
}

// `string.fromC(p)` (spec §12.1): a copy of the NUL-terminated UTF-8 string at `p`.
extern "C" {
  function ppl_str_from_c(p: ptr<u8>): string
}
