// Binary data (spec §10.3): `ArrayBuffer` holds bytes off the GC heap (malloc'd), so
// moving one to a worker (`postMessage(m, { transfer: [buf] })`) only hands over the
// pointer and detaches it here. Without a transfer, a message gets a copy of the bytes.

/// Raw bytes, off the GC heap. (A received copy's memory isn't freed yet.)
class ArrayBuffer {
  /// The memory (0: detached). The runtime knows this layout: `{ class, handle, byteLength }`.
  public __handle: int
  /// Its size in bytes (0 once detached).
  public byteLength: int

  /// `byteLength` zeroed bytes (a negative length gives an empty buffer).
  constructor(byteLength: int) {
    const n = if (byteLength < 0) 0 else byteLength
    __reclaimBuffers(n)
    this.__handle = __buf_op(1, n, 0, 0)
    this.byteLength = n
    __bufferRegistry().registerWithToken(this, this.__handle, this)
  }

  /// Takes over memory the runtime allocated (`std/fs` reads).
  constructor(handle: int, byteLength: int, __adopt: bool) {
    __reclaimBuffers(byteLength)
    this.__handle = handle
    this.byteLength = byteLength
    __buf_op(5, byteLength, 0, 0);  // the collector counts it (#90)
    __bufferRegistry().registerWithToken(this, this.__handle, this)
  }

  /// Whether it was transferred away (its length is then 0).
  public get detached(): bool {
    this.__handle == 0
  }

  /// A copy of bytes `begin..end` (negative counts from the end; `end` defaults to the end).
  public slice(begin: int = 0, end: int? = null): ArrayBuffer {
    const a = this.clampIndex(begin)
    const e = end
    const z = if (e != null) this.clampIndex(e) else this.byteLength
    const b = if (z < a) a else z
    // One copy of the range (`__buf_op` 3); nothing to copy (or a detached buffer): a new one.
    if (b == a) new ArrayBuffer(0) else new ArrayBuffer(__buf_op(3, this.__handle, a, b - a), b - a, true)
  }

  /// `i` clamped to `0..byteLength`, a negative one counted from the end.
  private clampIndex(i: int): int {
    if (i < 0) {
      const j = this.byteLength + i
      return if (j < 0) 0 else j
    }
    if (i > this.byteLength) this.byteLength else i
  }

  /// After a transfer: the bytes belong to the receiver now.
  public __detach(): void {
    __bufferRegistry().unregister(this)
    this.__handle = 0
    this.byteLength = 0
  }
}

/// Frees buffers' memory once they're collected.
let __buffers: FinalizationRegistry<int>? = null

function __bufferRegistry(): FinalizationRegistry<int> {
  const r = __buffers
  if (r != null) {
    return r
  }
  const made = new FinalizationRegistry<int>((h: int) => {
    __buf_op(2, h, 0, 0);
  })
  __buffers = made
  made
}

/// Collections counted when buffers were last reclaimed here, and buffer bytes made since then.
let __reclaimedAtCycle = -1
let __bytesSinceReclaim = 0

/// Before `bytes` of buffer are made: frees the buffers a collection found unreachable, once 32 MiB
/// of buffers were made since the last time and a collection ran since (#95). The event loop does
/// that between steps (#90), but long synchronous code never reaches one, and its garbage buffers'
/// memory would stay until it ends. Throttled by volume because cleaning up scans every
/// registration (and allocates): once per collection was a scan per allocation for small buffers.
/// The interpreter has no collector counters, so there the volume alone decides.
function __reclaimBuffers(bytes: int): void {
  const r = __buffers
  if (r == null) {
    return
  }
  __bytesSinceReclaim += bytes
  if (__bytesSinceReclaim < 32 * 1024 * 1024) {
    return
  }
  const cycles = __gc_stat(3) + __gc_stat(4)
  if (cycles != __reclaimedAtCycle || cycles == 0) {
    __reclaimedAtCycle = cycles
    __bytesSinceReclaim = 0
    r.__cleanupDue()
  }
}

/// `postMessage(message, { transfer: [buffer] })`: the buffers to move instead of copy.
struct TransferOptions {
  /// The buffers to move; each is detached in the sender.
  transfer: ArrayBuffer[]
}

/// Moves `options`' buffers: their handles (for the runtime), and they're detached here.
function __transfer(options: TransferOptions?): int[] {
  const hs: int[] = []
  if (options != null) {
    for (const b of options.transfer) {
      hs.push(b.__handle)
    }
  }
  hs
}

function __detachAll(options: TransferOptions?): void {
  if (options != null) {
    for (const b of options.transfer) {
      b.__detach()
    }
  }
}

// The typed arrays' checks (the runtime trusts views' offsets and lengths): each panics, as the
// Web API throws a `RangeError`.

/// `length`, if a view can have that many elements.
function __viewLength(length: int, view: string): int {
  if (length < 0) {
    panic(`invalid ${view} length: ${length}`)
  }
  length
}

/// How many `size`-byte elements fit in `buffer` from `byteOffset` to its end.
function __viewRest(buffer: ArrayBuffer, byteOffset: int, size: int, view: string): int {
  __viewOffset(buffer, byteOffset, size, view)
  const rest = buffer.byteLength - byteOffset
  if (rest % size != 0) {
    panic(`${view}: the buffer's length minus the offset isn't a multiple of ${size}`)
  }
  rest / size
}

/// `length`, if `length` `size`-byte elements from `byteOffset` fit in `buffer`.
function __viewSpan(
  buffer: ArrayBuffer,
  byteOffset: int,
  length: int,
  size: int,
  view: string,
): int {
  __viewOffset(buffer, byteOffset, size, view)
  __viewLength(length, view)
  if (length > (buffer.byteLength - byteOffset) / size) {
    const bytes = buffer.byteLength
    panic(`${view} of ${length} elements from byte ${byteOffset} overruns its ${bytes}-byte buffer`)
  }
  length
}

function __viewOffset(buffer: ArrayBuffer, byteOffset: int, size: int, view: string): void {
  if (byteOffset < 0 || byteOffset > buffer.byteLength) {
    panic(`${view} offset ${byteOffset} is outside its buffer of ${buffer.byteLength} bytes`)
  }
  if (byteOffset % size != 0) {
    panic(`${view} offset ${byteOffset} isn't a multiple of ${size}`)
  }
}

/// A view of an `ArrayBuffer` as 1-byte elements (`int`), as on the Web.
class Uint8Array {
  /// The size of an element: 1 byte.
  public static BYTES_PER_ELEMENT: int = 1
  /// The `ArrayBuffer` whose bytes the view reads and writes.
  public buffer: ArrayBuffer
  /// Where the view starts in `buffer`, in bytes.
  public byteOffset: int
  count: int

  /// `length` zeroed elements in a new buffer; panics if `length` is negative.
  constructor(length: int) {
    this.buffer = new ArrayBuffer(__viewLength(length, "Uint8Array") * 1)
    this.byteOffset = 0
    this.count = length
  }

  /// A view of `buffer` from `byteOffset` to its end; panics if `byteOffset` is outside the
  /// buffer.
  constructor(buffer: ArrayBuffer, byteOffset: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewRest(buffer, byteOffset, 1, "Uint8Array")
  }

  /// A view of `length` elements of `buffer` from `byteOffset`. Panics if `byteOffset` is
  /// negative, `length` is negative, or the view would end past the buffer.
  constructor(buffer: ArrayBuffer, byteOffset: int, length: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewSpan(buffer, byteOffset, length, 1, "Uint8Array")
  }

  /// 0 once the buffer is detached (transferred).
  public get length(): int {
    if (this.buffer.detached) 0 else this.count
  }

  /// The view's size in bytes (`length * 1`; 0 once the buffer is detached).
  public get byteLength(): int {
    this.length * 1
  }

  check(i: int): void {
    if (i < 0 || i >= this.length) {
      panic("index out of bounds")
    }
  }

  /// The byte at `i` (0 to 255); panics if `i` is out of bounds.
  public get(i: int): int {
    this.check(i)
    __buf_op(11, this.buffer.__handle, this.byteOffset + i, 0)
  }

  /// Sets the byte at `i` to `value`'s low 8 bits (`value` modulo 256); panics if `i` is out of
  /// bounds.
  public set(i: int, value: int): void {
    this.check(i)
    __buf_op(21, this.buffer.__handle, this.byteOffset + i, value);
  }

  operator [](i: int): int {
    this.get(i)
  }

  /// `i` as a position in `0..length` (negative counts from the end), as on the Web.
  clamp(i: int): int {
    const n = this.length
    if (i < 0) { if (n + i < 0) 0 else n + i } else if (i > n) n else i
  }

  /// A view of the same bytes from `begin` to `end` (negative counts from the end).
  public subarray(begin: int = 0, end: int? = null): Uint8Array {
    const a = this.clamp(begin)
    const e = end
    const b = if (e != null) this.clamp(e) else this.length
    new Uint8Array(this.buffer, this.byteOffset + a, if (b > a) b - a else 0)
  }

  /// A copy of the bytes from `begin` to `end` (negative counts from the end).
  public slice(begin: int = 0, end: int? = null): Uint8Array {
    const a = this.clamp(begin)
    const e = end
    const b = if (e != null) this.clamp(e) else this.length
    const n = if (b > a) b - a else 0
    new Uint8Array(this.buffer.slice(this.byteOffset + a, this.byteOffset + a + n), 0)
  }

  /// Copies `source`'s bytes into this view from `offset`, as the Web's `set(source, offset)`
  /// overload does: in one go, so `source` may overlap this view's bytes. Panics if they don't
  /// fit. (Named `setAll` until methods can be overloaded: decision 316.)
  public setAll(source: Uint8Array, offset: int = 0): void {
    const n = source.length
    if (offset < 0 || offset > this.length - n) {
      panic(`Uint8Array.setAll: ${n} bytes at offset ${offset} don't fit in ${this.length}`)
    }
    if (n > 0) {
      const to = this.buffer.__handle + this.byteOffset + offset
      __buf_op(4, to, source.buffer.__handle + source.byteOffset, n);
    }
  }

  /// Copies the bytes from `start` to `end` (default: the end) to position `target`, as on the
  /// Web: positions count from the end when negative, and the copy stops at the view's end. The
  /// ranges may overlap. Returns this view.
  public copyWithin(target: int, start: int, end: int? = null): Uint8Array {
    const t = this.clamp(target)
    const s = this.clamp(start)
    const e = end
    const f = if (e != null) this.clamp(e) else this.length
    const room = this.length - t
    const n = if (f - s < room) f - s else room
    if (n > 0) {
      const base = this.buffer.__handle + this.byteOffset
      __buf_op(4, base + t, base + s, n);
    }
    this
  }

  /// The bytes of `values` (each taken modulo 256).
  public static from(values: int[]): Uint8Array {
    const out = new Uint8Array(values.length)
    for (let i = 0; i < values.length; i++) {
      out.set(i, values[i] & 255)
    }
    out
  }
}

/// A view of an `ArrayBuffer` as 4-byte elements (`int`), as on the Web.
class Int32Array {
  /// The size of an element: 4 bytes.
  public static BYTES_PER_ELEMENT: int = 4
  /// The `ArrayBuffer` whose bytes the view reads and writes.
  public buffer: ArrayBuffer
  /// Where the view starts in `buffer`, in bytes.
  public byteOffset: int
  count: int

  /// `length` zeroed elements in a new buffer; panics if `length` is negative.
  constructor(length: int) {
    this.buffer = new ArrayBuffer(__viewLength(length, "Int32Array") * 4)
    this.byteOffset = 0
    this.count = length
  }

  /// A view of `buffer` from `byteOffset` to its end. Panics if `byteOffset` is outside the
  /// buffer or not a multiple of 4, or the bytes after it aren't a whole number of elements.
  constructor(buffer: ArrayBuffer, byteOffset: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewRest(buffer, byteOffset, 4, "Int32Array")
  }

  /// A view of `length` elements of `buffer` from `byteOffset`. Panics if `byteOffset` is
  /// negative or not a multiple of 4, `length` is negative, or the view would end past the
  /// buffer.
  constructor(buffer: ArrayBuffer, byteOffset: int, length: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewSpan(buffer, byteOffset, length, 4, "Int32Array")
  }

  /// 0 once the buffer is detached (transferred).
  public get length(): int {
    if (this.buffer.detached) 0 else this.count
  }

  /// The view's size in bytes (`length * 4`; 0 once the buffer is detached).
  public get byteLength(): int {
    this.length * 4
  }

  check(i: int): void {
    if (i < 0 || i >= this.length) {
      panic("index out of bounds")
    }
  }

  /// The element at `i`, a signed 32-bit integer; panics if `i` is out of bounds.
  public get(i: int): int {
    this.check(i)
    unsafe { unsafe.cast<i32>(__buf_op(14, this.buffer.__handle, this.byteOffset + i * 4, 0) as u32) as int }
  }

  /// Sets the element at `i` to `value`'s low 32 bits (wrapping); panics if `i` is out of bounds.
  public set(i: int, value: int): void {
    this.check(i)
    __buf_op(24, this.buffer.__handle, this.byteOffset + i * 4, value);
  }

  operator [](i: int): int {
    this.get(i)
  }
}

