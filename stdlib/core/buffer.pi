    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewRest(buffer, byteOffset, 4, "Float32Array")
  }

  /// A view of `length` elements of `buffer` from `byteOffset`. Panics if `byteOffset` is
  /// negative or not a multiple of 4, `length` is negative, or the view would end past the
  /// buffer.
  constructor(buffer: ArrayBuffer, byteOffset: int, length: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewSpan(buffer, byteOffset, length, 4, "Float32Array")
  }

  /// 0 once the buffer is detached (transferred).
  public get length(): int {
    if (this.buffer.detached) 0 else this.count
  }

  /// The view's size in bytes (`length * 4`; 0 once the buffer is detached).
  public get byteLength(): int {
    this.length * 4
  }

  check(i: int): void {
    if (i < 0 || i >= this.length) {
      panic("index out of bounds")
    }
  }

  /// The element at `i`; panics if `i` is out of bounds.
  public get(i: int): f32 {
    this.check(i)
    unsafe { unsafe.cast<f32>(__buf_op(14, this.buffer.__handle, this.byteOffset + i * 4, 0) as u32) }
  }

  /// Sets the element at `i` to `value`; panics if `i` is out of bounds.
  public set(i: int, value: f32): void {
    this.check(i)
    __buf_op(24, this.buffer.__handle, this.byteOffset + i * 4, unsafe { unsafe.cast<u32>(value) as int });
  }

  operator [](i: int): f32 {
    this.get(i)
  }
}

