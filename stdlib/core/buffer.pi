  /// A view of `buffer` from `byteOffset` to its end. Panics if `byteOffset` is outside the
  /// buffer or not a multiple of 8, or the bytes after it aren't a whole number of elements.
  constructor(buffer: ArrayBuffer, byteOffset: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewRest(buffer, byteOffset, 8, "Float64Array")
  }

  /// A view of `length` elements of `buffer` from `byteOffset`. Panics if `byteOffset` is
  /// negative or not a multiple of 8, `length` is negative, or the view would end past the
  /// buffer.
  constructor(buffer: ArrayBuffer, byteOffset: int, length: int) {
    this.buffer = buffer
    this.byteOffset = byteOffset
    this.count = __viewSpan(buffer, byteOffset, length, 8, "Float64Array")
  }

  /// 0 once the buffer is detached (transferred).
  public get length(): int {
    if (this.buffer.detached) 0 else this.count
  }

  /// The view's size in bytes (`length * 8`; 0 once the buffer is detached).
  public get byteLength(): int {
    this.length * 8
  }

  check(i: int): void {
    if (i < 0 || i >= this.length) {
      panic("index out of bounds")
    }
  }

  /// The element at `i`; panics if `i` is out of bounds.
  public get(i: int): f64 {
    this.check(i)
    unsafe { unsafe.cast<f64>(__buf_op(18, this.buffer.__handle, this.byteOffset + i * 8, 0)) }
  }

  /// Sets the element at `i` to `value`; panics if `i` is out of bounds.
  public set(i: int, value: f64): void {
    this.check(i)
    __buf_op(28, this.buffer.__handle, this.byteOffset + i * 8, unsafe { unsafe.cast<i64>(value) });
  }

  operator [](i: int): f64 {
    this.get(i)
  }
}
