/// A view of an `ArrayBuffer` as 4-byte elements (`f32`), as on the Web.
class Float32Array {
  /// The size of an element: 4 bytes.
  public static BYTES_PER_ELEMENT: int = 4
  /// The `ArrayBuffer` whose bytes the view reads and writes.
  public buffer: ArrayBuffer
