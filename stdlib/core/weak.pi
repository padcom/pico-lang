// Weak references and finalization (spec §9.3), as in JavaScript. A `@weak` field (core
// library only) doesn't keep its target alive: once nothing else refers to the target, the
// collector sets the field to `null`. The interpreter has no collector: there a target is gone
// when its last reference is (so a cycle is never cleared).

/// A reference that doesn't keep its target alive.
///
/// @example
/// ```ts
/// class Node {
///   public name: string
///   constructor(name: string) { this.name = name }
/// }
///
/// const node = new Node("root")
/// const ref = new WeakRef(node)
/// println(ref.deref()?.name)   // root (while `node` is still in use)
/// ```
class WeakRef<T extends object> {
  @weak target: T?

  /// A reference to `target`.
  ///
  /// @example
  /// ```ts
  /// class Config {
  ///   debug: bool = true
  /// }
  ///
  /// const config = new Config()
  /// const ref = new WeakRef<Config>(config)
  /// println(ref.deref() != null)   // true
  /// ```
  constructor(target: T) {
    this.target = target
  }

  /// The target, or `null` once it has been collected.
  ///
  /// @example
  /// ```ts
  /// class Session {
  ///   public user: string
  ///   constructor(user: string) { this.user = user }
  /// }
  ///
  /// const s = new Session("ann")
  /// const ref = new WeakRef(s)
  /// const target = ref.deref()
  /// if (target != null) {
  ///   println(target.user)   // ann
  /// }
  /// ```
  public deref(): T? {
    return this.target
  }
}

class __WeakEntry<K extends object, V> {
  @weak public key: K?
  public value: V

  constructor(key: K, value: V) {
    this.key = key
    this.value = value
  }
}

/// A map whose keys are held weakly: an entry goes away with its key. Values are held
/// strongly, so a value that refers to its own key keeps the entry (no ephemerons yet).
///
/// @example
/// ```ts
/// class Widget {}
///
/// const sizes = new WeakMap<Widget, int>()
/// const w = new Widget()
/// sizes.set(w, 42)
/// println(sizes.get(w))   // 42
/// ```
class WeakMap<K extends object, V> {
  /// By the key's identity. An entry whose key was collected has `key == null` and is
  /// dropped by `prune` (a new object at the same address replaces it).
  entries: Map<int, __WeakEntry<K, V>> = new Map<int, __WeakEntry<K, V>>()
  /// The entry count at which `set` drops the dead entries.
  pruneAt: int = 16

  /// An empty map.
  ///
  /// @example
  /// ```ts
  /// class Key {}
  ///
  /// const cache = new WeakMap<Key, string>()
  /// println(cache.has(new Key()))   // false
  /// ```
  constructor() {}

  live(key: K): __WeakEntry<K, V>? {
    const e = this.entries.get(__ref_id(key))
    if (e == null || e.key == null) {
      return null
    }
    return e
  }

  prune(): void {
    for (const id of this.entries.keys()) {
      const e = this.entries.get(id)
      if (e != null && e.key == null) {
        this.entries.delete(id)
      }
    }
    this.pruneAt = if (this.entries.size * 2 > 16) this.entries.size * 2 else 16
  }

  /// Whether the map has an entry for `key`.
  ///
  /// @example
  /// ```ts
  /// class Key {}
  ///
  /// const m = new WeakMap<Key, int>()
  /// const k = new Key()
  /// m.set(k, 1)
  /// println(m.has(k))           // true
  /// println(m.has(new Key()))   // false
  /// ```
  public has(key: K): bool {
    return this.live(key) != null
  }

  /// The value for `key`, or `null` if there's none.
  ///
  /// @example
  /// ```ts
  /// class Key {}
  ///
  /// const m = new WeakMap<Key, string>()
  /// const k = new Key()
  /// m.set(k, "meta")
  /// println(m.get(k))           // meta
  /// println(m.get(new Key()))   // null
  /// ```
  public get(key: K): V? {
    const e = this.live(key)
    if (e == null) {
      return null
    }
    return e.value
  }

  /// Sets `key`'s value; the map itself.
  ///
  /// @example
  /// ```ts
  /// class Key {}
  ///
  /// const m = new WeakMap<Key, int>()
  /// const k = new Key()
  /// m.set(k, 1).set(k, 2)
  /// println(m.get(k))   // 2
  /// ```
  public set(key: K, value: V): WeakMap<K, V> {
    const e = this.live(key)
    if (e != null) {
      e.value = value
      return this
    }
    if (this.entries.size >= this.pruneAt) {
      this.prune()
    }
    this.entries.set(__ref_id(key), new __WeakEntry<K, V>(key, value))
    this
  }

  /// Removes `key`'s entry; whether there was one.
  ///
  /// @example
  /// ```ts
  /// class Key {}
  ///
  /// const m = new WeakMap<Key, int>()
  /// const k = new Key()
  /// m.set(k, 1)
  /// println(m.delete(k))   // true
  /// println(m.has(k))      // false
  /// ```
  public delete(key: K): bool {
    if (this.live(key) == null) {
      return false
    }
    this.entries.delete(__ref_id(key))
  }
}

/// A set whose members are held weakly.
///
/// @example
/// ```ts
/// class Item {}
///
/// const visited = new WeakSet<Item>()
/// const a = new Item()
/// visited.add(a)
/// println(visited.has(a))   // true
/// ```
class WeakSet<T extends object> {
  members: WeakMap<T, bool> = new WeakMap<T, bool>()

  /// An empty set.
  ///
  /// @example
  /// ```ts
  /// class Item {}
  ///
  /// const s = new WeakSet<Item>()
  /// println(s.has(new Item()))   // false
  /// ```
  constructor() {}

  /// Whether `value` is in the set.
  ///
  /// @example
  /// ```ts
  /// class Item {}
  ///
  /// const s = new WeakSet<Item>()
  /// const a = new Item()
  /// s.add(a)
  /// println(s.has(a))            // true
  /// println(s.has(new Item()))   // false
  /// ```
  public has(value: T): bool {
    this.members.has(value)
  }

  /// Adds `value`; the set itself.
  ///
  /// @example
  /// ```ts
  /// class Item {}
  ///
  /// const s = new WeakSet<Item>()
  /// const a = new Item()
  /// s.add(a).add(a)
  /// println(s.has(a))   // true
  /// ```
  public add(value: T): WeakSet<T> {
    this.members.set(value, true)
    this
  }

  /// Removes `value`; whether it was in the set.
  ///
  /// @example
  /// ```ts
  /// class Item {}
  ///
  /// const s = new WeakSet<Item>()
  /// const a = new Item()
  /// s.add(a)
  /// println(s.delete(a))   // true
  /// println(s.delete(a))   // false
  /// ```
  public delete(value: T): bool {
    this.members.delete(value)
  }
}

class __FinalizationCell<T> {
  /// Whether the target is still alive.
  public alive: () => bool
  public held: T
  /// Whether the unregister token is the object with this identity.
  public token: (id: int) => bool

  constructor(alive: () => bool, held: T, token: (id: int) => bool) {
    this.alive = alive
    this.held = held
    this.token = token
  }
}

/// Calls `callback(held)` some time after a registered target has been collected. Until there
/// is an event loop (spec §10), the callbacks run when the program's top-level code ends.
///
/// @example
/// ```ts
/// class Resource {}
///
/// const registry = new FinalizationRegistry<string>((held) => println(`${held} was collected`))
/// let r: Resource? = new Resource()
/// registry.register(r!, "resource #1")
/// r = null
/// // may print "resource #1 was collected" once the collector has run
/// ```
class FinalizationRegistry<T> {
  callback: (held: T) => void
  cells: __FinalizationCell<T>[] = []

  /// A registry that calls `callback` with the `held` value of each registered target that gets
  /// collected.
  ///
  /// @example
  /// ```ts
  /// class File {}
  ///
  /// const registry = new FinalizationRegistry<int>((fd) => println(`closing fd ${fd}`))
  /// const f = new File()
  /// registry.register(f, 3)   // "closing fd 3" some time after `f` is collected
  /// ```
  constructor(callback: (held: T) => void) {
    this.callback = callback
    const all = __finalizationRegistries ?? []
    all.push(() => this.cleanup())
    __finalizationRegistries = all
  }

  /// Calls the callback with `held` once `target` has been collected.
  ///
  /// @example
  /// ```ts
  /// class Chunk {}
  ///
  /// const registry = new FinalizationRegistry<string>((name) => println(`freed ${name}`))
  /// const b = new Chunk()
  /// registry.register(b, "buffer A")   // "freed buffer A" some time after `b` is collected
  /// ```
  public register<U extends object>(target: U, held: T): void {
    const w = new WeakRef<U>(target)
    this.cells.push(new __FinalizationCell<T>(() => w.deref() != null, held, (id: int) => false))
  }

  /// `register`, and `unregister(token)` cancels it.
  ///
  /// @example
  /// ```ts
  /// class Handle {}
  ///
  /// const registry = new FinalizationRegistry<string>((name) => println(`freed ${name}`))
  /// const h = new Handle()
  /// const token = new Handle()
  /// registry.registerWithToken(h, "handle 1", token)
  /// println(registry.unregister(token))   // true
  /// ```
  public registerWithToken<U extends object, K extends object>(target: U, held: T, token: K): void {
    const w = new WeakRef<U>(target)
    const t = new WeakRef<K>(token)
    this.cells.push(
      new __FinalizationCell<T>(() => w.deref() != null, held, (id: int) => {
        const k = t.deref()
        return k != null && __ref_id(k) == id
      }),
    )
  }

  /// Cancels the registrations made with `token`; whether there were any.
  ///
  /// @example
  /// ```ts
  /// class Handle {}
  ///
  /// const registry = new FinalizationRegistry<string>((name) => println(`freed ${name}`))
  /// const h = new Handle()
  /// const token = new Handle()
  /// registry.registerWithToken(h, "handle 1", token)
  /// println(registry.unregister(token))   // true
  /// println(registry.unregister(token))   // false
  /// ```
  public unregister<K extends object>(token: K): bool {
    const id = __ref_id(token)
    const kept: __FinalizationCell<T>[] = []
    for (const c of this.cells) {
      const isToken = c.token
      if (!isToken(id)) {
        kept.push(c)
      }
    }
    const removed = kept.length < this.cells.length
    this.cells = kept
    return removed
  }

  /// The runtime's: runs the callback for the targets already collected, now (the buffers' registry
  /// during long synchronous code, #95); whether there were any.
  public __cleanupDue(): bool {
    cleanup()
  }

  /// Calls the callback for the targets that have been collected; whether there were any.
  cleanup(): bool {
    const due: T[] = []
    const kept: __FinalizationCell<T>[] = []
    for (const c of this.cells) {
      const alive = c.alive
      if (alive()) {
        kept.push(c)
      } else {
        due.push(c.held)
      }
    }
    this.cells = kept
    for (const h of due) {
      const f = this.callback
      f(h)
    }
    return due.length > 0
  }
}

/// The registries' `cleanup`s (created by the first registry).
let __finalizationRegistries: (() => bool)[]? = null

/// When the event loop has nothing left (spec §9.3): collects, then runs the finalization
/// callbacks that are due; whether any ran (they may have scheduled more work).
function __runFinalizers(): bool {
  if (__finalizationRegistries == null) {
    return false
  }
  __gc_collect()
  __runDueFinalizers()
}

/// The callbacks of every target the collector has already found unreachable, without forcing a
/// collection; whether any ran.
function __runDueFinalizers(): bool {
  const all = __finalizationRegistries
  if (all == null) {
    return false
  }
  let ran = false
  for (const f of all) {
    if (f()) {
      ran = true
    }
  }
  return ran
}

/// Collections counted when the due finalizers last ran, and loop steps since then.
let __finalizedAtCycle = -1
let __stepsSinceFinalizers = 0

/// Between event-loop steps: the due finalization callbacks, once per collection (#90). A loop
/// that's never idle (a server, a backend reading stdin) still gets its buffers' memory back. The
/// interpreter has no collector counters (its targets go as soon as they're unreferenced), so
/// there they run every 1024 steps.
function __finalizeAfterCollections(): void {
  if (__finalizationRegistries == null) {
    return
  }
  __stepsSinceFinalizers += 1
  const cycles = __gc_stat(3) + __gc_stat(4)
  if (cycles != __finalizedAtCycle || (cycles == 0 && __stepsSinceFinalizers >= 1024)) {
    __finalizedAtCycle = cycles
    __stepsSinceFinalizers = 0
    __runDueFinalizers()
  }
}
