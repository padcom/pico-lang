// `std/process`: this process (`args`, `argv0`, `execPath`, `env`, `exit`, `cwd`, `pid`,
// `stdin`/`stdout`/`stderr`) and external processes (`Command`), spec §13.2 and §13.3.
// Programs run without a shell (arguments are passed as an array) unless `Command.shell` asks
// for one. Reading or writing a pipe and waiting for a child are jobs on runtime threads that
// settle on the event loop.

import { ReadableStream, WritableStream, ReadableStreamDefaultController } from "std/streams"

const __windows = comptime (target.os == "windows")

const __kinds = ["", "NotFound", "AlreadyExists", "PermissionDenied", "NotADirectory",
  "IsADirectory", "DirectoryNotEmpty", "InvalidData", "Other"]
const __messages = ["", "no such file or directory", "already exists", "permission denied",
  "not a directory", "is a directory", "directory not empty", "not valid UTF-8", "I/O error"]

function __kind(r: int): int {
  if (-r > 0 && -r < __kinds.length) -r else 8
}

function __what(r: int, errno: int): string {
  const k = __kind(r)
  if (k == 8) `${__messages[k]} (os error ${errno})` else __messages[k]
}

/// A process that couldn't be started (or whose output couldn't be read as text): the
/// program, a message and a portable kind (as `IoError`'s: `"NotFound"`, `"PermissionDenied"`,
/// `"InvalidData"`, `"Other"`, …).
///
/// @example
/// ```ts
/// import { Command, ProcessError } from "std/process"
///
/// try {
///   const s = await new Command("no-such-program-here").status()
///   println(s.code)
/// } catch (e: ProcessError) {
///   println(e.kind)      // NotFound
///   println(e.command)   // no-such-program-here
/// }
/// ```
export class ProcessError extends Error {
  /// The program that was to run.
  public command: string
  /// The portable kind, as `IoError`'s (`"NotFound"`, `"PermissionDenied"`, `"InvalidData"`,
  /// `"Other"`, …).
  public kind: string
  /// An error for `command` with `message` and `kind`.
  ///
  /// @example
  /// ```ts
  /// import { ProcessError } from "std/process"
  ///
  /// const e = new ProcessError("git", "git is not installed", "NotFound")
  /// println(`${e.command}: ${e.message} (${e.kind})`)   // git: git is not installed (NotFound)
  /// ```
  constructor(command: string, message: string, kind: string) {
    super(message)
    this.command = command
    this.kind = kind
  }
}

/// A control operation's text result.
function __text(job: int): string {
  const text = __io_text(job)
  __io(104, job, 0, 0, "", "");
  return text
}

function __fields(text: string): string[] {
  const out: string[] = []
  if (text.length == 0) {
    return out
  }
  for (const part of text.split("\u{0}")) {
    out.push(part)
  }
  // (Every field ends with a NUL, so the last part is empty.)
  out.pop()
  return out
}

/// The program's arguments (without the program itself).
export const args: string[] = __fields(__text(__io(113, 0, 0, 0, "", "")))

/// The program as it was started: the first word of its command line as given (`./pm`, `pm`,
/// `C:\bin\pm.exe`), which names it (commander's `nameFromFilename`); under
/// `pico run --interp`, the entry file. `""` when there's none.
export const argv0: string = __text(__io(125, 0, 0, 0, "", ""))

/// The running program's file as an absolute path, symlinks resolved (an executable found
/// through `PATH` or a link too): what's next to it is the program's. Under
/// `pico run --interp`, the entry file. `null` where it can't be known (WASI).
///
/// @example
/// ```ts
/// import { execPath } from "std/process"
/// import { dirname } from "std/path"
///
/// const exe = execPath()
/// if (exe != null) {
///   println(dirname(exe))   // the directory the program is in, e.g. /usr/local/bin
/// }
/// ```
export function execPath(): string? {
  const job = __io(125, 1, 0, 0, "", "")
  const found = __io(102, job, 0, 0, "", "") == 1
  const value = __text(job)
  return if (found) value else null
}

/// The process id.
export const pid: int = __io(119, 0, 0, 0, "", "")

/// The working directory.
///
/// @example
/// ```ts
/// import { cwd } from "std/process"
/// import { join } from "std/path"
///
/// println(cwd())                         // e.g. /home/ada/project
/// println(join(cwd(), "project.json"))   // e.g. /home/ada/project/project.json
/// ```
export function cwd(): string {
  __text(__io(105, 0, 0, 0, "", ""))
}

/// Ends the process at once with exit code `code` (no `finally` blocks run, and pending
/// promises are dropped).
///
/// @example
/// ```ts
/// import { args, exit } from "std/process"
///
/// if (args.includes("--version")) {
///   println("1.0.0")
///   exit(0)   // ends here: nothing after this runs
/// }
/// println("working…")
/// ```
export function exit(code: i32 = 0): void {
  __io(118, code as int, 0, 0, "", "");
}

/// The environment variables (`env.get("HOME")`). Changes are seen by commands started
/// later.
///
/// @example
/// ```ts
/// import { env } from "std/process"
///
/// println(env.get("HOME"))   // e.g. /home/ada
/// env.set("GREETING", "hi")
/// println(env.get("GREETING"))   // hi
/// ```
export class Env {
  /// The variable's value, or `null` when it isn't set.
  ///
  /// @example
  /// ```ts
  /// import { env } from "std/process"
  ///
  /// const editor = env.get("EDITOR") ?? "vi"
  /// println(editor)                         // e.g. vim
  /// println(env.get("SURELY_NOT_SET_XYZ"))  // null
  /// ```
  public get(name: string): string? {
    const job = __io(114, 0, 0, 0, name, "")
    const found = __io(102, job, 0, 0, "", "") == 1
    const value = __text(job)
    if (found) value else null
  }

  /// Whether the variable is set (to anything, `""` too).
  ///
  /// @example
  /// ```ts
  /// import { env } from "std/process"
  ///
  /// env.set("EMPTY", "")
  /// println(env.has("EMPTY"))               // true
  /// println(env.has("SURELY_NOT_SET_XYZ"))  // false
  /// ```
  public has(name: string): bool {
    return this.get(name) != null
  }

  /// Sets the variable to `value` for this process and the commands it starts later.
  ///
  /// @example
  /// ```ts
  /// import { env, Command } from "std/process"
  ///
  /// env.set("APP_MODE", "test")
  /// const out = await Command.shell("echo $APP_MODE").output()
  /// println(out.stdout.trim())   // test
  /// ```
  public set(name: string, value: string): void {
    __io(115, 0, 0, 0, name, value);
  }

  /// Unsets the variable (nothing happens if it isn't set).
  ///
  /// @example
  /// ```ts
  /// import { env } from "std/process"
  ///
  /// env.set("TEMP_FLAG", "1")
  /// env.delete("TEMP_FLAG")
  /// println(env.has("TEMP_FLAG"))   // false
  /// ```
  public delete(name: string): void {
    __io(116, 0, 0, 0, name, "");
  }

  /// Every variable, by name.
  ///
  /// @example
  /// ```ts
  /// import { env } from "std/process"
  ///
  /// const vars = env.toObject()
  /// println(vars.has("PATH"))   // true
  /// println(vars.size > 0)      // true
  /// ```
  public toObject(): Map<string, string> {
    const m = new Map<string, string>()
    for (const line of __fields(__text(__io(117, 0, 0, 0, "", "")))) {
      const i = line.indexOf("=")
      if (i > 0) {
        m.set(line.slice(0, i), line.slice(i + 1))
      }
    }
    return m
  }
}

/// This process's environment variables.
export const env = new Env()

/// A finished job's results.
struct __PResult {
  r: int
  r2: int
  job: int
}

/// Runs job `op` (an `IoError` naming `name` when it fails).
function __pjob<T>(op: int, a: int, b: int, c: int, t: string, name: string,
  read: (res: __PResult) => T): Promise<T, IoError> {
  const p = new Promise<T, IoError>()
  __ioSubmit(op, a, b, c, "", t, (job: int) => {
    const r = __io(102, job, 0, 0, "", "")
    const r2 = __io(103, job, 0, 0, "", "")
    if (r < 0) {
      p.__reject(new IoError(name, `${__what(r, r2)}: ${name}`, __kinds[__kind(r)]))
    } else {
      p.__resolve(read({ r, r2, job }))
    }
  })
  return p
}

/// The bytes of a view as a buffer handle starting at its first byte.
function __bytesOf(data: Uint8Array): ArrayBuffer {
  if (data.byteOffset == 0) data.buffer else data.buffer.slice(data.byteOffset, data.byteOffset + data.length)
}

/// The reading end of a pipe (a child's `stdout`/`stderr`) or this process's `stdin`: chunks
/// of bytes with `read`, `for await`, or everything at once with `text()`. One read at a time.
///
/// @example
/// ```ts
/// import { Command } from "std/process"
///
/// const child = new Command("echo", ["hello"], stdout: "pipe").spawn()
/// println((await child.stdout.text()).trim())   // hello
/// await child.status()
/// ```
export class Reader {
  fd: int
  /// The stream's name (`"stdin"`, `"stdout"` or `"stderr"`), used in panics and as the `path` of
  /// its `IoError`s.
  public readonly name: string
  piped: bool
  done: bool = false
  reading: bool = false
  /// `close()` was called.
  closed: bool = false
  /// The pending read's job (while `reading`).
  job: int = -1
  rs: ReadableStream<Uint8Array>? = null

  /// A reader of descriptor `fd` (reading panics unless `piped`); `Command` and `stdin` make these.
  ///
  /// @example
  /// ```ts
  /// import { Reader, stdin } from "std/process"
  ///
  /// const input: Reader = stdin   // `stdin` and a piped child's `stdout`/`stderr` are Readers
  /// println(input.name)           // stdin
  /// ```
  constructor(fd: int, name: string, piped: bool) {
    this.fd = fd
    this.name = name
    this.piped = piped
    this.done = piped && fd < 0
  }

  /// Whether it reads from a terminal (#158): `stdin.isTerminal` is false when input is piped.
  ///
  /// @example
  /// ```ts
  /// import { stdin } from "std/process"
  ///
  /// if (stdin.isTerminal) {
  ///   println("type something, then Ctrl-D")   // when run from a terminal
  /// } else {
  ///   println("reading piped input")           // with `echo hi | myprogram`
  /// }
  /// ```
  public get isTerminal(): bool {
    return fd >= 0 && __io(123, fd, 0, 0, "", "") == 1
  }

  /// The bytes as a stream (reading it and `read()` don't mix).
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("echo", ["streamed"], stdout: "pipe").spawn()
  /// const reader = child.stdout.readable.getReader()
  /// const first = await reader.read()
  /// println(first.value?.length)   // 9
  /// await child.status()
  /// ```
  public get readable(): ReadableStream<Uint8Array> {
    const r = this.rs
    if (r != null) {
      return r
    }
    const s = new ReadableStream<Uint8Array>({ pullAsync: (c) => __pullReader(this, c) })
    this.rs = s
    return s
  }

  start(): void {
    if (!piped) {
      panic(`${name} isn't piped`)
    }
    if (reading) {
      panic(`${name} is already being read`)
    }
    reading = true
  }

  /// The end of the stream: the pipe is closed (this process's stdin stays open).
  finish(): void {
    done = true
    if (fd > 2) {
      __io(112, fd, 0, 0, "", "");
    }
  }

  /// Up to `n` bytes (as soon as some are there), or `null` at the end.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("echo", ["chunk"], stdout: "pipe").spawn()
  /// const bytes = await child.stdout.read()
  /// if (bytes != null) {
  ///   println(new TextDecoder().decode(bytes).trim())   // chunk
  /// }
  /// println(await child.stdout.read())   // null: the end
  /// await child.status()
  /// ```
  public read(n: int = 65536): Promise<Uint8Array?, IoError> {
    start()
    if (done) {
      reading = false
      const p = new Promise<Uint8Array?, IoError>()
      p.__resolve(null)
      return p
    }
    const p = __pjob<Uint8Array?>(20, fd, n, 0, "", name, (res: __PResult) => {
      this.reading = false
      if (res.r2 == 0 || this.closed) {
        // The end, or closed while reading (what came in that moment is dropped).
        __buf_op(2, res.r, 0, 0);
        this.finish()
        null
      } else {
        new Uint8Array(new ArrayBuffer(res.r, res.r2, true), 0, res.r2)
      }
    })
    this.job = __lastJob
    return p
  }

  /// Stops reading (#100): a pending `read()` settles with `null`, as at the end, and so do later
  /// ones. The descriptor is closed once nothing reads it (this process's stdin stays open). Use
  /// it for a pipe or device whose other end may never write or close (a child that keeps
  /// running, a serial port, a pty).
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("sleep", ["5"], stdout: "pipe").spawn()
  /// const pending = child.stdout.read()
  /// child.stdout.close()
  /// println(await pending)   // null
  /// child.kill()
  /// await child.status()
  /// ```
  public close(): void {
    if (done || closed) {
      return
    }
    closed = true
    if (reading) {
      // The read ends (and the callback above closes the descriptor).
      __io(107, job, 0, 0, "", "");
    } else {
      finish()
    }
  }

  /// `for await` reads chunks of bytes until the end.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("echo", ["hi"], stdout: "pipe").spawn()
  /// const chunk = await child.stdout.next()
  /// println(chunk?.length)   // 3
  /// await child.status()
  /// ```
  public next(): Promise<Uint8Array?, IoError> {
    read()
  }

  /// `for await` uses the reader itself.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("printf", ["a\\nb\\n"], stdout: "pipe").spawn()
  /// let total = 0
  /// for await (const chunk of child.stdout) {
  ///   total += chunk.length
  /// }
  /// println(total)   // 4
  /// await child.status()
  /// ```
  public asyncIterator(): Reader {
    this
  }

  /// `text()`, or "" when it isn't piped.
  public __rest(): Promise<string, IoError> {
    if (piped) {
      return text()
    }
    const p = new Promise<string, IoError>()
    p.__resolve("")
    return p
  }

  /// The rest of the stream as text (UTF-8; anything else rejects with kind `"InvalidData"`).
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("printf", ["one\\ntwo\\n"], stdout: "pipe").spawn()
  /// const text = await child.stdout.text()
  /// println(text.split("\n").length)   // 3
  /// await child.status()
  /// ```
  public text(): Promise<string, IoError> {
    start()
    if (done) {
      reading = false
      const p = new Promise<string, IoError>()
      p.__resolve("")
      return p
    }
    __pjob<string>(22, fd, 0, 0, "", name, (res: __PResult) => {
      this.reading = false
      this.finish()
      __io_text(res.job)
    })
  }
}

/// Reads the next chunk of `r` into a stream.
async function __pullReader(r: Reader, c: ReadableStreamDefaultController<Uint8Array>): Promise<void> throws IoError {
  const chunk = await r.read()
  if (chunk == null) {
    c.close()
  } else {
    c.enqueue(chunk)
  }
}

/// A queued write.
struct __Write {
  bytes: ArrayBuffer?
  count: int
  text: string
  p: Promise<int, IoError>
}

/// The writing end of a pipe (a child's `stdin`) or this process's `stdout`/`stderr`. Writes
/// happen in the order they're made; `close()` (after them) ends the child's input.
///
/// @example
/// ```ts
/// import { Command } from "std/process"
///
/// const child = new Command("cat", stdin: "pipe", stdout: "pipe").spawn()
/// await child.stdin.writeText("piped through cat")
/// child.stdin.close()
/// println(await child.stdout.text())   // piped through cat
/// await child.status()
/// ```
export class Writer {
  fd: int
  /// The stream's name (`"stdin"`, `"stdout"` or `"stderr"`), used in panics and as the `path` of
  /// its `IoError`s.
  public readonly name: string
  piped: bool
  queue: __Write[] = []
  head: int = 0
  busy: bool = false
  closing: bool = false
  closed: bool = false
  ws: WritableStream<Uint8Array>? = null

  /// A writer to descriptor `fd` (writing panics unless `piped`); `Command`, `stdout` and `stderr`
  /// make these.
  ///
  /// @example
  /// ```ts
  /// import { Writer, stdout } from "std/process"
  ///
  /// const out: Writer = stdout   // `stdout`, `stderr` and a piped child's `stdin` are Writers
  /// println(out.name)            // stdout
  /// ```
  constructor(fd: int, name: string, piped: bool) {
    this.fd = fd
    this.name = name
    this.piped = piped
  }

  /// The writer as a stream: closing it closes the pipe.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("cat", stdin: "pipe", stdout: "pipe").spawn()
  /// const writer = child.stdin.writable.getWriter()
  /// await writer.write(new TextEncoder().encode("via a stream"))
  /// await writer.close()
  /// println(await child.stdout.text())   // via a stream
  /// await child.status()
  /// ```
  public get writable(): WritableStream<Uint8Array> {
    const w = this.ws
    if (w != null) {
      return w
    }
    const s = new WritableStream<Uint8Array>({
      writeAsync: (chunk, _c) => this.write(chunk).then<void>((_n: int) => {}),
      close: () => this.close(),
    })
    this.ws = s
    return s
  }

  add(w: __Write): Promise<int, IoError> {
    if (!piped) {
      panic(`${name} isn't piped`)
    }
    if (closing) {
      // A closed pipe: the write fails like one the system refused (#37).
      w.p.__reject(new IoError(name, `write after close: ${name}`, "Other"))
      return w.p
    }
    queue.push(w)
    pump()
    return w.p
  }

  /// Writes all of `data`; the count written.
  ///
  /// @example
  /// ```ts
  /// import { stdout } from "std/process"
  ///
  /// const n = await stdout.write(new TextEncoder().encode("bytes\n"))   // bytes
  /// println(n)                                                           // 6
  /// ```
  public write(data: Uint8Array): Promise<int, IoError> {
    add({ bytes: __bytesOf(data), count: data.length, text: "", p: new Promise<int, IoError>() })
  }

  /// Whether it writes to a terminal (#158): `stdout.isTerminal` is false when the output is
  /// piped or redirected.
  ///
  /// @example
  /// ```ts
  /// import { stdout } from "std/process"
  ///
  /// if (stdout.isTerminal) {
  ///   println("on a terminal")         // when run from a terminal
  /// } else {
  ///   println("piped or redirected")   // with `myprogram > out.txt`
  /// }
  /// ```
  public get isTerminal(): bool {
    return fd >= 0 && __io(123, fd, 0, 0, "", "") == 1
  }

  /// Whether text written here should have colours (decision 344), as command-line tools
  /// commonly decide: no when `NO_COLOR` is set to anything but `""`, or `FORCE_COLOR` is `0` or
  /// `false`; yes when `FORCE_COLOR` is set to anything else but `""`, or `CLICOLOR_FORCE` is set;
  /// otherwise whether it writes to a terminal.
  ///
  /// @example
  /// ```ts
  /// import { stdout } from "std/process"
  ///
  /// const red = if (stdout.hasColors()) "\u{1b}[31merror\u{1b}[0m" else "error"
  /// println(red)   // error (in red on a colour terminal)
  /// ```
  public hasColors(): bool {
    const force = env.get("FORCE_COLOR")
    if ((env.get("NO_COLOR") ?? "") != "" || force == "0" || force == "false") return false
    if ((force ?? "") != "" || env.has("CLICOLOR_FORCE")) return true
    return isTerminal
  }

  /// The terminal's width in columns, or `null` when it isn't one (#158).
  ///
  /// @example
  /// ```ts
  /// import { stdout } from "std/process"
  ///
  /// const width = stdout.columns ?? 80
  /// println("-".repeat(width))   // a line as wide as the terminal (80 when it isn't one)
  /// ```
  public get columns(): int? {
    const n = if (fd >= 0) __io(124, fd, 0, 0, "", "") else -1
    return if (n > 0) n else null
  }

  /// The terminal's height in rows, or `null` when it isn't one.
  ///
  /// @example
  /// ```ts
  /// import { stdout } from "std/process"
  ///
  /// println(stdout.rows ?? 24)   // the terminal's height, e.g. 50 (24 when it isn't one)
  /// ```
  public get rows(): int? {
    const n = if (fd >= 0) __io(124, fd, 1, 0, "", "") else -1
    return if (n > 0) n else null
  }

  /// Writes `text` as UTF-8; the count of bytes written.
  ///
  /// @example
  /// ```ts
  /// import { stdout, stderr } from "std/process"
  ///
  /// await stdout.writeText("no newline, ")
  /// await stdout.writeText("then one\n")    // no newline, then one
  /// await stderr.writeText("a warning\n")   // (on standard error) a warning
  /// ```
  public writeText(text: string): Promise<int, IoError> {
    add({ bytes: null, count: 0, text, p: new Promise<int, IoError>() })
  }

  /// Closes the pipe once earlier writes are done (twice is fine; for `stdout`/`stderr`
  /// nothing happens).
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("wc", ["-c"], stdin: "pipe", stdout: "pipe").spawn()
  /// child.stdin.writeText("12345")
  /// child.stdin.close()   // after the write: wc sees the end of its input
  /// println((await child.stdout.text()).trim())   // 5
  /// await child.status()
  /// ```
  public close(): void {
    // The standard streams stay open (`println` writes to them too, #37).
    if (fd >= 0 && fd <= 2) {
      return
    }
    closing = true
    pump()
  }

  pump(): void {
    if (busy) {
      return
    }
    if (head == queue.length) {
      queue = []
      head = 0
      if (closing && !closed) {
        closed = true
        if (fd > 2) {
          __io(112, fd, 0, 0, "", "");
        }
      }
      return
    }
    const w = queue[head]
    head += 1
    if (fd < 0) {
      // (The child never started.)
      w.p.__resolve(0)
      pump()
      return
    }
    busy = true
    const op = if (fd <= 2) 25 else 21
    const b = w.bytes
    const settle = (job: int) => {
      const r = __io(102, job, 0, 0, "", "")
      const r2 = __io(103, job, 0, 0, "", "")
      this.busy = false
      if (r < 0) {
        w.p.__reject(new IoError(this.name, `${__what(r, r2)}: ${this.name}`, __kinds[__kind(r)]))
      } else {
        w.p.__resolve(r)
      }
      this.pump()
    }
    if (b != null) {
      __ioSubmit(op, fd, b.__handle, w.count, "", "", settle)
    } else {
      __ioSubmit(op, fd, 0, -1, "", w.text, settle)
    }
  }
}

/// This process's standard input.
export const stdin = new Reader(0, "stdin", true)
/// This process's standard output: writes are in order with `print`.
export const stdout = new Writer(1, "stdout", true)
/// This process's standard error: writes are in order with `print`.
export const stderr = new Writer(2, "stderr", true)

/// What a child's standard stream is connected to: this process's (`"inherit"`), a pipe to
/// this process (`"pipe"`), or nothing (`"null"`).
export type Stdio = "inherit" | "pipe" | "null"

function __mode(s: Stdio): int {
  if (s == "pipe") 1 else if (s == "null") 2 else 0
}

/// How a child ended: `code` is its exit code (128 + the signal's number when a signal
/// ended it, as shells report it).
///
/// @example
/// ```ts
/// import { Command, ExitStatus } from "std/process"
///
/// const s: ExitStatus = await Command.shell("exit 3").status()
/// println(s.success)   // false
/// println(s.code)      // 3
/// println(s.signal)    // null
/// ```
export struct ExitStatus {
  /// Whether it exited with code 0 (and no signal ended it).
  success: bool
  /// The exit code (128 + the signal's number when a signal ended it).
  code: i32
  /// The number of the signal that ended it (on Windows, the one `kill` was given), or `null`.
  signal: i32?
}

/// A finished child's status and everything it wrote (as UTF-8 text).
///
/// @example
/// ```ts
/// import { Command, Output } from "std/process"
///
/// const out: Output = await new Command("echo", ["hi"]).output()
/// println(out.success)          // true
/// println(out.stdout.trim())    // hi
/// println(out.stderr == "")     // true
/// ```
export struct Output {
  /// Whether it exited with code 0 (and no signal ended it).
  success: bool
  /// The exit code (128 + the signal's number when a signal ended it).
  code: i32
  /// The number of the signal that ended it (on Windows, the one `kill` was given), or `null`.
  signal: i32?
  /// Everything it wrote to its standard output (`""` when that wasn't piped).
  stdout: string
  /// Everything it wrote to its standard error (`""` when that wasn't piped).
  stderr: string
}

/// A started process: its pipes (where piped), `status()`, `kill()`.
///
/// @example
/// ```ts
/// import { Command } from "std/process"
///
/// const child = new Command("echo", ["from a child"], stdout: "pipe").spawn()
/// println(child.pid > 0)                   // true
/// println((await child.stdout.text()).trim())   // from a child
/// println((await child.status()).success)  // true
/// ```
export class Child {
  /// 0 when it couldn't be started.
  public readonly pid: int
  /// Its standard input, when spawned with `stdin: "pipe"` (writing to it otherwise panics).
  public readonly stdin: Writer
  /// Its standard output, when spawned with `stdout: "pipe"` (reading it otherwise panics).
  public readonly stdout: Reader
  /// Its standard error, when spawned with `stderr: "pipe"` (reading it otherwise panics).
  public readonly stderr: Reader
  program: string
  error: ProcessError?
  waited: Promise<ExitStatus, ProcessError>? = null
  exited: bool = false

  /// A child with process id `pid` (0 and an `error` when it couldn't start); `Command.spawn` makes
  /// these.
  ///
  /// @example
  /// ```ts
  /// import { Command, Child } from "std/process"
  ///
  /// const child: Child = new Command("true").spawn()   // Command.spawn makes Children
  /// println((await child.status()).code)               // 0
  /// ```
  constructor(pid: int, program: string, error: ProcessError?, stdin: Writer, stdout: Reader, stderr: Reader) {
    this.pid = pid
    this.program = program
    this.error = error
    this.stdin = stdin
    this.stdout = stdout
    this.stderr = stderr
  }

  /// Waits for the child to end (rejects when it couldn't be started). Every call gives the
  /// same promise.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("true").spawn()
  /// const s = await child.status()
  /// println(s.success)   // true
  /// println(s.code)      // 0
  /// ```
  public status(): Promise<ExitStatus, ProcessError> {
    const w = waited
    if (w != null) {
      return w
    }
    const p = new Promise<ExitStatus, ProcessError>()
    waited = p
    const e = error
    if (e != null) {
      p.__reject(e)
      return p
    }
    __ioSubmit(23, pid, 0, 0, "", "", (job: int) => {
      const code = __io(102, job, 0, 0, "", "")
      const sig = __io(103, job, 0, 0, "", "")
      this.exited = true
      const signal: i32? = if (sig > 0) sig as i32 else null
      const status: ExitStatus = {
        success: sig == 0 && code == 0,
        code: (if (sig > 0) 128 + sig else code) as i32,
        signal,
      }
      p.__resolve(status)
    })
    return p
  }

  /// Everything the child writes to its piped `stdout` and `stderr` (as text), and how it
  /// ended.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = Command.shell("echo out; echo err >&2", stdout: "pipe", stderr: "pipe").spawn()
  /// const o = await child.output()
  /// println(o.stdout.trim())   // out
  /// println(o.stderr.trim())   // err
  /// ```
  public async output(): Promise<Output> throws ProcessError {
    const out = stdout.__rest()
    const err = stderr.__rest()
    const s = await status()
    let o = ""
    let e = ""
    try {
      o = await out
      e = await err
    } catch (x: IoError) {
      throw new ProcessError(program, `the output of ${program} is not valid UTF-8`, "InvalidData")
    }
    const res: Output = { success: s.success, code: s.code, signal: s.signal, stdout: o, stderr: e }
    return res
  }

  /// Sends the child a signal (`SIGTERM` by default; on Windows it's terminated). Nothing
  /// happens once it has ended.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("sleep", ["10"]).spawn()
  /// child.kill()
  /// const s = await child.status()
  /// println(s.signal)   // 15
  /// println(s.code)     // 143
  /// ```
  public kill(signal: "SIGTERM" | "SIGKILL" | "SIGINT" | "SIGHUP" = "SIGTERM"): void {
    if (pid == 0 || exited) {
      return
    }
    const n = if (signal == "SIGKILL") 9 else if (signal == "SIGINT") 2 else if (signal == "SIGHUP") 1 else 15
    __io(111, pid, n, 0, "", "");
  }
}

/// A program to run: its arguments (passed as they are, never through a shell), working
/// directory, environment (`env` adds to or replaces this process's variables; with
/// `clearEnv` it's all there is) and standard streams. `spawn()` starts it; `output()` and
/// `status()` start it and wait.
///
/// @example
/// ```ts
/// import { Command } from "std/process"
///
/// const out = await new Command("echo", ["one", "two"]).output()
/// println(out.stdout.trim())   // one two
/// ```
export class Command {
  /// The program to run: a path, or a name looked up in `PATH`.
  public readonly program: string
  /// The arguments after the program.
  public readonly args: string[]
  dir: string?
  vars: Map<string, string>?
  clearEnv: bool
  stdinMode: Stdio
  stdoutMode: Stdio
  stderrMode: Stdio
  /// Windows: the arguments go on the command line as they are, unquoted (`shell`).
  verbatim: bool = false

  /// A command running `program` with `args`, in `cwd` (a relative one is resolved against the
  /// working directory; this process's by default), with `env` added to (or, with `clearEnv`,
  /// instead of) this process's variables, and each standard stream `"inherit"`ed, `"pipe"`d or
  /// `"null"`. Nothing runs until `spawn`, `output` or `status`.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  /// import { tmpDir } from "std/os"
  ///
  /// const vars = new Map<string, string>()
  /// vars.set("NAME", "Ada")
  /// const cmd = new Command("/bin/sh", ["-c", "echo $NAME in $(pwd)"], cwd: tmpDir(), env: vars)
  /// println((await cmd.output()).stdout.trim())   // e.g. Ada in /tmp
  /// ```
  constructor(program: string, args: string[] = [], cwd: string? = null,
    env: Map<string, string>? = null, clearEnv: bool = false, stdin: Stdio = "inherit",
    stdout: Stdio = "inherit", stderr: Stdio = "inherit") {
    this.program = program
    this.args = args
    this.dir = cwd
    this.vars = env
    this.clearEnv = clearEnv
    this.stdinMode = stdin
    this.stdoutMode = stdout
    this.stderrMode = stderr
  }

  /// `script` run by the platform's shell (`/bin/sh -c`; `cmd.exe /c` on Windows).
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const out = await Command.shell("echo a | tr a b").output()
  /// println(out.stdout.trim())   // b
  /// ```
  public static shell(script: string, cwd: string? = null, env: Map<string, string>? = null,
    clearEnv: bool = false, stdin: Stdio = "inherit", stdout: Stdio = "inherit",
    stderr: Stdio = "inherit"): Command {
    if (__windows) {
      // As Node does: cmd's own parsing of `/s /c "…"` keeps the script as it is.
      const c = new Command("cmd.exe", ["/d", "/s", "/c", `"${script}"`], cwd: cwd, env: env,
        clearEnv: clearEnv, stdin: stdin, stdout: stdout, stderr: stderr)
      c.verbatim = true
      return c
    }
    new Command("/bin/sh", ["-c", script], cwd: cwd, env: env, clearEnv: clearEnv,
      stdin: stdin, stdout: stdout, stderr: stderr)
  }

  /// Starts the program. If it can't be started, the child's `status()` rejects with a
  /// `ProcessError`.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const child = new Command("echo", ["spawned"], stdout: "pipe").spawn()
  /// println((await child.stdout.text()).trim())   // spawned
  /// await child.status()
  /// ```
  public spawn(): Child {
    spawnWith(__mode(stdinMode), __mode(stdoutMode), __mode(stderrMode))
  }

  spawnWith(inMode: int, outMode: int, errMode: int): Child {
    const d = dir
    let t = if (d != null) d else ""
    for (const a of args) {
      t = `${t}\u{0}${a}`
    }
    let count = 0
    const vs = vars
    if (vs != null) {
      for (const [k, v] of vs) {
        t = `${t}\u{0}${k}=${v}`
        count += 1
      }
    }
    const modes = inMode + outMode * 4 + errMode * 16 + (if (clearEnv) 64 else 0) +
      (if (verbatim) 128 else 0)
    const job = __io(110, args.length, count, modes, program, t)
    const r = __io(102, job, 0, 0, "", "")
    const r2 = __io(103, job, 0, 0, "", "")
    const fds = __text(job).split(" ")
    if (r < 0) {
      const e = new ProcessError(program, `cannot run ${program}: ${__what(r, r2)}`, __kinds[__kind(r)])
      return new Child(0, program, e, new Writer(-1, "stdin", inMode == 1),
        new Reader(-1, "stdout", outMode == 1), new Reader(-1, "stderr", errMode == 1))
    }
    new Child(r, program, null, new Writer(parseInt(fds[0]), "stdin", inMode == 1),
      new Reader(parseInt(fds[1]), "stdout", outMode == 1),
      new Reader(parseInt(fds[2]), "stderr", errMode == 1))
  }

  /// Runs the program with its `stdout` and `stderr` piped and waits for it: what it wrote
  /// and how it ended.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const out = await new Command("ls", ["/"]).output()
  /// println(out.success)                     // true
  /// println(out.stdout.split("\n").length > 1)   // true
  /// ```
  public output(): Promise<Output, ProcessError> {
    spawnWith(__mode(stdinMode), 1, 1).output()
  }

  /// Runs the program and waits for it to end.
  ///
  /// @example
  /// ```ts
  /// import { Command } from "std/process"
  ///
  /// const s = await new Command("true").status()
  /// println(s.success)   // true
  /// const f = await new Command("false").status()
  /// println(f.code)      // 1
  /// ```
  public status(): Promise<ExitStatus, ProcessError> {
    spawn().status()
  }
}
