// `std/worker` (spec §10.2): the worker side of a worker thread.
//
// `import { self } from "std/worker"`, then `self.onmessage = (job: Job) => { … }` and
// `self.postMessage(result)`.

/// The worker's side of its channel to the parent: `self` is the one instance.
export class WorkerSelf {
  /// A handle on the current worker's channel; use `self` rather than making another.
  constructor() {}

  /// Sends a copy of `message` to the parent (nothing in the main thread);
  /// `options.transfer`: buffers moved instead.
  public postMessage<T extends Sendable>(message: T, options: TransferOptions? = null): void {
    __worker_post(0, message, __transfer(options))
    __detachAll(options)
  }

  /// Stops listening: the worker ends once nothing else is pending.
  public close(): void {
    const l = __theLoop()
    l.listening = false
    l.channels.delete(0);
  }
}

/// This worker (set `onmessage` on it to receive the parent's messages).
export const self = new WorkerSelf()

/// `f` over every item, in parallel on up to `workers` inline workers (spec §10.4); the
/// results in order. `f` must not capture anything.
export function parallelMap<T extends Sendable, U extends Sendable, E extends Error>(
  items: T[],
  f: (item: T) => U throws E,
  workers: int,
): Promise<U[], E> {
  const n = if (workers < 1) 1 else if (workers > items.length) items.length else workers
  const pool: Worker<T, U, E>[] = []
  for (let i = 0; i < n; i++) {
    pool.push(new Worker<T, U, E>(f))
  }
  const calls: Promise<U, E>[] = []
  for (let i = 0; i < items.length; i++) {
    calls.push(pool[i % n].call(items[i]))
  }
  const all = Promise.all(calls)
  all.__onSettle(() => {
    for (const w of pool) {
      w.terminate()
    }
  })
  all
}

/// A fixed number of workers running the same module (`new WorkerPool<In, Out>("./job",
/// size: n)`); `run(job)` sends a job to the least busy one and promises its next message.
export class WorkerPool<In extends Sendable, Out extends Sendable> {
  workers: Worker<In, Out>[] = []
  /// Per worker: the promises waiting for its answers, oldest first.
  waiting: Promise<Out>[][] = []

  /// (`module` is the module's id: the compiler rewrites the path.)
  constructor(module: int, size: int) {
    const n = if (size < 1) 1 else size
    for (let i = 0; i < n; i++) {
      const w = new Worker<In, Out>(module, 0)
      this.waiting.push([])
      w.onmessage = (m: Out) => {
        const q = this.waiting[i]
        if (q.length > 0) {
          this.waiting[i] = q.slice(1)
          q[0].__resolve(m)
        }
      }
      this.workers.push(w)
    }
  }

  /// The number of workers (`size`, at least 1).
  public get size(): int {
    this.workers.length
  }

  /// Sends `job` to the worker with the fewest jobs waiting.
  public run(job: In): Promise<Out> {
    let best = 0
    for (let i = 1; i < this.workers.length; i++) {
      if (this.waiting[i].length < this.waiting[best].length) {
        best = i
      }
    }
    const p = new Promise<Out>()
    this.waiting[best].push(p)
    this.workers[best].postMessage(job)
    p
  }

  /// Stops every worker; jobs still waiting for an answer never settle.
  public terminate(): void {
    for (const w of this.workers) {
      w.terminate()
    }
  }
}
