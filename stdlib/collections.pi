// `std/collections` (spec §13.2): `Deque` (a double-ended queue), `PriorityQueue` (a binary
// heap), `SortedMap` (keys kept in order) and `BitSet`. Each one walks with `for-of`.
//
// Iterators end at `null` (spec §5.7), so iterating a collection of a nullable type stops at
// its first `null` element; use `toArray()` for those.

/// A double-ended queue: push and pop at both ends in amortized O(1), index in O(1).
///
/// @example
/// ```ts
/// import { Deque } from "std/collections"
///
/// const d = new Deque<int>([2, 3])
/// d.pushFront(1)
/// d.pushBack(4)
/// println(d.popFront())              // 1
/// println(d.popBack())               // 4
/// println(d.toArray().join(", "))    // 2, 3
/// ```
export class Deque<T> {
  /// The front half, reversed (its last element is the deque's first).
  front: T[] = []
  back: T[] = []

  /// A deque holding `items`, front to back.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<string>(["a", "b", "c"])
  /// println(d.peekFront())   // a
  /// println(d.length)        // 3
  /// ```
  constructor(items: T[] = []) {
    for (const x of items) this.back.push(x)
  }

  /// The number of elements.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([1, 2])
  /// d.push(3)
  /// println(d.length)   // 3
  /// ```
  public get length(): int { return this.front.length + this.back.length }
  /// Whether there are no elements.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>()
  /// println(d.isEmpty)   // true
  /// d.push(1)
  /// println(d.isEmpty)   // false
  /// ```
  public get isEmpty(): bool { return this.front.length == 0 && this.back.length == 0 }

  /// Adds `x` at the back (also `push`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([1])
  /// d.pushBack(2)
  /// println(d.peekBack())   // 2
  /// ```
  public pushBack(x: T): void { this.back.push(x) }
  /// Adds `x` at the back (the same as `pushBack`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>()
  /// d.push(1)
  /// d.push(2)
  /// println(d.toArray().join(", "))   // 1, 2
  /// ```
  public push(x: T): void { this.back.push(x) }

  /// Adds `x` at the front (also `unshift`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([2])
  /// d.pushFront(1)
  /// println(d.peekFront())   // 1
  /// ```
  public pushFront(x: T): void { this.front.push(x) }
  /// Adds `x` at the front (the same as `pushFront`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([3])
  /// d.unshift(2)
  /// d.unshift(1)
  /// println(d.toArray().join(", "))   // 1, 2, 3
  /// ```
  public unshift(x: T): void { this.front.push(x) }

  /// Moves half of one side over when the other runs out.
  balance(toFront: bool): void {
    const from = if (toFront) this.back else this.front
    const n = from.length
    if (n == 0) return
    // Keep the far half where it is; the near half moves (reversed) to the other side.
    const keep = n / 2
    const moved = n - keep
    const rest: T[] = []
    for (let i = 0; i < keep; i++) rest.push(from[moved + i])
    const other: T[] = []
    let i = moved - 1
    while (i >= 0) {
      other.push(from[i])
      i -= 1
    }
    if (toFront) {
      this.front = other
      this.back = rest
    } else {
      this.back = other
      this.front = rest
    }
  }

  /// Removes and returns the last element (`null` when empty; also `pop`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([1, 2])
  /// println(d.popBack())   // 2
  /// println(d.popBack())   // 1
  /// println(d.popBack())   // null
  /// ```
  public popBack(): T? {
    if (this.back.length == 0) this.balance(false)
    if (this.back.length == 0) return null
    this.back.pop()
  }
  /// Removes and returns the last element, or `null` when empty (the same as `popBack`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const stack = new Deque<string>()
  /// stack.push("a")
  /// stack.push("b")
  /// println(stack.pop())   // b
  /// ```
  public pop(): T? { this.popBack() }

  /// Removes and returns the first element (`null` when empty; also `shift`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([1, 2])
  /// println(d.popFront())   // 1
  /// println(d.length)       // 1
  /// ```
  public popFront(): T? {
    if (this.front.length == 0) this.balance(true)
    if (this.front.length == 0) return null
    this.front.pop()
  }
  /// Removes and returns the first element, or `null` when empty (the same as `popFront`).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const queue = new Deque<string>()
  /// queue.push("first")
  /// queue.push("second")
  /// println(queue.shift())   // first
  /// ```
  public shift(): T? { this.popFront() }

  /// The element at `i` (negative counts from the back), or `null` out of range.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<string>(["a", "b", "c"])
  /// println(d.at(1))    // b
  /// println(d.at(-1))   // c
  /// println(d.at(5))    // null
  /// ```
  public at(i: int): T? {
    const n = this.length
    const k = if (i < 0) n + i else i
    if (k < 0 || k >= n) return null
    if (k < this.front.length) this.front[this.front.length - 1 - k] else this.back[k - this.front.length]
  }

  /// The first element without removing it, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([7, 8])
  /// println(d.peekFront())   // 7
  /// println(d.length)        // 2
  /// ```
  public peekFront(): T? { this.at(0) }
  /// The last element without removing it, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([7, 8])
  /// println(d.peekBack())   // 8
  /// ```
  public peekBack(): T? { this.at(-1) }

  /// Removes every element.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([1, 2, 3])
  /// d.clear()
  /// println(d.isEmpty)   // true
  /// ```
  public clear(): void {
    this.front = []
    this.back = []
  }

  /// The elements, front to back.
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<int>([2])
  /// d.pushFront(1)
  /// d.pushBack(3)
  /// println(d.toArray().join(" "))   // 1 2 3
  /// ```
  public toArray(): T[] {
    const r: T[] = []
    let i = this.front.length - 1
    while (i >= 0) {
      r.push(this.front[i])
      i -= 1
    }
    for (const x of this.back) r.push(x)
    return r
  }

  /// `for (const x of deque)`: front to back, over a snapshot (changes during the loop don't show).
  ///
  /// @example
  /// ```ts
  /// import { Deque } from "std/collections"
  ///
  /// const d = new Deque<string>(["x", "y"])
  /// for (const s of d) println(s)
  /// // x
  /// // y
  /// ```
  public iterator(): Iterator<T> { this.toArray().iterator() }
}

/// A priority queue: `pop` gives the smallest element by `compare` (negative when `a` comes
/// first), so `(a, b) => b - a` makes a max-queue. Push and pop are O(log n).
///
/// @example
/// ```ts
/// import { PriorityQueue } from "std/collections"
///
/// const tasks = new PriorityQueue<int>((a, b) => a - b, [5, 1, 3])
/// tasks.push(2)
/// println(tasks.pop())   // 1
/// println(tasks.pop())   // 2
/// ```
export class PriorityQueue<T> {
  heap: T[] = []
  compare: (a: T, b: T) => int

  /// A queue ordered by `compare` (negative when `a` comes first), holding `items`.
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const maxQueue = new PriorityQueue<int>((a, b) => b - a, [3, 9, 4])
  /// println(maxQueue.peek())   // 9
  /// ```
  constructor(compare: (a: T, b: T) => int, items: T[] = []) {
    this.compare = compare
    for (const x of items) this.push(x)
  }

  /// The number of elements.
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [3, 1])
  /// println(q.size)   // 2
  /// ```
  public get size(): int { return this.heap.length }
  /// Whether there are no elements.
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b)
  /// println(q.isEmpty)   // true
  /// ```
  public get isEmpty(): bool { return this.heap.length == 0 }

  /// Adds `x` in O(log n).
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<string>((a, b) => a.length - b.length)
  /// q.push("banana")
  /// q.push("fig")
  /// println(q.peek())   // fig
  /// ```
  public push(x: T): void {
    this.heap.push(x)
    let i = this.heap.length - 1
    const cmp = this.compare
    while (i > 0) {
      const parent = (i - 1) / 2
      if (cmp(this.heap[i], this.heap[parent]) >= 0) break
      const t = this.heap[i]
      this.heap[i] = this.heap[parent]
      this.heap[parent] = t
      i = parent
    }
  }

  /// The first element without removing it (`null` when empty).
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [4, 2])
  /// println(q.peek())   // 2
  /// println(q.size)     // 2
  /// ```
  public peek(): T? {
    if (this.heap.length == 0) null else this.heap[0]
  }

  /// Removes and returns the first element (`null` when empty).
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [4, 2])
  /// println(q.pop())   // 2
  /// println(q.pop())   // 4
  /// println(q.pop())   // null
  /// ```
  public pop(): T? {
    const n = this.heap.length
    if (n == 0) return null
    const top = this.heap[0]
    // Read the last element by index: with a nullable `T`, `pop()`'s `null` could be an element.
    const last = this.heap[n - 1]
    this.heap.pop()
    if (n > 1) {
      this.heap[0] = last
      this.siftDown(0)
    }
    return top
  }

  siftDown(start: int): void {
    const cmp = this.compare
    const n = this.heap.length
    let i = start
    while (true) {
      const l = 2 * i + 1
      const r = l + 1
      let m = i
      if (l < n && cmp(this.heap[l], this.heap[m]) < 0) m = l
      if (r < n && cmp(this.heap[r], this.heap[m]) < 0) m = r
      if (m == i) break
      const t = this.heap[i]
      this.heap[i] = this.heap[m]
      this.heap[m] = t
      i = m
    }
  }

  /// Removes every element.
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [1, 2])
  /// q.clear()
  /// println(q.size)   // 0
  /// ```
  public clear(): void { this.heap = [] }

  /// The elements in priority order (the queue is unchanged).
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [5, 1, 4, 2])
  /// println(q.toSortedArray().join(", "))   // 1, 2, 4, 5
  /// println(q.size)                         // 4
  /// ```
  public toSortedArray(): T[] {
    const copy = new PriorityQueue<T>(this.compare)
    for (const x of this.heap) copy.heap.push(x)
    const r: T[] = []
    while (copy.heap.length > 0) {
      r.push(copy.heap[0])
      copy.pop()
    }
    return r
  }

  /// The elements in heap order (not sorted).
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => a - b, [3, 1, 2])
  /// println(q.toArray().length)   // 3
  /// println(q.toArray()[0])       // 1
  /// ```
  public toArray(): T[] { this.heap.slice(0) }

  /// Walks the elements in priority order.
  ///
  /// @example
  /// ```ts
  /// import { PriorityQueue } from "std/collections"
  ///
  /// const q = new PriorityQueue<int>((a, b) => b - a, [1, 3, 2])
  /// for (const x of q) println(x)
  /// // 3
  /// // 2
  /// // 1
  /// ```
  public iterator(): Iterator<T> { this.toSortedArray().iterator() }
}

/// Inserts `x` at `i`, moving later elements up.
function __insertAt<T>(xs: T[], i: int, x: T): void {
  xs.push(x)
  let j = xs.length - 1
  while (j > i) {
    xs[j] = xs[j - 1]
    j -= 1
  }
  xs[i] = x
}

/// Removes the element at `i`, moving later elements down.
function __removeAt<T>(xs: T[], i: int): void {
  for (let j = i; j < xs.length - 1; j++) xs[j] = xs[j + 1]
  xs.pop();
}

/// A node of `SortedMap`'s AVL tree.
class __TreeNode<K, V> {
  public key: K
  public value: V
  public left: __TreeNode<K, V>? = null
  public right: __TreeNode<K, V>? = null
  public height: int = 1
  constructor(key: K, value: V) {
    this.key = key
    this.value = value
  }
}

function __height<K, V>(n: __TreeNode<K, V>?): int { if (n == null) 0 else n.height }

function __fix<K, V>(n: __TreeNode<K, V>): void {
  const l = __height(n.left)
  const r = __height(n.right)
  n.height = (if (l > r) l else r) + 1
}

function __rotateRight<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  const l = n.left!
  n.left = l.right
  l.right = n
  __fix(n)
  __fix(l)
  return l
}

function __rotateLeft<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  const r = n.right!
  n.right = r.left
  r.left = n
  __fix(n)
  __fix(r)
  return r
}

/// `n` rebalanced after one of its subtrees changed height by one.
function __balance<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  __fix(n)
  const b = __height(n.left) - __height(n.right)
  if (b > 1) {
    const l = n.left!
    if (__height(l.left) < __height(l.right)) n.left = __rotateLeft(l)
    return __rotateRight(n)
  }
  if (b < -1) {
    const r = n.right!
    if (__height(r.right) < __height(r.left)) n.right = __rotateRight(r)
    return __rotateLeft(n)
  }
  return n
}

/// A map whose keys stay sorted (by `compareTo`), as a balanced (AVL) tree: lookups, inserts
/// and deletes in O(log n) (#59), plus ordered queries (`floorKey`, `ceilingKey`, `range`).
///
/// @example
/// ```ts
/// import { SortedMap } from "std/collections"
///
/// const ages = new SortedMap<string, int>()
/// ages.set("carol", 41).set("alice", 30).set("bob", 25)
/// println(ages.keys().join(", "))   // alice, bob, carol
/// println(ages.get("bob"))          // 25
/// ```
export class SortedMap<K extends Comparable<K>, V> {
  root: __TreeNode<K, V>? = null
  count: int = 0

  /// An empty map.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// println(m.size)   // 0
  /// ```
  constructor() {}

  /// The number of entries.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(1, "one").set(2, "two").set(1, "uno")
  /// println(m.size)   // 2
  /// ```
  public get size(): int { return this.count }
  /// Whether there are no entries.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// println(m.isEmpty)   // true
  /// ```
  public get isEmpty(): bool { return this.count == 0 }

  node(k: K): __TreeNode<K, V>? {
    let n = this.root
    while (n != null) {
      const c = k.compareTo(n.key)
      if (c == 0) return n
      n = if (c < 0) n.left else n.right
    }
    return null
  }

  /// The value for `k`, or `null` if there's none. O(log n).
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("a", 1)
  /// println(m.get("a"))   // 1
  /// println(m.get("z"))   // null
  /// ```
  public get(k: K): V? {
    const n = this.node(k)
    if (n == null) null else n.value
  }

  /// Whether the map has an entry for `k`. O(log n).
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("a", 1)
  /// println(m.has("a"))   // true
  /// println(m.has("b"))   // false
  /// ```
  public has(k: K): bool { return this.node(k) != null }

  insert(n: __TreeNode<K, V>?, k: K, v: V): __TreeNode<K, V> {
    if (n == null) {
      this.count += 1
      return new __TreeNode<K, V>(k, v)
    }
    const c = k.compareTo(n.key)
    if (c == 0) {
      n.value = v
      return n
    }
    if (c < 0) n.left = this.insert(n.left, k, v) else n.right = this.insert(n.right, k, v)
    __balance(n)
  }

  /// Sets `k`'s value to `v` (O(log n)); the map itself, for chaining.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(3, "c").set(1, "a")
  /// println(m.firstKey())   // 1
  /// ```
  public set(k: K, v: V): SortedMap<K, V> {
    this.root = this.insert(this.root, k, v)
    this
  }

  /// `n` without its smallest node (which `min` then holds).
  removeMin(n: __TreeNode<K, V>, min: __TreeNode<K, V>[]): __TreeNode<K, V>? {
    const l = n.left
    if (l == null) {
      min.push(n)
      return n.right
    }
    n.left = this.removeMin(l, min)
    __balance(n)
  }

  remove(n: __TreeNode<K, V>?, k: K, found: bool[]): __TreeNode<K, V>? {
    if (n == null) return null
    const c = k.compareTo(n.key)
    if (c < 0) {
      n.left = this.remove(n.left, k, found)
    } else if (c > 0) {
      n.right = this.remove(n.right, k, found)
    } else {
      found.push(true)
      const l = n.left
      const r = n.right
      if (l == null) return r
      if (r == null) return l
      // The next key takes its place.
      const min: __TreeNode<K, V>[] = []
      const rest = this.removeMin(r, min)
      const m = min[0]
      m.left = l
      m.right = rest
      return __balance(m)
    }
    __balance(n)
  }

  /// Removes `k`'s entry (O(log n)); whether there was one.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(1, "a")
  /// println(m.delete(1))   // true
  /// println(m.delete(1))   // false
  /// ```
  public delete(k: K): bool {
    const found: bool[] = []
    this.root = this.remove(this.root, k, found)
    if (found.length > 0) this.count -= 1
    return found.length > 0
  }

  /// Removes every entry.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(1, "a").set(2, "b")
  /// m.clear()
  /// println(m.isEmpty)   // true
  /// ```
  public clear(): void {
    this.root = null
    this.count = 0
  }

  /// The smallest key, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(20, "b").set(10, "a")
  /// println(m.firstKey())   // 10
  /// ```
  public firstKey(): K? {
    const r = this.root
    if (r == null) return null
    let n: __TreeNode<K, V> = r
    let next = n.left
    while (next != null) {
      n = next
      next = n.left
    }
    return n.key
  }

  /// The largest key, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(20, "b").set(10, "a")
  /// println(m.lastKey())   // 20
  /// ```
  public lastKey(): K? {
    const r = this.root
    if (r == null) return null
    let n: __TreeNode<K, V> = r
    let next = n.right
    while (next != null) {
      n = next
      next = n.right
    }
    return n.key
  }

  /// The largest key `<= k`, or `null`.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// // Price brackets: the bracket of 75 starts at the largest key <= 75.
  /// const brackets = new SortedMap<int, string>()
  /// brackets.set(0, "cheap").set(50, "mid").set(100, "premium")
  /// const k = brackets.floorKey(75)
  /// if (k != null) println(brackets.get(k))   // mid
  /// println(brackets.floorKey(-1))            // null
  /// ```
  public floorKey(k: K): K? {
    let n = this.root
    let best: K? = null
    while (n != null) {
      const at: __TreeNode<K, V> = n
      const c = k.compareTo(at.key)
      if (c == 0) return at.key
      if (c < 0) {
        n = at.left
      } else {
        best = at.key
        n = at.right
      }
    }
    return best
  }

  /// The smallest key `>= k`, or `null`.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(10, "a").set(20, "b")
  /// println(m.ceilingKey(15))   // 20
  /// println(m.ceilingKey(25))   // null
  /// ```
  public ceilingKey(k: K): K? {
    let n = this.root
    let best: K? = null
    while (n != null) {
      const at: __TreeNode<K, V> = n
      const c = k.compareTo(at.key)
      if (c == 0) return at.key
      if (c > 0) {
        n = at.right
      } else {
        best = at.key
        n = at.left
      }
    }
    return best
  }

  /// The entries of `n` with `lo <= key < hi` (no bound when `null`), in order, onto `out`.
  walk(n: __TreeNode<K, V>?, lo: K?, hi: K?, out: [K, V][]): void {
    if (n == null) return
    const aboveLo = lo == null || n.key.compareTo(lo) >= 0
    const belowHi = hi == null || n.key.compareTo(hi) < 0
    if (aboveLo) this.walk(n.left, lo, hi, out)
    if (aboveLo && belowHi) out.push([n.key, n.value])
    if (belowHi) this.walk(n.right, lo, hi, out)
  }

  /// The entries with `lo <= key < hi`, in order.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(1, "a").set(2, "b").set(3, "c").set(4, "d")
  /// for (const [k, v] of m.range(2, 4)) println(`${k}=${v}`)
  /// // 2=b
  /// // 3=c
  /// ```
  public range(lo: K, hi: K): [K, V][] {
    const r: [K, V][] = []
    this.walk(this.root, lo, hi, r)
    return r
  }

  /// The `[key, value]` pairs in key order.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("y", 2).set("x", 1)
  /// println(m.entries().map(([k, v]) => `${k}=${v}`).join(" "))   // x=1 y=2
  /// ```
  public entries(): [K, V][] {
    const r: [K, V][] = []
    this.walk(this.root, null, null, r)
    return r
  }

  /// The keys in order (a new array).
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("pear", 3).set("apple", 5)
  /// println(m.keys().join(", "))   // apple, pear
  /// ```
  public keys(): K[] {
    const r: K[] = []
    for (const [k, _] of this.entries()) r.push(k)
    return r
  }

  /// The values in key order (a new array).
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("pear", 3).set("apple", 5)
  /// println(m.values().join(", "))   // 5, 3
  /// ```
  public values(): V[] {
    const r: V[] = []
    for (const [_, v] of this.entries()) r.push(v)
    return r
  }

  /// Calls `f(value, key)` for each entry in key order.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<string, int>()
  /// m.set("b", 2).set("a", 1)
  /// m.forEach((v, k) => println(`${k}: ${v}`))
  /// // a: 1
  /// // b: 2
  /// ```
  public forEach(f: (value: V, key: K) => void): void {
    for (const [k, v] of this.entries()) f(v, k)
  }

  /// `for (const [k, v] of map)`: in key order.
  ///
  /// @example
  /// ```ts
  /// import { SortedMap } from "std/collections"
  ///
  /// const m = new SortedMap<int, string>()
  /// m.set(2, "two").set(1, "one")
  /// for (const [k, v] of m) println(`${k} ${v}`)
  /// // 1 one
  /// // 2 two
  /// ```
  public iterator(): Iterator<[K, V]> { this.entries().iterator() }
}

/// A set whose values stay sorted (by `compareTo`): adds, deletes and lookups in O(log n), and
/// the ordered queries of `SortedMap` (#59).
///
/// @example
/// ```ts
/// import { SortedSet } from "std/collections"
///
/// const s = new SortedSet<int>()
/// s.add(5).add(1).add(3).add(1)
/// println(s.values().join(", "))   // 1, 3, 5
/// println(s.ceiling(2))            // 3
/// ```
export class SortedSet<T extends Comparable<T>> {
  map: SortedMap<T, bool> = new SortedMap<T, bool>()

  /// An empty set.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<string>()
  /// println(s.size)   // 0
  /// ```
  constructor() {}

  /// How many values the set has.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<string>()
  /// s.add("a").add("b").add("a")
  /// println(s.size)   // 2
  /// ```
  public get size(): int { return this.map.size }
  /// Whether it's empty.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// println(s.isEmpty)   // true
  /// ```
  public get isEmpty(): bool { return this.map.isEmpty }
  /// Whether `v` is in the set.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(1)
  /// println(s.has(1))   // true
  /// println(s.has(2))   // false
  /// ```
  public has(v: T): bool { this.map.has(v) }
  /// Adds `v` (nothing changes if it's there); the set, for chaining.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<string>()
  /// s.add("pear").add("apple")
  /// println(s.first())   // apple
  /// ```
  public add(v: T): SortedSet<T> {
    this.map.set(v, true)
    this
  }
  /// Removes `v`; whether it was there.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(1)
  /// println(s.delete(1))   // true
  /// println(s.delete(1))   // false
  /// ```
  public delete(v: T): bool { this.map.delete(v) }
  /// Removes every value.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(1).add(2)
  /// s.clear()
  /// println(s.isEmpty)   // true
  /// ```
  public clear(): void { this.map.clear() }
  /// The smallest value, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(8).add(3)
  /// println(s.first())   // 3
  /// ```
  public first(): T? { this.map.firstKey() }
  /// The largest value, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(8).add(3)
  /// println(s.last())   // 8
  /// ```
  public last(): T? { this.map.lastKey() }
  /// The largest value `<= v`, or `null`.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(10).add(20)
  /// println(s.floor(15))   // 10
  /// println(s.floor(5))    // null
  /// ```
  public floor(v: T): T? { this.map.floorKey(v) }
  /// The smallest value `>= v`, or `null`.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(10).add(20)
  /// println(s.ceiling(15))   // 20
  /// println(s.ceiling(25))   // null
  /// ```
  public ceiling(v: T): T? { this.map.ceilingKey(v) }
  /// The values with `lo <= v < hi`, in order.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// for (const x of [1, 2, 3, 4, 5]) s.add(x)
  /// println(s.range(2, 4).join(", "))   // 2, 3
  /// ```
  public range(lo: T, hi: T): T[] {
    const r: T[] = []
    for (const [k, _] of this.map.range(lo, hi)) r.push(k)
    return r
  }
  /// The values in order (a new array).
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<string>()
  /// s.add("c").add("a").add("b")
  /// println(s.values().join(""))   // abc
  /// ```
  public values(): T[] { this.map.keys() }
  /// `for (const v of set)`: in order.
  ///
  /// @example
  /// ```ts
  /// import { SortedSet } from "std/collections"
  ///
  /// const s = new SortedSet<int>()
  /// s.add(2).add(1)
  /// for (const x of s) println(x)
  /// // 1
  /// // 2
  /// ```
  public iterator(): Iterator<T> { this.map.keys().iterator() }
}

/// A map from each key to a list of values, in the order they were added (#59).
///
/// @example
/// ```ts
/// import { MultiMap } from "std/collections"
///
/// const tags = new MultiMap<string, string>()
/// tags.add("fruit", "apple").add("fruit", "pear").add("veg", "leek")
/// println(tags.get("fruit").join(", "))   // apple, pear
/// println(tags.size)                      // 3
/// ```
export class MultiMap<K extends Hashable<K>, V> {
  map: Map<K, V[]> = new Map<K, V[]>()
  count: int = 0

  /// An empty map.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// println(m.size)   // 0
  /// ```
  constructor() {}

  /// How many values there are, over all keys.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("a", 1).add("a", 2).add("b", 3)
  /// println(m.size)   // 3
  /// ```
  public get size(): int { return this.count }
  /// How many keys have values.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("a", 1).add("a", 2).add("b", 3)
  /// println(m.keyCount)   // 2
  /// ```
  public get keyCount(): int { return this.map.size }
  /// Adds `v` to `k`'s values; the map, for chaining.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("x", 1).add("x", 2)
  /// println(m.get("x").join(", "))   // 1, 2
  /// ```
  public add(k: K, v: V): MultiMap<K, V> {
    const vs = this.map.get(k)
    if (vs == null) {
      this.map.set(k, [v]);
    } else {
      vs.push(v)
    }
    this.count += 1
    this
  }
  /// `k`'s values (a new array; empty when there are none).
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("x", 1)
  /// println(m.get("x").length)   // 1
  /// println(m.get("y").length)   // 0
  /// ```
  public get(k: K): V[] {
    const vs = this.map.get(k)
    if (vs == null) [] else vs.slice(0)
  }
  /// Whether `k` has any values.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("x", 1)
  /// println(m.has("x"))   // true
  /// println(m.has("y"))   // false
  /// ```
  public has(k: K): bool { this.map.has(k) }
  /// Removes all of `k`'s values; how many there were.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("x", 1).add("x", 2)
  /// println(m.delete("x"))   // 2
  /// println(m.has("x"))      // false
  /// ```
  public delete(k: K): int {
    const vs = this.map.get(k)
    if (vs == null) return 0
    this.map.delete(k)
    this.count -= vs.length
    return vs.length
  }
  /// Removes everything.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("x", 1)
  /// m.clear()
  /// println(m.size)   // 0
  /// ```
  public clear(): void {
    this.map.clear()
    this.count = 0
  }
  /// The keys with values, in the order they first got one.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("b", 1).add("a", 2).add("b", 3)
  /// println(m.keys().join(", "))   // b, a
  /// ```
  public keys(): K[] { this.map.keys() }
  /// Every `[key, value]` pair, key by key.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("b", 1).add("a", 2).add("b", 3)
  /// println(m.entries().map(([k, v]) => `${k}${v}`).join(" "))   // b1 b3 a2
  /// ```
  public entries(): [K, V][] {
    const r: [K, V][] = []
    for (const [k, vs] of this.map) {
      for (const v of vs) r.push([k, v])
    }
    return r
  }
  /// `for (const [k, v] of multi)`: every pair, key by key.
  ///
  /// @example
  /// ```ts
  /// import { MultiMap } from "std/collections"
  ///
  /// const m = new MultiMap<string, int>()
  /// m.add("a", 1).add("a", 2)
  /// for (const [k, v] of m) println(`${k}=${v}`)
  /// // a=1
  /// // a=2
  /// ```
  public iterator(): Iterator<[K, V]> { this.entries().iterator() }
}

/// A node of `LinkedList` (and `LruCache`'s order).
class __ListNode<T> {
  public value: T
  public prev: __ListNode<T>? = null
  public next: __ListNode<T>? = null
  constructor(value: T) { this.value = value }
}

/// A doubly linked list: adding and removing at either end in O(1) (#59). `Deque` is usually
/// faster; this one never moves its elements.
///
/// @example
/// ```ts
/// import { LinkedList } from "std/collections"
///
/// const list = new LinkedList<string>()
/// list.push("b")
/// list.unshift("a")
/// list.push("c")
/// println(list.toArray().join(", "))   // a, b, c
/// println(list.shift())                // a
/// ```
export class LinkedList<T> {
  head: __ListNode<T>? = null
  tail: __ListNode<T>? = null
  count: int = 0

  /// An empty list.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// println(list.size)   // 0
  /// ```
  constructor() {}

  /// How many elements it has.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(1)
  /// list.push(2)
  /// println(list.size)   // 2
  /// ```
  public get size(): int { return this.count }
  /// Whether it's empty.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// println(list.isEmpty)   // true
  /// ```
  public get isEmpty(): bool { return this.count == 0 }

  /// Adds `v` at the end.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(1)
  /// list.push(2)
  /// println(list.last())   // 2
  /// ```
  public push(v: T): void {
    const n = new __ListNode<T>(v)
    const t = this.tail
    if (t == null) this.head = n else {
      t.next = n
      n.prev = t
    }
    this.tail = n
    this.count += 1
  }

  /// Adds `v` at the start.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.unshift(2)
  /// list.unshift(1)
  /// println(list.first())   // 1
  /// ```
  public unshift(v: T): void {
    const n = new __ListNode<T>(v)
    const h = this.head
    if (h == null) this.tail = n else {
      h.prev = n
      n.next = h
    }
    this.head = n
    this.count += 1
  }

  /// Removes the last element and returns it; `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(1)
  /// list.push(2)
  /// println(list.pop())   // 2
  /// println(list.size)    // 1
  /// ```
  public pop(): T? {
    const t = this.tail
    if (t == null) return null
    this.tail = t.prev
    const p = t.prev
    if (p == null) this.head = null else p.next = null
    this.count -= 1
    return t.value
  }

  /// Removes the first element and returns it; `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(1)
  /// println(list.shift())   // 1
  /// println(list.shift())   // null
  /// ```
  public shift(): T? {
    const h = this.head
    if (h == null) return null
    this.head = h.next
    const n = h.next
    if (n == null) this.tail = null else n.prev = null
    this.count -= 1
    return h.value
  }

  /// The first element, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<string>()
  /// println(list.first())   // null
  /// list.push("x")
  /// println(list.first())   // x
  /// ```
  public first(): T? {
    const h = this.head
    if (h == null) null else h.value
  }

  /// The last element, or `null` when empty.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<string>()
  /// list.push("x")
  /// list.push("y")
  /// println(list.last())   // y
  /// ```
  public last(): T? {
    const t = this.tail
    if (t == null) null else t.value
  }

  /// Removes every element.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(1)
  /// list.clear()
  /// println(list.isEmpty)   // true
  /// ```
  public clear(): void {
    this.head = null
    this.tail = null
    this.count = 0
  }

  /// The elements in order (a new array).
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<int>()
  /// list.push(2)
  /// list.unshift(1)
  /// println(list.toArray().join(" "))   // 1 2
  /// ```
  public toArray(): T[] {
    const r: T[] = []
    let n = this.head
    while (n != null) {
      r.push(n.value)
      n = n.next
    }
    return r
  }

  /// `for (const v of list)`: in order.
  ///
  /// @example
  /// ```ts
  /// import { LinkedList } from "std/collections"
  ///
  /// const list = new LinkedList<string>()
  /// list.push("a")
  /// list.push("b")
  /// for (const s of list) println(s)
  /// // a
  /// // b
  /// ```
  public iterator(): Iterator<T> { this.toArray().iterator() }
}

/// A map that holds at most `capacity` entries, dropping the least recently used one (by `get`
/// or `set`) when a new key would go past it (#59). Every operation is O(1).
///
/// @example
/// ```ts
/// import { LruCache } from "std/collections"
///
/// const cache = new LruCache<string, int>(2)
/// cache.set("a", 1).set("b", 2)
/// cache.get("a")         // "a" is now the most recently used
/// cache.set("c", 3)      // drops "b"
/// println(cache.has("b"))            // false
/// println(cache.keys().join(", "))   // c, a
/// ```
export class LruCache<K extends Hashable<K>, V> {
  public readonly capacity: int
  map: Map<K, __ListNode<[K, V]>> = new Map<K, __ListNode<[K, V]>>()
  /// Most recently used first.
  head: __ListNode<[K, V]>? = null
  tail: __ListNode<[K, V]>? = null

  /// An empty cache for at most `capacity` entries (at least 1).
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<int, string>(100)
  /// println(cache.capacity)   // 100
  /// ```
  constructor(capacity: int) {
    if (capacity < 1) panic(`an LruCache needs a capacity of at least 1, got ${capacity}`)
    this.capacity = capacity
  }

  /// How many entries it has.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(2)
  /// cache.set("a", 1).set("b", 2).set("c", 3)
  /// println(cache.size)   // 2
  /// ```
  public get size(): int { return this.map.size }

  unlink(n: __ListNode<[K, V]>): void {
    const p = n.prev
    const x = n.next
    if (p == null) this.head = x else p.next = x
    if (x == null) this.tail = p else x.prev = p
    n.prev = null
    n.next = null
  }

  front(n: __ListNode<[K, V]>): void {
    const h = this.head
    n.next = h
    if (h == null) this.tail = n else h.prev = n
    this.head = n
  }

  /// `k`'s value (now the most recently used), or `null`.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(10)
  /// cache.set("a", 1)
  /// println(cache.get("a"))   // 1
  /// println(cache.get("b"))   // null
  /// ```
  public get(k: K): V? {
    const n = this.map.get(k)
    if (n == null) return null
    this.unlink(n)
    this.front(n)
    return n.value[1]
  }

  /// `k`'s value without counting as a use, or `null`.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(2)
  /// cache.set("a", 1).set("b", 2)
  /// println(cache.peek("a"))           // 1
  /// println(cache.keys().join(", "))   // b, a
  /// ```
  public peek(k: K): V? {
    const n = this.map.get(k)
    if (n == null) null else n.value[1]
  }

  /// Whether `k` has an entry (not counting as a use).
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(2)
  /// cache.set("a", 1)
  /// println(cache.has("a"))   // true
  /// ```
  public has(k: K): bool { this.map.has(k) }

  /// Sets `k`'s value (now the most recently used), dropping the least recently used entry when
  /// the cache is full; the cache, for chaining.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(1)
  /// cache.set("a", 1).set("b", 2)
  /// println(cache.has("a"))   // false
  /// println(cache.get("b"))   // 2
  /// ```
  public set(k: K, v: V): LruCache<K, V> {
    const old = this.map.get(k)
    if (old != null) {
      old.value = [k, v]
      this.unlink(old)
      this.front(old)
      return this
    }
    if (this.map.size >= this.capacity) {
      const t = this.tail
      if (t != null) {
        this.unlink(t)
        this.map.delete(t.value[0])
      }
    }
    const n = new __ListNode<[K, V]>([k, v])
    this.front(n)
    this.map.set(k, n)
    this
  }

  /// Removes `k`'s entry; whether there was one.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(2)
  /// cache.set("a", 1)
  /// println(cache.delete("a"))   // true
  /// println(cache.size)          // 0
  /// ```
  public delete(k: K): bool {
    const n = this.map.get(k)
    if (n == null) return false
    this.unlink(n)
    this.map.delete(k)
    return true
  }

  /// Removes every entry.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(2)
  /// cache.set("a", 1).set("b", 2)
  /// cache.clear()
  /// println(cache.size)   // 0
  /// ```
  public clear(): void {
    this.map.clear()
    this.head = null
    this.tail = null
  }

  /// The keys, most recently used first.
  ///
  /// @example
  /// ```ts
  /// import { LruCache } from "std/collections"
  ///
  /// const cache = new LruCache<string, int>(3)
  /// cache.set("a", 1).set("b", 2).set("c", 3)
  /// println(cache.keys().join(", "))   // c, b, a
  /// ```
  public keys(): K[] {
    const r: K[] = []
    let n = this.head
    while (n != null) {
      r.push(n.value[0])
      n = n.next
    }
    return r
  }
}

/// A growable set of small non-negative integers, one bit each.
///
/// @example
/// ```ts
/// import { BitSet } from "std/collections"
///
/// const flags = new BitSet([1, 5])
/// flags.add(64)
/// println(flags.has(5))   // true
/// println(flags)          // {1, 5, 64}
/// ```
export class BitSet {
  /// 32 bits per word.
  words: int[] = []

  /// A set with the bits in `bits` set (a negative one panics).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([0, 3])
  /// println(bits.size)   // 2
  /// ```
  constructor(bits: int[] = []) {
    for (const b of bits) this.add(b)
  }

  static __check(i: int): void {
    if (i < 0) panic(`BitSet: negative index ${i}`)
  }

  /// Whether bit `i` is set (`false` beyond the highest one; a negative `i` panics).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([2])
  /// println(bits.has(2))      // true
  /// println(bits.has(1000))   // false
  /// ```
  public has(i: int): bool {
    BitSet.__check(i)
    const w = i >> 5
    return w < this.words.length && ((this.words[w] >> (i & 31)) & 1) == 1
  }

  /// Sets bit `i` (grows as needed).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet()
  /// bits.add(1).add(100)
  /// println(bits)   // {1, 100}
  /// ```
  public add(i: int): BitSet {
    BitSet.__check(i)
    const w = i >> 5
    while (this.words.length <= w) this.words.push(0)
    this.words[w] = this.words[w] | (1 << (i & 31))
    this
  }

  /// Clears bit `i`; `true` if it was set.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([3])
  /// println(bits.delete(3))   // true
  /// println(bits.delete(3))   // false
  /// ```
  public delete(i: int): bool {
    if (!this.has(i)) return false
    const w = i >> 5
    this.words[w] = this.words[w] & ~(1 << (i & 31)) & 0xFFFFFFFF
    return true
  }

  /// Sets `i` when `on`, else clears it.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet()
  /// bits.set(4, true)
  /// bits.set(5, true)
  /// bits.set(4, false)
  /// println(bits)   // {5}
  /// ```
  public set(i: int, on: bool): void {
    if (on) {
      this.add(i);
    } else {
      this.delete(i);
    }
  }

  /// Toggles bit `i` (a negative `i` panics).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([1])
  /// bits.flip(1)
  /// bits.flip(2)
  /// println(bits)   // {2}
  /// ```
  public flip(i: int): void { this.set(i, !this.has(i)) }

  /// Clears every bit.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([1, 2])
  /// bits.clear()
  /// println(bits.isEmpty)   // true
  /// ```
  public clear(): void { this.words = [] }

  /// The number of set bits.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([1, 40, 100])
  /// println(bits.size)   // 3
  /// ```
  public get size(): int {
    let n = 0
    for (const w of this.words) {
      let x = w
      while (x != 0) {
        x = x & (x - 1)
        n += 1
      }
    }
    return n
  }

  /// Whether no bit is set.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// println(new BitSet().isEmpty)      // true
  /// println(new BitSet([0]).isEmpty)   // false
  /// ```
  public get isEmpty(): bool { return this.size == 0 }

  /// One more than the highest set bit (0 when empty).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([1, 40])
  /// println(bits.length)   // 41
  /// ```
  public get length(): int {
    let w = this.words.length - 1
    while (w >= 0) {
      const x = this.words[w]
      if (x != 0) {
        let b = 31
        while (((x >> b) & 1) == 0) b -= 1
        return w * 32 + b + 1
      }
      w -= 1
    }
    return 0
  }

  static __combine(a: BitSet, b: BitSet, op: int): BitSet {
    const r = new BitSet()
    const n = if (a.words.length > b.words.length) a.words.length else b.words.length
    for (let i = 0; i < n; i++) {
      const x = if (i < a.words.length) a.words[i] else 0
      const y = if (i < b.words.length) b.words[i] else 0
      r.words.push(if (op == 0) x & y else if (op == 1) x | y else if (op == 2) x ^ y else x & ~y & 0xFFFFFFFF)
    }
    return r
  }

  /// A new set: the bits in both this set and `o`.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const a = new BitSet([1, 2, 3])
  /// const b = new BitSet([2, 3, 4])
  /// println(a.and(b))   // {2, 3}
  /// ```
  public and(o: BitSet): BitSet { BitSet.__combine(this, o, 0) }
  /// A new set: the bits in either this set or `o`.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const a = new BitSet([1, 2])
  /// const b = new BitSet([2, 70])
  /// println(a.or(b))   // {1, 2, 70}
  /// ```
  public or(o: BitSet): BitSet { BitSet.__combine(this, o, 1) }
  /// A new set: the bits in exactly one of this set and `o`.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const a = new BitSet([1, 2])
  /// const b = new BitSet([2, 3])
  /// println(a.xor(b))   // {1, 3}
  /// ```
  public xor(o: BitSet): BitSet { BitSet.__combine(this, o, 2) }
  /// A new set: the bits in this set but not in `o`.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const a = new BitSet([1, 2, 3])
  /// const b = new BitSet([2])
  /// println(a.andNot(b))   // {1, 3}
  /// ```
  public andNot(o: BitSet): BitSet { BitSet.__combine(this, o, 3) }

  /// The same bits set (trailing zero words don't matter).
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const a = new BitSet([1, 100])
  /// a.delete(100)
  /// println(a.equals(new BitSet([1])))   // true
  /// ```
  public equals(o: BitSet): bool {
    const n = if (this.words.length > o.words.length) this.words.length else o.words.length
    for (let i = 0; i < n; i++) {
      const x = if (i < this.words.length) this.words[i] else 0
      const y = if (i < o.words.length) o.words[i] else 0
      if (x != y) return false
    }
    return true
  }

  /// The set bits, ascending.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([9, 2, 5])
  /// println(bits.toArray().join(", "))   // 2, 5, 9
  /// ```
  public toArray(): int[] {
    const r: int[] = []
    for (let w = 0; w < this.words.length; w++) {
      const x = this.words[w]
      if (x == 0) continue
      for (let b = 0; b < 32; b++) {
        if (((x >> b) & 1) == 1) r.push(w * 32 + b)
      }
    }
    return r
  }

  /// `for (const i of bits)`: the set bits, ascending.
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([3, 1])
  /// for (const i of bits) println(i)
  /// // 1
  /// // 3
  /// ```
  public iterator(): Iterator<int> { this.toArray().iterator() }

  /// `{1, 5, 64}`
  ///
  /// @example
  /// ```ts
  /// import { BitSet } from "std/collections"
  ///
  /// const bits = new BitSet([1, 5, 64])
  /// println(bits.toString())   // {1, 5, 64}
  /// ```
  public toString(): string { return "{" + this.toArray().join(", ") + "}" }
}
