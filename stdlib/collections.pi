// `std/collections` (spec §13.2): `Deque` (a double-ended queue), `PriorityQueue` (a binary
// heap), `SortedMap` (keys kept in order) and `BitSet`. Each one walks with `for-of`.
//
// Iterators end at `null` (spec §5.7), so iterating a collection of a nullable type stops at
// its first `null` element; use `toArray()` for those.

/// A double-ended queue: push and pop at both ends in amortized O(1), index in O(1).
export class Deque<T> {
  /// The front half, reversed (its last element is the deque's first).
  front: T[] = []
  back: T[] = []

  /// A deque holding `items`, front to back.
  constructor(items: T[] = []) {
    for (const x of items) this.back.push(x)
  }

  /// The number of elements.
  public get length(): int { this.front.length + this.back.length }
  /// Whether there are no elements.
  public get isEmpty(): bool { this.front.length == 0 && this.back.length == 0 }

  /// Adds `x` at the back (also `push`).
  public pushBack(x: T): void { this.back.push(x) }
  /// Adds `x` at the back (the same as `pushBack`).
  public push(x: T): void { this.back.push(x) }

  /// Adds `x` at the front (also `unshift`).
  public pushFront(x: T): void { this.front.push(x) }
  /// Adds `x` at the front (the same as `pushFront`).
  public unshift(x: T): void { this.front.push(x) }

  /// Moves half of one side over when the other runs out.
  balance(toFront: bool): void {
    const from = if (toFront) this.back else this.front
    const n = from.length
    if (n == 0) return
    // Keep the far half where it is; the near half moves (reversed) to the other side.
    const keep = n / 2
    const moved = n - keep
    const rest: T[] = []
    for (let i = 0; i < keep; i++) rest.push(from[moved + i])
    const other: T[] = []
    let i = moved - 1
    while (i >= 0) {
      other.push(from[i])
      i -= 1
    }
    if (toFront) {
      this.front = other
      this.back = rest
    } else {
      this.back = other
      this.front = rest
    }
  }

  /// Removes and returns the last element (`null` when empty; also `pop`).
  public popBack(): T? {
    if (this.back.length == 0) this.balance(false)
    if (this.back.length == 0) return null
    this.back.pop()
  }
  /// Removes and returns the last element, or `null` when empty (the same as `popBack`).
  public pop(): T? { this.popBack() }

  /// Removes and returns the first element (`null` when empty; also `shift`).
  public popFront(): T? {
    if (this.front.length == 0) this.balance(true)
    if (this.front.length == 0) return null
    this.front.pop()
  }
  /// Removes and returns the first element, or `null` when empty (the same as `popFront`).
  public shift(): T? { this.popFront() }

  /// The element at `i` (negative counts from the back), or `null` out of range.
  public at(i: int): T? {
    const n = this.length
    const k = if (i < 0) n + i else i
    if (k < 0 || k >= n) return null
    if (k < this.front.length) this.front[this.front.length - 1 - k] else this.back[k - this.front.length]
  }

  /// The first element without removing it, or `null` when empty.
  public peekFront(): T? { this.at(0) }
  /// The last element without removing it, or `null` when empty.
  public peekBack(): T? { this.at(-1) }

  /// Removes every element.
  public clear(): void {
    this.front = []
    this.back = []
  }

  /// The elements, front to back.
  public toArray(): T[] {
    const r: T[] = []
    let i = this.front.length - 1
    while (i >= 0) {
      r.push(this.front[i])
      i -= 1
    }
    for (const x of this.back) r.push(x)
    r
  }

  /// `for (const x of deque)`: front to back, over a snapshot (changes during the loop don't show).
  public iterator(): Iterator<T> { this.toArray().iterator() }
}

/// A priority queue: `pop` gives the smallest element by `compare` (negative when `a` comes
/// first), so `(a, b) => b - a` makes a max-queue. Push and pop are O(log n).
export class PriorityQueue<T> {
  heap: T[] = []
  compare: (a: T, b: T) => int

  /// A queue ordered by `compare` (negative when `a` comes first), holding `items`.
  constructor(compare: (a: T, b: T) => int, items: T[] = []) {
    this.compare = compare
    for (const x of items) this.push(x)
  }

  /// The number of elements.
  public get size(): int { this.heap.length }
  /// Whether there are no elements.
  public get isEmpty(): bool { this.heap.length == 0 }

  /// Adds `x` in O(log n).
  public push(x: T): void {
    this.heap.push(x)
    let i = this.heap.length - 1
    const cmp = this.compare
    while (i > 0) {
      const parent = (i - 1) / 2
      if (cmp(this.heap[i], this.heap[parent]) >= 0) break
      const t = this.heap[i]
      this.heap[i] = this.heap[parent]
      this.heap[parent] = t
      i = parent
    }
  }

  /// The first element without removing it (`null` when empty).
  public peek(): T? {
    if (this.heap.length == 0) null else this.heap[0]
  }

  /// Removes and returns the first element (`null` when empty).
  public pop(): T? {
    const n = this.heap.length
    if (n == 0) return null
    const top = this.heap[0]
    // Read the last element by index: with a nullable `T`, `pop()`'s `null` could be an element.
    const last = this.heap[n - 1]
    this.heap.pop()
    if (n > 1) {
      this.heap[0] = last
      this.siftDown(0)
    }
    top
  }

  siftDown(start: int): void {
    const cmp = this.compare
    const n = this.heap.length
    let i = start
    while (true) {
      const l = 2 * i + 1
      const r = l + 1
      let m = i
      if (l < n && cmp(this.heap[l], this.heap[m]) < 0) m = l
      if (r < n && cmp(this.heap[r], this.heap[m]) < 0) m = r
      if (m == i) break
      const t = this.heap[i]
      this.heap[i] = this.heap[m]
      this.heap[m] = t
      i = m
    }
  }

  /// Removes every element.
  public clear(): void { this.heap = [] }

  /// The elements in priority order (the queue is unchanged).
  public toSortedArray(): T[] {
    const copy = new PriorityQueue<T>(this.compare)
    for (const x of this.heap) copy.heap.push(x)
    const r: T[] = []
    while (copy.heap.length > 0) {
      r.push(copy.heap[0])
      copy.pop()
    }
    r
  }

  /// The elements in heap order (not sorted).
  public toArray(): T[] { this.heap.slice(0) }

  /// Walks the elements in priority order.
  public iterator(): Iterator<T> { this.toSortedArray().iterator() }
}

/// Inserts `x` at `i`, moving later elements up.
function __insertAt<T>(xs: T[], i: int, x: T): void {
  xs.push(x)
  let j = xs.length - 1
  while (j > i) {
    xs[j] = xs[j - 1]
    j -= 1
  }
  xs[i] = x
}

/// Removes the element at `i`, moving later elements down.
function __removeAt<T>(xs: T[], i: int): void {
  for (let j = i; j < xs.length - 1; j++) xs[j] = xs[j + 1]
  xs.pop();
}

/// A node of `SortedMap`'s AVL tree.
class __TreeNode<K, V> {
  public key: K
  public value: V
  public left: __TreeNode<K, V>? = null
  public right: __TreeNode<K, V>? = null
  public height: int = 1
  constructor(key: K, value: V) {
    this.key = key
    this.value = value
  }
}

function __height<K, V>(n: __TreeNode<K, V>?): int { if (n == null) 0 else n.height }

function __fix<K, V>(n: __TreeNode<K, V>): void {
  const l = __height(n.left)
  const r = __height(n.right)
  n.height = (if (l > r) l else r) + 1
}

function __rotateRight<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  const l = n.left!
  n.left = l.right
  l.right = n
  __fix(n)
  __fix(l)
  l
}

function __rotateLeft<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  const r = n.right!
  n.right = r.left
  r.left = n
  __fix(n)
  __fix(r)
  r
}

/// `n` rebalanced after one of its subtrees changed height by one.
function __balance<K, V>(n: __TreeNode<K, V>): __TreeNode<K, V> {
  __fix(n)
  const b = __height(n.left) - __height(n.right)
  if (b > 1) {
    const l = n.left!
    if (__height(l.left) < __height(l.right)) n.left = __rotateLeft(l)
    return __rotateRight(n)
  }
  if (b < -1) {
    const r = n.right!
    if (__height(r.right) < __height(r.left)) n.right = __rotateRight(r)
    return __rotateLeft(n)
  }
  n
}

/// A map whose keys stay sorted (by `compareTo`), as a balanced (AVL) tree: lookups, inserts
/// and deletes in O(log n) (#59), plus ordered queries (`floorKey`, `ceilingKey`, `range`).
export class SortedMap<K extends Comparable<K>, V> {
  root: __TreeNode<K, V>? = null
  count: int = 0

  /// An empty map.
  constructor() {}

  /// The number of entries.
  public get size(): int { this.count }
  /// Whether there are no entries.
  public get isEmpty(): bool { this.count == 0 }

  node(k: K): __TreeNode<K, V>? {
    let n = this.root
    while (n != null) {
      const c = k.compareTo(n.key)
      if (c == 0) return n
      n = if (c < 0) n.left else n.right
    }
    null
  }

  /// The value for `k`, or `null` if there's none. O(log n).
  public get(k: K): V? {
    const n = this.node(k)
    if (n == null) null else n.value
  }

  /// Whether the map has an entry for `k`. O(log n).
  public has(k: K): bool { this.node(k) != null }

  insert(n: __TreeNode<K, V>?, k: K, v: V): __TreeNode<K, V> {
    if (n == null) {
      this.count += 1
      return new __TreeNode<K, V>(k, v)
    }
    const c = k.compareTo(n.key)
    if (c == 0) {
      n.value = v
      return n
    }
    if (c < 0) n.left = this.insert(n.left, k, v) else n.right = this.insert(n.right, k, v)
    __balance(n)
  }

  /// Sets `k`'s value to `v` (O(log n)); the map itself, for chaining.
  public set(k: K, v: V): SortedMap<K, V> {
    this.root = this.insert(this.root, k, v)
    this
  }

  /// `n` without its smallest node (which `min` then holds).
  removeMin(n: __TreeNode<K, V>, min: __TreeNode<K, V>[]): __TreeNode<K, V>? {
    const l = n.left
    if (l == null) {
      min.push(n)
      return n.right
    }
    n.left = this.removeMin(l, min)
    __balance(n)
  }

  remove(n: __TreeNode<K, V>?, k: K, found: bool[]): __TreeNode<K, V>? {
    if (n == null) return null
    const c = k.compareTo(n.key)
    if (c < 0) {
      n.left = this.remove(n.left, k, found)
    } else if (c > 0) {
      n.right = this.remove(n.right, k, found)
    } else {
      found.push(true)
      const l = n.left
      const r = n.right
      if (l == null) return r
      if (r == null) return l
      // The next key takes its place.
      const min: __TreeNode<K, V>[] = []
      const rest = this.removeMin(r, min)
      const m = min[0]
      m.left = l
      m.right = rest
      return __balance(m)
    }
    __balance(n)
  }

  /// Removes `k`'s entry (O(log n)); whether there was one.
  public delete(k: K): bool {
    const found: bool[] = []
    this.root = this.remove(this.root, k, found)
    if (found.length > 0) this.count -= 1
    found.length > 0
  }

  /// Removes every entry.
  public clear(): void {
    this.root = null
    this.count = 0
  }

  /// The smallest key, or `null` when empty.
  public firstKey(): K? {
    const r = this.root
    if (r == null) return null
    let n: __TreeNode<K, V> = r
    let next = n.left
    while (next != null) {
      n = next
      next = n.left
    }
    n.key
  }

  /// The largest key, or `null` when empty.
  public lastKey(): K? {
    const r = this.root
    if (r == null) return null
    let n: __TreeNode<K, V> = r
    let next = n.right
    while (next != null) {
      n = next
      next = n.right
    }
    n.key
  }

  /// The largest key `<= k`, or `null`.
  public floorKey(k: K): K? {
    let n = this.root
    let best: K? = null
    while (n != null) {
      const at: __TreeNode<K, V> = n
      const c = k.compareTo(at.key)
      if (c == 0) return at.key
      if (c < 0) {
        n = at.left
      } else {
        best = at.key
        n = at.right
      }
    }
    best
  }

  /// The smallest key `>= k`, or `null`.
  public ceilingKey(k: K): K? {
    let n = this.root
    let best: K? = null
    while (n != null) {
      const at: __TreeNode<K, V> = n
      const c = k.compareTo(at.key)
      if (c == 0) return at.key
      if (c > 0) {
        n = at.right
      } else {
        best = at.key
        n = at.left
      }
    }
    best
  }

  /// The entries of `n` with `lo <= key < hi` (no bound when `null`), in order, onto `out`.
  walk(n: __TreeNode<K, V>?, lo: K?, hi: K?, out: [K, V][]): void {
    if (n == null) return
    const aboveLo = lo == null || n.key.compareTo(lo) >= 0
    const belowHi = hi == null || n.key.compareTo(hi) < 0
    if (aboveLo) this.walk(n.left, lo, hi, out)
    if (aboveLo && belowHi) out.push([n.key, n.value])
    if (belowHi) this.walk(n.right, lo, hi, out)
  }

  /// The entries with `lo <= key < hi`, in order.
  public range(lo: K, hi: K): [K, V][] {
    const r: [K, V][] = []
    this.walk(this.root, lo, hi, r)
    r
  }

  /// The `[key, value]` pairs in key order.
  public entries(): [K, V][] {
    const r: [K, V][] = []
    this.walk(this.root, null, null, r)
    r
  }

  /// The keys in order (a new array).
  public keys(): K[] {
    const r: K[] = []
    for (const [k, _] of this.entries()) r.push(k)
    r
  }

  /// The values in key order (a new array).
  public values(): V[] {
    const r: V[] = []
    for (const [_, v] of this.entries()) r.push(v)
    r
  }

  /// Calls `f(value, key)` for each entry in key order.
  public forEach(f: (value: V, key: K) => void): void {
    for (const [k, v] of this.entries()) f(v, k)
  }

  /// `for (const [k, v] of map)`: in key order.
  public iterator(): Iterator<[K, V]> { this.entries().iterator() }
}

/// A set whose values stay sorted (by `compareTo`): adds, deletes and lookups in O(log n), and
/// the ordered queries of `SortedMap` (#59).
export class SortedSet<T extends Comparable<T>> {
  map: SortedMap<T, bool> = new SortedMap<T, bool>()

  /// An empty set.
  constructor() {}

  /// How many values the set has.
  public get size(): int { this.map.size }
  /// Whether it's empty.
  public get isEmpty(): bool { this.map.isEmpty }
  /// Whether `v` is in the set.
  public has(v: T): bool { this.map.has(v) }
  /// Adds `v` (nothing changes if it's there); the set, for chaining.
  public add(v: T): SortedSet<T> {
    this.map.set(v, true)
    this
  }
  /// Removes `v`; whether it was there.
  public delete(v: T): bool { this.map.delete(v) }
  /// Removes every value.
  public clear(): void { this.map.clear() }
  /// The smallest value, or `null` when empty.
  public first(): T? { this.map.firstKey() }
  /// The largest value, or `null` when empty.
  public last(): T? { this.map.lastKey() }
  /// The largest value `<= v`, or `null`.
  public floor(v: T): T? { this.map.floorKey(v) }
  /// The smallest value `>= v`, or `null`.
  public ceiling(v: T): T? { this.map.ceilingKey(v) }
  /// The values with `lo <= v < hi`, in order.
  public range(lo: T, hi: T): T[] {
    const r: T[] = []
    for (const [k, _] of this.map.range(lo, hi)) r.push(k)
    r
  }
  /// The values in order (a new array).
  public values(): T[] { this.map.keys() }
  /// `for (const v of set)`: in order.
  public iterator(): Iterator<T> { this.map.keys().iterator() }
}

/// A map from each key to a list of values, in the order they were added (#59).
export class MultiMap<K extends Hashable<K>, V> {
  map: Map<K, V[]> = new Map<K, V[]>()
  count: int = 0

  /// An empty map.
  constructor() {}

  /// How many values there are, over all keys.
  public get size(): int { this.count }
  /// How many keys have values.
  public get keyCount(): int { this.map.size }
  /// Adds `v` to `k`'s values; the map, for chaining.
  public add(k: K, v: V): MultiMap<K, V> {
    const vs = this.map.get(k)
    if (vs == null) {
      this.map.set(k, [v]);
    } else {
      vs.push(v)
    }
    this.count += 1
    this
  }
  /// `k`'s values (a new array; empty when there are none).
  public get(k: K): V[] {
    const vs = this.map.get(k)
    if (vs == null) [] else vs.slice(0)
  }
  /// Whether `k` has any values.
  public has(k: K): bool { this.map.has(k) }
  /// Removes all of `k`'s values; how many there were.
  public delete(k: K): int {
    const vs = this.map.get(k)
    if (vs == null) return 0
    this.map.delete(k)
    this.count -= vs.length
    vs.length
  }
  /// Removes everything.
  public clear(): void {
    this.map.clear()
    this.count = 0
  }
  /// The keys with values, in the order they first got one.
  public keys(): K[] { this.map.keys() }
  /// Every `[key, value]` pair, key by key.
  public entries(): [K, V][] {
    const r: [K, V][] = []
    for (const [k, vs] of this.map) {
      for (const v of vs) r.push([k, v])
    }
    r
  }
  /// `for (const [k, v] of multi)`: every pair, key by key.
  public iterator(): Iterator<[K, V]> { this.entries().iterator() }
}

/// A node of `LinkedList` (and `LruCache`'s order).
class __ListNode<T> {
  public value: T
  public prev: __ListNode<T>? = null
  public next: __ListNode<T>? = null
  constructor(value: T) { this.value = value }
}

/// A doubly linked list: adding and removing at either end in O(1) (#59). `Deque` is usually
/// faster; this one never moves its elements.
export class LinkedList<T> {
  head: __ListNode<T>? = null
  tail: __ListNode<T>? = null
  count: int = 0

  /// An empty list.
  constructor() {}

  /// How many elements it has.
  public get size(): int { this.count }
  /// Whether it's empty.
  public get isEmpty(): bool { this.count == 0 }

  /// Adds `v` at the end.
  public push(v: T): void {
    const n = new __ListNode<T>(v)
    const t = this.tail
    if (t == null) this.head = n else {
      t.next = n
      n.prev = t
    }
    this.tail = n
    this.count += 1
  }

  /// Adds `v` at the start.
  public unshift(v: T): void {
    const n = new __ListNode<T>(v)
    const h = this.head
    if (h == null) this.tail = n else {
      h.prev = n
      n.next = h
    }
    this.head = n
    this.count += 1
  }

  /// Removes the last element and returns it; `null` when empty.
  public pop(): T? {
    const t = this.tail
    if (t == null) return null
    this.tail = t.prev
    const p = t.prev
    if (p == null) this.head = null else p.next = null
    this.count -= 1
    t.value
  }

  /// Removes the first element and returns it; `null` when empty.
  public shift(): T? {
    const h = this.head
    if (h == null) return null
    this.head = h.next
    const n = h.next
    if (n == null) this.tail = null else n.prev = null
    this.count -= 1
    h.value
  }

  /// The first element, or `null` when empty.
  public first(): T? {
    const h = this.head
    if (h == null) null else h.value
  }

  /// The last element, or `null` when empty.
  public last(): T? {
    const t = this.tail
    if (t == null) null else t.value
  }

  /// Removes every element.
  public clear(): void {
    this.head = null
    this.tail = null
    this.count = 0
  }

  /// The elements in order (a new array).
  public toArray(): T[] {
    const r: T[] = []
    let n = this.head
    while (n != null) {
      r.push(n.value)
      n = n.next
    }
    r
  }

  /// `for (const v of list)`: in order.
  public iterator(): Iterator<T> { this.toArray().iterator() }
}

/// A map that holds at most `capacity` entries, dropping the least recently used one (by `get`
/// or `set`) when a new key would go past it (#59). Every operation is O(1).
export class LruCache<K extends Hashable<K>, V> {
  public readonly capacity: int
  map: Map<K, __ListNode<[K, V]>> = new Map<K, __ListNode<[K, V]>>()
  /// Most recently used first.
  head: __ListNode<[K, V]>? = null
  tail: __ListNode<[K, V]>? = null

  /// An empty cache for at most `capacity` entries (at least 1).
  constructor(capacity: int) {
    if (capacity < 1) panic(`an LruCache needs a capacity of at least 1, got ${capacity}`)
    this.capacity = capacity
  }

  /// How many entries it has.
  public get size(): int { this.map.size }

  unlink(n: __ListNode<[K, V]>): void {
    const p = n.prev
    const x = n.next
    if (p == null) this.head = x else p.next = x
    if (x == null) this.tail = p else x.prev = p
    n.prev = null
    n.next = null
  }

  front(n: __ListNode<[K, V]>): void {
    const h = this.head
    n.next = h
    if (h == null) this.tail = n else h.prev = n
    this.head = n
  }

  /// `k`'s value (now the most recently used), or `null`.
  public get(k: K): V? {
    const n = this.map.get(k)
    if (n == null) return null
    this.unlink(n)
    this.front(n)
    n.value[1]
  }

  /// `k`'s value without counting as a use, or `null`.
  public peek(k: K): V? {
    const n = this.map.get(k)
    if (n == null) null else n.value[1]
  }

  /// Whether `k` has an entry (not counting as a use).
  public has(k: K): bool { this.map.has(k) }

  /// Sets `k`'s value (now the most recently used), dropping the least recently used entry when
  /// the cache is full; the cache, for chaining.
  public set(k: K, v: V): LruCache<K, V> {
    const old = this.map.get(k)
    if (old != null) {
      old.value = [k, v]
      this.unlink(old)
      this.front(old)
      return this
    }
    if (this.map.size >= this.capacity) {
      const t = this.tail
      if (t != null) {
        this.unlink(t)
        this.map.delete(t.value[0])
      }
    }
    const n = new __ListNode<[K, V]>([k, v])
    this.front(n)
    this.map.set(k, n)
    this
  }

  /// Removes `k`'s entry; whether there was one.
  public delete(k: K): bool {
    const n = this.map.get(k)
    if (n == null) return false
    this.unlink(n)
    this.map.delete(k)
    true
  }

  /// Removes every entry.
  public clear(): void {
    this.map.clear()
    this.head = null
    this.tail = null
  }

  /// The keys, most recently used first.
  public keys(): K[] {
    const r: K[] = []
    let n = this.head
    while (n != null) {
      r.push(n.value[0])
      n = n.next
    }
    r
  }
}

/// A growable set of small non-negative integers, one bit each.
export class BitSet {
  /// 32 bits per word.
  words: int[] = []

  /// A set with the bits in `bits` set (a negative one panics).
  constructor(bits: int[] = []) {
    for (const b of bits) this.add(b)
  }

  static __check(i: int): void {
    if (i < 0) panic(`BitSet: negative index ${i}`)
  }

  /// Whether bit `i` is set (`false` beyond the highest one; a negative `i` panics).
  public has(i: int): bool {
    BitSet.__check(i)
    const w = i >> 5
    w < this.words.length && ((this.words[w] >> (i & 31)) & 1) == 1
  }

  /// Sets bit `i` (grows as needed).
  public add(i: int): BitSet {
    BitSet.__check(i)
    const w = i >> 5
    while (this.words.length <= w) this.words.push(0)
    this.words[w] = this.words[w] | (1 << (i & 31))
    this
  }

  /// Clears bit `i`; `true` if it was set.
  public delete(i: int): bool {
    if (!this.has(i)) return false
    const w = i >> 5
    this.words[w] = this.words[w] & ~(1 << (i & 31)) & 0xFFFFFFFF
    true
  }

  /// Sets `i` when `on`, else clears it.
  public set(i: int, on: bool): void {
    if (on) {
      this.add(i);
    } else {
      this.delete(i);
    }
  }

  /// Toggles bit `i` (a negative `i` panics).
  public flip(i: int): void { this.set(i, !this.has(i)) }

  /// Clears every bit.
  public clear(): void { this.words = [] }

  /// The number of set bits.
  public get size(): int {
    let n = 0
    for (const w of this.words) {
      let x = w
      while (x != 0) {
        x = x & (x - 1)
        n += 1
      }
    }
    n
  }

  /// Whether no bit is set.
  public get isEmpty(): bool { this.size == 0 }

  /// One more than the highest set bit (0 when empty).
  public get length(): int {
    let w = this.words.length - 1
    while (w >= 0) {
      const x = this.words[w]
      if (x != 0) {
        let b = 31
        while (((x >> b) & 1) == 0) b -= 1
        return w * 32 + b + 1
      }
      w -= 1
    }
    0
  }

  static __combine(a: BitSet, b: BitSet, op: int): BitSet {
    const r = new BitSet()
    const n = if (a.words.length > b.words.length) a.words.length else b.words.length
    for (let i = 0; i < n; i++) {
      const x = if (i < a.words.length) a.words[i] else 0
      const y = if (i < b.words.length) b.words[i] else 0
      r.words.push(if (op == 0) x & y else if (op == 1) x | y else if (op == 2) x ^ y else x & ~y & 0xFFFFFFFF)
    }
    r
  }

  /// A new set: the bits in both this set and `o`.
  public and(o: BitSet): BitSet { BitSet.__combine(this, o, 0) }
  /// A new set: the bits in either this set or `o`.
  public or(o: BitSet): BitSet { BitSet.__combine(this, o, 1) }
  /// A new set: the bits in exactly one of this set and `o`.
  public xor(o: BitSet): BitSet { BitSet.__combine(this, o, 2) }
  /// A new set: the bits in this set but not in `o`.
  public andNot(o: BitSet): BitSet { BitSet.__combine(this, o, 3) }

  /// The same bits set (trailing zero words don't matter).
  public equals(o: BitSet): bool {
    const n = if (this.words.length > o.words.length) this.words.length else o.words.length
    for (let i = 0; i < n; i++) {
      const x = if (i < this.words.length) this.words[i] else 0
      const y = if (i < o.words.length) o.words[i] else 0
      if (x != y) return false
    }
    true
  }

  /// The set bits, ascending.
  public toArray(): int[] {
    const r: int[] = []
    for (let w = 0; w < this.words.length; w++) {
      const x = this.words[w]
      if (x == 0) continue
      for (let b = 0; b < 32; b++) {
        if (((x >> b) & 1) == 1) r.push(w * 32 + b)
      }
    }
    r
  }

  /// `for (const i of bits)`: the set bits, ascending.
  public iterator(): Iterator<int> { this.toArray().iterator() }

  /// `{1, 5, 64}`
  public toString(): string { "{" + this.toArray().join(", ") + "}" }
}
