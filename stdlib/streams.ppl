// `std/streams` (spec §13.5): the Web Streams classes (globals, as on the Web) and transform
// streams between strings and UTF-8 bytes.

export {
  ReadResult,
  QueuingStrategy,
  StreamPipeOptions,
  UnderlyingSource,
  ReadableStreamDefaultController,
  ReadableStream,
  ReadableStreamDefaultReader,
  WritableStreamDefaultController,
  UnderlyingSink,
  WritableStream,
  WritableStreamDefaultWriter,
  TransformStreamDefaultController,
  Transformer,
  TransformStream,
}

/// A transform stream from strings to their UTF-8 bytes.
export function textEncoderStream(): TransformStream<string, Uint8Array> {
  const enc = new TextEncoder()
  new TransformStream<string, Uint8Array>({
    transform: (s, c) => {
      if (s.length > 0) {
        c.enqueue(enc.encode(s))
      }
    },
  })
}

/// A transform stream from UTF-8 bytes to strings (sequences split across chunks are kept
/// whole; bad bytes become U+FFFD).
export function textDecoderStream(): TransformStream<Uint8Array, string> {
  const dec = new TextDecoder()
  new TransformStream<Uint8Array, string>({
    transform: (b, c) => {
      let s = ""
      try {
        s = dec.decode(b, { stream: true })
      } catch (e: TypeError) {}
      if (s.length > 0) {
        c.enqueue(s)
      }
    },
    flush: (c) => {
      let s = ""
      try {
        s = dec.decode()
      } catch (e: TypeError) {}
      if (s.length > 0) {
        c.enqueue(s)
      }
    },
  })
}
