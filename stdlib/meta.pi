// `std/meta`: what decorators see of the declarations they decorate (spec §11.2).
//
// A `decorator function` takes a `ClassDecl` (classes and structs) or a `FunctionDecl` first,
// then the decorator's own arguments (`@route("GET", "/users")`). The compiler runs it at
// compile time, before the decorated declaration is compiled, and applies what it asked for:
// added members, hidden statics, wrapped bodies and diagnostics. Code is written as strings
// (template literals), parsed and type-checked where it's spliced in.

export {
  __ClassDecl as ClassDecl,
  __FunctionDecl as FunctionDecl,
  __Args as Args,
  __ast as ast,
}
