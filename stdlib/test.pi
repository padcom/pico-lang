// `std/test` (spec §14.3): a Vitest-like test API. `describe`/`test` register tests while the
// file's top level runs; they run (in order) once it's done, and the file reports each one
// and a summary, exiting with 1 when any failed. `pico test` runs every `*.test.pi` file in
// parallel, one process each; `pico run x.test.pi` runs one.
//
// A failed expectation stops a test (it panics, and the runner catches that); after an
// `await` it's recorded and the test goes on. A panic or an exception in a test fails it.
// Async tests are `async function`s or async lambdas (`it("…", async () => { … })`). Environment:
// `PICO_TEST_FILTER` (only tests whose full name contains it), `PICO_TEST_MODE=bench` (run the
// benchmarks instead), `PICO_TEST_TIMES=0` (no durations, for reproducible output).

import { env, exit } from "std/process"

// ---- registry ----

class __Test {
  public name: string
  public sync: (() => void throws Error)?
  public async_: (() => Promise<void, Error>)?
  public skip: bool
  public only: bool
  /// The suites it's in, outermost first.
  public suites: __Suite[]

  constructor(name: string, sync: (() => void throws Error)?, async_: (() => Promise<void, Error>)?, skip: bool, only: bool, suites: __Suite[]) {
    this.name = name
    this.sync = sync
    this.async_ = async_
    this.skip = skip
    this.only = only
    this.suites = suites
  }

  public get fullName(): string {
    let s = ""
    for (const suite of this.suites) {
      if (suite.name != "") s = s + suite.name + " > "
    }
    return s + this.name
  }
}

class __Suite {
  public name: string
  public beforeEach: __Hook[] = []
  public afterEach: __Hook[] = []
  public beforeAll: __Hook[] = []
  public afterAll: __Hook[] = []
  /// Whether `beforeAll` ran (it runs before the suite's first test).
  public started: bool = false
  /// What failed in `beforeAll`: every test of the suite fails with it.
  public setupFailures: string[] = []
  /// Tests left before `afterAll` runs.
  public remaining: int = 0

  constructor(name: string) {
    this.name = name
  }
}

class __Bench {
  public name: string
  public f: () => void

  constructor(name: string, f: () => void) {
    this.name = name
    this.f = f
  }
}

class __Run {
  public tests: __Test[] = []
  public benches: __Bench[] = []
  /// The suites being declared (innermost last); the root suite is first.
  public stack: __Suite[] = [new __Suite("")]
  public scheduled: bool = false
  public passed: int = 0
  public failed: int = 0
  public skipped: int = 0
  /// The running test's failures.
  public failures: string[] = []
  /// Whether the running test is in its synchronous part (a failure then stops it).
  public inSync: bool = false

  constructor() {}
}

const __state = new __Run()

function __run(): __Run { return __state }

const __STOP = "\u{1}pico-test: expectation failed"

/// Records a failed expectation; in a test's synchronous part, stops it too.
function __fail(message: string): void {
  const r = __run()
  r.failures.push(message)
  if (r.inSync) panic(__STOP)
}

function __schedule(r: __Run): void {
  if (r.scheduled) return
  r.scheduled = true
  // After the file's top level (which declares the tests).
  setTimeout(() => {
    __runAll();
  }, 0)
}

function __register(name: string, sync: (() => void throws Error)?, async_: (() => Promise<void, Error>)?, skip: bool, only: bool): void {
  const r = __run()
  r.tests.push(new __Test(name, sync, async_, skip, only, r.stack.slice(0)))
  __schedule(r)
}

/// Groups tests: `fn` runs now and declares them; names show as `group > test`.
///
/// @example
/// ```ts
/// import { describe, it, expect } from "std/test"
///
/// describe("Array", () => {
///   describe("push", () => {
///     it("adds to the end", () => {
///       const xs = [1, 2]
///       xs.push(3)
///       expect(xs).toEqual([1, 2, 3])
///     })
///   })
/// })
/// // pico test: ✓ Array > push > adds to the end
/// ```
export function describe(name: string, fn: () => void): void {
  const r = __run()
  r.stack.push(new __Suite(name))
  fn()
  r.stack.pop();
}

/// A test (also `it`).
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("adds", () => {
///   expect(1 + 2).toBe(3)
/// })
/// // pico test: ✓ adds
/// ```
export function test(name: string, fn: () => void throws Error): void {
  __register(name, fn, null, false, false)
}

/// An async test: an `async function` (its promise is awaited).
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
/// import { delay } from "std/timers"
///
/// async function waitsForATimer(): Promise<void> throws AbortError {
///   await delay(5)
///   expect(await Promise.resolve(2)).toBe(2)
/// }
///
/// test("waits for a timer", waitsForATimer)
/// test("an async lambda", async () => {
///   await delay(1)
///   expect("ok").toBe("ok")
/// })
/// // pico test: ✓ waits for a timer, ✓ an async lambda
/// ```
export function test(name: string, fn: () => Promise<void, Error>): void {
  __register(name, null, fn, false, false)
}

/// A test (the same as `test`): `fn` runs after the file's top level; a failed expectation, a panic
/// or an uncaught exception fails it.
///
/// @example
/// ```ts
/// import { describe, it, expect } from "std/test"
///
/// describe("string", () => {
///   it("uppercases", () => {
///     expect("pico".toUpperCase()).toBe("PICO")
///   })
/// })
/// // pico test: ✓ string > uppercases
/// ```
export function it(name: string, fn: () => void throws Error): void { test(name, fn) }
/// An async test (the same as `test`): an `async function` passed by name; its promise is awaited,
/// and a rejection fails the test.
///
/// @example
/// ```ts
/// import { it, expect } from "std/test"
/// import { delay } from "std/timers"
///
/// async function settlesLater(): Promise<void> throws AbortError {
///   await delay(5)
///   expect([1, 2].length).toBe(2)
/// }
///
/// it("settles later", settlesLater)
/// // pico test: ✓ settles later
/// ```
export function it(name: string, fn: () => Promise<void, Error>): void { test(name, fn) }

/// A test that's reported as skipped.
///
/// @example
/// ```ts
/// import { test, skip, expect } from "std/test"
///
/// test("runs", () => {
///   expect(true).toBeTruthy()
/// })
/// skip("flaky on CI", () => {
///   expect(1).toBe(2)   // not run
/// })
/// // pico test: ✓ runs, - flaky on CI (skipped)
/// ```
export function skip(name: string, fn: () => void throws Error): void {
  __register(name, fn, null, true, false)
}

/// An async test that's reported as skipped.
///
/// @example
/// ```ts
/// import { skip, expect } from "std/test"
/// import { delay } from "std/timers"
///
/// async function slowNetworkCall(): Promise<void> throws AbortError {
///   await delay(5000)
///   expect(1).toBe(1)
/// }
///
/// skip("slow network call", slowNetworkCall)
/// // pico test: - slow network call (skipped)
/// ```
export function skip(name: string, fn: () => Promise<void, Error>): void {
  __register(name, null, fn, true, false)
}

/// When any test is `only`, the others are skipped.
///
/// @example
/// ```ts
/// import { test, only, expect } from "std/test"
///
/// only("the one being debugged", () => {
///   expect(2 * 21).toBe(42)
/// })
/// test("everything else", () => {
///   expect(1).toBe(1)
/// })
/// // pico test: ✓ the one being debugged, - everything else (skipped)
/// ```
export function only(name: string, fn: () => void throws Error): void {
  __register(name, fn, null, false, true)
}

/// An async `only` test: an `async function` passed by name (its promise is awaited). When any test
/// is `only`, the others are skipped.
///
/// @example
/// ```ts
/// import { test, only, expect } from "std/test"
/// import { delay } from "std/timers"
///
/// async function debugThis(): Promise<void> throws AbortError {
///   await delay(1)
///   expect("a" + "b").toBe("ab")
/// }
///
/// only("debug this", debugThis)
/// test("not now", () => {})
/// // pico test: ✓ debug this, - not now (skipped)
/// ```
export function only(name: string, fn: () => Promise<void, Error>): void {
  __register(name, null, fn, false, true)
}

/// A test still to write (reported as skipped).
///
/// @example
/// ```ts
/// import { todo } from "std/test"
///
/// todo("parses negative numbers")
/// // pico test: - parses negative numbers (skipped)
/// ```
export function todo(name: string): void {
  __register(name, null, null, true, false)
}

/// Runs `fn` before each test of the enclosing `describe` (at the top level: of the file), outer
/// suites' hooks first; skipped tests don't run it. A failure or panic in it fails the test, which
/// then doesn't run (its `afterEach` hooks still do).
///
/// @example
/// ```ts
/// import { describe, it, beforeEach, expect } from "std/test"
///
/// describe("cart", () => {
///   let items: string[] = []
///   beforeEach(() => {
///     items = []   // a fresh cart for every test
///   })
///   it("starts empty", () => {
///     expect(items).toHaveLength(0)
///   })
///   it("adds", () => {
///     items.push("apple")
///     expect(items).toHaveLength(1)
///   })
/// })
/// // pico test: ✓ cart > starts empty, ✓ cart > adds
/// ```
export function beforeEach(fn: () => void): void { __currentSuite().beforeEach.push(__Hook { sync: fn, async_: null }) }
/// An async `beforeEach` hook: the runner awaits it (#70).
export function beforeEach(fn: () => Promise<void, Error>): void {
  __currentSuite().beforeEach.push(__Hook { sync: null, async_: fn })
}
/// Runs `fn` after each test of the enclosing `describe` (at the top level: of the file), even a
/// failed one; inner suites' hooks first, skipped tests don't run it. A failure or panic in it
/// fails the test.
///
/// @example
/// ```ts
/// import { it, afterEach, expect } from "std/test"
///
/// const opened: string[] = []
/// afterEach(() => {
///   opened.pop()   // clean up after each test, even a failed one
/// })
/// it("opens one", () => {
///   opened.push("db")
///   expect(opened).toHaveLength(1)
/// })
/// it("still one", () => {
///   opened.push("db")
///   expect(opened).toHaveLength(1)
/// })
/// // pico test: ✓ opens one, ✓ still one
/// ```
export function afterEach(fn: () => void): void { __currentSuite().afterEach.push(__Hook { sync: fn, async_: null }) }
/// An async `afterEach` hook: the runner awaits it (#70).
export function afterEach(fn: () => Promise<void, Error>): void {
  __currentSuite().afterEach.push(__Hook { sync: null, async_: fn })
}
/// Runs `fn` once, before the first test of the enclosing `describe` (at the top level: of the
/// file) that isn't skipped. A failure or panic in it fails that first test only; the later ones
/// still run.
///
/// @example
/// ```ts
/// import { describe, it, beforeAll, expect } from "std/test"
///
/// describe("config", () => {
///   const settings = new Map<string, string>()
///   beforeAll(() => {
///     settings.set("mode", "test")   // once, before the first test
///   })
///   it("has a mode", () => {
///     expect(settings.get("mode")).toBe("test")
///   })
/// })
/// // pico test: ✓ config > has a mode
/// ```
export function beforeAll(fn: () => void): void { __currentSuite().beforeAll.push(__Hook { sync: fn, async_: null }) }
/// An async `beforeAll` hook: the runner awaits it (#70).
export function beforeAll(fn: () => Promise<void, Error>): void {
  __currentSuite().beforeAll.push(__Hook { sync: null, async_: fn })
}
/// Runs `fn` once, after the last test of the enclosing `describe` (at the top level: of the file),
/// when `beforeAll` ran (some test of the suite wasn't skipped). A failure or panic in it is
/// reported as a failed `suite > afterAll` entry of its own.
///
/// @example
/// ```ts
/// import { describe, it, afterAll, expect } from "std/test"
///
/// describe("suite", () => {
///   afterAll(() => {
///     println("all done")   // once, after the last test
///   })
///   it("works", () => {
///     expect(1).toBe(1)
///   })
/// })
/// // pico test: ✓ suite > works (and prints "all done")
/// ```
export function afterAll(fn: () => void): void { __currentSuite().afterAll.push(__Hook { sync: fn, async_: null }) }
/// An async `afterAll` hook: the runner awaits it (#70).
export function afterAll(fn: () => Promise<void, Error>): void {
  __currentSuite().afterAll.push(__Hook { sync: null, async_: fn })
}

function __currentSuite(): __Suite {
  const r = __run()
  return r.stack[r.stack.length - 1]
}

/// A benchmark: `pico bench` runs it (warm-up, then enough iterations for about half a
/// second) and reports mean, median and standard deviation per iteration. `pico test` and
/// `pico run` skip benchmarks.
///
/// @example
/// ```ts
/// import { bench } from "std/test"
///
/// bench("join 100 strings", () => {
///   const parts: string[] = []
///   for (let i = 0; i < 100; i++) {
///     parts.push(`${i}`)
///   }
///   parts.join(",")
/// })
/// // pico bench: join 100 strings, its mean, median and standard deviation per iteration
/// ```
export function bench(name: string, fn: () => void): void {
  const r = __run()
  r.benches.push(new __Bench(name, fn))
  __schedule(r)
}

// ---- running ----

function __catching(f: () => void): string? {
  const msg = __catch_panic(f)
  if (msg == null || msg == __STOP) null else `panic: ${msg}`
}

/// Runs a hook; a failure or panic in it fails the test.
/// A hook: a plain function, or an async one the runner awaits (#70).
struct __Hook {
  sync: (() => void)?
  async_: (() => Promise<void, Error>)?
}

async function __hook(r: __Run, h: __Hook): Promise<void> {
  const sync = h.sync
  const async_ = h.async_
  if (sync != null) {
    const f: () => void = sync
    r.inSync = true
    const p = __catching(f)
    r.inSync = false
    if (p != null) r.failures.push(p)
  } else if (async_ != null) {
    const start: () => Promise<void, Error> = async_
    let promise: Promise<void, Error>? = null
    r.inSync = true
    const p = __catching(() => {
      promise = start()
    })
    r.inSync = false
    if (p != null) r.failures.push(p)
    const pr = promise
    if (pr != null) {
      try {
        await pr
      } catch (e) {
        r.failures.push(`hook rejected with ${typeof e}: ${e.message}`)
      }
    }
  }
}

async function __runAll(): Promise<void> {
  const r = __run()
  const mode = env.get("PICO_TEST_MODE") ?? "test"
  const filter = env.get("PICO_TEST_FILTER") ?? ""
  if (mode == "bench") {
    __runBenches(r)
    return
  }
  const anyOnly = r.tests.some((t) => t.only)
  for (const t of r.tests) {
    for (const s of t.suites) s.remaining += 1
  }
  for (const t of r.tests) {
    const wanted = (!anyOnly || t.only) && (filter == "" || t.fullName.includes(filter))
    if (t.skip || !wanted) {
      r.skipped += 1
      println(`  - ${t.fullName} (skipped)`)
      await __finished(r, t)
      continue
    }
    r.failures = []
    for (const s of t.suites) {
      if (!s.started) {
        s.started = true
        for (const h of s.beforeAll) await __hook(r, h)
        s.setupFailures = r.failures.slice(0)
      } else {
        // A failed `beforeAll` fails every test of its suite, not only the first (#38).
        for (const f of s.setupFailures) r.failures.push(f)
      }
    }
    for (const s of t.suites) {
      for (const h of s.beforeEach) await __hook(r, h)
    }
    const start = performance.now()
    if (r.failures.length == 0) {
      const sync = t.sync
      const async_ = t.async_
      if (sync != null) {
        const run: () => void throws Error = sync
        r.inSync = true
        const p = __catching(() => {
          try {
            run()
          } catch (e) {
            r.failures.push(`uncaught ${typeof e}: ${e.message}`)
          }
        })
        r.inSync = false
        if (p != null) r.failures.push(p)
      } else if (async_ != null) {
        const start_: () => Promise<void, Error> = async_
        let promise: Promise<void, Error>? = null
        r.inSync = true
        const p = __catching(() => {
          promise = start_()
        })
        r.inSync = false
        if (p != null) r.failures.push(p)
        const pr = promise
        if (pr != null) {
          try {
            await pr
          } catch (e) {
            r.failures.push(`rejected with ${typeof e}: ${e.message}`)
          }
        }
      }
    }
    const ms = performance.now() - start
    let i = t.suites.length - 1
    while (i >= 0) {
      for (const h of t.suites[i].afterEach) await __hook(r, h)
      i -= 1
    }
    if (r.failures.length == 0) {
      r.passed += 1
      println(if (env.get("PICO_TEST_TIMES") == "0") `  ✓ ${t.fullName}` else `  ✓ ${t.fullName} ${__ms(ms)}`)
    } else {
      r.failed += 1
      println(`  ✗ ${t.fullName}`)
      for (const f of r.failures) {
        for (const line of f.split("\n")) println(`      ${line}`)
      }
    }
    await __finished(r, t)
  }
  println(`pico-test: ${r.passed} passed, ${r.failed} failed, ${r.skipped} skipped`)
  if (r.failed > 0) exit(1)
}

/// After a test: `afterAll` of the suites it was the last test of.
async function __finished(r: __Run, t: __Test): Promise<void> {
  let i = t.suites.length - 1
  while (i >= 0) {
    const s = t.suites[i]
    s.remaining -= 1
    if (s.remaining == 0 && s.started && s.afterAll.length > 0) {
      const saved = r.failures
      r.failures = []
      for (const h of s.afterAll) await __hook(r, h)
      if (r.failures.length > 0) {
        r.failed += 1
        println(`  ✗ ${if (s.name == "") "afterAll" else s.name + " > afterAll"}`)
        for (const f of r.failures) println(`      ${f}`)
      }
      r.failures = saved
    }
    i -= 1
  }
}

/// `0.12ms`, with a few significant digits.
function __ms(ms: number): string {
  const r = if (ms >= 100.0) Math.round(ms) else Math.round(ms * 100.0) / 100.0
  return `(${r}ms)`
}

function __runBenches(r: __Run): void {
  for (const b of r.benches) {
    const f = b.f
    // Warm-up, and a first estimate of the time per call.
    let n = 1
    let t = 0.0
    while (true) {
      const s = performance.now()
      for (let i = 0; i < n; i++) f()
      t = performance.now() - s
      if (t >= 20.0 || n >= 1 << 30) break
      n *= 2
    }
    const per = t / (n as f64)
    // About 0.5 s in 20 samples.
    let batch = ((25.0 / (if (per > 0.0) per else 0.000001)) as int)
    if (batch < 1) batch = 1
    const samples: number[] = []
    for (let k = 0; k < 20; k++) {
      const s = performance.now()
      for (let i = 0; i < batch; i++) f()
      samples.push((performance.now() - s) / (batch as f64))
    }
    let mean = 0.0
    for (const x of samples) mean += x
    mean /= samples.length as f64
    let v = 0.0
    for (const x of samples) v += (x - mean) * (x - mean)
    const sd = Math.sqrt(v / (samples.length as f64))
    const sorted = samples.slice(0)
    sorted.sort((a, c) => if (a < c) -1 else if (a > c) 1 else 0)
    const median = (sorted[9] + sorted[10]) / 2.0
    println(`  ${b.name}: mean ${__time(mean)}, median ${__time(median)}, stddev ${__time(sd)} (${batch * 20} iterations)`)
  }
  println(`pico-bench: ${r.benches.length} benchmarks`)
}

/// A per-iteration time in ns, µs or ms.
function __time(ms: number): string {
  if (ms < 0.001) return `${Math.round(ms * 1000000.0 * 10.0) / 10.0}ns`
  if (ms < 1.0) return `${Math.round(ms * 1000.0 * 100.0) / 100.0}µs`
  return `${Math.round(ms * 100.0) / 100.0}ms`
}

// ---- expectations ----

/// A value's text for comparisons and messages: its debug form, or a class's string form.
function __show<T>(v: T): string {
  const d = `${v:?}`
  if (d.startsWith("<") && d.endsWith(">")) `${v}` else d
}

/// Expectations on any value: `toBe`/`toEqual` compare string forms (fields for structs,
/// elements for arrays, `toString` or fields for classes).
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// struct Point {
///   x: int
///   y: int
/// }
///
/// test("structs compare by fields", () => {
///   const p: Point = { x: 1, y: 2 }
///   expect(p).toEqual({ x: 1, y: 2 })
/// })
/// // pico test: ✓ structs compare by fields
/// ```
export class Expect<T> {
  /// The value under test.
  public readonly actual: T
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, Expect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   const e = new Expect<string?>(null)   // what `expect(value)` makes
  ///   e.toBeNull()
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: T, negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   const m = new Map<string, int>()
  ///   m.set("a", 1)
  ///   expect(m.get("a")).not.toBeNull()
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): Expect<T> { new Expect<T>(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) {
      __fail(`expected ${__show(this.actual)} ${if (this.negated) "not " else ""}${what}`)
    }
  }

  /// Passes when `actual` and `expected` have the same string form (their debug form, or a class's
  /// `toString`), so it doesn't test identity; fails with `expected <actual> to be <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// struct User {
  ///   name: string
  /// }
  ///
  /// test("same string form", () => {
  ///   const u: User = { name: "ada" }
  ///   expect(u).toBe({ name: "ada" })
  /// })
  /// // pico test: ✓ same string form
  /// ```
  public toBe(expected: T): void { this.__check(__show(this.actual) == __show(expected), `to be ${__show(expected)}`) }
  /// The same comparison as `toBe` (equal string forms); fails with `expected <actual> to equal
  /// <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("nullable values", () => {
  ///   const found: int? = [1, 2, 3].find((x: int) => x > 1)
  ///   expect(found).toEqual(2)
  /// })
  /// // pico test: ✓ nullable values
  /// ```
  public toEqual(expected: T): void { this.__check(__show(this.actual) == __show(expected), `to equal ${__show(expected)}`) }
  /// Passes when `actual` is `null` (its string form is `null`): `expect(map.get(k)).toBeNull()`.
  /// Fails with `expected <actual> to be null`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("missing key", () => {
  ///   const ages = new Map<string, int>()
  ///   expect(ages.get("nobody")).toBeNull()
  /// })
  /// // pico test: ✓ missing key
  /// ```
  public toBeNull(): void { this.__check(__show(this.actual) == "null", "to be null") }
  /// Passes when `actual` isn't `null`; fails with `expected a value, got null` (negated: `expected
  /// <actual> to be null`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("present key", () => {
  ///   const ages = new Map<string, int>()
  ///   ages.set("ada", 36)
  ///   expect(ages.get("ada")).toBeDefined()
  /// })
  /// // pico test: ✓ present key
  /// ```
  public toBeDefined(): void {
    if ((__show(this.actual) != "null") == this.negated) {
      __fail(if (this.negated) `expected ${__show(this.actual)} to be null` else "expected a value, got null")
    }
  }
}

/// Expectations on integers.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("ints", () => {
///   const n = [3, 1, 2].length
///   expect(n).toBe(3)
///   expect(n).toBeGreaterThan(2)
/// })
/// // pico test: ✓ ints
/// ```
export class IntExpect {
  /// The value under test.
  public readonly actual: int
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, IntExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new IntExpect(5).toBe(5)               // what `expect(5)` makes
  ///   new IntExpect(5, negated: true).toBe(6)   // what `expect(5).not` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: int, negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation: each matcher on it passes where it would fail
  /// (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect(7).not.toBe(8)
  ///   expect(7).not.toBeLessThan(7)
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): IntExpect { new IntExpect(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) __fail(`expected ${this.actual} ${if (this.negated) "not " else ""}${what}`)
  }

  /// Passes when `actual == expected`; fails with `expected <actual> to be <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", () => {
  ///   expect(6 * 7).toBe(42)
  /// })
  /// // pico test: ✓ toBe (`expect(6 * 7).toBe(41)` fails with: expected 42 to be 41)
  /// ```
  public toBe(expected: int): void { this.__check(this.actual == expected, `to be ${expected}`) }
  /// The same as `toBe` (`actual == expected`); fails with `expected <actual> to equal <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toEqual", () => {
  ///   expect("abc".length).toEqual(3)
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public toEqual(expected: int): void { this.__check(this.actual == expected, `to equal ${expected}`) }
  /// Passes when `actual > n`; fails with `expected <actual> to be greater than <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeGreaterThan", () => {
  ///   expect(10).toBeGreaterThan(9)
  /// })
  /// // pico test: ✓ toBeGreaterThan
  /// ```
  public toBeGreaterThan(n: int): void { this.__check(this.actual > n, `to be greater than ${n}`) }
  /// Passes when `actual >= n`; fails with `expected <actual> to be at least <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeGreaterThanOrEqual", () => {
  ///   expect(10).toBeGreaterThanOrEqual(10)
  /// })
  /// // pico test: ✓ toBeGreaterThanOrEqual
  /// ```
  public toBeGreaterThanOrEqual(n: int): void { this.__check(this.actual >= n, `to be at least ${n}`) }
  /// Passes when `actual < n`; fails with `expected <actual> to be less than <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeLessThan", () => {
  ///   expect(-1).toBeLessThan(0)
  /// })
  /// // pico test: ✓ toBeLessThan
  /// ```
  public toBeLessThan(n: int): void { this.__check(this.actual < n, `to be less than ${n}`) }
  /// Passes when `actual <= n`; fails with `expected <actual> to be at most <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeLessThanOrEqual", () => {
  ///   expect([1, 2].length).toBeLessThanOrEqual(2)
  /// })
  /// // pico test: ✓ toBeLessThanOrEqual
  /// ```
  public toBeLessThanOrEqual(n: int): void { this.__check(this.actual <= n, `to be at most ${n}`) }
}

/// Expectations on numbers.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("numbers", () => {
///   expect(0.1 + 0.2).toBeCloseTo(0.3)
///   expect(1.5).toBeGreaterThan(1.0)
/// })
/// // pico test: ✓ numbers
/// ```
export class NumberExpect {
  /// The value under test.
  public readonly actual: number
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, NumberExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new NumberExpect(2.5).toBe(2.5)   // what `expect(2.5)` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: number, negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation: each matcher on it passes where it would fail
  /// (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect(Math.sqrt(2.0)).not.toBe(1.4)
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): NumberExpect { new NumberExpect(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) __fail(`expected ${this.actual} ${if (this.negated) "not " else ""}${what}`)
  }

  /// Passes when `actual == expected` (so `NaN` never passes, and `-0.0` equals `0.0`; for rounding
  /// errors use `toBeCloseTo`); fails with `expected <actual> to be <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", () => {
  ///   expect(1.0 / 4.0).toBe(0.25)
  /// })
  /// // pico test: ✓ toBe
  /// ```
  public toBe(expected: number): void { this.__check(this.actual == expected, `to be ${expected}`) }
  /// The same as `toBe` (`actual == expected`); fails with `expected <actual> to equal <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toEqual", () => {
  ///   expect(Math.abs(-3.5)).toEqual(3.5)
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public toEqual(expected: number): void { this.__check(this.actual == expected, `to equal ${expected}`) }
  /// Passes when `actual > n`; fails with `expected <actual> to be greater than <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeGreaterThan", () => {
  ///   expect(Math.PI).toBeGreaterThan(3.14)
  /// })
  /// // pico test: ✓ toBeGreaterThan
  /// ```
  public toBeGreaterThan(n: number): void { this.__check(this.actual > n, `to be greater than ${n}`) }
  /// Passes when `actual >= n`; fails with `expected <actual> to be at least <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeGreaterThanOrEqual", () => {
  ///   expect(Math.max(1.0, 2.0)).toBeGreaterThanOrEqual(2.0)
  /// })
  /// // pico test: ✓ toBeGreaterThanOrEqual
  /// ```
  public toBeGreaterThanOrEqual(n: number): void { this.__check(this.actual >= n, `to be at least ${n}`) }
  /// Passes when `actual < n`; fails with `expected <actual> to be less than <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeLessThan", () => {
  ///   expect(Math.random()).toBeLessThan(1.0)
  /// })
  /// // pico test: ✓ toBeLessThan
  /// ```
  public toBeLessThan(n: number): void { this.__check(this.actual < n, `to be less than ${n}`) }
  /// Passes when `actual <= n`; fails with `expected <actual> to be at most <n>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeLessThanOrEqual", () => {
  ///   expect(Math.min(1.0, 2.0)).toBeLessThanOrEqual(1.0)
  /// })
  /// // pico test: ✓ toBeLessThanOrEqual
  /// ```
  public toBeLessThanOrEqual(n: number): void { this.__check(this.actual <= n, `to be at most ${n}`) }
  /// Passes when `actual` is `NaN`; fails with `expected <actual> to be NaN`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeNaN", () => {
  ///   expect(Math.sqrt(-1.0)).toBeNaN()
  /// })
  /// // pico test: ✓ toBeNaN
  /// ```
  public toBeNaN(): void { this.__check(this.actual != this.actual, "to be NaN") }

  /// Within half of 10^-digits (Vitest's rule).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeCloseTo", () => {
  ///   expect(0.1 + 0.2).toBeCloseTo(0.3)              // within ±0.005
  ///   expect(Math.PI).toBeCloseTo(3.1416, digits: 4)  // within ±0.00005
  /// })
  /// // pico test: ✓ toBeCloseTo
  /// ```
  public toBeCloseTo(expected: number, digits: int = 2): void {
    const tol = Math.pow(10.0, -(digits as f64)) / 2.0
    this.__check(Math.abs(this.actual - expected) < tol, `to be close to ${expected} (±${tol})`)
  }
}

/// Expectations on strings.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("strings", () => {
///   const greeting = "hello, world"
///   expect(greeting).toContain("world")
///   expect(greeting).toHaveLength(12)
/// })
/// // pico test: ✓ strings
/// ```
export class StringExpect {
  /// The value under test.
  public readonly actual: string
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, StringExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new StringExpect("pico").toBe("pico")   // what `expect("pico")` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: string, negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation: each matcher on it passes where it would fail
  /// (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect("release").not.toContain("debug")
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): StringExpect { new StringExpect(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) __fail(`expected ${this.actual:?} ${if (this.negated) "not " else ""}${what}`)
  }

  /// Passes when `actual == expected`; fails with `expected "<actual>" to be "<expected>"` (both
  /// quoted).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", () => {
  ///   expect(["a", "b"].join("-")).toBe("a-b")
  /// })
  /// // pico test: ✓ toBe (`toBe("a+b")` fails with: expected "a-b" to be "a+b")
  /// ```
  public toBe(expected: string): void { this.__check(this.actual == expected, `to be ${expected:?}`) }
  /// The same as `toBe` (`actual == expected`); fails with `expected "<actual>" to equal
  /// "<expected>"`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toEqual", () => {
  ///   expect("Pico".toLowerCase()).toEqual("pico")
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public toEqual(expected: string): void { this.__check(this.actual == expected, `to equal ${expected:?}`) }
  /// Passes when `actual` contains `part` (any string contains `""`); fails with `expected
  /// "<actual>" to contain "<part>"`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toContain", () => {
  ///   expect("error: file not found").toContain("not found")
  /// })
  /// // pico test: ✓ toContain
  /// ```
  public toContain(part: string): void { this.__check(this.actual.includes(part), `to contain ${part:?}`) }
  /// Passes when `re` matches somewhere in `actual` (`re.test`; anchor it with `^…$` for a full
  /// match): `expect(id).toMatch(/^[a-z]+$/)`. Fails with `expected "<actual>" to match <re>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toMatch", () => {
  ///   expect("user_42").toMatch(/^[a-z]+_\d+$/)
  /// })
  /// // pico test: ✓ toMatch
  /// ```
  public toMatch(re: RegExp): void { this.__check(re.test(this.actual), `to match ${re}`) }
  /// Passes when `actual.length == n`; fails with `expected "<actual>" to have length <n> (it's
  /// <length>)`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toHaveLength", () => {
  ///   expect("abc").toHaveLength(3)
  /// })
  /// // pico test: ✓ toHaveLength
  /// ```
  public toHaveLength(n: int): void { this.__check(this.actual.length == n, `to have length ${n} (it's ${this.actual.length})`) }
}

/// Expectations on `bool`s.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("bools", () => {
///   expect([1, 2].includes(2)).toBe(true)
///   expect("".length == 0).toBeTruthy()
/// })
/// // pico test: ✓ bools
/// ```
export class BoolExpect {
  /// The value under test.
  public readonly actual: bool
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, BoolExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new BoolExpect(true).toBeTruthy()   // what `expect(true)` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: bool, negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation: each matcher on it passes where it would fail
  /// (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect("abc".startsWith("b")).not.toBe(true)
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): BoolExpect { new BoolExpect(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) __fail(`expected ${this.actual} ${if (this.negated) "not " else ""}${what}`)
  }

  /// Passes when `actual == expected`; fails with `expected <actual> to be <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", () => {
  ///   expect("abc".endsWith("c")).toBe(true)
  /// })
  /// // pico test: ✓ toBe
  /// ```
  public toBe(expected: bool): void { this.__check(this.actual == expected, `to be ${expected}`) }
  /// The same as `toBe`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toEqual", () => {
  ///   expect("".length == 0).toEqual(true)
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public toEqual(expected: bool): void { this.toBe(expected) }
  /// Passes when `actual` is `true` (there's no other truthiness: `actual` is a `bool`); fails with
  /// `expected false to be true`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeTruthy", () => {
  ///   expect("pico".includes("i")).toBeTruthy()
  /// })
  /// // pico test: ✓ toBeTruthy
  /// ```
  public toBeTruthy(): void { this.__check(this.actual, "to be true") }
  /// Passes when `actual` is `false`; fails with `expected true to be false`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBeFalsy", () => {
  ///   expect([1, 2, 3].includes(4)).toBeFalsy()
  /// })
  /// // pico test: ✓ toBeFalsy
  /// ```
  public toBeFalsy(): void { this.__check(!this.actual, "to be false") }
}

/// Expectations on arrays: `toEqual` compares elements' string forms.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("arrays", () => {
///   const xs = [3, 1, 2].sort()
///   expect(xs).toEqual([1, 2, 3])
///   expect(xs).toContain(2)
/// })
/// // pico test: ✓ arrays
/// ```
export class ArrayExpect<T> {
  /// The array under test.
  public readonly actual: T[]
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on `actual` (`expect(actual)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, ArrayExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new ArrayExpect<string>(["a"]).toHaveLength(1)   // what `expect(["a"])` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(actual: T[], negated: bool = false) {
    this.actual = actual
    this.negated = negated
  }

  /// The opposite expectation: each matcher on it passes where it would fail
  /// (`expect(x).not.toBe(y)`).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect(["a", "b"]).not.toContain("c")
  /// })
  /// // pico test: ✓ not
  /// ```
  public get not(): ArrayExpect<T> { new ArrayExpect<T>(this.actual, !this.negated) }

  __check(ok: bool, what: string): void {
    if (ok == this.negated) __fail(`expected ${__show(this.actual)} ${if (this.negated) "not " else ""}${what}`)
  }

  /// The same as `toEqual` (equal elements, not the same array).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", () => {
  ///   expect([1, 2].map((x: int) => x * 10)).toBe([10, 20])   // equal elements: passes
  /// })
  /// // pico test: ✓ toBe
  /// ```
  public toBe(expected: T[]): void { this.toEqual(expected) }
  /// Passes when both arrays have the same string form (their elements' debug forms, in order):
  /// `expect(xs).toEqual([1, 2])`. Fails with `expected <actual> to equal <expected>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toEqual", () => {
  ///   expect("a,b,c".split(",")).toEqual(["a", "b", "c"])
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public toEqual(expected: T[]): void { this.__check(__show(this.actual) == __show(expected), `to equal ${__show(expected)}`) }
  /// Passes when `actual.length == n`: `expect(xs).toHaveLength(3)`. Fails with `expected <actual>
  /// to have length <n> (it's <length>)`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toHaveLength", () => {
  ///   expect([1, 2, 3].filter((x: int) => x > 1)).toHaveLength(2)
  /// })
  /// // pico test: ✓ toHaveLength
  /// ```
  public toHaveLength(n: int): void { this.__check(this.actual.length == n, `to have length ${n} (it's ${this.actual.length})`) }

  /// Passes when some element has `x`'s string form; fails with `expected <actual> to contain <x>`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toContain", () => {
  ///   expect(["red", "green"]).toContain("green")
  /// })
  /// // pico test: ✓ toContain
  /// ```
  public toContain(x: T): void {
    const want = __show(x)
    this.__check(this.actual.some((e) => __show(e) == want), `to contain ${want}`)
  }
}

/// Expectations on a function call: it throws, or it panics.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// function parsePort(s: string): int throws Error {
///   if (!/^\d+$/.test(s)) throw new Error(`bad port: ${s}`)
///   return parseInt(s)
/// }
///
/// test("rejects a bad port", () => {
///   expect(() => { parsePort("x") }).toThrow("bad port")
/// })
/// // pico test: ✓ rejects a bad port
/// ```
export class FnExpect {
  /// The function under test (`toThrow` and `toPanic` call it).
  public readonly f: () => void throws Error
  /// Whether the matchers are negated (by `.not`).
  public readonly negated: bool

  /// Expectations on calling `f` (`expect(f)` makes one); negated when `negated` is `true`.
  ///
  /// @example
  /// ```ts
  /// import { test, FnExpect } from "std/test"
  ///
  /// test("by hand", () => {
  ///   new FnExpect(() => { throw new Error("no") }).toThrow()   // what `expect(f)` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(f: () => void throws Error, negated: bool = false) {
    this.f = f
    this.negated = negated
  }

  /// The opposite expectation: `expect(f).not.toThrow()` passes when the call returns (a panic
  /// still fails `toThrow`, negated or not).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("not", () => {
  ///   expect(() => { println("fine") }).not.toThrow()
  /// })
  /// // pico test: ✓ not (and prints "fine")
  /// ```
  public get not(): FnExpect { new FnExpect(this.f, !this.negated) }

  /// It throws (an error whose message contains `message`, when given).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toThrow", () => {
  ///   expect(() => { throw new Error("disk full") }).toThrow()          // any error
  ///   expect(() => { throw new Error("disk full") }).toThrow("full")    // its message contains "full"
  /// })
  /// // pico test: ✓ toThrow
  /// ```
  public toThrow(message: string = ""): void {
    const f = this.f
    let thrown: string? = null
    let text = ""
    const p = __catch_panic(() => {
      try {
        f()
      } catch (e) {
        thrown = e.message
        text = `${typeof e}: ${e.message}`
      }
    })
    if (p != null) {
      if (p == __STOP) panic(__STOP)
      __fail(`expected ${if (this.negated) "no throw" else "a throw"}, but it panicked: ${p}`)
      return
    }
    const m = thrown
    const ok = m != null && m.includes(message)
    if (ok == this.negated) {
      const what = if (message == "") "to throw" else `to throw ${message:?}`
      __fail(if (m == null) `expected the call ${if (this.negated) "not " else ""}${what}, but it returned` else `expected the call ${if (this.negated) "not " else ""}${what}, but it threw ${text}`)
    }
  }

  /// It panics (with a message containing `message`, when given).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toPanic", () => {
  ///   expect(() => { panic("unreachable state") }).toPanic("unreachable")
  /// })
  /// // pico test: ✓ toPanic
  /// ```
  public toPanic(message: string = ""): void {
    const f = this.f
    let threw = ""
    const p = __catch_panic(() => {
      try {
        f()
      } catch (e) {
        threw = `${typeof e}: ${e.message}`
      }
    })
    if (p == __STOP) panic(__STOP)
    const ok = p != null && p.includes(message)
    if (ok == this.negated) {
      const what = if (message == "") "to panic" else `to panic with ${message:?}`
      const got = if (p != null) `it panicked: ${p}` else if (threw != "") `it threw ${threw}` else "it returned"
      __fail(`expected the call ${if (this.negated) "not " else ""}${what}, but ${got}`)
    }
  }
}

/// Expectations on a promise: `await expect(p).resolves.toBe(v)`,
/// `await expect(p).rejects.toThrow("…")`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// async function promises(): Promise<void> {
///   await expect(Promise.resolve(42)).resolves.toBe(42)
///   await expect(Promise.reject<int>(new Error("not found"))).rejects.toThrow("not found")
/// }
///
/// test("promises", promises)
/// // pico test: ✓ promises
/// ```
export class PromiseExpect<T, E extends Error> {
  /// The promise under test.
  public readonly p: Promise<T, E>

  /// Expectations on `p` (`expect(p)` makes one).
  ///
  /// @example
  /// ```ts
  /// import { test, PromiseExpect } from "std/test"
  ///
  /// async function byHand(): Promise<void> {
  ///   await new PromiseExpect<int, Error>(Promise.resolve(1)).resolves.toBe(1)   // what `expect(p)` makes
  /// }
  ///
  /// test("by hand", byHand)
  /// // pico test: ✓ by hand
  /// ```
  constructor(p: Promise<T, E>) {
    this.p = p
  }

  /// Matchers on the value the promise resolves to: `await expect(p).resolves.toBe(v)`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  /// import { delay } from "std/timers"
  ///
  /// async function double(n: int): Promise<int> throws AbortError {
  ///   await delay(1)
  ///   return n * 2
  /// }
  ///
  /// test("resolves", async () => {
  ///   await expect(double(21)).resolves.toBe(42)
  /// })
  /// // pico test: ✓ resolves
  /// ```
  public get resolves(): Resolves<T, E> { new Resolves<T, E>(this.p) }
  /// Matchers on the promise's rejection: `await expect(p).rejects.toThrow("not found")`.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("rejects", async () => {
  ///   await expect(Promise.reject<string>(new Error("timeout"))).rejects.toThrow()
  /// })
  /// // pico test: ✓ rejects
  /// ```
  public get rejects(): Rejects<T, E> { new Rejects<T, E>(this.p) }
}

/// Expectations on what a promise resolves to (`expect(p).resolves`); await the matchers. There's
/// no `.not`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("resolves", async () => {
///   await expect(Promise.resolve("ok")).resolves.toEqual("ok")
/// })
/// // pico test: ✓ resolves
/// ```
export class Resolves<T, E extends Error> {
  /// The promise under test.
  public readonly p: Promise<T, E>

  /// Expectations on the value `p` resolves to (`expect(p).resolves` makes one).
  ///
  /// @example
  /// ```ts
  /// import { test, Resolves } from "std/test"
  ///
  /// test("by hand", async () => {
  ///   await new Resolves<int, Error>(Promise.resolve(3)).toBe(3)   // what `expect(p).resolves` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(p: Promise<T, E>) {
    this.p = p
  }

  /// It resolves to a value with `expected`'s string form.
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toBe", async () => {
  ///   await expect(Promise.resolve([1, 2].length)).resolves.toBe(2)
  /// })
  /// // pico test: ✓ toBe
  /// ```
  public async toBe(expected: T): Promise<void> {
    try {
      const v = await this.p
      if (__show(v) != __show(expected)) __fail(`expected the promise to resolve to ${__show(expected)}, got ${__show(v)}`)
    } catch (e) {
      __fail(`expected the promise to resolve, but it rejected with ${typeof e}: ${e.message}`)
    }
  }

  /// The same as `toBe` (equal string forms).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// struct Reply {
  ///   status: int
  /// }
  ///
  /// test("toEqual", async () => {
  ///   const r: Reply = { status: 200 }
  ///   await expect(Promise.resolve(r)).resolves.toEqual({ status: 200 })
  /// })
  /// // pico test: ✓ toEqual
  /// ```
  public async toEqual(expected: T): Promise<void> {
    await this.toBe(expected)
  }
}

/// Expectations on a promise's rejection (`expect(p).rejects`); await the matcher. There's no
/// `.not`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
/// import { readText } from "std/fs"
///
/// test("missing file", async () => {
///   await expect(readText("/no/such/file")).rejects.toThrow("no such file")
/// })
/// // pico test: ✓ missing file
/// ```
export class Rejects<T, E extends Error> {
  /// The promise under test.
  public readonly p: Promise<T, E>

  /// Expectations on `p` rejecting (`expect(p).rejects` makes one).
  ///
  /// @example
  /// ```ts
  /// import { test, Rejects } from "std/test"
  ///
  /// test("by hand", async () => {
  ///   await new Rejects<int, Error>(Promise.reject<int>(new Error("x"))).toThrow()   // what `expect(p).rejects` makes
  /// })
  /// // pico test: ✓ by hand
  /// ```
  constructor(p: Promise<T, E>) {
    this.p = p
  }

  /// It rejects (with a message containing `message`, when given).
  ///
  /// @example
  /// ```ts
  /// import { test, expect } from "std/test"
  ///
  /// test("toThrow", async () => {
  ///   const p = Promise.reject<int>(new Error("connection refused"))
  ///   await expect(p).rejects.toThrow("refused")
  /// })
  /// // pico test: ✓ toThrow
  /// ```
  public async toThrow(message: string = ""): Promise<void> {
    try {
      const v = await this.p
      __fail(`expected the promise to reject, but it resolved to ${__show(v)}`)
    } catch (e) {
      if (!e.message.includes(message)) __fail(`expected a rejection with ${message:?}, got ${typeof e}: ${e.message}`)
    }
  }
}

/// Expectations on an `int`: `expect(xs.length).toBe(3)`. `expect` picks its matchers by the
/// value's type; this overload adds the comparisons (`toBeGreaterThan`, …).
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("an int", () => {
///   expect([1, 2, 3].length).toBe(3)
///   expect(10 % 3).toBeLessThan(2)
/// })
/// // pico test: ✓ an int
/// ```
export function expect(actual: int): IntExpect { new IntExpect(actual) }
/// Expectations on a `number`: comparisons, `toBeCloseTo` and `toBeNaN` (`expect(0.1 +
/// 0.2).toBeCloseTo(0.3)`).
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("a number", () => {
///   expect(0.1 + 0.2).toBeCloseTo(0.3)
///   expect(0.0 / 0.0).toBeNaN()
/// })
/// // pico test: ✓ a number
/// ```
export function expect(actual: number): NumberExpect { new NumberExpect(actual) }
/// Expectations on a `string`: `toBe`, `toContain`, `toMatch` and `toHaveLength`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("a string", () => {
///   expect("pico".toUpperCase()).toBe("PICO")
///   expect("v1.2.3").toMatch(/^v\d+\.\d+\.\d+$/)
/// })
/// // pico test: ✓ a string
/// ```
export function expect(actual: string): StringExpect { new StringExpect(actual) }
/// Expectations on a `bool`: `toBe`, `toBeTruthy` and `toBeFalsy`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("a bool", () => {
///   expect("abc".includes("b")).toBeTruthy()
/// })
/// // pico test: ✓ a bool
/// ```
export function expect(actual: bool): BoolExpect { new BoolExpect(actual) }
/// Expectations on an array: `toEqual` (element-wise), `toContain` and `toHaveLength`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("an array", () => {
///   expect("a b".split(" ")).toEqual(["a", "b"])
///   expect([1, 2, 3]).toContain(2)
/// })
/// // pico test: ✓ an array
/// ```
export function expect<T>(actual: T[]): ArrayExpect<T> { new ArrayExpect<T>(actual) }
/// Expectations on calling a function: `expect(() => parse("x")).toThrow("bad")`, `toPanic`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("a function", () => {
///   expect(() => { throw new Error("bad input") }).toThrow("bad")
/// })
/// // pico test: ✓ a function
/// ```
export function expect(f: () => void throws Error): FnExpect { new FnExpect(f) }
/// Expectations on a promise, through `resolves` and `rejects`: `await expect(p).resolves.toBe(v)`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// test("a promise", async () => {
///   await expect(Promise.resolve(7)).resolves.toBe(7)
/// })
/// // pico test: ✓ a promise
/// ```
export function expect<T, E extends Error>(p: Promise<T, E>): PromiseExpect<T, E> { new PromiseExpect<T, E>(p) }
/// Expectations on any other value (structs, classes, nullable values, …): `toBe`/`toEqual` compare
/// string forms; `toBeNull` and `toBeDefined`.
///
/// @example
/// ```ts
/// import { test, expect } from "std/test"
///
/// struct Size {
///   w: int
///   h: int
/// }
///
/// test("anything else", () => {
///   const s: Size = { w: 2, h: 3 }
///   expect(s).toEqual({ w: 2, h: 3 })
///   expect(new Map<string, int>().get("x")).toBeNull()
/// })
/// // pico test: ✓ anything else
/// ```
export function expect<T>(actual: T): Expect<T> { new Expect<T>(actual) }
