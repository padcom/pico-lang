// `std/fs`: the file system (spec §13.2, §13.4). Every operation is async: it runs on the
// runtime's I/O threads and settles its promise on the event loop. Failures reject with an
// `IoError` (a global) naming the path and the kind of failure.

import { ByteStream } from "std/streams"

const __kinds = ["", "NotFound", "AlreadyExists", "PermissionDenied", "NotADirectory",
  "IsADirectory", "DirectoryNotEmpty", "InvalidData", "Other"]
const __messages = ["", "no such file or directory", "already exists", "permission denied",
  "not a directory", "is a directory", "directory not empty", "not valid UTF-8", "I/O error"]

/// A finished job's results.
struct __IoResult {
  r: int
  r2: int
  job: int
}

/// The `IoError` for a failed job (`r` < 0).
function __ioError(path: string, r: int, errno: int): IoError {
  const k = if (-r > 0 && -r < __kinds.length) -r else 8
  const what = if (k == 8) `${__messages[k]} (os error ${errno})` else __messages[k]
  new IoError(path, `${what}: ${path}`, __kinds[k])
}

/// Runs job `op`; `read(result)` turns its result into the promised value.
function __job<T>(op: int, a: int, b: int, c: int, s: string, t: string, path: string,
  read: (res: __IoResult) => T): Promise<T, IoError> {
  const p = new Promise<T, IoError>()
  __ioSubmit(op, a, b, c, s, t, (job: int) => {
    const r = __io(102, job, 0, 0, "", "")
    const r2 = __io(103, job, 0, 0, "", "")
    if (r < 0) {
      p.__reject(__ioError(path, r, r2))
    } else {
      p.__resolve(read({ r, r2, job }))
    }
  })
  return p
}

function __unit(_res: __IoResult): void {}

/// The bytes of a view as a buffer handle starting at its first byte, and their count.
function __bytesOf(data: Uint8Array): ArrayBuffer {
  if (data.byteOffset == 0) data.buffer else data.buffer.slice(data.byteOffset, data.byteOffset + data.length)
}

/// The file's text (UTF-8; anything else rejects with kind `"InvalidData"`).
///
/// @example
/// ```ts
/// import { readText, writeText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "read-text-example.txt")
/// await writeText(path, "hello\nworld\n")
/// const text = await readText(path)
/// println(text.split("\n")[1])   // world
/// await remove(path)
/// ```
export function readText(path: string): Promise<string, IoError> {
  __job<string>(1, 0, 0, 0, path, "", path, (res: __IoResult) => __io_text(res.job))
}

/// The file's bytes.
///
/// @example
/// ```ts
/// import { readBytes, writeText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "read-bytes-example.txt")
/// await writeText(path, "AB")
/// const bytes = await readBytes(path)
/// println(bytes.length)   // 2
/// println(bytes[0])       // 65
/// await remove(path)
/// ```
export function readBytes(path: string): Promise<Uint8Array, IoError> {
  __job<Uint8Array>(2, 0, 0, 0, path, "", path, (res: __IoResult) => {
    new Uint8Array(new ArrayBuffer(res.r, res.r2, true), 0, res.r2)
  })
}

/// Writes `text` to the file (created if needed; replaced, or appended to with `append`).
///
/// @example
/// ```ts
/// import { writeText, readText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const log = join(tmpDir(), "write-text-example.log")
/// await writeText(log, "first\n")
/// await writeText(log, "second\n", append: true)
/// print(await readText(log))   // first, then second
/// await remove(log)
/// ```
export function writeText(path: string, text: string, append: bool = false): Promise<void, IoError> {
  __job<void>(3, if (append) 1 else 0, 0, 0, path, text, path, __unit)
}

/// Writes the bytes to the file (created if needed; replaced, or appended to with `append`).
///
/// @example
/// ```ts
/// import { writeBytes, readBytes, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "write-bytes-example.bin")
/// await writeBytes(path, Uint8Array.from([1, 2, 3]))
/// await writeBytes(path, Uint8Array.from([4]), append: true)
/// println((await readBytes(path)).length)   // 4
/// await remove(path)
/// ```
export function writeBytes(path: string, data: Uint8Array, append: bool = false): Promise<void, IoError> {
  const buf = __bytesOf(data)
  __job<void>(4, if (append) 1 else 0, buf.__handle, data.length, path, "", path, __unit)
}

/// What `stat` tells about a path.
///
/// @example
/// ```ts
/// import { stat, writeText, remove, FileInfo } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "file-info-example.txt")
/// await writeText(path, "12345")
/// const info: FileInfo = await stat(path)
/// println(info.isFile)        // true
/// println(info.isDirectory)   // false
/// println(info.size)          // 5
/// println(info.mtime)         // when it was written, e.g. 1795430400000
/// await remove(path)
/// ```
export struct FileInfo {
  /// Whether it's a regular file.
  isFile: bool
  /// Whether it's a directory.
  isDirectory: bool
  /// Whether it's a symbolic link (only with `followLinks: false`; otherwise the link's target is
  /// described).
  isSymlink: bool
  /// In bytes.
  size: int
  /// The last modification, in milliseconds since 1970 (UTC).
  mtime: int
}

function __info(text: string): FileInfo {
  const parts = text.split(" ")
  const k = parts[0]
  const info: FileInfo = {
    isFile: k == "f",
    isDirectory: k == "d",
    isSymlink: k == "l",
    size: parseInt(parts[1]),
    mtime: parseInt(parts[2]),
  }
  return info
}

/// Facts about the file or directory at `path` (following symbolic links unless
/// `followLinks` is false).
///
/// @example
/// ```ts
/// import { stat } from "std/fs"
/// import { tmpDir } from "std/os"
///
/// const info = await stat(tmpDir())
/// println(info.isDirectory)   // true
///
/// try {
///   const missing = await stat("/no/such/path")
///   println(missing.size)
/// } catch (e: IoError) {
///   println(e.kind)           // NotFound
/// }
/// ```
export function stat(path: string, followLinks: bool = true): Promise<FileInfo, IoError> {
  __job<FileInfo>(5, if (followLinks) 0 else 1, 0, 0, path, "", path, (res: __IoResult) => __info(__io_text(res.job)))
}

/// Whether something exists at `path`.
///
/// @example
/// ```ts
/// import { exists, writeText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "exists-example.txt")
/// println(await exists(path))   // false
/// await writeText(path, "")
/// println(await exists(path))   // true
/// await remove(path)
/// ```
export async function exists(path: string): Promise<bool> {
  try {
    await stat(path, false)
    true
  } catch (e: IoError) {
    false
  }
}

/// Creates a directory (with `recursive`, also its missing parents, and an existing
/// directory is fine).
///
/// @example
/// ```ts
/// import { mkdir, exists, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const root = join(tmpDir(), "mkdir-example")
/// await mkdir(join(root, "a", "b"), recursive: true)
/// println(await exists(join(root, "a", "b")))   // true
/// await remove(root, recursive: true)
/// ```
export function mkdir(path: string, recursive: bool = false): Promise<void, IoError> {
  __job<void>(6, if (recursive) 1 else 0, 0, 0, path, "", path, __unit)
}

/// Removes a file or an empty directory (with `recursive`, a directory and everything in it).
///
/// @example
/// ```ts
/// import { mkdir, writeText, remove, exists } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "remove-example")
/// await mkdir(dir)
/// await writeText(join(dir, "a.txt"), "a")
/// await remove(join(dir, "a.txt"))     // a file
/// await writeText(join(dir, "b.txt"), "b")
/// await remove(dir, recursive: true)   // a directory and what's in it
/// println(await exists(dir))           // false
/// ```
export function remove(path: string, recursive: bool = false): Promise<void, IoError> {
  __job<void>(7, if (recursive) 1 else 0, 0, 0, path, "", path, __unit)
}

/// Moves or renames `from` to `to` (replacing a file there).
///
/// @example
/// ```ts
/// import { rename, writeText, readText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const from = join(tmpDir(), "rename-example.tmp")
/// const to = join(tmpDir(), "rename-example.txt")
/// await writeText(from, "moved")
/// await rename(from, to)
/// println(await readText(to))   // moved
/// await remove(to)
/// ```
export function rename(from: string, to: string): Promise<void, IoError> {
  __job<void>(8, 0, 0, 0, from, to, from, __unit)
}

/// Copies file `from` to `to`, replacing a file there; the copy gets `from`'s permissions (#64).
/// A directory rejects (`IsADirectory`).
///
/// @example
/// ```ts
/// import { copy, writeText, readText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const original = join(tmpDir(), "copy-example.txt")
/// const backup = join(tmpDir(), "copy-example.bak")
/// await writeText(original, "keep me")
/// await copy(original, backup)
/// println(await readText(backup))   // keep me
/// await remove(original)
/// await remove(backup)
/// ```
export function copy(from: string, to: string): Promise<void, IoError> {
  __job<void>(37, 0, 0, 0, from, to, from, __unit)
}

/// Makes `path` a symbolic link to `target` (as written: a relative target is relative to the
/// link's directory) (#64). On Windows this needs Developer Mode or the symlink privilege.
///
/// @example
/// ```ts
/// import { symlink, readText, writeText, remove, stat } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const target = join(tmpDir(), "symlink-example.txt")
/// const link = join(tmpDir(), "symlink-example.link")
/// await writeText(target, "through the link")
/// await symlink("symlink-example.txt", link)   // relative to the link's directory
/// println(await readText(link))                // through the link
/// println((await stat(link, followLinks: false)).isSymlink)   // true
/// await remove(link)
/// await remove(target)
/// ```
export function symlink(target: string, path: string): Promise<void, IoError> {
  __job<void>(38, 0, 0, 0, path, target, path, __unit)
}

/// The target of the symbolic link `path`, as it was written (#64). Not on Windows yet.
///
/// @example
/// ```ts
/// import { symlink, readlink, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const link = join(tmpDir(), "readlink-example.link")
/// await symlink("../somewhere/else", link)
/// println(await readlink(link))   // ../somewhere/else
/// await remove(link)
/// ```
export function readlink(path: string): Promise<string, IoError> {
  __job<string>(39, 0, 0, 0, path, "", path, (res: __IoResult) => __io_text(res.job))
}

/// Sets `path`'s permission bits (`0o644`, `0o755`, …) (#64). On Windows only the owner's write
/// bit counts (the read-only attribute); WASI has no permissions (it rejects).
///
/// @example
/// ```ts
/// import { chmod, writeText, remove } from "std/fs"
/// import { Command } from "std/process"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const script = join(tmpDir(), "chmod-example.sh")
/// await writeText(script, "#!/bin/sh\necho it runs\n")
/// await chmod(script, 0o755)
/// println((await new Command(script).output()).stdout.trim())   // it runs
/// await remove(script)
/// ```
export function chmod(path: string, mode: int): Promise<void, IoError> {
  __job<void>(40, mode, 0, 0, path, "", path, __unit)
}

/// An entry of a directory.
///
/// @example
/// ```ts
/// import { readDir, mkdir, writeText, remove, DirEntry } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "dir-entry-example")
/// await mkdir(join(dir, "sub"), recursive: true)
/// await writeText(join(dir, "a.txt"), "")
/// for await (const e of readDir(dir)) {
///   const entry: DirEntry = e
///   println(`${entry.name} ${if (entry.isDirectory) "dir" else "file"}`)   // a.txt file, then sub dir
/// }
/// await remove(dir, recursive: true)
/// ```
export struct DirEntry {
  /// The entry's name (not a path).
  name: string
  /// Whether it's a regular file.
  isFile: bool
  /// Whether it's a directory.
  isDirectory: bool
  /// Whether it's a symbolic link (not followed: a link to a directory is neither `isFile` nor
  /// `isDirectory`).
  isSymlink: bool
}

function __entries(text: string): DirEntry[] {
  const out: DirEntry[] = []
  for (const line of text.split("\u{0}")) {
    if (line.length >= 2) {
      const k = line.slice(0, 1)
      out.push({ name: line.slice(2), isFile: k == "f", isDirectory: k == "d", isSymlink: k == "l" })
    }
  }
  return out
}

/// The entries of a directory (without `.` and `..`), in name order.
///
/// @example
/// ```ts
/// import { readDir, mkdir, writeText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "read-dir-example")
/// await mkdir(dir)
/// await writeText(join(dir, "b.txt"), "")
/// await writeText(join(dir, "a.txt"), "")
/// for await (const e of readDir(dir)) {
///   println(e.name)   // a.txt, then b.txt
/// }
/// await remove(dir, recursive: true)
/// ```
export async function* readDir(path: string): AsyncIterator<DirEntry> throws IoError {
  const entries = await __job<DirEntry[]>(9, 0, 0, 0, path, "", path, (res: __IoResult) => __entries(__io_text(res.job)))
  for (const e of entries) {
    yield e
  }
}

/// An open file: `read`, `write` and `seek` (from the start), then `close` (or `await using`).
///
/// @example
/// ```ts
/// import { open, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "file-example.bin")
/// const f = await open(path, write: true, create: true, truncate: true)
/// await f.write(new TextEncoder().encode("hello"))
/// await f.seek(0)
/// const bytes = await f.read(5)
/// if (bytes != null) {
///   println(new TextDecoder().decode(bytes))   // hello
/// }
/// await f.close()
/// await remove(path)
/// ```
export class File implements AsyncDisposable {
  fd: int
  /// The path the file was opened with.
  public readonly path: string
  closed: bool = false

  /// Wraps the open descriptor `fd`; `open` makes these.
  ///
  /// @example
  /// ```ts
  /// import { open, File, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-ctor-example.txt")
  /// await writeText(path, "x")
  /// const f: File = await open(path)   // `open` makes Files
  /// println(f.path == path)            // true
  /// await f.close()
  /// await remove(path)
  /// ```
  constructor(fd: int, path: string) {
    this.fd = fd
    this.path = path
  }

  check(): void {
    if (closed) {
      panic(`file ${path} is closed`)
    }
  }

  /// Up to `n` bytes from the current position; `null` at the end of the file.
  ///
  /// @example
  /// ```ts
  /// import { open, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-read-example.txt")
  /// await writeText(path, "abcdef")
  /// const f = await open(path)
  /// println((await f.read(4))?.length)   // 4
  /// println((await f.read(4))?.length)   // 2
  /// println(await f.read(4))             // null
  /// await f.close()
  /// await remove(path)
  /// ```
  public read(n: int): Promise<Uint8Array?, IoError> {
    check()
    __job<Uint8Array?>(11, fd, n, 0, "", "", path, (res: __IoResult) => {
      if (res.r2 == 0) {
        __buf_op(2, res.r, 0, 0);
        null
      } else {
        new Uint8Array(new ArrayBuffer(res.r, res.r2, true), 0, res.r2)
      }
    })
  }

  /// The rest of the file as a stream of chunks (up to 64 KiB each, #64), for files too big to
  /// read whole; the file closes when the stream ends or is cancelled. Pipe it through
  /// `textDecoderStream()` (`std/streams`) for text.
  ///
  /// @example
  /// ```ts
  /// import { open, writeText, remove } from "std/fs"
  /// import { textDecoderStream } from "std/streams"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-readable-example.txt")
  /// await writeText(path, "streamed text")
  /// const f = await open(path)
  /// let text = ""
  /// for await (const piece of f.readable.pipeThrough(textDecoderStream())) {
  ///   text = text + piece
  /// }
  /// println(text)   // streamed text
  /// await remove(path)
  /// ```
  public get readable(): ReadableStream<Uint8Array> {
    new ReadableStream<Uint8Array>({
      pullAsync: (c) => __readChunk(this, c),
      cancel: (_reason) => {
        this.__closeQuietly()
      },
    })
  }

  /// Closes the file unless it's closed, ignoring a failure (a stream's end).
  public __closeQuietly(): void {
    if (!closed) {
      closed = true
      __job<void>(13, fd, 0, 0, "", "", path, __unit)
    }
  }

  /// Writes all of `data` at the current position; the count written.
  ///
  /// @example
  /// ```ts
  /// import { open, readText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-write-example.txt")
  /// const f = await open(path, write: true, create: true, truncate: true)
  /// println(await f.write(new TextEncoder().encode("written")))   // 7
  /// await f.close()
  /// println(await readText(path))   // written
  /// await remove(path)
  /// ```
  public write(data: Uint8Array): Promise<int, IoError> {
    check()
    const buf = __bytesOf(data)
    __job<int>(12, fd, buf.__handle, data.length, "", "", path, (res: __IoResult) => res.r)
  }

  /// Moves to byte `position` (from the start); the new position.
  ///
  /// @example
  /// ```ts
  /// import { open, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-seek-example.txt")
  /// await writeText(path, "0123456789")
  /// const f = await open(path)
  /// println(await f.seek(7))   // 7
  /// const rest = await f.read(10)
  /// if (rest != null) {
  ///   println(new TextDecoder().decode(rest))   // 789
  /// }
  /// await f.close()
  /// await remove(path)
  /// ```
  public seek(position: int): Promise<int, IoError> {
    check()
    __job<int>(14, fd, position, 0, "", "", path, (res: __IoResult) => res.r)
  }

  /// Closes the file (twice is fine: the second call resolves at once). Using it afterwards panics.
  ///
  /// @example
  /// ```ts
  /// import { open, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-close-example.txt")
  /// await writeText(path, "x")
  /// const f = await open(path)
  /// await f.close()
  /// await f.close()   // twice is fine
  /// await remove(path)
  /// ```
  public close(): Promise<void, IoError> {
    if (closed) {
      const done = new Promise<void, IoError>()
      done.__resolve(__void())
      return done
    }
    closed = true
    __job<void>(13, fd, 0, 0, "", "", path, __unit)
  }

  /// `await using`: closes the file, ignoring a failure.
  ///
  /// @example
  /// ```ts
  /// import { open, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-using-example.txt")
  /// await writeText(path, "auto-closed")
  /// {
  ///   await using f = await open(path)
  ///   println((await f.read(100))?.length)   // 11
  /// }   // f.disposeAsync() closes it here
  /// await remove(path)
  /// ```
  public async disposeAsync(): Promise<void> {
    try {
      await close()
    } catch (e: IoError) {}
  }
}

/// One pull of `File.readable`: the next chunk, or the end (which closes the file).
async function __readChunk(f: File, c: ReadableStreamDefaultController<Uint8Array>): Promise<void> throws Error {
  const b = await f.read(65536)
  if (b != null && b.length > 0) {
    c.enqueue(b)
  } else {
    f.__closeQuietly()
    c.close()
  }
}

/// Opens a file: for reading by default; `write: true` to write (with `create` to create it,
/// `truncate` to empty it, `append` to write at its end, `createNew` to require that it
/// doesn't exist).
///
/// @example
/// ```ts
/// import { open, readText, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "open-example.log")
/// const f = await open(path, write: true, create: true, append: true)
/// await f.write(new TextEncoder().encode("one line\n"))
/// await f.close()
/// print(await readText(path))   // one line
/// await remove(path)
/// ```
export function open(path: string, read: bool = true, write: bool = false, append: bool = false,
  create: bool = false, truncate: bool = false, createNew: bool = false): Promise<File, IoError> {
  let flags = 0
  if (read) flags += 1
  if (write) flags += 2
  if (append) flags += 4
  if (create) flags += 8
  if (truncate) flags += 16
  if (createNew) flags += 32
  __job<File>(10, flags, 0, 0, path, "", path, (res: __IoResult) => new File(res.r, path))
}

/// The platform's path separator, which watch events use.
const __sep = comptime if (target.os == "windows") "\\" else "/"

/// A change `watch` saw: `kind` is `"create"`, `"modify"` (a file's size or modification time
/// changed) or `"remove"`; `path` is the watched path joined with the changed entry's path
/// (the watched path itself when watching a file). A rename is a remove and a create.
///
/// @example
/// ```ts
/// import { watch, writeText, remove, mkdir, WatchEvent } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "watch-event-example")
/// await mkdir(dir, recursive: true)
/// const w = await watch(dir)
/// await writeText(join(dir, "new.txt"), "hi")
/// const e: WatchEvent? = await w.next()
/// if (e != null) {
///   println(e.kind)                                // create
///   println(e.path == join(dir, "new.txt"))        // true
/// }
/// w.close()
/// await remove(dir, recursive: true)
/// ```
export struct WatchEvent {
  /// `"create"`, `"modify"` or `"remove"`.
  kind: string
  /// The watched path joined with the changed entry's path (the watched path itself when watching a
  /// file).
  path: string
}

/// Watches a file or a directory (with `recursive`, the whole tree below it): an async
/// iterator of `WatchEvent`s, ended by `close()` (or `using`). Changes made while nobody
/// waits for an event are compared as a whole when the next one is asked for, so a file
/// created and changed in between is one `create`, and one created and removed is nothing.
///
/// The OS says which directories changed (inotify on Linux, FSEvents on macOS,
/// `ReadDirectoryChangesW` on Windows) and only those are looked at again, so an idle watcher
/// costs nothing, even on a big tree. When it can't say, the watcher looks at the whole tree
/// each time, and also every 250 ms while an event is awaited, which on a big tree (tens of
/// thousands of entries) is noticeable CPU: when the OS dropped events (its queue or buffer
/// overflowed), Linux's watch limit (`fs.inotify.max_user_watches`) is reached, the watched
/// path is a file, or it's gone. (On macOS then, in a tree of more than 256 entries, a change
/// to a file's contents is only noticed by that 250 ms look.)
///
/// @example
/// ```ts
/// import { watch, writeText, remove, mkdir } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "watcher-example")
/// await mkdir(dir, recursive: true)
/// const w = await watch(dir)
/// await writeText(join(dir, "a.txt"), "1")
/// for await (const e of w) {
///   println(`${e.kind} a.txt`)   // create a.txt
///   w.close()                    // ends the loop
/// }
/// await remove(dir, recursive: true)
/// ```
export class Watcher implements Disposable {
  id: int
  /// The path being watched, as given to `watch`.
  public readonly path: string
  queued: WatchEvent[] = []
  head: int = 0
  /// `next()` promises not fulfilled yet, oldest first.
  requests: Promise<WatchEvent?>[] = []
  served: int = 0
  waiting: bool = false
  closed: bool = false

  /// Wraps the runtime's watch `id`; `watch` makes these.
  ///
  /// @example
  /// ```ts
  /// import { watch, Watcher, mkdir, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const dir = join(tmpDir(), "watcher-ctor-example")
  /// await mkdir(dir, recursive: true)
  /// const w: Watcher = await watch(dir)   // `watch` makes Watchers
  /// println(w.path == dir)                // true
  /// w.close()
  /// await remove(dir, recursive: true)
  /// ```
  constructor(id: int, path: string) {
    this.id = id
    this.path = path
  }

  /// The next change (waiting for one), or `null` once the watcher is closed.
  ///
  /// @example
  /// ```ts
  /// import { watch, writeText, remove, mkdir } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const dir = join(tmpDir(), "watcher-next-example")
  /// await mkdir(dir, recursive: true)
  /// const w = await watch(dir)
  /// const next = w.next()
  /// await writeText(join(dir, "f.txt"), "x")
  /// println((await next)?.kind)   // create
  /// w.close()
  /// println(await w.next() == null)   // true: closed
  /// await remove(dir, recursive: true)
  /// ```
  public next(): Promise<WatchEvent?> {
    const p = new Promise<WatchEvent?>()
    requests.push(p)
    serve()
    return p
  }

  /// `for await` uses the watcher itself.
  ///
  /// @example
  /// ```ts
  /// import { watch, writeText, remove, mkdir } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const dir = join(tmpDir(), "watcher-iter-example")
  /// await mkdir(dir, recursive: true)
  /// const w = await watch(dir)
  /// await writeText(join(dir, "f.txt"), "x")
  /// for await (const e of w.asyncIterator()) {
  ///   println(e.kind)   // create
  ///   w.close()
  /// }
  /// await remove(dir, recursive: true)
  /// ```
  public asyncIterator(): Watcher {
    this
  }

  /// Stops watching: waiting and later `next()` calls get `null`. Twice is fine.
  ///
  /// @example
  /// ```ts
  /// import { watch, mkdir, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const dir = join(tmpDir(), "watcher-close-example")
  /// await mkdir(dir, recursive: true)
  /// const w = await watch(dir)
  /// const pending = w.next()
  /// w.close()
  /// println(await pending == null)   // true
  /// await remove(dir, recursive: true)
  /// ```
  public close(): void {
    if (closed) {
      return
    }
    closed = true
    __watchers.unregister(this)
    __io(106, id, 0, 0, "", "");
    serve()
  }

  /// `using`: the same as `close()`.
  ///
  /// @example
  /// ```ts
  /// import { watch, mkdir, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const dir = join(tmpDir(), "watcher-using-example")
  /// await mkdir(dir, recursive: true)
  /// {
  ///   using w = await watch(dir)
  ///   println(w.path == dir)   // true
  /// }   // w.dispose() stops watching here
  /// await remove(dir, recursive: true)
  /// ```
  public dispose(): void {
    close()
  }

  serve(): void {
    while (served < requests.length && (head < queued.length || closed)) {
      const p = requests[served]
      served += 1
      if (head < queued.length) {
        const e = queued[head]
        head += 1
        p.__resolve(e)
      } else {
        p.__resolve(null)
      }
    }
    if (served == requests.length) {
      requests = []
      served = 0
    }
    if (head == queued.length) {
      queued = []
      head = 0
    }
    if (served < requests.length && !waiting && !closed) {
      waiting = true
      __ioSubmit(16, id, 0, 0, "", "", (job: int) => {
        this.waiting = false
        if (__io(102, job, 0, 0, "", "") == 1) {
          this.closed = true
        } else {
          for (const line of __io_text(job).split("\u{0}")) {
            if (line.length >= 2) {
              const k = line.slice(0, 1)
              const rel = line.slice(2)
              const kind = if (k == "c") "create" else if (k == "m") "modify" else "remove"
              const root = this.path
              const full = if (rel.length == 0) root else if (root.endsWith("/") || root.endsWith(__sep)) `${root}${rel}` else `${root}${__sep}${rel}`
              this.queued.push({ kind, path: full })
            }
          }
        }
        this.serve()
      })
    }
  }
}

/// Starts watching `path` (see `Watcher`, also for what it costs on each platform); rejects
/// if it can't be looked at.
///
/// @example
/// ```ts
/// import { watch, writeText, remove, mkdir } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const dir = join(tmpDir(), "watch-example")
/// await mkdir(join(dir, "src"), recursive: true)
/// const w = await watch(dir, recursive: true)
/// await writeText(join(dir, "src", "main.pi"), "println(1)")
/// const e = await w.next()
/// println(e?.kind)   // create
/// w.close()
/// await remove(dir, recursive: true)
/// ```
export function watch(path: string, recursive: bool = true): Promise<Watcher, IoError> {
  __job<Watcher>(15, if (recursive) 1 else 0, 0, 0, path, "", path, (res: __IoResult) => {
    const w = new Watcher(res.r, path)
    // (A watcher dropped without `close()` is closed once it's collected, #64.)
    __watchers.registerWithToken(w, res.r, w)
    return w
  })
}

/// Closes the runtime watcher (its thread and descriptors) of a `Watcher` that was collected
/// without `close()` (#64).
const __watchers = new FinalizationRegistry<int>((id: int) => {
  __io(106, id, 0, 0, "", "");
})

/// A file read as a `ByteStream` (`std/streams`), `chunkSize` bytes at a time: a recording for
/// protocol code to replay. Writes are discarded, so that code can still answer.
///
/// @example
/// ```ts
/// import { FileStream, writeBytes, remove } from "std/fs"
/// import { tmpDir } from "std/os"
/// import { join } from "std/path"
///
/// const path = join(tmpDir(), "file-stream-example.bin")
/// await writeBytes(path, Uint8Array.from([1, 2, 3, 4, 5]))
/// const stream = new FileStream(path, chunkSize: 2)
/// let chunk = await stream.read()
/// while (chunk != null) {
///   println(chunk.length)   // 2, 2, then 1
///   chunk = await stream.read()
/// }
/// await remove(path)
/// ```
export class FileStream implements ByteStream {
  /// The file's path.
  public readonly path: string
  readonly chunkSize: int
  file: File? = null
  ended: bool = false

  /// @example
  /// ```ts
  /// import { FileStream, writeText, remove } from "std/fs"
  /// import { ByteStream } from "std/streams"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-stream-ctor-example.bin")
  /// await writeText(path, "recorded")
  /// const replay: ByteStream = new FileStream(path)
  /// println((await replay.read())?.length)   // 8
  /// replay.close()
  /// await remove(path)
  /// ```
  constructor(path: string, chunkSize: int = 65536) {
    this.path = path
    this.chunkSize = chunkSize
  }

  /// @example
  /// ```ts
  /// import { FileStream, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-stream-read-example.txt")
  /// await writeText(path, "abc")
  /// const stream = new FileStream(path)
  /// const bytes = await stream.read()
  /// if (bytes != null) {
  ///   println(new TextDecoder().decode(bytes))   // abc
  /// }
  /// println(await stream.read())   // null: the end
  /// await remove(path)
  /// ```
  public async read(): Promise<Uint8Array?> throws Error {
    if (ended) {
      return null
    }
    const known = file
    const f = if (known != null) known else await open(path)
    file = f
    const chunk = await f.read(chunkSize)
    if (chunk == null) {
      close()
    }
    return chunk
  }

  /// Discards `bytes`.
  ///
  /// @example
  /// ```ts
  /// import { FileStream, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-stream-write-example.txt")
  /// await writeText(path, "data")
  /// const stream = new FileStream(path)
  /// await stream.write(Uint8Array.from([1, 2]))   // discarded: the file is unchanged
  /// println((await stream.read())?.length)          // 4
  /// stream.close()
  /// await remove(path)
  /// ```
  public async write(bytes: Uint8Array): Promise<void> throws Error {}

  /// Stops reading (and closes the file).
  ///
  /// @example
  /// ```ts
  /// import { FileStream, writeText, remove } from "std/fs"
  /// import { tmpDir } from "std/os"
  /// import { join } from "std/path"
  ///
  /// const path = join(tmpDir(), "file-stream-close-example.txt")
  /// await writeText(path, "data")
  /// const stream = new FileStream(path)
  /// stream.close()
  /// println(await stream.read())   // null
  /// await remove(path)
  /// ```
  public close(): void {
    ended = true
    const f = file
    if (f != null) {
      file = null
      f.close().catch((_e: Error) => {})
    }
  }
}
