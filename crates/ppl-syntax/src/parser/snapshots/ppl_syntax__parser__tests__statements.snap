---
source: crates/ppl-syntax/src/parser/tests.rs
expression: "ok(r##\"\nconst a = 1\nlet b: i32 = 2\nconst { x, y: py, ...rest } = point\nconst [first, second] = pair\nconst { port = 8080, host = \"localhost\" } = opts\nlet [p, q] = [1, 2]\nfor (let i = 0; i < n; i++) println(i)\nfor (;;) {}\nfor (const item of items) { println(item) }\nfor (const [k, v] of map) println(k)\nfor await (const l of lines()) println(l)\nwhile (x > 0) x--\ndo { x++ } while (x < 10)\nconst found = loop {\n  const line = readLine() ?? break null\n  if (line.startsWith(\"#\")) break line\n}\nusing lock = mutex.lock()\nawait using f = await open(\"data.bin\")\ncomptime const K: u32 = 1 << 10\n\"##)"
---
(const a 1)
(let b (: i32) 2)
(const (object-pat x (y: py) (... rest)) point)
(const (array-pat first second) pair)
(const (object-pat (= port 8080) (= host "localhost")) opts)
(let (array-pat p q) (array 1 2))
(for (let i 0) (< i n) (post++ i) (call println i))
(for _ _ _ (block))
(for-of const item items (block (call println item)))
(for-of const (array-pat k v) map (call println k))
(for-await-of const l (call lines) (call println l))
(while (> x 0) (post-- x))
(do-while (block (post++ x)) (< x 10))
(const
  found
  (loop
    (block
      (const line (?? (call readLine) (break null)))
      (if (call (. line startsWith) "#") (break line)))))
(using lock (call (. mutex lock)))
(await-using f (await (call open "data.bin")))
(comptime-const K (: u32) (<< 1 10))
