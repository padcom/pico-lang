---
source: crates/ppl-syntax/src/parser/tests.rs
expression: "ok(r##\"\nswitch (cmd) {\n  case \"build\" | \"b\": build()\n  case \"test\":        test()\n  case Run { file }:  run(file)\n  default:            usage()\n}\nconst code = switch (r) {\n  case Ok(_): 0\n  case Err(e): { log(e); 1 }\n}\nif (shape is Circle { r }) println(r)\nif (!(x is string)) return\nwhile (it.next() is Some(v)) use(v)\nconst config = try {\n  readConfig(path)\n} catch (e: IoError { path }) {\n  Config.default()\n} catch (e: ParseError) {\n  throw new ConfigError(\"bad config\", cause: e)\n} finally {\n  log.flush()\n}\ntry f() catch (e) g()\n\"##)"
---
(switch
  cmd
  (case (| "build" "b") (block (call build)))
  (case "test" (block (call test)))
  (case (struct-pat Run file) (block (call run file)))
  (default (block (call usage))))
(const
  code
  (switch
    r
    (case (variant Ok _) (block 0))
    (case (variant Err e) (block (block (; (call log e)) 1)))))
(if (is shape (struct-pat Circle r)) (call println r))
(if (! (paren (is x string))) (return))
(while (is (call (. it next)) (variant Some v)) (call use v))
(const
  config
  (try
    (block (call readConfig path))
    (catch (typed e IoError path) (block (call (. Config default))))
    (catch (typed e ParseError) (block (throw (new ConfigError "bad config" (cause: e)))))
    (finally (block (call (. log flush))))))
(try (call f) (catch e (call g)))
