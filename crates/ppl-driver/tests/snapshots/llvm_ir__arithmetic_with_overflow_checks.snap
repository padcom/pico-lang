---
source: crates/ppl-driver/tests/llvm_ir.rs
expression: "ir(r#\"\nfunction add(a: i32, b: i32): i32 { a + b }\nfunction half(a: u64): u64 { a / 2 }\nfunction neg(x: f64): f64 { -x * 2.0 }\n\"#)"
---
; ModuleID = 'test.ppl'
source_filename = "test.ppl"

@ppl.global.__finalizationRegistries = internal global ptr null
@ppl.global.__loop = internal global ptr null
@ppl.classinfo.Error = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.__MapEntry = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.Map = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.Set = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.Iterator = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.WeakRef = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.__WeakEntry = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.WeakMap = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.WeakSet = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.__FinalizationCell = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.FinalizationRegistry = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.__Timer = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.__Loop = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.Promise = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl.classinfo.Arena = internal constant { ptr, [0 x ptr] } zeroinitializer
@ppl_gc_requested = external global i32
@ppl.cstr = private unnamed_addr constant [16 x i8] c"integer overflow"
@ppl.cstr.8 = private unnamed_addr constant [8 x i8] c"test.ppl"
@ppl.cstr.9 = private unnamed_addr constant [16 x i8] c"division by zero"
@ppl.layout = private constant { i64, i32, i32, [1 x i32] } { i64 8, i32 1, i32 0, [1 x i32] zeroinitializer }, align 8
@ppl.layout.10 = private constant { i64, i32, i32, [1 x i32] } { i64 8, i32 1, i32 0, [1 x i32] zeroinitializer }, align 8
@ppl.gc_globals = private constant { i64, [2 x { ptr, ptr, ptr }] } { i64 2, [2 x { ptr, ptr, ptr }] [{ ptr, ptr, ptr } { ptr null, ptr @ppl.layout, ptr @ppl.global.__finalizationRegistries }, { ptr, ptr, ptr } { ptr null, ptr @ppl.layout.10, ptr @ppl.global.__loop }] }

define internal i32 @ppl.add(i32 %0, i32 %1) {
start:
  %a = alloca i32, align 4
  %b = alloca i32, align 4
  %t2 = alloca i32, align 4
  store i32 %0, ptr %a, align 4
  store i32 %1, ptr %b, align 4
  %gc.requested = load i32, ptr @ppl_gc_requested, align 4
  %2 = icmp ne i32 %gc.requested, 0
  br i1 %2, label %gc.collect, label %gc.continue

bb0:                                              ; preds = %gc.continue
  %3 = load i32, ptr %a, align 4
  %4 = load i32, ptr %b, align 4
  %5 = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %3, i32 %4)
  %6 = extractvalue { i32, i1 } %5, 0
  %7 = extractvalue { i32, i1 } %5, 1
  br i1 %7, label %panic, label %ok

gc.collect:                                       ; preds = %start
  call void @ppl_gc_safepoint()
  br label %gc.continue

gc.continue:                                      ; preds = %gc.collect, %start
  br label %bb0

panic:                                            ; preds = %bb0
  call void @ppl_panic(ptr @ppl.cstr, i64 16, ptr @ppl.cstr.8, i64 8, i32 2, i32 37)
  unreachable

ok:                                               ; preds = %bb0
  store i32 %6, ptr %t2, align 4
  %8 = load i32, ptr %t2, align 4
  ret i32 %8
}

define internal i64 @ppl.half(i64 %0) {
start:
  %a = alloca i64, align 8
  %t1 = alloca i64, align 8
  store i64 %0, ptr %a, align 4
  %gc.requested = load i32, ptr @ppl_gc_requested, align 4
  %1 = icmp ne i32 %gc.requested, 0
  br i1 %1, label %gc.collect, label %gc.continue

bb0:                                              ; preds = %gc.continue
  %2 = load i64, ptr %a, align 4
  br i1 false, label %panic, label %ok

gc.collect:                                       ; preds = %start
  call void @ppl_gc_safepoint()
  br label %gc.continue

gc.continue:                                      ; preds = %gc.collect, %start
  br label %bb0

panic:                                            ; preds = %bb0
  call void @ppl_panic(ptr @ppl.cstr.9, i64 16, ptr @ppl.cstr.8, i64 8, i32 3, i32 30)
  unreachable

ok:                                               ; preds = %bb0
  %3 = udiv i64 %2, 2
  store i64 %3, ptr %t1, align 4
  %4 = load i64, ptr %t1, align 4
  ret i64 %4
}

define internal double @ppl.neg(double %0) {
start:
  %x = alloca double, align 8
  %t1 = alloca double, align 8
  %t2 = alloca double, align 8
  store double %0, ptr %x, align 8
  %gc.requested = load i32, ptr @ppl_gc_requested, align 4
  %1 = icmp ne i32 %gc.requested, 0
  br i1 %1, label %gc.collect, label %gc.continue

bb0:                                              ; preds = %gc.continue
  %2 = load double, ptr %x, align 8
  %3 = fneg double %2
  store double %3, ptr %t1, align 8
  %4 = load double, ptr %t1, align 8
  %5 = fmul double %4, 2.000000e+00
  store double %5, ptr %t2, align 8
  %6 = load double, ptr %t2, align 8
  ret double %6

gc.collect:                                       ; preds = %start
  call void @ppl_gc_safepoint()
  br label %gc.continue

gc.continue:                                      ; preds = %gc.collect, %start
  br label %bb0
}

define void @ppl_entry() {
start:
  call void @ppl_gc_set_globals(ptr @ppl.gc_globals)
  %gc.requested = load i32, ptr @ppl_gc_requested, align 4
  %0 = icmp ne i32 %gc.requested, 0
  br i1 %0, label %gc.collect, label %gc.continue

bb0:                                              ; preds = %gc.continue
  store ptr null, ptr @ppl.global.__finalizationRegistries, align 8
  store ptr null, ptr @ppl.global.__loop, align 8
  br label %bb1

bb1:                                              ; preds = %bb0
  ret void

gc.collect:                                       ; preds = %start
  call void @ppl_gc_safepoint()
  br label %gc.continue

gc.continue:                                      ; preds = %gc.collect, %start
  br label %bb0
}

declare void @ppl_gc_safepoint()

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare { i32, i1 } @llvm.sadd.with.overflow.i32(i32, i32) #0

; Function Attrs: cold noreturn
declare void @ppl_panic(ptr, i64, ptr, i64, i32, i32) #1

declare void @ppl_gc_set_globals(ptr)

attributes #0 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
attributes #1 = { cold noreturn }
