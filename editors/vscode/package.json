{
  "name": "pico-lang",
  "displayName": "Pico",
  "description": "The Pico Programming Language: highlighting, diagnostics, completion, hover, rename, formatting and debugging, through the pico language server.",
  "version": "0.4.2",
  "publisher": "padcom",
  "license": "MIT",
  "icon": "images/pico-icon.png",
  "homepage": "https://padcom.github.io/pico-lang/",
  "repository": {
    "type": "git",
    "url": "https://github.com/padcom/pico-lang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/padcom/pico-lang/issues"
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "pico",
    "pico-lang",
    "language server",
    "lsp",
    "typescript",
    "llvm",
    "webassembly"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pico",
    "onDebugResolve:pico",
    "onDebugDynamicConfigurations:pico",
    "onCommand:workbench.action.tasks.runTask"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pico",
        "aliases": [
          "pico",
          "Pico"
        ],
        "extensions": [
          ".pi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/pico-file.svg",
          "dark": "./images/pico-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pico",
        "scopeName": "source.pico",
        "path": "./syntaxes/pico.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pico.codeblock",
        "path": "./syntaxes/pico.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pico": "pico"
        }
      }
    ],
    "commands": [
      {
        "command": "pico.restartServer",
        "title": "pico: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "pico",
      "properties": {
        "pico.server.path": {
          "type": "string",
          "default": "pico",
          "description": "The pico binary that runs the language server (`pico lsp`); `pico` is looked up on PATH."
        },
        "pico.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments before `lsp`."
        },
        "pico.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with the language server (the \"pico language server\" output)."
        }
      }
    },
    "breakpoints": [
      {
        "language": "pico"
      }
    ],
    "debuggers": [
      {
        "type": "pico",
        "label": "pico",
        "languages": [
          "pico"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The `.pi` file to build and debug, a project directory (its `entry`), or an executable.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The working directory (default: the program's directory).",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Environment variables, as `NAME=value`.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first line.",
                "default": false
              }
            }
          },
          "attach": {
            "properties": {
              "pid": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "The process to attach to.",
                "default": "${command:pickProcess}"
              },
              "program": {
                "type": "string",
                "description": "The executable. With `waitFor`, the next process started from it is attached to (for a program another one starts, such as a backend whose stdio its parent owns)."
              },
              "waitFor": {
                "type": "boolean",
                "description": "Wait for `program` to start, then attach.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pico",
            "request": "launch",
            "name": "Debug the project",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "pico: Launch",
            "description": "Build and debug a pico program.",
            "body": {
              "type": "pico",
              "request": "launch",
              "name": "Debug ${1:main.pi}",
              "program": "^\"\\${workspaceFolder}/${1:main.pi}\""
            }
          },
          {
            "label": "pico: Attach",
            "description": "Attach to a pico program when it starts (one that another program launches).",
            "body": {
              "type": "pico",
              "request": "attach",
              "name": "Attach to ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:program}\"",
              "waitFor": true
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "pico",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build"
            ],
            "description": "The pico command (`build`: the project's `entry`)."
          }
        }
      }
    ]
  },
  "scripts": {
    "package": "../../scripts/vscode-package.sh"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
