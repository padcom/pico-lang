{
  "name": "ppl",
  "displayName": "ppl",
  "description": "The padcom programming language: syntax highlighting, diagnostics and formatting (ppl lsp).",
  "version": "0.2.0",
  "publisher": "padcom",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ppl",
    "onDebugResolve:ppl",
    "onDebugDynamicConfigurations:ppl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ppl",
        "aliases": [
          "ppl",
          "PPL"
        ],
        "extensions": [
          ".ppl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ppl",
        "scopeName": "source.ppl",
        "path": "./syntaxes/ppl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ppl.codeblock",
        "path": "./syntaxes/ppl.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ppl": "ppl"
        }
      }
    ],
    "commands": [
      {
        "command": "ppl.restartServer",
        "title": "ppl: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "ppl",
      "properties": {
        "ppl.server.path": {
          "type": "string",
          "default": "ppl",
          "description": "The ppl binary that runs the language server (`ppl lsp`); `ppl` is looked up on PATH."
        },
        "ppl.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments before `lsp`."
        },
        "ppl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with the language server (the \"ppl language server\" output)."
        }
      }
    },
    "breakpoints": [
      {
        "language": "ppl"
      }
    ],
    "debuggers": [
      {
        "type": "ppl",
        "label": "ppl",
        "languages": [
          "ppl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The `.ppl` file to build and debug (or an executable).",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The working directory (default: the program's directory).",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Environment variables, as `NAME=value`.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first line.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ppl",
            "request": "launch",
            "name": "Debug the current ppl file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "ppl: Launch",
            "description": "Build and debug a ppl program.",
            "body": {
              "type": "ppl",
              "request": "launch",
              "name": "Debug ${1:main.ppl}",
              "program": "^\"\\${workspaceFolder}/${1:main.ppl}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "package": "../../scripts/vscode-package.sh"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
